import System.Collections.ArrayList;
import editor.TextBuffer;
import editor.Editor;
import editor.Match;
import syntax.Tok;
import syntax.Span;
import syntax.Highlighter;
import io.Document;
import io.FileTree;
import io.FileNode;
import System.IO.File;
import view.Viewport;
import view.TextRenderer;
import view.ScreenRenderer;
import app.Controller;
import app.DocumentManager;
import app.Command;
import app.CommandRegistry;
import app.Workbench;
import input.Key;
import input.KeyCode;
import input.KeyMap;
import test.Asserts;

program Forge;

public bundle forge {
    public namespace test {

        // The headless self-check suite for the editor core. run() exercises every module and returns the
        // number of failed checks (0 == all green), so the entry point can report and exit accordingly.
        public class CoreTests {
            public static method run() returns int {
                Asserts a = new Asserts() on heap;

                // --- TextBuffer edits ---
                TextBuffer buf = new TextBuffer() on heap;
                buf.loadText("ab\ncd");
                buf.insertChar(0, 1, 'X');               // "aXb"
                buf.splitLine(0, 2);                       // "aX" / "b"
                buf.backspace(2, 0);                       // join "cd" onto "b" -> "bcd"
                a.eqInt(buf.lineCount(), 2, "buf.lineCount");
                a.eqStr(buf.line(0), "aX", "buf.line0");
                a.eqStr(buf.line(1), "bcd", "buf.line1");

                // --- Editor: type, Enter, backspace within a line, backspace-join, cursor motion ---
                Editor ed = new Editor(new TextBuffer() on heap) on heap;
                ed.type('h'); ed.type('i'); ed.enter(); ed.type('y'); ed.type('o');   // "hi" / "yo"
                a.eqInt(ed.document().lineCount(), 2, "ed.lineCount");
                a.eqStr(ed.document().line(0), "hi", "ed.line0");
                a.eqStr(ed.document().line(1), "yo", "ed.line1");
                a.eqInt(ed.cursorRow(), 1, "ed.row");
                a.eqInt(ed.cursorCol(), 2, "ed.col");
                ed.backspace(); ed.backspace();
                a.eqStr(ed.document().line(1), "", "ed.after-bs-line1");
                a.eqInt(ed.cursorCol(), 0, "ed.col-after-bs");
                ed.backspace();                            // line-start backspace joins -> "hi"
                a.eqInt(ed.document().lineCount(), 1, "ed.after-join-count");
                a.eqStr(ed.document().line(0), "hi", "ed.after-join");
                a.eqInt(ed.cursorRow(), 0, "ed.row-after-join");
                a.eqInt(ed.cursorCol(), 2, "ed.col-after-join");
                ed.moveLeft();  a.eqInt(ed.cursorCol(), 1, "moveLeft");
                ed.moveRight(); ed.moveRight();  a.eqInt(ed.cursorCol(), 2, "moveRight-clamp");

                // --- syntax highlighting ---
                Highlighter hl = new Highlighter() on heap;
                ArrayList<Span> sp = hl.tokenize("public int x = 42; // hi");
                a.eqInt(sp.size(), 12, "hl.spanCount");
                a.eqInt(cast<int>(sp.get(0).kind), cast<int>(Tok.KEYWORD), "hl.public-kw");
                a.eqInt(cast<int>(sp.get(2).kind), cast<int>(Tok.KEYWORD), "hl.int-kw");
                a.eqInt(cast<int>(sp.get(4).kind), cast<int>(Tok.IDENT), "hl.x-ident");
                a.eqInt(cast<int>(sp.get(8).kind), cast<int>(Tok.NUMBER), "hl.42-number");
                a.eqInt(cast<int>(sp.get(11).kind), cast<int>(Tok.COMMENT), "hl.comment");
                ArrayList<Span> sp2 = hl.tokenize("s = \"hi\";");
                a.eqInt(cast<int>(sp2.get(4).kind), cast<int>(Tok.STRING), "hl.string");

                // --- undo / redo ---
                Editor ed2 = new Editor(new TextBuffer() on heap) on heap;
                ed2.type('h'); ed2.type('i');
                a.eqStr(ed2.document().line(0), "hi", "ur.typed");
                ed2.undo();  a.eqStr(ed2.document().line(0), "h", "ur.undo1");
                ed2.undo();  a.eqStr(ed2.document().line(0), "", "ur.undo2");
                ed2.redo();  a.eqStr(ed2.document().line(0), "h", "ur.redo1");
                ed2.redo();  a.eqStr(ed2.document().line(0), "hi", "ur.redo2");
                a.eqBool(ed2.redo(), false, "ur.redo-empty");
                ed2.undo();
                ed2.type('o');
                a.eqStr(ed2.document().line(0), "ho", "ur.new-edit");
                a.eqBool(ed2.redo(), false, "ur.redo-cleared");

                // --- file I/O (Document) ---
                Document doc = new Document(new TextBuffer() on heap) on heap;
                doc.buffer().loadText("line1\nline2\nline3");
                doc.saveAs("forge_doc_test.tmp");
                a.eqBool(doc.isModified(), false, "doc.saved-clean");
                Document doc2 = new Document(new TextBuffer() on heap) on heap;
                doc2.openFile("forge_doc_test.tmp");
                a.eqStr(doc2.buffer().line(0), "line1", "doc.reload-l0");
                a.eqStr(doc2.buffer().line(1), "line2", "doc.reload-l1");
                a.eqStr(doc2.buffer().line(2), "line3", "doc.reload-l2");
                a.eqStr(doc2.path(), "forge_doc_test.tmp", "doc.path");

                // --- selection: extend, read, replace, multi-line delete ---
                Editor es = new Editor(new TextBuffer() on heap) on heap;
                es.document().loadText("hello world");
                es.selectRight(); es.selectRight(); es.selectRight(); es.selectRight(); es.selectRight();
                a.eqBool(es.hasSelection(), true, "sel.has");
                a.eqStr(es.selectionText(), "hello", "sel.text");
                es.type('H'); es.type('i');                    // replace the selection with "Hi"
                a.eqStr(es.document().line(0), "Hi world", "sel.replace");
                a.eqBool(es.hasSelection(), false, "sel.cleared");

                Editor es2 = new Editor(new TextBuffer() on heap) on heap;
                es2.document().loadText("aaa\nbbb\nccc");
                es2.moveRight();                                // caret (0,1)
                es2.selectDown();                               // anchor (0,1), caret (1,1)
                es2.selectRight();                              // caret (1,2)
                a.eqStr(es2.selectionText(), "aa\nbb", "sel.multiline-text");
                es2.deleteSelection();
                a.eqStr(es2.document().line(0), "ab", "sel.multiline-deleted");
                a.eqInt(es2.document().lineCount(), 2, "sel.multiline-count");
                a.eqInt(es2.cursorRow(), 0, "sel.caret-row");
                a.eqInt(es2.cursorCol(), 1, "sel.caret-col");

                // --- clipboard: copy/paste, cut, multi-line paste ---
                Editor ec = new Editor(new TextBuffer() on heap) on heap;
                ec.document().loadText("abc");
                ec.selectRight(); ec.selectRight(); ec.selectRight();   // select "abc"
                ec.copy();
                a.eqStr(ec.clipboardText(), "abc", "clip.copy");
                ec.moveRight();                                 // clear selection, caret at end (0,3)
                ec.paste();                                     // -> "abcabc"
                a.eqStr(ec.document().line(0), "abcabc", "clip.paste");
                a.eqInt(ec.cursorCol(), 6, "clip.paste-caret");

                Editor ec2 = new Editor(new TextBuffer() on heap) on heap;
                ec2.document().loadText("xy");
                ec2.selectRight();                              // select "x"
                ec2.cut();
                a.eqStr(ec2.clipboardText(), "x", "clip.cut-content");
                a.eqStr(ec2.document().line(0), "y", "clip.cut-removed");
                a.eqInt(ec2.cursorCol(), 0, "clip.cut-caret");

                Editor ec3 = new Editor(new TextBuffer() on heap) on heap;
                ec3.document().loadText("ab\ncd");
                ec3.selectRight(); ec3.selectRight(); ec3.selectDown();   // select "ab\ncd"
                ec3.copy();
                a.eqStr(ec3.clipboardText(), "ab\ncd", "clip.ml-copy");
                ec3.moveRight();                                // clear selection, caret at (1,2)
                ec3.paste();                                    // insert "ab\ncd" -> 3 lines
                a.eqInt(ec3.document().lineCount(), 3, "clip.ml-count");
                a.eqStr(ec3.document().line(1), "cdab", "clip.ml-l1");
                a.eqStr(ec3.document().line(2), "cd", "clip.ml-l2");
                a.eqInt(ec3.cursorRow(), 2, "clip.ml-caret-row");

                // --- line operations: duplicate / delete / move / indent ---
                Editor el = new Editor(new TextBuffer() on heap) on heap;
                el.document().loadText("one\ntwo\nthree");
                el.duplicateLine();                             // ["one","one","two","three"], caret row 1
                a.eqInt(el.document().lineCount(), 4, "line.dup-count");
                a.eqStr(el.document().line(1), "one", "line.dup-content");
                a.eqInt(el.cursorRow(), 1, "line.dup-caret");
                el.deleteLine();                                // remove the dup -> caret on "two"
                a.eqInt(el.document().lineCount(), 3, "line.del-count");
                a.eqStr(el.document().line(1), "two", "line.del-content");
                el.moveLineDown();                              // ["one","three","two"], caret row 2
                a.eqStr(el.document().line(1), "three", "line.movedown-1");
                a.eqStr(el.document().line(2), "two", "line.movedown-2");
                a.eqInt(el.cursorRow(), 2, "line.movedown-caret");
                el.moveLineUp();                                // back to ["one","two","three"]
                a.eqStr(el.document().line(1), "two", "line.moveup");
                el.indent();
                a.eqStr(el.document().line(1), "    two", "line.indent");
                el.dedent();
                a.eqStr(el.document().line(1), "two", "line.dedent");

                // --- find / replace (plain text) ---
                Editor ef = new Editor(new TextBuffer() on heap) on heap;
                ef.document().loadText("foo bar foo\nbaz foo\nqux");
                a.eqInt(ef.matchCount("foo"), 3, "find.count");
                a.eqInt(ef.matchCount("nope"), 0, "find.count-none");
                a.eqBool(ef.find("foo"), true, "find.first");     // (0,0) -> caret (0,3), selected
                a.eqInt(ef.cursorRow(), 0, "find.first-row");
                a.eqInt(ef.cursorCol(), 3, "find.first-col");
                a.eqStr(ef.selectionText(), "foo", "find.first-sel");
                ef.find("foo");                                    // (0,8) -> caret (0,11)
                a.eqInt(ef.cursorCol(), 11, "find.second-col");
                ef.find("foo");                                    // (1,4) -> caret (1,7)
                a.eqInt(ef.cursorRow(), 1, "find.third-row");
                a.eqInt(ef.cursorCol(), 7, "find.third-col");
                ef.find("foo");                                    // wraps to (0,0)
                a.eqInt(ef.cursorRow(), 0, "find.wrap-row");
                a.eqInt(ef.cursorCol(), 3, "find.wrap-col");
                a.eqBool(ef.find("zzz"), false, "find.miss");

                Editor er = new Editor(new TextBuffer() on heap) on heap;
                er.document().loadText("a foo b foo\nfoo end");
                a.eqInt(er.replaceAll("foo", "X"), 3, "replace.count");
                a.eqStr(er.document().line(0), "a X b X", "replace.l0");
                a.eqStr(er.document().line(1), "X end", "replace.l1");
                er.undo();
                a.eqStr(er.document().line(0), "a foo b foo", "replace.undo");

                Editor eci = new Editor(new TextBuffer() on heap) on heap;
                eci.document().loadText("Foo FOO foo");
                a.eqInt(eci.matchCount("foo"), 1, "find.case-sensitive");
                eci.setSearchCase(false);
                a.eqInt(eci.matchCount("foo"), 3, "find.case-insensitive");
                a.eqInt(eci.replaceAll("foo", "x"), 3, "replace.ci-count");
                a.eqStr(eci.document().line(0), "x x x", "replace.ci-result");

                // --- word-wise motion / deletion / selection ---
                Editor ew = new Editor(new TextBuffer() on heap) on heap;
                ew.document().loadText("foo bar baz");
                ew.moveWordRight(); a.eqInt(ew.cursorCol(), 3, "word.right1");
                ew.moveWordRight(); a.eqInt(ew.cursorCol(), 7, "word.right2");
                ew.moveWordRight(); a.eqInt(ew.cursorCol(), 11, "word.right3");
                ew.moveWordLeft();  a.eqInt(ew.cursorCol(), 8, "word.left1");
                ew.moveWordLeft();  a.eqInt(ew.cursorCol(), 4, "word.left2");
                ew.moveWordLeft();  a.eqInt(ew.cursorCol(), 0, "word.left3");

                Editor ew2 = new Editor(new TextBuffer() on heap) on heap;
                ew2.document().loadText("hello world");
                ew2.moveRight(); ew2.moveRight();               // caret inside "hello"
                ew2.selectWordAtCaret();
                a.eqStr(ew2.selectionText(), "hello", "word.select");

                Editor ew3 = new Editor(new TextBuffer() on heap) on heap;
                ew3.document().loadText("alpha beta");
                ew3.moveWordRight(); ew3.moveWordRight();       // caret at end of "beta"
                ew3.deleteWordLeft();
                a.eqStr(ew3.document().line(0), "alpha ", "word.del-left");
                a.eqInt(ew3.cursorCol(), 6, "word.del-left-caret");

                Editor ew4 = new Editor(new TextBuffer() on heap) on heap;
                ew4.document().loadText("alpha beta");
                ew4.deleteWordRight();                          // caret at 0 -> removes "alpha"
                a.eqStr(ew4.document().line(0), " beta", "word.del-right");

                // --- viewport scrolling model ---
                Viewport vp = new Viewport(10, 20) on heap;     // 10 rows x 20 cols
                vp.setTotalLines(100);
                a.eqInt(vp.firstLine(), 0, "vp.init-top");
                a.eqBool(vp.scrollToCaret(5, 0, 0), false, "vp.no-scroll");
                a.eqBool(vp.scrollToCaret(30, 0, 0), true, "vp.scrolled");
                a.eqInt(vp.firstLine(), 21, "vp.top-after-down");
                a.eqBool(vp.isLineVisible(30), true, "vp.30-visible");
                a.eqBool(vp.isLineVisible(20), false, "vp.20-hidden");
                vp.scrollToCaret(0, 0, 0);
                a.eqInt(vp.firstLine(), 0, "vp.top-back");
                vp.scrollToCaret(0, 50, 0);                     // horizontal scroll
                a.eqInt(vp.firstColumn(), 31, "vp.left-after");

                Viewport vp2 = new Viewport(10, 20) on heap;
                vp2.setTotalLines(100);
                vp2.scrollToCaret(8, 0, 2);                     // scrolloff margin at bottom
                a.eqInt(vp2.firstLine(), 1, "vp.margin-bottom");
                vp2.pageDown();
                a.eqInt(vp2.firstLine(), 10, "vp.pagedown");

                Viewport vp3 = new Viewport(10, 20) on heap;
                vp3.setTotalLines(5);                           // fewer lines than the viewport
                vp3.scrollToCaret(4, 0, 0);
                a.eqInt(vp3.firstLine(), 0, "vp.clamp-small");

                // --- navigation: smart home/end, doc start/end, delete-forward, select-all ---
                Editor en = new Editor(new TextBuffer() on heap) on heap;
                en.document().loadText("    hello\nworld");
                en.moveLineEnd();   a.eqInt(en.cursorCol(), 9, "nav.end");
                en.moveLineStart(); a.eqInt(en.cursorCol(), 4, "nav.home-nonblank");
                en.moveLineStart(); a.eqInt(en.cursorCol(), 0, "nav.home-zero");
                en.moveDocEnd();
                a.eqInt(en.cursorRow(), 1, "nav.docend-row");
                a.eqInt(en.cursorCol(), 5, "nav.docend-col");
                en.moveDocStart();
                a.eqInt(en.cursorRow(), 0, "nav.docstart-row");
                a.eqInt(en.cursorCol(), 0, "nav.docstart-col");
                en.deleteForward();
                a.eqStr(en.document().line(0), "   hello", "nav.del-fwd");

                Editor en2 = new Editor(new TextBuffer() on heap) on heap;
                en2.document().loadText("ab\ncd");
                en2.moveLineEnd();
                en2.deleteForward();                            // join next line
                a.eqStr(en2.document().line(0), "abcd", "nav.del-fwd-join");
                a.eqInt(en2.document().lineCount(), 1, "nav.del-fwd-join-count");

                Editor en3 = new Editor(new TextBuffer() on heap) on heap;
                en3.document().loadText("xy\nz");
                en3.selectAll();
                a.eqStr(en3.selectionText(), "xy\nz", "nav.select-all");

                // --- Controller: editor + viewport + document + highlighter, driven by commands ---
                Controller ctrl = new Controller(5, 10) on heap;   // 5 rows x 10 cols
                ctrl.insertText("line0\nline1\nline2\nline3\nline4\nline5\nline6");
                a.eqInt(ctrl.editor().cursorRow(), 6, "ctrl.caret-row");
                a.eqBool(ctrl.viewport().isLineVisible(6), true, "ctrl.caret-visible");
                a.eqBool(ctrl.document().isModified(), true, "ctrl.modified");
                a.eqBool(ctrl.caretScreenRow() >= 0 && ctrl.caretScreenRow() < 5, true, "ctrl.caret-in-view");
                ctrl.moveDocStart(false);
                a.eqInt(ctrl.firstLine(), 0, "ctrl.docstart-scroll");
                a.eqStr(ctrl.renderLine(0), "line0", "ctrl.render0");
                a.eqInt(ctrl.caretScreenRow(), 0, "ctrl.caret-top");
                a.eqInt(ctrl.lineNumberAt(2), 2, "ctrl.line-number");
                ctrl.moveRight(true); ctrl.moveRight(true);
                a.eqStr(ctrl.editor().selectionText(), "li", "ctrl.shift-select");
                ArrayList<Span> rs = ctrl.renderSpans(0);
                a.eqBool(rs.size() >= 1, true, "ctrl.spans");
                ctrl.moveDocEnd(false);
                a.eqBool(ctrl.firstLine() > 0, true, "ctrl.docend-scrolled");
                a.eqBool(ctrl.viewport().isLineVisible(6), true, "ctrl.docend-caret-visible");

                // --- input: KeyMap dispatch (typing, editing, navigation, shortcuts) ---
                Controller kc = new Controller(10, 40) on heap;
                KeyMap km = new KeyMap() on heap;
                km.dispatch(kc, Key.ch('h'));
                km.dispatch(kc, Key.ch('i'));
                a.eqStr(kc.editor().document().line(0), "hi", "key.type");
                km.dispatch(kc, Key.key(KeyCode.ENTER));
                km.dispatch(kc, Key.ch('y'));
                a.eqInt(kc.editor().document().lineCount(), 2, "key.enter-count");
                a.eqStr(kc.editor().document().line(1), "y", "key.enter-line");
                km.dispatch(kc, Key.key(KeyCode.LEFT));
                a.eqInt(kc.editor().cursorCol(), 0, "key.left");
                km.dispatch(kc, Key.key(KeyCode.END));
                a.eqInt(kc.editor().cursorCol(), 1, "key.end");
                km.dispatch(kc, Key.key(KeyCode.BACKSPACE));
                a.eqStr(kc.editor().document().line(1), "", "key.backspace");
                a.eqBool(km.dispatch(kc, Key.ctrlCh('Z')), true, "key.ctrl-handled");  // undo (case-fold)

                // shift+arrow builds a selection; a following typed char replaces it
                Controller kc2 = new Controller(10, 40) on heap;
                km.dispatch(kc2, Key.ch('a'));
                km.dispatch(kc2, Key.ch('b'));
                km.dispatch(kc2, Key.ch('c'));
                km.dispatch(kc2, Key.key(KeyCode.HOME));
                km.dispatch(kc2, Key.shiftKey(KeyCode.END));
                a.eqStr(kc2.editor().selectionText(), "abc", "key.shift-select");
                km.dispatch(kc2, Key.ch('Q'));
                a.eqStr(kc2.editor().document().line(0), "Q", "key.replace-selection");

                // Ctrl+word navigation and Alt+Up line move
                Controller kc3 = new Controller(10, 40) on heap;
                km.dispatch(kc3, Key.key(KeyCode.TAB));               // indent -> 4 spaces
                a.eqStr(kc3.editor().document().line(0), "    ", "key.tab-indent");
                a.eqBool(km.dispatch(kc3, Key.ctrlKey(KeyCode.HOME)), true, "key.ctrl-home");
                a.eqInt(kc3.editor().cursorCol(), 0, "key.ctrl-home-col");
                a.eqBool(km.dispatch(kc3, Key.ch('~')), true, "key.printable");

                // --- rendering: gutter, clipping, status bar, ANSI ---
                Controller rc = new Controller(4, 20) on heap;   // 4 rows x 20 cols
                rc.insertText("alpha\nbeta\ngamma");
                rc.moveDocStart(false);
                TextRenderer tr = new TextRenderer() on heap;
                ArrayList<String> frame = tr.renderPlain(rc);
                a.eqInt(frame.size(), 3, "render.rows");
                a.eqStr(frame.get(0), "  1 | alpha", "render.row0");
                a.eqStr(frame.get(1), "  2 | beta", "render.row1");
                a.eqStr(frame.get(2), "  3 | gamma", "render.row2");
                String status = tr.statusBar(rc);
                a.eqBool(status.contains("Ln 1, Col 1"), true, "render.status-caret");
                a.eqBool(status.contains("3 lines"), true, "render.status-lines");
                a.eqBool(status.contains("*"), true, "render.status-dirty");
                a.eqBool(tr.renderAnsi(rc).get(0).contains("alpha"), true, "render.ansi-text");

                Controller rc2 = new Controller(2, 5) on heap;   // width 5 -> horizontal clip
                rc2.insertText("abcdefghij");
                rc2.moveDocStart(false);
                a.eqStr(tr.renderPlain(rc2).get(0), "  1 | abcde", "render.clip-left");
                rc2.moveDocEnd(false);                            // scroll right to follow the caret
                a.eqBool(tr.renderPlain(rc2).get(0).contains("ghij"), true, "render.clip-scrolled");

                // --- auto-indent on Enter ---
                Editor ai = new Editor(new TextBuffer() on heap) on heap;
                ai.type(' '); ai.type(' '); ai.type(' '); ai.type(' ');
                ai.type('x'); ai.type(' '); ai.type('{');          // line "    x {"
                ai.enter();
                a.eqStr(ai.document().line(1), "        ", "autoindent.brace");   // 4 inherited + 4 for '{'
                a.eqInt(ai.cursorCol(), 8, "autoindent.brace-caret");

                Editor ai2 = new Editor(new TextBuffer() on heap) on heap;
                ai2.type(' '); ai2.type(' '); ai2.type('a'); ai2.type('b');       // "  ab"
                ai2.enter();
                a.eqStr(ai2.document().line(1), "  ", "autoindent.inherit");
                a.eqInt(ai2.cursorCol(), 2, "autoindent.inherit-caret");

                // --- block indent / dedent over a multi-line selection ---
                Editor bi = new Editor(new TextBuffer() on heap) on heap;
                bi.document().loadText("a\nb\nc");
                bi.selectDown(); bi.selectDown();                  // select lines 0..2
                bi.indentSelection();
                a.eqStr(bi.document().line(0), "    a", "blockindent.0");
                a.eqStr(bi.document().line(1), "    b", "blockindent.1");
                a.eqStr(bi.document().line(2), "    c", "blockindent.2");
                bi.dedentSelection();
                a.eqStr(bi.document().line(0), "a", "blockdedent.0");
                a.eqStr(bi.document().line(2), "c", "blockdedent.2");

                // Tab with a selection block-indents through the Controller
                Controller tc = new Controller(10, 40) on heap;
                tc.insertText("x\ny");
                tc.moveDocStart(false);
                tc.moveDown(true);                                 // extend selection to line 1
                tc.indent();
                a.eqStr(tc.editor().document().line(0), "    x", "ctrl.block-indent-0");
                a.eqStr(tc.editor().document().line(1), "    y", "ctrl.block-indent-1");

                // --- document manager: tabs, switching, close, titles ---
                DocumentManager dm = new DocumentManager(20, 80) on heap;
                a.eqInt(dm.count(), 0, "dm.empty");
                a.eqBool(dm.hasActive(), false, "dm.no-active");
                Controller* d1 = dm.openNew();
                d1.insertText("hello");
                a.eqInt(dm.count(), 1, "dm.opened1");
                a.eqInt(dm.activeIndex(), 0, "dm.active0");
                dm.openNew();                                      // second tab, now active
                a.eqInt(dm.count(), 2, "dm.opened2");
                a.eqInt(dm.activeIndex(), 1, "dm.active1");
                a.eqStr(dm.active().editor().document().line(0), "", "dm.active-empty");
                dm.setActive(0);
                a.eqStr(dm.active().editor().document().line(0), "hello", "dm.switch-back");
                a.eqStr(dm.title(0), "untitled *", "dm.title-modified");
                a.eqStr(dm.title(1), "untitled", "dm.title-clean");
                dm.close(0);
                a.eqInt(dm.count(), 1, "dm.closed");
                a.eqStr(dm.active().editor().document().line(0), "", "dm.after-close");

                // --- file tree over a real temp directory (dirs first, lazy expand) ---
                File.mkdir("ft_tree.tmp");
                File.mkdir("ft_tree.tmp/sub");
                File.writeAll("ft_tree.tmp/a.txt", "1");
                File.writeAll("ft_tree.tmp/b.txt", "2");
                File.writeAll("ft_tree.tmp/sub/c.txt", "3");
                FileTree* tree = new FileTree("ft_tree.tmp") on heap;
                FileNode* troot = tree.root();
                a.eqInt(troot.children.size(), 3, "tree.child-count");
                a.eqStr(troot.children.get(0).name, "sub", "tree.dir-first");
                a.eqBool(troot.children.get(0).isDir, true, "tree.dir-flag");
                a.eqStr(troot.children.get(1).name, "a.txt", "tree.file1");
                a.eqStr(troot.children.get(2).name, "b.txt", "tree.file2");
                a.eqBool(troot.children.get(0).expanded, false, "tree.collapsed");
                a.eqInt(tree.visible().size(), 4, "tree.visible-collapsed");   // root + 3
                tree.toggle(troot.children.get(0));                            // expand "sub"
                a.eqBool(troot.children.get(0).expanded, true, "tree.expanded");
                a.eqInt(troot.children.get(0).children.size(), 1, "tree.sub-loaded");
                a.eqStr(troot.children.get(0).children.get(0).name, "c.txt", "tree.sub-child");
                a.eqInt(tree.visible().size(), 5, "tree.visible-expanded");    // root, sub, c.txt, a, b
                a.eqStr(tree.rowLabel(troot.children.get(0)), "  v sub", "tree.row-label");
                File.remove("ft_tree.tmp/sub/c.txt");
                File.remove("ft_tree.tmp/a.txt");
                File.remove("ft_tree.tmp/b.txt");

                // --- auto-close pairs + bracket matching ---
                Editor bp = new Editor(new TextBuffer() on heap) on heap;
                bp.typeWithPairs('(');
                a.eqStr(bp.document().line(0), "()", "pair.insert");
                a.eqInt(bp.cursorCol(), 1, "pair.caret-inside");
                bp.typeWithPairs(')');                          // step over the auto-inserted ')'
                a.eqStr(bp.document().line(0), "()", "pair.typeover");
                a.eqInt(bp.cursorCol(), 2, "pair.typeover-caret");

                Editor bp2 = new Editor(new TextBuffer() on heap) on heap;
                bp2.document().loadText("foo(bar(x))");
                bp2.moveRight(); bp2.moveRight(); bp2.moveRight();   // caret on the first '('
                Match* mm = bp2.matchingBracket();
                a.eqBool(mm.valid(), true, "match.open-valid");
                a.eqInt(mm.col, 10, "match.open-close");

                Editor bp3 = new Editor(new TextBuffer() on heap) on heap;
                bp3.document().loadText("(a(b)c)");
                bp3.moveDocEnd();                               // caret just past the closing ')'
                Match* mm3 = bp3.matchingBracket();
                a.eqBool(mm3.valid(), true, "match.close-valid");
                a.eqInt(mm3.col, 0, "match.close-open");

                // --- command palette: registry + fuzzy filter ---
                CommandRegistry cr = new CommandRegistry() on heap;
                a.eqInt(cr.all().size(), 14, "cmd.count");
                a.eqInt(cr.filter("").size(), 14, "cmd.filter-empty");
                a.eqInt(cr.filter("zzq").size(), 0, "cmd.filter-none");
                a.eqInt(cr.filter("undo").size(), 1, "cmd.filter-undo-count");
                a.eqStr(cr.filter("undo").get(0).id, "edit.undo", "cmd.filter-undo");
                a.eqInt(cr.filter("file").size(), 4, "cmd.filter-file");      // New/Open/Save/Save As File
                a.eqStr(cr.filter("save file").get(0).id, "file.save", "cmd.filter-rank");
                a.eqStr(cr.filter("dupl").get(0).id, "edit.duplicateLine", "cmd.fuzzy-subseq");
                a.eqStr(cr.filter("spe").get(0).id, "view.split", "cmd.fuzzy-gap");

                // --- workbench: application root (keys + palette commands over tabs) ---
                Workbench wb = new Workbench(24, 80) on heap;
                a.eqInt(wb.documents().count(), 1, "wb.starts-with-one");
                a.eqBool(wb.documents().hasActive(), true, "wb.has-active");
                wb.handleKey(Key.ch('h'));
                wb.handleKey(Key.ch('i'));
                a.eqStr(wb.active().editor().document().line(0), "hi", "wb.type");
                wb.runCommand("edit.duplicateLine");
                a.eqInt(wb.active().editor().document().lineCount(), 2, "wb.dupline-count");
                a.eqStr(wb.active().editor().document().line(1), "hi", "wb.dupline-content");
                wb.runCommand("file.new");
                a.eqInt(wb.documents().count(), 2, "wb.new-tab");
                wb.handleKey(Key.ch('x'));
                a.eqStr(wb.active().editor().document().line(0), "x", "wb.type-new-tab");
                wb.runCommand("edit.undo");
                a.eqStr(wb.active().editor().document().line(0), "", "wb.undo-cmd");
                a.eqBool(wb.runCommand("edit.selectAll"), true, "wb.selectall-cmd");
                a.eqBool(wb.runCommand("bogus.cmd"), false, "wb.unknown-cmd");

                // --- full IDE screen composition (tab bar + tree + editor + status) ---
                Workbench wbs = new Workbench(4, 24) on heap;
                wbs.active().insertText("hi\nyo");
                wbs.active().moveDocStart(false);
                ScreenRenderer sr = new ScreenRenderer() on heap;
                ArrayList<String> screen = sr.render(wbs, tree);  // reuse the temp-dir tree above
                a.eqBool(screen.get(0).contains("untitled"), true, "screen.tabbar");
                a.eqBool(screen.size() >= 3, true, "screen.row-count");
                a.eqBool(screen.get(1).contains("hi"), true, "screen.editor-text");
                a.eqBool(screen.get(1).contains("ft_tree.tmp"), true, "screen.tree-col");
                a.eqBool(screen.get(screen.size() - 1).contains("Ln 1"), true, "screen.status");

                // --- line-comment toggle (single line + multi-line selection) ---
                Editor cm = new Editor(new TextBuffer() on heap) on heap;
                cm.document().loadText("    int x = 1;");
                cm.toggleComment();
                a.eqStr(cm.document().line(0), "    // int x = 1;", "comment.add");
                cm.toggleComment();
                a.eqStr(cm.document().line(0), "    int x = 1;", "comment.remove");

                Editor cm2 = new Editor(new TextBuffer() on heap) on heap;
                cm2.document().loadText("a\nb\nc");
                cm2.selectDown(); cm2.selectDown();            // select all three lines
                cm2.toggleComment();
                a.eqStr(cm2.document().line(0), "// a", "comment.multi-0");
                a.eqStr(cm2.document().line(2), "// c", "comment.multi-2");
                cm2.toggleComment();
                a.eqStr(cm2.document().line(0), "a", "comment.multi-uncomment");

                // --- configurable tab width ---
                Editor tw = new Editor(new TextBuffer() on heap) on heap;
                tw.document().loadText("x");
                tw.setTabWidth(2);
                a.eqInt(tw.tabSize(), 2, "tab.size");
                tw.indent();
                a.eqStr(tw.document().line(0), "  x", "tab.indent-2");
                tw.dedent();
                a.eqStr(tw.document().line(0), "x", "tab.dedent-2");

                a.summary("editor tests");
                return a.failCount();
            }
        }
    }
}
