program Forge;

public bundle forge {
    public namespace view {

        // A scrolling window onto a document, measured in text cells (not pixels): the first visible line
        // and column, plus the viewport size in rows/columns. The render layer draws rows [firstLine,
        // lastLine) and columns [firstColumn, firstColumn+width), and converts cells to pixels itself. This
        // is pure model logic so it can be unit-tested headless; a controller drives it after each edit.
        public class Viewport {
            private mutable int top;         // first visible line
            private mutable int left;        // first visible column
            private mutable int rows;        // visible line count
            private mutable int cols;        // visible column count
            private mutable int totalLines;  // lines in the document (for clamping)

            public constructor Viewport(int rows, int cols) {
                this.top = 0;
                this.left = 0;
                this.rows = rows;
                this.cols = cols;
                this.totalLines = 1;
            }

            public method firstLine() returns int { return this.top; }
            public method firstColumn() returns int { return this.left; }
            public method height() returns int { return this.rows; }
            public method width() returns int { return this.cols; }

            public method resize(int rows, int cols) returns void {
                this.rows = rows;
                this.cols = cols;
                this.clampTop();
            }
            public method setTotalLines(int n) returns void {
                this.totalLines = n;
                this.clampTop();
            }

            // One past the last visible line, clamped to the document's end.
            public method lastLine() returns int {
                int last = this.top + this.rows;
                if (last > this.totalLines) { return this.totalLines; }
                return last;
            }
            public method isLineVisible(int row) returns boolean {
                return row >= this.top && row < this.top + this.rows;
            }

            // Scroll the minimum needed so (row, col) sits inside the viewport. `margin` keeps that many
            // rows of context above/below the caret when possible (a "scrolloff"). Returns true if the view
            // actually moved.
            public method scrollToCaret(int row, int col, int margin) returns boolean {
                int startTop = this.top;
                int startLeft = this.left;
                if (row < this.top + margin) {
                    this.top = row - margin;
                } else if (row >= this.top + this.rows - margin) {
                    this.top = row - this.rows + 1 + margin;
                }
                this.clampTop();
                if (col < this.left) {
                    this.left = col;
                } else if (col >= this.left + this.cols) {
                    this.left = col - this.cols + 1;
                }
                if (this.left < 0) { this.left = 0; }
                return this.top != startTop || this.left != startLeft;
            }

            public method scrollUp(int lines) returns void { this.top = this.top - lines; this.clampTop(); }
            public method scrollDown(int lines) returns void { this.top = this.top + lines; this.clampTop(); }
            public method pageUp() returns void { this.scrollUp(this.rows - 1); }
            public method pageDown() returns void { this.scrollDown(this.rows - 1); }

            // Keep `top` in [0, max(0, totalLines - rows)] so the last screen isn't scrolled past the end.
            private method clampTop() returns void {
                int maxTop = this.totalLines - this.rows;
                if (this.top > maxTop) { this.top = maxTop; }
                if (this.top < 0) { this.top = 0; }
            }
        }
    }
}
