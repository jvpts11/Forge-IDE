import test.CoreTests;
import gfx.GuiApp;

program Forge;

// Forge -- the LDP3 IDE. Entry point. With no arguments it opens the graphical editor window; `shot`
// renders one frame to frame.ppm for offscreen verification; `test` runs the headless editor-core
// self-check (the engine's 229 checks). See docs/DESIGN.md.
public bundle forge {
    public namespace app {
        public class Main {
            public static method main(string[] args) returns void {
                if (args.length() > 0) {
                    if (args[0].equals("test")) { CoreTests.run(); return; }
                    if (args[0].equals("shot")) { GuiApp.shot("frame.ppm"); return; }
                    if (args[0].equals("uitest")) { GuiApp.uitest("frame.ppm"); return; }
                }
                GuiApp.run();
                return;
            }
        }
    }
}
