import System.Collections.ArrayList;
import System.Collections.HashSet;
import System.Text.Strings;

program Forge;

public bundle forge {
    public namespace syntax {

        // A small Polaron tokenizer for syntax highlighting: it tiles a line into coloured Spans (whitespace,
        // line comments, string/char literals with escapes, numbers, and words classified into semantic
        // keyword groups vs identifiers, plus punctuation). Keyword groups mirror the Polaron VS Code grammar's
        // token scopes so each renders in its own colour. Line-local for now -- no multi-line state.
        public class Highlighter {
            private mutable HashSet<String>* control;
            private mutable HashSet<String>* modifier;
            private mutable HashSet<String>* decl;
            private mutable HashSet<String>* types;
            private mutable HashSet<String>* opword;
            private mutable HashSet<String>* constant;
            private mutable HashSet<String>* selfkw;

            public constructor Highlighter() {
                this.control = new HashSet<String>() on heap;
                this.modifier = new HashSet<String>() on heap;
                this.decl = new HashSet<String>() on heap;
                this.types = new HashSet<String>() on heap;
                this.opword = new HashSet<String>() on heap;
                this.constant = new HashSet<String>() on heap;
                this.selfkw = new HashSet<String>() on heap;
                this.addAll(this.control, "if else while do for foreach switch match case default break "
                    + "continue return yield try catch finally throw throws goto comefrom abstainfrom "
                    + "reinstate step defer using await async synchronized expecting onFailure");
                this.addAll(this.modifier, "public private protected internal static abstract final override "
                    + "mutable nullable sealed permits var move movable unique partitionable extern cdecl "
                    + "stdcall fastcall freestanding persistent eternal transient comptime literal fixed "
                    + "volatile cascade lazy external release reimport unimport requires ensures invariant "
                    + "demand otherwise extends implements "
                    + "bump pool stack fixedslot ring growable");   // spec 17: region flavor / growth
                this.addAll(this.decl, "program bundle namespace class interface struct record union enum layout "
                    + "catalog byCatalog method operator constructor destructor returns import annotation "
                    + "typealias newtype region label lambda function methodref");
                this.addAll(this.types, "void boolean char string String int8 int16 int32 int64 int uint8 "
                    + "uint16 uint32 uint64 short long byte ubyte ushort uint ulong float32 float64 float "
                    + "double Decimal smallfloat quadruple address vec2 vec3 vec4 checkpoint");
                this.addAll(this.opword, "new delete on in is as cast of accepts rejects stack heap "
                    + "extract mark rollback");   // spec 17: region operations
                this.addAll(this.constant, "true false null");
                this.addAll(this.selfkw, "this super itself");
            }

            // Add every space-separated word of `words` to `set`.
            private method addAll(HashSet<String>* set, String words) returns void {
                ArrayList<String> parts = Strings.split(words, " ");
                for (mutable int i = 0; i < parts.size(); i++) {
                    if (parts.get(i).length() > 0) {
                        set.add(parts.get(i));
                    }
                }
            }

            // The colour group of a word (Tok.IDENT if it isn't a keyword). TYPENAME/FUNC are decided by the
            // tokenizer from context (CamelCase / a following '(').
            private method classify(String word) returns Tok {
                if (this.control.contains(word)) {
                    return Tok.CONTROL;
                }
                if (this.modifier.contains(word)) {
                    return Tok.MODIFIER;
                }
                if (this.decl.contains(word)) {
                    return Tok.DECL;
                }
                if (this.types.contains(word)) {
                    return Tok.TYPE;
                }
                if (this.opword.contains(word)) {
                    return Tok.OPWORD;
                }
                if (this.constant.contains(word)) {
                    return Tok.CONSTANT;
                }
                if (this.selfkw.contains(word)) {
                    return Tok.SELFKW;
                }
                return Tok.IDENT;
            }

            public method isKeyword(String word) returns boolean {
                return this.classify(word) != Tok.IDENT;
            }

            // True when the next non-space character at or after `i` in `line` is `target`.
            private method nextNonSpaceIs(String line, int i, char target) returns boolean {
                mutable int j = i;
                while (j < line.length() && (line.charAt(j) == ' ' || line.charAt(j) == '\t')) {
                    j = j + 1;
                }
                return j < line.length() && line.charAt(j) == target;
            }
            private method isUpper(char c) returns boolean {
                return c >= 'A' && c <= 'Z';
            }

            private method isDigit(char c) returns boolean {
                return c >= '0' && c <= '9';
            }
            private method isAlpha(char c) returns boolean {
                return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_';
            }
            private method isAlnum(char c) returns boolean {
                return this.isAlpha(c) || this.isDigit(c);
            }

            // Break `line` into a complete, gap-free sequence of Spans.
            public method tokenize(String line) returns ArrayList<Span> {
                ArrayList<Span> spans = new ArrayList<Span>() on heap;
                int n = line.length();
                mutable int i = 0;
                while (i < n) {
                    char c = line.charAt(i);
                    int start = i;
                    if (c == ' ' || c == '\t') {
                        while (i < n && (line.charAt(i) == ' ' || line.charAt(i) == '\t')) {
                            i = i + 1;
                        }
                        spans.add(new Span(start, i, Tok.WS) on heap);
                    } else if (c == '/' && i + 1 < n && line.charAt(i + 1) == '/') {
                        spans.add(new Span(start, n, Tok.COMMENT) on heap);
                        i = n;
                    } else if (c == '"') {
                        i = i + 1;
                        while (i < n && line.charAt(i) != '"') {
                            if (line.charAt(i) == '\\' && i + 1 < n) {
                                i = i + 1;
                            }
                            i = i + 1;
                        }
                        if (i < n) {
                            i = i + 1;
                        }
                        spans.add(new Span(start, i, Tok.STRING) on heap);
                    } else if (c == '\'') {
                        i = i + 1;
                        while (i < n && line.charAt(i) != '\'') {
                            if (line.charAt(i) == '\\' && i + 1 < n) {
                                i = i + 1;
                            }
                            i = i + 1;
                        }
                        if (i < n) {
                            i = i + 1;
                        }
                        spans.add(new Span(start, i, Tok.CHAR) on heap);
                    } else if (this.isDigit(c)) {
                        while (i < n && (this.isAlnum(line.charAt(i)) || line.charAt(i) == '.')) {
                            i = i + 1;
                        }
                        spans.add(new Span(start, i, Tok.NUMBER) on heap);
                    } else if (this.isAlpha(c)) {
                        while (i < n && this.isAlnum(line.charAt(i))) {
                            i = i + 1;
                        }
                        String word = line.substring(start, i);
                        mutable Tok kind = this.classify(word);
                        if (kind == Tok.IDENT) {
                            // an identifier: a call site (name followed by '(') or a CamelCase type reference
                            if (this.nextNonSpaceIs(line, i, '(')) {
                                kind = Tok.FUNC;
                            }
                            else if (this.isUpper(word.charAt(0))) {
                                kind = Tok.TYPENAME;
                            }
                        }
                        spans.add(new Span(start, i, kind) on heap);
                    } else {
                        i = i + 1;
                        spans.add(new Span(start, i, Tok.PUNCT) on heap);
                    }
                }
                return spans;
            }

            // Net change in bracket nesting depth contributed by `line` -- brackets inside strings, chars, and
            // line comments do not count (mirrors tokenize's skip rules). Used to seed bracket-pair colouring at
            // the top of the viewport without re-tokenising every preceding line into spans.
            public method bracketDelta(String line) returns int {
                int n = line.length();
                mutable int i = 0;
                mutable int depth = 0;
                while (i < n) {
                    char c = line.charAt(i);
                    if (c == '/' && i + 1 < n && line.charAt(i + 1) == '/') {
                        return depth;
                    }
                    if (c == '"') {
                        i = i + 1;
                        while (i < n && line.charAt(i) != '"') {
                            if (line.charAt(i) == '\\' && i + 1 < n) {
                                i = i + 1;
                            }
                            i = i + 1;
                        }
                        if (i < n) {
                            i = i + 1;
                        }
                    } else if (c == '\'') {
                        i = i + 1;
                        while (i < n && line.charAt(i) != '\'') {
                            if (line.charAt(i) == '\\' && i + 1 < n) {
                                i = i + 1;
                            }
                            i = i + 1;
                        }
                        if (i < n) {
                            i = i + 1;
                        }
                    } else {
                        if (c == '(' || c == '[' || c == '{') {
                            depth = depth + 1;
                        } else if (c == ')' || c == ']' || c == '}') {
                            depth = depth - 1;
                        }
                        i = i + 1;
                    }
                }
                return depth;
            }
        }
    }
}
