program Forge;

public bundle forge {
    public namespace syntax {

        // The token classes a line is broken into for colouring. Keywords are split into semantic groups
        // (control flow, modifiers, declarations, types, word-operators, language constants, self-refs) so
        // each gets its own colour -- the multi-hue scheme a real editor theme gives, mirroring the token
        // scopes of the Polaron VS Code grammar. TYPENAME = a CamelCase type reference; FUNC = a call site.
        public enum Tok {
            WS, IDENT, KEYWORD, NUMBER, STRING, CHAR, COMMENT, PUNCT,
            CONTROL, MODIFIER, DECL, TYPE, OPWORD, CONSTANT, SELFKW, TYPENAME, FUNC
        }
    }
}
