import System.Collections.ArrayList;
import editor.History;
import System.Text.Strings;
import System.Text.StringBuilder;
import syntax.Highlighter;
import syntax.Span;
import syntax.Tok;

program Forge;

public bundle forge {
    public namespace editor {

        // A caret over a TextBuffer: turns key events (type/enter/backspace) and arrow moves into buffer
        // edits, keeping (row, col) valid, with snapshot-based undo/redo. TextBuffer and Snapshot are in the
        // same namespace, so no import is needed for them. This is the model an input layer drives.
        public class Editor {
            private mutable TextBuffer* buf;
            private mutable int row;
            private mutable int col;
            private mutable int selRow;             // selection anchor; the caret (row,col) is the active end
            private mutable int selCol;
            private mutable boolean hasSel;
            private mutable Clipboard* clip;
            private mutable Search* search;
            private mutable Brackets* brackets;
            private mutable int tabWidth;
            // The undo history belongs to the DOCUMENT, not to this view: two panes showing one file share
            // it, or an undo in one would resurrect text the other had already replaced. An Editor built on
            // its own starts with a private history, which is exactly the old behaviour.
            private mutable History* hist;
            private mutable ArrayList<int>* extraRows;   // secondary carets (multi-cursor); primary is row/col
            private mutable ArrayList<int>* extraCols;
            private mutable ArrayList<int>* extraSelRows; // per-caret selection anchor; -1 row means "no selection"
            private mutable ArrayList<int>* extraSelCols;
            private mutable ArrayList<int>* expandHist;    // expand-selection history: flattened [sr,sc,r,c] frames
            private mutable int expSr;                     // the selection expand last produced, to detect a
            private mutable int expSc;                     // manual change (which restarts the expand sequence)
            private mutable int expR;
            private mutable int expC;
            private mutable boolean suppressUndo;         // set while a multi-caret edit groups into one undo

            public constructor Editor(TextBuffer* doc) {
                this.buf = doc;
                this.row = 0;
                this.col = 0;
                this.selRow = 0;
                this.selCol = 0;
                this.hasSel = false;
                this.clip = new Clipboard() on heap;
                this.search = new Search(doc) on heap;
                this.brackets = new Brackets(doc) on heap;
                this.tabWidth = 4;
                this.hist = new History() on heap;
                this.extraRows = new ArrayList<int>() on heap;
                this.extraCols = new ArrayList<int>() on heap;
                this.extraSelRows = new ArrayList<int>() on heap;
                this.extraSelCols = new ArrayList<int>() on heap;
                this.expandHist = new ArrayList<int>() on heap;
                this.expSr = 0 - 1;
                this.expSc = 0 - 1;
                this.expR = 0 - 1;
                this.expC = 0 - 1;
                this.suppressUndo = false;
            }

            // Indentation width (spaces per level), configurable. indentUnit() is one level of spaces.
            public method setTabWidth(int n) returns void {
                if (n > 0) {
                    this.tabWidth = n;
                }
            }
            public method tabSize() returns int {
                return this.tabWidth;
            }
            private method indentUnit() returns String {
                return " ".repeat(this.tabWidth);
            }

            // --- bracket auto-close + matching ---
            private method closerFor(char c) returns char {
                if (c == '(') {
                    return ')';
                }
                if (c == '[') {
                    return ']';
                }
                if (c == '{') {
                    return '}';
                }
                if (c == cast<char>(34)) {
                    return cast<char>(34);
                }
                // "
                if (c == cast<char>(39)) {
                    return cast<char>(39);
                }
                // '
                return cast<char>(0);
            }
            private method isCloserChar(char c) returns boolean {
                return c == ')' || c == ']' || c == '}'
                    || c == cast<char>(34) || c == cast<char>(39);
            }
            private method nextCharIs(char c) returns boolean {
                String line = this.buf.line(this.row);
                return this.col < line.length() && line.charAt(this.col) == c;
            }

            // Type a character with auto-pairing: an opener also inserts its closer (caret stays between);
            // typing a closer that already sits under the caret just steps over it. With a selection, typing a
            // bracket/quote SURROUNDS the selection (keeping it selected); any other char replaces it.
            public method typeWithPairs(char c) returns void {
                if (this.hasSelection()) {
                    if (this.trySurround(c)) {
                        return;
                    }
                    this.type(c);
                    return;
                }
                if (this.isCloserChar(c) && this.nextCharIs(c)) {
                    this.rawRight();
                    return;
                }
                char closer = this.closerFor(c);
                this.type(c);
                if (closer != cast<char>(0)) {
                    this.buf.insertChar(this.row, this.col, closer);   // after caret, no caret move
                }
            }

            // Wrap the current selection in `c` and its partner, keeping the content selected. Returns false
            // (so the caller replaces instead) when `c` is not a surround char, or during a multi-caret edit.
            private method trySurround(char c) returns boolean {
                if (this.suppressUndo) {
                    return false;
                }
                char closer = this.surroundCloser(c);
                if (closer == cast<char>(0)) {
                    return false;
                }
                mutable int sr = this.selRow;
                mutable int sc = this.selCol;
                mutable int er = this.row;
                mutable int ec = this.col;
                if (!this.anchorBeforeCaret()) {
                    sr = this.row;
                    sc = this.col;
                    er = this.selRow;
                    ec = this.selCol;
                }
                this.saveUndo();
                this.buf.insertChar(er, ec, closer);   // closer first so the start offsets stay valid
                this.buf.insertChar(sr, sc, c);
                this.selRow = sr;
                this.selCol = sc + 1;
                this.row = er;
                if (sr == er) {
                    this.col = ec + 1;
                } else {
                    this.col = ec;
                }
                this.hasSel = true;
                return true;
            }
            private method surroundCloser(char c) returns char {
                if (c == '(') {
                    return ')';
                }
                if (c == '[') {
                    return ']';
                }
                if (c == '{') {
                    return '}';
                }
                if (c == cast<char>(34)) {
                    return cast<char>(34);
                }
                if (c == cast<char>(39)) {
                    return cast<char>(39);
                }
                return cast<char>(0);
            }

            // A short summary of the current selection for the status bar ("N selected", or "N chars, M
            // lines" across lines), or "" when there is no selection. Counts a line break as one character.
            public method selectionInfo() returns String {
                if (!this.hasSel) {
                    return "";
                }
                mutable int sr = this.selRow;
                mutable int sc = this.selCol;
                mutable int er = this.row;
                mutable int ec = this.col;
                if (!this.anchorBeforeCaret()) {
                    sr = this.row;
                    sc = this.col;
                    er = this.selRow;
                    ec = this.selCol;
                }
                int lines = er - sr + 1;
                mutable int chars = 0;
                if (sr == er) {
                    chars = ec - sc;
                } else {
                    chars = this.buf.line(sr).length() - sc;
                    mutable int r = sr + 1;
                    while (r < er) {
                        chars = chars + this.buf.line(r).length() + 1;
                        r = r + 1;
                    }
                    chars = chars + 1 + ec;
                }
                if (lines > 1) {
                    return "(" + chars.toString() + " chars, " + lines.toString() + " lines)   ";
                }
                return "(" + chars.toString() + " selected)   ";
            }

            // The matching bracket for a bracket at or just before the caret, or an invalid Match.
            public method matchingBracket() returns Match* {
                Match* m = this.brackets.matchAt(this.row, this.col);
                if (m.valid()) {
                    return m;
                }
                if (this.col > 0) {
                    delete m;   // the char at the caret was not a bracket; discard before trying col-1
                    return this.brackets.matchAt(this.row, this.col - 1);
                }
                return m;
            }

            // --- find / replace (plain text, case-sensitivity via setSearchCase) ---
            public method setSearchCase(boolean caseSensitive) returns void {
                this.search.setCaseSensitive(caseSensitive);
            }
            public method matchCount(String needle) returns int {
                return this.search.count(needle);
            }

            // Move to and select the next/previous occurrence of `needle`. Returns false (leaving the caret
            // put) when there is no match. The match is selected so a following type()/paste() replaces it.
            public method find(String needle) returns boolean {
                Match* m = this.search.findNext(needle, this.row, this.col);
                if (!m.valid()) {
                    return false;
                }
                this.selectMatch(m);
                return true;
            }
            public method findPrevious(String needle) returns boolean {
                Match* m = this.search.findPrev(needle, this.row, this.col);
                if (!m.valid()) {
                    return false;
                }
                this.selectMatch(m);
                return true;
            }
            private method selectMatch(Match* m) returns void {
                this.selRow = m.row;
                this.selCol = m.col;
                this.hasSel = true;
                this.row = m.row;
                this.col = m.col + m.length;
            }

            // Replace every occurrence of `needle` with `replacement`. Returns how many were replaced. One
            // undo step covers the whole sweep. Applied bottom-up so earlier match columns stay valid.
            public method replaceAll(String needle, String replacement) returns int {
                if (needle.length() == 0) {
                    return 0;
                }
                ArrayList<Match>* all = this.search.findAll(needle);
                if (all.size() == 0) {
                    return 0;
                }
                this.saveUndo();
                this.clearSelection();
                for (mutable int i = all.size() - 1; i >= 0; i--) {
                    Match* m = all.get(i);
                    String cur = this.buf.line(m.row);
                    this.buf.setLine(m.row,
                        cur.substring(0, m.col) + replacement + cur.substring(m.col + m.length, cur.length()));
                }
                this.clampCaret();
                return all.size();
            }

            private static method isIdentChar(char c) returns boolean {
                return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
                    || (c >= '0' && c <= '9') || c == '_';
            }

            // True if column `col` on `line` falls inside a string, char or comment token -- positions a
            // symbol rename must leave alone (renaming `x` shouldn't rewrite "x=%d" or a // comment).
            private static method inStringOrComment(Highlighter* hl, String line, int col) returns boolean {
                ArrayList<Span> spans = hl.tokenize(line);
                for (mutable int i = 0; i < spans.size(); i++) {
                    Span sp = spans.get(i);
                    if (col >= sp.start && col < sp.end) {
                        return sp.kind == Tok.STRING || sp.kind == Tok.CHAR || sp.kind == Tok.COMMENT;
                    }
                }
                return false;
            }

            // Rename every WHOLE-WORD occurrence of `oldName` to `newName` (a match preceded/followed by a
            // non-identifier char) that is real code, as one undo step. Substring hits inside longer
            // identifiers are left alone (so renaming `x` never touches `xs` or `max`), and matches inside
            // strings/chars/comments are skipped via the highlighter. Returns the number of occurrences changed.
            public method renameWord(String oldName, String newName, Highlighter* hl) returns int {
                if (oldName.length() == 0) {
                    return 0;
                }
                ArrayList<Match>* all = this.search.findAll(oldName);
                ArrayList<Match>* whole = new ArrayList<Match>() on heap;
                for (mutable int i = 0; i < all.size(); i++) {
                    Match* m = all.get(i);
                    String cur = this.buf.line(m.row);
                    boolean leftOk = m.col == 0 || !Editor.isIdentChar(cur.charAt(m.col - 1));
                    int after = m.col + m.length;
                    boolean rightOk = after >= cur.length() || !Editor.isIdentChar(cur.charAt(after));
                    if (leftOk && rightOk && !Editor.inStringOrComment(hl, cur, m.col)) {
                        whole.add(m);
                    }
                }
                if (whole.size() == 0) {
                    return 0;
                }
                this.saveUndo();
                this.clearSelection();
                for (mutable int i = whole.size() - 1; i >= 0; i--) {
                    Match* m = whole.get(i);
                    String cur = this.buf.line(m.row);
                    this.buf.setLine(m.row,
                        cur.substring(0, m.col) + newName + cur.substring(m.col + m.length, cur.length()));
                }
                this.clampCaret();
                return whole.size();
            }

            // Replace one whole-word occurrence of `oldName` on `row` -- the one covering or nearest to
            // `col` -- with `newName`. One undo step; the caret lands after the replacement. Returns false
            // if the word is not on that line, which happens when the buffer changed since the diagnostic
            // that asked for the fix was produced (the caller then just does nothing). Powers Alt+Enter.
            public method replaceWordOn(int row, int col, String oldName, String newName) returns boolean {
                if (row < 0 || row >= this.buf.lineCount() || oldName.length() == 0) {
                    return false;
                }
                String cur = this.buf.line(row);
                int at = Editor.wholeWordNear(cur, col, oldName);
                if (at < 0) {
                    return false;
                }
                this.saveUndo();
                this.clearSelection();
                this.buf.setLine(row, cur.substring(0, at) + newName
                    + cur.substring(at + oldName.length(), cur.length()));
                this.row = row;
                this.col = at + newName.length();
                this.clampCaret();
                return true;
            }
            // The start index of `word` as a WHOLE word on `line`, choosing the occurrence nearest `col`, or
            // -1. Whole-word so replacing `width` never touches `widthOf`, and nearest-`col` so the fix lands
            // on the identifier the diagnostic pointed at even if the line has the name more than once.
            private static method wholeWordNear(String line, int col, String word) returns int {
                int m = word.length();
                mutable int best = 0 - 1;
                mutable int bestDist = 1000000;
                mutable int i = 0;
                while (i + m <= line.length()) {
                    if (line.substring(i, i + m).equals(word)) {
                        boolean leftOk = i == 0 || !Editor.isIdentChar(line.charAt(i - 1));
                        boolean rightOk = i + m >= line.length() || !Editor.isIdentChar(line.charAt(i + m));
                        if (leftOk && rightOk) {
                            mutable int dist = i - col;
                            if (dist < 0) {
                                dist = 0 - dist;
                            }
                            if (dist < bestDist) {
                                bestDist = dist;
                                best = i;
                            }
                        }
                    }
                    i = i + 1;
                }
                return best;
            }

            // --- clipboard: copy/cut the selection, paste at the caret (replacing any selection) ---
            public method copy() returns void {
                if (this.hasSelection()) {
                    this.clip.set(this.selectionText());
                }
            }
            public method cut() returns void {
                if (!this.hasSelection()) {
                    return;
                }
                this.clip.set(this.selectionText());
                this.saveUndo();
                this.deleteSelection();
            }
            public method paste() returns void {
                String text = this.clip.get();
                if (text.length() == 0) {
                    return;
                }
                this.saveUndo();
                if (this.hasSelection()) {
                    this.deleteSelection();
                }
                int addedRows = this.buf.insertText(this.row, this.col, text);
                if (addedRows == 0) {
                    this.col = this.col + text.length();
                } else {
                    ArrayList<String> parts = Strings.split(text, "\n");
                    this.row = this.row + addedRows;
                    this.col = parts.get(parts.size() - 1).length();
                }
            }
            public method clipboardText() returns String {
                return this.clip.get();
            }

            // --- line operations (duplicate / delete / move up-down / indent-dedent), on the caret's line ---
            public method duplicateLine() returns void {
                this.saveUndo();
                this.buf.insertLine(this.row + 1, this.buf.line(this.row));
                this.row = this.row + 1;
            }
            public method deleteLine() returns void {
                this.saveUndo();
                this.clearSelection();
                this.buf.removeLine(this.row);
                if (this.row >= this.buf.lineCount()) {
                    this.row = this.buf.lineCount() - 1;
                }
                this.clampCol();
            }
            public method moveLineUp() returns void {
                if (this.row == 0) {
                    return;
                }
                this.saveUndo();
                String cur = this.buf.line(this.row);
                this.buf.setLine(this.row, this.buf.line(this.row - 1));
                this.buf.setLine(this.row - 1, cur);
                this.row = this.row - 1;
            }
            public method moveLineDown() returns void {
                if (this.row >= this.buf.lineCount() - 1) {
                    return;
                }
                this.saveUndo();
                String cur = this.buf.line(this.row);
                this.buf.setLine(this.row, this.buf.line(this.row + 1));
                this.buf.setLine(this.row + 1, cur);
                this.row = this.row + 1;
            }
            public method indent() returns void {
                this.saveUndo();
                this.buf.setLine(this.row, this.indentUnit() + this.buf.line(this.row));
                this.col = this.col + this.tabWidth;
            }
            public method dedent() returns void {
                String cur = this.buf.line(this.row);
                mutable int remove = 0;
                while (remove < this.tabWidth && remove < cur.length() && cur.charAt(remove) == ' ') {
                    remove = remove + 1;
                }
                if (remove == 0) {
                    return;
                }
                this.saveUndo();
                this.buf.setLine(this.row, cur.substring(remove, cur.length()));
                if (this.col >= remove) {
                    this.col = this.col - remove;
                } else {
                    this.col = 0;
                }
            }

            // Block indent/dedent: shift every line the selection touches by four spaces. The caret and the
            // anchor stay on their lines; their columns are clamped afterward.
            private method selMinRow() returns int {
                if (this.selRow < this.row) {
                    return this.selRow;
                }
                return this.row;
            }
            private method selMaxRow() returns int {
                if (this.selRow > this.row) {
                    return this.selRow;
                }
                return this.row;
            }
            // Ctrl+J: join the selected lines (or the current line with the next) into one, collapsing each
            // break plus the joined line's leading whitespace to a single space. The caret lands at the join.
            public method joinLines() returns void {
                mutable int a = this.selMinRow();
                mutable int b = this.selMaxRow();
                if (a == b) {
                    if (this.row + 1 >= this.buf.lineCount()) {
                        return;
                    }
                    a = this.row;
                    b = this.row + 1;
                }
                this.saveUndo();
                StringBuilder sb = new StringBuilder() on heap;
                sb.append(this.buf.line(a));
                mutable int r = a + 1;
                while (r <= b) {
                    String piece = this.buf.line(r).trim();
                    if (piece.length() > 0) {
                        sb.append(" ");
                        sb.append(piece);
                    }
                    r = r + 1;
                }
                this.buf.setLine(a, sb.toString());
                mutable int k = b;
                while (k > a) {
                    this.buf.removeLine(a + 1);
                    k = k - 1;
                }
                this.clearSelection();
                this.row = a;
                this.col = this.buf.line(a).length();
            }

            // Move the caret to the bracket matching the one at/just before it (Ctrl+Shift+\). No-op if the
            // caret isn't on a bracket with a partner.
            public method goToMatchingBracket() returns void {
                Match* m = this.matchingBracket();
                if (m.valid()) {
                    this.clearSelection();
                    this.row = m.row;
                    this.col = m.col;
                }
                delete m;   // owned fresh Match from matchingBracket
            }
            // Upper- or lower-case the selected text in place (positions unchanged, so the selection is kept),
            // as one undo step. A no-op without a selection.
            public method transformCase(boolean upper) returns void {
                if (!this.hasSelection()) {
                    return;
                }
                mutable int sr = this.selRow;
                mutable int sc = this.selCol;
                mutable int er = this.row;
                mutable int ec = this.col;
                if (!this.anchorBeforeCaret()) {
                    sr = this.row;
                    sc = this.col;
                    er = this.selRow;
                    ec = this.selCol;
                }
                this.saveUndo();
                mutable int r = sr;
                while (r <= er) {
                    String line = this.buf.line(r);
                    mutable int from = 0;
                    if (r == sr) {
                        from = sc;
                    }
                    mutable int to = line.length();
                    if (r == er) {
                        to = ec;
                    }
                    StringBuilder sb = new StringBuilder() on heap;
                    sb.append(line.substring(0, from));
                    mutable int i = from;
                    while (i < to) {
                        char ch = line.charAt(i);
                        if (upper) {
                            sb.appendChar(Editor.upperCh(ch));
                        } else {
                            sb.appendChar(Editor.lowerCh(ch));
                        }
                        i = i + 1;
                    }
                    sb.append(line.substring(to, line.length()));
                    this.buf.setLine(r, sb.toString());
                    r = r + 1;
                }
            }
            private static method upperCh(char c) returns char {
                if (c >= 'a' && c <= 'z') {
                    return cast<char>(cast<int>(c) - 32);
                }
                return c;
            }
            private static method lowerCh(char c) returns char {
                if (c >= 'A' && c <= 'Z') {
                    return cast<char>(cast<int>(c) + 32);
                }
                return c;
            }

            // Extract the selected single-line expression into a new `var <name> = <expr>;` declaration on the
            // line above (at the same indent), replacing the selection with `<name>`. One undo step; the caret
            // lands on the new usage. Returns false unless there's a non-empty single-line selection.
            public method extractVariable(String name) returns boolean {
                if (!this.hasSelection() || name.length() == 0) {
                    return false;
                }
                if (this.selRow != this.row) {
                    return false;
                }
                mutable int sc = this.selCol;
                mutable int ec = this.col;
                if (ec < sc) {
                    int t = sc;
                    sc = ec;
                    ec = t;
                }
                if (sc >= ec) {
                    return false;
                }
                String line = this.buf.line(this.row);
                String expr = line.substring(sc, ec).trim();
                if (expr.length() == 0) {
                    return false;
                }
                this.saveUndo();
                mutable int ind = 0;
                while (ind < line.length() && (line.charAt(ind) == ' ' || line.charAt(ind) == '\t')) {
                    ind = ind + 1;
                }
                String indent = line.substring(0, ind);
                String newLine = line.substring(0, sc) + name + line.substring(ec, line.length());
                this.buf.setLine(this.row, newLine);
                this.buf.insertLine(this.row, indent + "var " + name + " = " + expr + ";");
                this.clearSelection();
                this.row = this.row + 1;
                this.col = sc + name.length();
                return true;
            }

            // Sort the selected lines in ascending (byte) order, in place, as one undo step. A no-op unless the
            // selection spans at least two lines.
            public method sortSelectedLines() returns void {
                int a = this.selMinRow();
                int b = this.selMaxRow();
                if (a >= b) {
                    return;
                }
                this.saveUndo();
                ArrayList<String>* ls = new ArrayList<String>() on heap;
                mutable int r = a;
                while (r <= b) {
                    ls.add(this.buf.line(r));
                    r = r + 1;
                }
                mutable int i = 1;
                while (i < ls.size()) {
                    String key = ls.get(i);
                    mutable int j = i - 1;
                    while (j >= 0 && Editor.strGreater(ls.get(j), key)) {
                        ls.set(j + 1, ls.get(j));
                        j = j - 1;
                    }
                    ls.set(j + 1, key);
                    i = i + 1;
                }
                r = a;
                while (r <= b) {
                    this.buf.setLine(r, ls.get(r - a));
                    r = r + 1;
                }
                this.clearSelection();
            }
            private static method strGreater(String x, String y) returns boolean {
                int n = x.length();
                int m = y.length();
                mutable int i = 0;
                while (i < n && i < m) {
                    char cx = x.charAt(i);
                    char cy = y.charAt(i);
                    if (cx != cy) {
                        return cast<int>(cx) > cast<int>(cy);
                    }
                    i = i + 1;
                }
                return n > m;
            }

            public method indentSelection() returns void {
                this.saveUndo();
                int a = this.selMinRow();
                int b = this.selMaxRow();
                for (mutable int r = a; r <= b; r++) {
                    this.buf.setLine(r, this.indentUnit() + this.buf.line(r));
                }
                this.selCol = this.selCol + this.tabWidth;
                this.col = this.col + this.tabWidth;
            }
            public method dedentSelection() returns void {
                this.saveUndo();
                int a = this.selMinRow();
                int b = this.selMaxRow();
                for (mutable int r = a; r <= b; r++) {
                    String s = this.buf.line(r);
                    mutable int rm = 0;
                    while (rm < this.tabWidth && rm < s.length() && s.charAt(rm) == ' ') {
                        rm = rm + 1;
                    }
                    this.buf.setLine(r, s.substring(rm, s.length()));
                }
                this.clampCaret();
                int selLen = this.buf.line(this.selRow).length();
                if (this.selCol > selLen) {
                    this.selCol = selLen;
                }
            }

            // --- word-wise motion & deletion (Ctrl+Arrows, Ctrl+Backspace / Ctrl+Delete) ---
            private method isWordChar(char c) returns boolean {
                return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
                    || (c >= '0' && c <= '9') || c == '_';
            }
            // Column of the next word boundary to the right on the current line: skip a run of separators,
            // then a run of word chars, landing just past the coming word (or at end of line).
            private method wordRightCol() returns int {
                String s = this.buf.line(this.row);
                int len = s.length();
                mutable int c = this.col;
                while (c < len && !this.isWordChar(s.charAt(c))) {
                    c = c + 1;
                }
                while (c < len && this.isWordChar(s.charAt(c))) {
                    c = c + 1;
                }
                return c;
            }
            // Mirror image: skip separators then word chars to the left, landing at the word's start.
            private method wordLeftCol() returns int {
                String s = this.buf.line(this.row);
                mutable int c = this.col;
                while (c > 0 && !this.isWordChar(s.charAt(c - 1))) {
                    c = c - 1;
                }
                while (c > 0 && this.isWordChar(s.charAt(c - 1))) {
                    c = c - 1;
                }
                return c;
            }
            private method rawWordRight() returns void {
                if (this.col >= this.buf.line(this.row).length()) {
                    this.rawRight();
                    return;
                }
                this.col = this.wordRightCol();
            }
            private method rawWordLeft() returns void {
                if (this.col == 0) {
                    this.rawLeft();
                    return;
                }
                this.col = this.wordLeftCol();
            }
            public method moveWordRight() returns void {
                this.clearSelection();
                this.clearExtraCarets();
                this.rawWordRight();
            }
            public method moveWordLeft() returns void {
                this.clearSelection();
                this.clearExtraCarets();
                this.rawWordLeft();
            }
            public method selectWordRight() returns void {
                this.anchorSelection();
                this.rawWordRight();
            }
            public method selectWordLeft()  returns void {
                this.anchorSelection();
                this.rawWordLeft();
            }

            public method deleteWordLeft() returns void {
                if (this.hasSelection()) {
                    this.saveUndo();
                    this.deleteSelection();
                    return;
                }
                if (this.col == 0) {
                    this.backspace();
                    return;
                }
                // at line start: join upward
                int target = this.wordLeftCol();
                this.saveUndo();
                this.buf.deleteRange(this.row, target, this.row, this.col);
                this.col = target;
            }
            public method deleteWordRight() returns void {
                if (this.hasSelection()) {
                    this.saveUndo();
                    this.deleteSelection();
                    return;
                }
                int len = this.buf.line(this.row).length();
                if (this.col >= len) {                             // at line end: pull the next line up
                    if (this.row < this.buf.lineCount() - 1) {
                        this.saveUndo();
                        this.buf.setLine(this.row, this.buf.line(this.row) + this.buf.line(this.row + 1));
                        this.buf.removeLine(this.row + 1);
                    }
                    return;
                }
                int target = this.wordRightCol();
                this.saveUndo();
                this.buf.deleteRange(this.row, this.col, this.row, target);
            }

            // Select the word under (or immediately before) the caret -- double-click semantics. No-op when
            // the caret is not on a word.
            public method selectWordAtCaret() returns void {
                String s = this.buf.line(this.row);
                int len = s.length();
                mutable int start = this.col;
                mutable int end = this.col;
                while (start > 0 && this.isWordChar(s.charAt(start - 1))) {
                    start = start - 1;
                }
                while (end < len && this.isWordChar(s.charAt(end))) {
                    end = end + 1;
                }
                if (start == end) {
                    return;
                }
                this.selRow = this.row;
                this.selCol = start;
                this.hasSel = true;
                this.col = end;
            }

            // --- line-comment toggle (Ctrl+/): comment the caret line, or every line a selection touches.
            // If every non-blank line in range is already commented, uncomment; otherwise comment. Blank
            // lines are left alone. The marker is "// " inserted at each line's first non-blank column.
            private method firstNonBlank(String s) returns int {
                mutable int i = 0;
                while (i < s.length() && (s.charAt(i) == ' ' || s.charAt(i) == '\t')) {
                    i = i + 1;
                }
                return i;
            }
            private method lineIsCommented(String s) returns boolean {
                int at = this.firstNonBlank(s);
                return at + 1 < s.length() && s.charAt(at) == '/' && s.charAt(at + 1) == '/';
            }
            private method commentLine(int row) returns void {
                String s = this.buf.line(row);
                int at = this.firstNonBlank(s);
                this.buf.setLine(row, s.substring(0, at) + "// " + s.substring(at, s.length()));
            }
            private method uncommentLine(int row) returns void {
                String s = this.buf.line(row);
                int at = this.firstNonBlank(s);
                mutable int rm = at + 2;                       // past the "//"
                if (rm < s.length() && s.charAt(rm) == ' ') {
                    rm = rm + 1;
                }
                // and one space
                this.buf.setLine(row, s.substring(0, at) + s.substring(rm, s.length()));
            }
            public method toggleComment() returns void {
                this.saveUndo();
                mutable int a = this.row;
                mutable int b = this.row;
                if (this.hasSelection()) {
                    a = this.selMinRow();
                    b = this.selMaxRow();
                }
                mutable boolean allCommented = true;
                for (mutable int r = a; r <= b; r++) {
                    String s = this.buf.line(r);
                    if (this.firstNonBlank(s) < s.length() && !this.lineIsCommented(s)) {
                        allCommented = false;
                    }
                }
                for (mutable int r = a; r <= b; r++) {
                    String s = this.buf.line(r);
                    if (this.firstNonBlank(s) >= s.length()) {
                        continue;
                    }
                    // skip blank lines
                    if (allCommented) {
                        this.uncommentLine(r);
                    } else {
                        this.commentLine(r);
                    }
                }
            }

            // --- selection ---
            private method anchorSelection() returns void {
                if (!this.hasSel) {
                    this.selRow = this.row;
                    this.selCol = this.col;
                    this.hasSel = true;
                }
            }
            public method clearSelection() returns void {
                this.hasSel = false;
            }
            public method hasSelection() returns boolean {
                return this.hasSel && !(this.selRow == this.row && this.selCol == this.col);
            }
            private method anchorBeforeCaret() returns boolean {
                if (this.selRow < this.row) {
                    return true;
                }
                if (this.selRow > this.row) {
                    return false;
                }
                return this.selCol <= this.col;
            }
            public method selectionText() returns String {
                if (!this.hasSelection()) {
                    return "";
                }
                if (this.anchorBeforeCaret()) {
                    return this.buf.getRange(this.selRow, this.selCol, this.row, this.col);
                }
                return this.buf.getRange(this.row, this.col, this.selRow, this.selCol);
            }
            // Delete the selection and put the caret at its start. Does NOT snapshot undo -- callers wrap it.
            public method deleteSelection() returns void {
                if (!this.hasSelection()) {
                    this.hasSel = false;
                    return;
                }
                if (this.anchorBeforeCaret()) {
                    this.buf.deleteRange(this.selRow, this.selCol, this.row, this.col);
                    this.row = this.selRow;
                    this.col = this.selCol;
                } else {
                    this.buf.deleteRange(this.row, this.col, this.selRow, this.selCol);
                }
                this.hasSel = false;
            }

            public method cursorRow() returns int {
                return this.row;
            }
            public method cursorCol() returns int {
                return this.col;
            }
            public method document() returns TextBuffer* {
                return this.buf;
            }

            // Place the caret at (row, col), clamped into the document, clearing any selection -- a mouse
            // click lands here.
            public method setCaret(int row, int col) returns void {
                this.clearSelection();
                this.clearExtraCarets();
                mutable int rr = row;
                if (rr < 0) {
                    rr = 0;
                }
                if (rr >= this.buf.lineCount()) {
                    rr = this.buf.lineCount() - 1;
                }
                this.row = rr;
                mutable int cc = col;
                if (cc < 0) {
                    cc = 0;
                }
                int len = this.buf.line(this.row).length();
                if (cc > len) {
                    cc = len;
                }
                this.col = cc;
            }

            // Mouse press: place the caret at (row, col) and anchor a (still-empty) selection there, so a drag
            // can extend from this point.
            public method beginSelect(int row, int col) returns void {
                this.setCaret(row, col);
                this.selRow = this.row;
                this.selCol = this.col;
                this.hasSel = true;
            }
            // Double-click: select the whole word at (row, col).
            public method selectWordAt(int row, int col) returns void {
                this.setCaret(row, col);
                String line = this.buf.line(this.row);
                mutable int start = this.col;
                while (start > 0 && Editor.isWordCh(line.charAt(start - 1))) {
                    start = start - 1;
                }
                mutable int end = this.col;
                while (end < line.length() && Editor.isWordCh(line.charAt(end))) {
                    end = end + 1;
                }
                if (end > start) {
                    this.selRow = this.row;
                    this.selCol = start;
                    this.col = end;
                    this.hasSel = true;
                }
            }
            private static method isWordCh(char ch) returns boolean {
                return (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z')
                    || (ch >= '0' && ch <= '9') || ch == '_';
            }
            // Mouse drag: move the caret to (row, col) while keeping the anchor -> grow/shrink the selection.
            public method extendSelectTo(int row, int col) returns void {
                mutable int rr = row;
                if (rr < 0) {
                    rr = 0;
                }
                if (rr >= this.buf.lineCount()) {
                    rr = this.buf.lineCount() - 1;
                }
                this.row = rr;
                mutable int cc = col;
                if (cc < 0) {
                    cc = 0;
                }
                int len = this.buf.line(this.row).length();
                if (cc > len) {
                    cc = len;
                }
                this.col = cc;
                this.hasSel = true;
            }

            // Ordered selection bounds (start <= end), for rendering. Only meaningful when hasSelection().
            public method selStartRow() returns int {
                if (this.anchorBeforeCaret()) {
                    return this.selRow;
                }
                return this.row;
            }
            public method selStartCol() returns int {
                if (this.anchorBeforeCaret()) {
                    return this.selCol;
                }
                return this.col;
            }
            public method selEndRow() returns int {
                if (this.anchorBeforeCaret()) {
                    return this.row;
                }
                return this.selRow;
            }
            public method selEndCol() returns int {
                if (this.anchorBeforeCaret()) {
                    return this.col;
                }
                return this.selCol;
            }

            // Record the current state before a mutating edit; a fresh edit invalidates the redo history.
            // A multi-caret edit takes one snapshot up front and suppresses the per-sub-edit snapshots so the
            // whole thing is a single undo step.
            private method saveUndo() returns void {
                if (this.suppressUndo) {
                    return;
                }
                this.hist.push(this.buf.text(), this.row, this.col);
            }

            private method restore(Snapshot* s) returns void {
                this.buf.loadText(s.text);
                this.row = s.row;
                this.col = s.col;
            }

            // Share this view's history with a document (the other view of the same file already has it).
            public method setHistory(History* h) returns void {
                this.hist = h;
                return;
            }
            public method history() returns History* {
                return this.hist;
            }

            public method undo() returns boolean {
                if (!this.hist.canUndo()) {
                    return false;
                }
                this.restore(this.hist.popUndo(this.buf.text(), this.row, this.col));
                this.clampCaret();
                return true;
            }

            public method redo() returns boolean {
                if (!this.hist.canRedo()) {
                    return false;
                }
                this.restore(this.hist.popRedo(this.buf.text(), this.row, this.col));
                this.clampCaret();
                return true;
            }

            // Pull the caret back inside the buffer. The text under a view can change without that view
            // touching it -- the other pane edited it, or undid an edit -- so a caret that was valid a moment
            // ago may now point past the end. Every view clamps before it is read.
            public method clampCaret() returns void {
                int lines = this.buf.lineCount();
                if (this.row >= lines) {
                    this.row = lines - 1;
                }
                if (this.row < 0) {
                    this.row = 0;
                }
                int len = this.buf.line(this.row).length();
                if (this.col > len) {
                    this.col = len;
                }
                if (this.col < 0) {
                    this.col = 0;
                }
                if (this.hasSel) {
                    if (this.selRow >= lines) {
                        this.selRow = lines - 1;
                    }
                    if (this.selRow < 0) {
                        this.selRow = 0;
                    }
                    int slen = this.buf.line(this.selRow).length();
                    if (this.selCol > slen) {
                        this.selCol = slen;
                    }
                }
                return;
            }

            // --- multi-cursor: secondary carets edited together with the primary (row, col) ---
            public method hasMultipleCarets() returns boolean {
                return this.extraRows.size() > 0;
            }
            public method extraCaretCount() returns int {
                return this.extraRows.size();
            }
            public method extraCaretRow(int i) returns int {
                return this.extraRows.get(i);
            }
            public method extraCaretCol(int i) returns int {
                return this.extraCols.get(i);
            }
            public method clearExtraCarets() returns void {
                this.extraRows = new ArrayList<int>() on heap;
                this.extraCols = new ArrayList<int>() on heap;
                this.extraSelRows = new ArrayList<int>() on heap;
                this.extraSelCols = new ArrayList<int>() on heap;
            }
            // Whether secondary caret `i` carries a selection (from Ctrl+D add-next-occurrence).
            public method extraHasSel(int i) returns boolean {
                return this.extraSelRows.get(i) >= 0;
            }
            public method extraSelRow(int i) returns int {
                return this.extraSelRows.get(i);
            }
            public method extraSelCol(int i) returns int {
                return this.extraSelCols.get(i);
            }
            // Add a secondary caret at (row, col), clamped into the document; a no-op if it duplicates a caret.
            public method addCaretAt(int row, int col) returns void {
                mutable int rr = row;
                if (rr < 0) {
                    rr = 0;
                }
                if (rr >= this.buf.lineCount()) {
                    rr = this.buf.lineCount() - 1;
                }
                mutable int cc = col;
                if (cc < 0) {
                    cc = 0;
                }
                int len = this.buf.line(rr).length();
                if (cc > len) {
                    cc = len;
                }
                if (rr == this.row && cc == this.col) {
                    return;
                }
                mutable int i = 0;
                while (i < this.extraRows.size()) {
                    if (this.extraRows.get(i) == rr && this.extraCols.get(i) == cc) {
                        return;
                    }
                    i = i + 1;
                }
                this.extraRows.add(rr);
                this.extraCols.add(cc);
                this.extraSelRows.add(0 - 1);
                this.extraSelCols.add(0 - 1);
            }
            // Add a secondary caret that also carries a selection spanning (selRow,selCol)..(row,col) -- the
            // shape Ctrl+D produces so that a subsequent keystroke replaces every selected occurrence at once.
            private method addSelectionCaret(int selRow, int selCol, int row, int col) returns void {
                this.extraRows.add(row);
                this.extraCols.add(col);
                this.extraSelRows.add(selRow);
                this.extraSelCols.add(selCol);
            }
            // Add a caret one line below the bottom-most caret (or above the top-most). With a single-line
            // selection this extends a COLUMN block -- each new caret carries the same column span (box select);
            // otherwise it is a bare caret at the primary column.
            public method addCaretBelow() returns void {
                mutable int maxRow = this.row;
                mutable int i = 0;
                while (i < this.extraRows.size()) {
                    if (this.extraRows.get(i) > maxRow) {
                        maxRow = this.extraRows.get(i);
                    }
                    i = i + 1;
                }
                if (maxRow + 1 < this.buf.lineCount()) {
                    this.addColumnCaretAt(maxRow + 1);
                }
            }
            public method addCaretAbove() returns void {
                mutable int minRow = this.row;
                mutable int i = 0;
                while (i < this.extraRows.size()) {
                    if (this.extraRows.get(i) < minRow) {
                        minRow = this.extraRows.get(i);
                    }
                    i = i + 1;
                }
                if (minRow - 1 >= 0) {
                    this.addColumnCaretAt(minRow - 1);
                }
            }
            // Add a caret on `targetRow`: mirroring the primary's single-line selection span there (column/box
            // select), clamped to the target line's length, or a bare caret at the primary column otherwise.
            private method addColumnCaretAt(int targetRow) returns void {
                if (this.hasSelection() && this.selRow == this.row) {
                    mutable int a = this.selCol;
                    mutable int b = this.col;
                    if (b < a) {
                        int t = a;
                        a = b;
                        b = t;
                    }
                    int len = this.buf.line(targetRow).length();
                    if (a > len) {
                        a = len;
                    }
                    if (b > len) {
                        b = len;
                    }
                    this.addSelectionCaret(targetRow, a, targetRow, b);
                } else {
                    this.addCaretAt(targetRow, this.col);
                }
            }

            // The start (row, col) of the primary selection -- the anchor when it precedes the caret, else the
            // caret. Returns the caret when there is no selection.
            private method primaryStartRow() returns int {
                if (this.hasSelection() && !this.anchorBeforeCaret()) {
                    return this.row;
                }
                if (this.hasSelection()) {
                    return this.selRow;
                }
                return this.row;
            }
            private method primaryStartCol() returns int {
                if (this.hasSelection() && !this.anchorBeforeCaret()) {
                    return this.col;
                }
                if (this.hasSelection()) {
                    return this.selCol;
                }
                return this.col;
            }
            // Is an occurrence starting at (r, c) already selected by the primary or one of the secondaries?
            private method occurrenceOccupied(int r, int c) returns boolean {
                if (r == this.primaryStartRow() && c == this.primaryStartCol()) {
                    return true;
                }
                mutable int i = 0;
                while (i < this.extraRows.size()) {
                    if (this.extraSelRows.get(i) == r && this.extraSelCols.get(i) == c) {
                        return true;
                    }
                    i = i + 1;
                }
                return false;
            }

            // Ctrl+D: the first press with no selection selects the word under the caret; each further press
            // adds the next occurrence of the selected text as a new selection+caret (wrapping the document,
            // skipping ones already selected). Typing then replaces every selected occurrence at once. Returns
            // false when there is nothing more to add.
            public method selectNextOccurrence() returns boolean {
                if (!this.hasSelection()) {
                    this.selectWordAtCaret();
                    return this.hasSelection();
                }
                String needle = this.selectionText();
                if (needle.length() == 0 || Editor.hasNewline(needle)) {
                    return false;
                }
                ArrayList<Match>* all = this.search.findAll(needle);
                if (all.size() <= 1) {
                    return false;
                }
                int pr = this.primaryStartRow();
                int pc = this.primaryStartCol();
                mutable int pIdx = 0;
                mutable int f = 0;
                while (f < all.size()) {
                    if (all.get(f).row == pr && all.get(f).col == pc) {
                        pIdx = f;
                    }
                    f = f + 1;
                }
                mutable int advance = 1;
                while (advance <= all.size()) {
                    int idx = (pIdx + advance) % all.size();
                    Match* m = all.get(idx);
                    if (!this.occurrenceOccupied(m.row, m.col)) {
                        // Demote the current primary to a secondary, promote the found occurrence to primary.
                        int endRow = this.row;
                        int endCol = this.col;
                        int sr = this.selRow;
                        int sc = this.selCol;
                        this.addSelectionCaret(sr, sc, endRow, endCol);
                        this.selRow = m.row;
                        this.selCol = m.col;
                        this.row = m.row;
                        this.col = m.col + m.length;
                        this.hasSel = true;
                        return true;
                    }
                    advance = advance + 1;
                }
                return false;
            }

            // Ctrl+Shift+L: select every occurrence of the current selection (or the word under the caret) at
            // once. The primary stays on its occurrence; every other becomes a secondary selection.
            public method selectAllOccurrences() returns boolean {
                if (!this.hasSelection()) {
                    this.selectWordAtCaret();
                }
                if (!this.hasSelection()) {
                    return false;
                }
                String needle = this.selectionText();
                if (needle.length() == 0 || Editor.hasNewline(needle)) {
                    return false;
                }
                ArrayList<Match>* all = this.search.findAll(needle);
                if (all.size() == 0) {
                    return false;
                }
                this.clearExtraCarets();
                int pr = this.primaryStartRow();
                int pc = this.primaryStartCol();
                // Keep the primary anchored to its own occurrence, shaped anchor-before-caret for consistency.
                this.selRow = pr;
                this.selCol = pc;
                this.row = pr;
                this.col = pc + needle.length();
                this.hasSel = true;
                mutable int i = 0;
                while (i < all.size()) {
                    Match* m = all.get(i);
                    if (!(m.row == pr && m.col == pc)) {
                        this.addSelectionCaret(m.row, m.col, m.row, m.col + m.length);
                    }
                    i = i + 1;
                }
                return true;
            }
            private static method hasNewline(String s) returns boolean {
                mutable int i = 0;
                while (i < s.length()) {
                    if (s.charAt(i) == '\n') {
                        return true;
                    }
                    i = i + 1;
                }
                return false;
            }

            // Type / backspace / newline that route through every caret when there are secondaries.
            public method typeMulti(char c) returns void {
                if (this.extraRows.size() == 0) {
                    this.typeWithPairs(c);
                    return;
                }
                this.applyMulti(0, c);
            }
            public method backspaceMulti() returns void {
                if (this.extraRows.size() == 0) {
                    this.backspace();
                    return;
                }
                this.applyMulti(1, ' ');
            }
            public method enterMulti() returns void {
                if (this.extraRows.size() == 0) {
                    this.enter();
                    return;
                }
                this.applyMulti(2, ' ');
            }

            // Apply one edit at every caret as a single undo step. op: 0 = type char, 1 = backspace, 2 = enter.
            // Carets run bottom-to-top so an edit never shifts a caret still to be processed. Each caret carries
            // its own selection (sr,sc >= 0 means active): the edit deletes it first, so typing over Ctrl+D
            // occurrences replaces every one at once.
            private method applyMulti(int op, char ch) returns void {
                this.saveUndo();
                this.suppressUndo = true;
                ArrayList<int>* rows = new ArrayList<int>() on heap;
                ArrayList<int>* cols = new ArrayList<int>() on heap;
                ArrayList<int>* srs = new ArrayList<int>() on heap;
                ArrayList<int>* scs = new ArrayList<int>() on heap;
                ArrayList<int>* prim = new ArrayList<int>() on heap;
                rows.add(this.row);
                cols.add(this.col);
                if (this.hasSelection()) {
                    srs.add(this.selRow);
                    scs.add(this.selCol);
                } else {
                    srs.add(0 - 1);
                    scs.add(0 - 1);
                }
                prim.add(1);
                mutable int i = 0;
                while (i < this.extraRows.size()) {
                    rows.add(this.extraRows.get(i));
                    cols.add(this.extraCols.get(i));
                    srs.add(this.extraSelRows.get(i));
                    scs.add(this.extraSelCols.get(i));
                    prim.add(0);
                    i = i + 1;
                }
                // selection sort, descending by (row, col)
                mutable int a = 0;
                while (a < rows.size()) {
                    mutable int best = a;
                    mutable int b = a + 1;
                    while (b < rows.size()) {
                        if (Editor.caretAfter(rows.get(b), cols.get(b), rows.get(best), cols.get(best))) {
                            best = b;
                        }
                        b = b + 1;
                    }
                    if (best != a) {
                        Editor.swapInt(rows, a, best);
                        Editor.swapInt(cols, a, best);
                        Editor.swapInt(srs, a, best);
                        Editor.swapInt(scs, a, best);
                        Editor.swapInt(prim, a, best);
                    }
                    a = a + 1;
                }
                // apply at each caret, recording the new position
                mutable int k = 0;
                while (k < rows.size()) {
                    this.row = rows.get(k);
                    this.col = cols.get(k);
                    if (srs.get(k) >= 0) {
                        this.selRow = srs.get(k);
                        this.selCol = scs.get(k);
                        this.hasSel = true;
                    } else {
                        this.hasSel = false;
                    }
                    if (op == 0) {
                        this.typeWithPairs(ch);
                    } else if (op == 1) {
                        this.backspace();
                    } else {
                        this.enter();
                    }
                    this.hasSel = false;
                    rows.set(k, this.row);
                    cols.set(k, this.col);
                    k = k + 1;
                }
                // scatter back: the tagged entry is the primary, the rest become bare secondaries
                this.extraRows = new ArrayList<int>() on heap;
                this.extraCols = new ArrayList<int>() on heap;
                this.extraSelRows = new ArrayList<int>() on heap;
                this.extraSelCols = new ArrayList<int>() on heap;
                mutable int j = 0;
                while (j < rows.size()) {
                    if (prim.get(j) == 1) {
                        this.row = rows.get(j);
                        this.col = cols.get(j);
                    } else {
                        this.extraRows.add(rows.get(j));
                        this.extraCols.add(cols.get(j));
                        this.extraSelRows.add(0 - 1);
                        this.extraSelCols.add(0 - 1);
                    }
                    j = j + 1;
                }
                this.suppressUndo = false;
            }
            private static method caretAfter(int r1, int c1, int r2, int c2) returns boolean {
                if (r1 > r2) {
                    return true;
                }
                if (r1 < r2) {
                    return false;
                }
                return c1 > c2;
            }
            private static method swapInt(ArrayList<int>* xs, int i, int j) returns void {
                int t = xs.get(i);
                xs.set(i, xs.get(j));
                xs.set(j, t);
            }

            public method type(char c) returns void {
                this.saveUndo();
                if (this.hasSelection()) {
                    this.deleteSelection();
                }
                this.buf.insertChar(this.row, this.col, c);
                this.col = this.col + 1;
            }

            // Count of leading whitespace on `s`, not looking past column `upTo` (so a caret inside the
            // indentation doesn't over-count).
            private method leadingIndent(String s, int upTo) returns int {
                mutable int i = 0;
                while (i < s.length() && i < upTo && (s.charAt(i) == ' ' || s.charAt(i) == '\t')) {
                    i = i + 1;
                }
                return i;
            }

            // Enter with auto-indent: the new line inherits the current line's leading whitespace, plus one
            // level (four spaces) when the caret follows an opening brace.
            public method enter() returns void {
                this.saveUndo();
                if (this.hasSelection()) {
                    this.deleteSelection();
                }
                String cur = this.buf.line(this.row);
                int ind = this.leadingIndent(cur, this.col);
                boolean opensBlock = this.col > 0 && cur.charAt(this.col - 1) == '{';
                this.buf.splitLine(this.row, this.col);
                this.row = this.row + 1;
                this.col = 0;
                if (ind > 0) {
                    this.buf.insertText(this.row, 0, cur.substring(0, ind));
                    this.col = ind;
                }
                if (opensBlock) {
                    this.buf.insertText(this.row, this.col, this.indentUnit());
                    this.col = this.col + this.tabWidth;
                }
            }

            // Insert `text` (possibly multi-line) verbatim at the caret -- no auto-indent, unlike enter().
            // This is the path for pasting and bulk loading, so pre-formatted code lands exactly as given.
            public method insertText(String text) returns void {
                this.saveUndo();
                if (this.hasSelection()) {
                    this.deleteSelection();
                }
                int added = this.buf.insertText(this.row, this.col, text);
                if (added == 0) {
                    this.col = this.col + text.length();
                } else {
                    ArrayList<String> parts = Strings.split(text, "\n");
                    this.row = this.row + added;
                    this.col = parts.get(parts.size() - 1).length();
                }
            }

            public method backspace() returns void {
                if (this.hasSelection()) {
                    this.saveUndo();
                    this.deleteSelection();
                    return;
                }
                if (this.col == 0 && this.row == 0) {
                    return;
                }
                this.saveUndo();
                boolean joining = this.col == 0;
                int newCol = this.buf.backspace(this.row, this.col);
                if (joining) {
                    this.row = this.row - 1;
                }
                this.col = newCol;
            }

            // Raw caret moves (no selection side effect). The public moveX clear the selection first; the
            // selectX anchor it and extend -- that's Shift+arrow.
            private method rawLeft() returns void {
                if (this.col > 0) {
                    this.col = this.col - 1;
                }
                else if (this.row > 0) {
                    this.row = this.row - 1;
                    this.col = this.buf.line(this.row).length();
                }
            }
            private method rawRight() returns void {
                if (this.col < this.buf.line(this.row).length()) {
                    this.col = this.col + 1;
                }
                else if (this.row < this.buf.lineCount() - 1) {
                    this.row = this.row + 1;
                    this.col = 0;
                }
            }
            private method rawUp() returns void {
                if (this.row > 0) {
                    this.row = this.row - 1;
                    this.clampCol();
                }
            }
            private method rawDown() returns void {
                if (this.row < this.buf.lineCount() - 1) {
                    this.row = this.row + 1;
                    this.clampCol();
                }
            }
            // Smart Home: first press goes to the first non-blank column, a second press to column 0.
            private method rawLineStart() returns void {
                String s = this.buf.line(this.row);
                mutable int firstNonBlank = 0;
                while (firstNonBlank < s.length()
                       && (s.charAt(firstNonBlank) == ' ' || s.charAt(firstNonBlank) == '\t')) {
                    firstNonBlank = firstNonBlank + 1;
                }
                if (this.col == firstNonBlank) {
                    this.col = 0;
                } else {
                    this.col = firstNonBlank;
                }
            }
            private method rawLineEnd() returns void {
                this.col = this.buf.line(this.row).length();
            }
            private method rawDocStart() returns void {
                this.row = 0;
                this.col = 0;
            }
            private method rawDocEnd() returns void {
                this.row = this.buf.lineCount() - 1;
                this.col = this.buf.line(this.row).length();
            }

            public method moveLeft() returns void {
                this.clearSelection();
                this.clearExtraCarets();
                this.rawLeft();
            }
            public method moveRight() returns void {
                this.clearSelection();
                this.clearExtraCarets();
                this.rawRight();
            }
            public method moveUp() returns void {
                this.clearSelection();
                this.clearExtraCarets();
                this.rawUp();
            }
            public method moveDown() returns void {
                this.clearSelection();
                this.clearExtraCarets();
                this.rawDown();
            }
            public method moveLineStart() returns void {
                this.clearSelection();
                this.clearExtraCarets();
                this.rawLineStart();
            }
            public method moveLineEnd() returns void {
                this.clearSelection();
                this.clearExtraCarets();
                this.rawLineEnd();
            }
            public method moveDocStart() returns void {
                this.clearSelection();
                this.clearExtraCarets();
                this.rawDocStart();
            }
            public method moveDocEnd() returns void {
                this.clearSelection();
                this.clearExtraCarets();
                this.rawDocEnd();
            }

            public method selectLeft()  returns void {
                this.anchorSelection();
                this.rawLeft();
            }
            public method selectRight() returns void {
                this.anchorSelection();
                this.rawRight();
            }
            public method selectUp()    returns void {
                this.anchorSelection();
                this.rawUp();
            }
            public method selectDown()  returns void {
                this.anchorSelection();
                this.rawDown();
            }
            public method selectLineStart() returns void {
                this.anchorSelection();
                this.rawLineStart();
            }
            public method selectLineEnd()   returns void {
                this.anchorSelection();
                this.rawLineEnd();
            }
            public method selectDocStart()  returns void {
                this.anchorSelection();
                this.rawDocStart();
            }
            public method selectDocEnd()    returns void {
                this.anchorSelection();
                this.rawDocEnd();
            }
            public method selectAll() returns void {
                this.selRow = 0;
                this.selCol = 0;
                this.hasSel = true;
                this.rawDocEnd();
            }

            // Set the selection to span (sr,sc)..(er,ec) in document order, the caret at the end. An empty range
            // (start == end) clears the selection, leaving the caret there.
            private method setSelectionRange(int sr, int sc, int er, int ec) returns void {
                this.selRow = sr;
                this.selCol = sc;
                this.row = er;
                this.col = ec;
                this.hasSel = !(sr == er && sc == ec);
            }

            // Shift+Alt+Right: grow the selection to the next syntactic unit -- the word under the caret, then
            // the contents inside the nearest enclosing brackets, then those brackets, climbing outward, and
            // finally the whole document. A history stack lets shrinkSelection walk it back exactly.
            public method expandSelection() returns void {
                boolean cont = this.hasSelection() && this.selRow == this.expSr && this.selCol == this.expSc
                               && this.row == this.expR && this.col == this.expC;
                if (!cont) {
                    this.expandHist = new ArrayList<int>() on heap;
                }
                mutable int csr = this.row;
                mutable int csc = this.col;
                if (this.hasSelection()) {
                    csr = this.selRow;
                    csc = this.selCol;
                }
                this.expandHist.add(csr);
                this.expandHist.add(csc);
                this.expandHist.add(this.row);
                this.expandHist.add(this.col);
                this.computeExpand();
                this.expSr = this.selRow;
                this.expSc = this.selCol;
                this.expR = this.row;
                this.expC = this.col;
            }

            private method computeExpand() returns void {
                if (!this.hasSelection()) {
                    this.selectWordAtCaret();
                    return;
                }
                mutable int sr = this.selRow;
                mutable int sc = this.selCol;
                mutable int er = this.row;
                mutable int ec = this.col;
                if (!this.anchorBeforeCaret()) {
                    sr = this.row;
                    sc = this.col;
                    er = this.selRow;
                    ec = this.selCol;
                }
                Match* op = this.brackets.enclosingOpen(sr, sc);
                if (!op.valid()) {
                    this.selectAll();
                    return;
                }
                Match* cl = this.brackets.matchAt(op.row, op.col);
                if (!cl.valid()) {
                    this.selectAll();
                    return;
                }
                int innerSr = op.row;
                int innerSc = op.col + 1;
                int innerEr = cl.row;
                int innerEc = cl.col;
                boolean innerEmpty = innerSr == innerEr && innerSc == innerEc;
                boolean atInner = sr == innerSr && sc == innerSc && er == innerEr && ec == innerEc;
                if (innerEmpty || atInner) {
                    this.setSelectionRange(op.row, op.col, cl.row, cl.col + 1);
                } else {
                    this.setSelectionRange(innerSr, innerSc, innerEr, innerEc);
                }
            }

            // Shift+Alt+Left: undo the last expand, shrinking back to the previous selection.
            public method shrinkSelection() returns void {
                if (this.expandHist.size() < 4) {
                    return;
                }
                int n = this.expandHist.size();
                int cc = this.expandHist.get(n - 1);
                int cr = this.expandHist.get(n - 2);
                int sc = this.expandHist.get(n - 3);
                int sr = this.expandHist.get(n - 4);
                this.expandHist.removeAt(n - 1);
                this.expandHist.removeAt(n - 2);
                this.expandHist.removeAt(n - 3);
                this.expandHist.removeAt(n - 4);
                this.setSelectionRange(sr, sc, cr, cc);
                this.expSr = this.selRow;
                this.expSc = this.selCol;
                this.expR = this.row;
                this.expC = this.col;
            }

            // Strip trailing spaces/tabs from every line (the professional editor hygiene applied on save).
            // Takes one undo snapshot only if something changed, then clamps the caret if it sat in the trimmed
            // tail. Returns whether any line changed.
            public method trimTrailingWhitespace() returns boolean {
                mutable boolean any = false;
                mutable int r = 0;
                while (r < this.buf.lineCount()) {
                    String s = this.buf.line(r);
                    if (Editor.rtrimLen(s) < s.length()) {
                        any = true;
                    }
                    r = r + 1;
                }
                if (!any) {
                    return false;
                }
                this.saveUndo();
                r = 0;
                while (r < this.buf.lineCount()) {
                    String s = this.buf.line(r);
                    int t = Editor.rtrimLen(s);
                    if (t < s.length()) {
                        this.buf.setLine(r, s.substring(0, t));
                    }
                    r = r + 1;
                }
                this.clampCol();
                return true;
            }
            private static method rtrimLen(String s) returns int {
                mutable int n = s.length();
                while (n > 0 && (s.charAt(n - 1) == ' ' || s.charAt(n - 1) == '\t')) {
                    n = n - 1;
                }
                return n;
            }

            // Delete the character to the right of the caret (the Delete key); at a line end, pull the next
            // line up. With a selection, delete that instead.
            public method deleteForward() returns void {
                if (this.hasSelection()) {
                    this.saveUndo();
                    this.deleteSelection();
                    return;
                }
                int len = this.buf.line(this.row).length();
                if (this.col < len) {
                    this.saveUndo();
                    this.buf.deleteRange(this.row, this.col, this.row, this.col + 1);
                } else if (this.row < this.buf.lineCount() - 1) {
                    this.saveUndo();
                    this.buf.setLine(this.row, this.buf.line(this.row) + this.buf.line(this.row + 1));
                    this.buf.removeLine(this.row + 1);
                }
            }

            private method clampCol() returns void {
                int len = this.buf.line(this.row).length();
                if (this.col > len) {
                    this.col = len;
                }
            }
        }
    }
}
