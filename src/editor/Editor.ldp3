import System.Collections.ArrayList;
import System.Text.Strings;

program Forge;

public bundle forge {
    public namespace editor {

        // A caret over a TextBuffer: turns key events (type/enter/backspace) and arrow moves into buffer
        // edits, keeping (row, col) valid, with snapshot-based undo/redo. TextBuffer and Snapshot are in the
        // same namespace, so no import is needed for them. This is the model an input layer drives.
        public class Editor {
            private mutable TextBuffer* buf;
            private mutable int row;
            private mutable int col;
            private mutable int selRow;             // selection anchor; the caret (row,col) is the active end
            private mutable int selCol;
            private mutable boolean hasSel;
            private mutable Clipboard* clip;
            private mutable Search* search;
            private mutable Brackets* brackets;
            private mutable int tabWidth;
            private mutable ArrayList<Snapshot>* undoStack;
            private mutable ArrayList<Snapshot>* redoStack;
            private mutable ArrayList<int>* extraRows;   // secondary carets (multi-cursor); primary is row/col
            private mutable ArrayList<int>* extraCols;
            private mutable boolean suppressUndo;         // set while a multi-caret edit groups into one undo

            public constructor Editor(TextBuffer* doc) {
                this.buf = doc;
                this.row = 0;
                this.col = 0;
                this.selRow = 0;
                this.selCol = 0;
                this.hasSel = false;
                this.clip = new Clipboard() on heap;
                this.search = new Search(doc) on heap;
                this.brackets = new Brackets(doc) on heap;
                this.tabWidth = 4;
                this.undoStack = new ArrayList<Snapshot>() on heap;
                this.redoStack = new ArrayList<Snapshot>() on heap;
                this.extraRows = new ArrayList<int>() on heap;
                this.extraCols = new ArrayList<int>() on heap;
                this.suppressUndo = false;
            }

            // Indentation width (spaces per level), configurable. indentUnit() is one level of spaces.
            public method setTabWidth(int n) returns void {
                if (n > 0) {
                    this.tabWidth = n;
                }
            }
            public method tabSize() returns int {
                return this.tabWidth;
            }
            private method indentUnit() returns String {
                return " ".repeat(this.tabWidth);
            }

            // --- bracket auto-close + matching ---
            private method closerFor(char c) returns char {
                if (c == '(') {
                    return ')';
                }
                if (c == '[') {
                    return ']';
                }
                if (c == '{') {
                    return '}';
                }
                if (c == cast<char>(34)) {
                    return cast<char>(34);
                }
                // "
                if (c == cast<char>(39)) {
                    return cast<char>(39);
                }
                // '
                return cast<char>(0);
            }
            private method isCloserChar(char c) returns boolean {
                return c == ')' || c == ']' || c == '}'
                    || c == cast<char>(34) || c == cast<char>(39);
            }
            private method nextCharIs(char c) returns boolean {
                String line = this.buf.line(this.row);
                return this.col < line.length() && line.charAt(this.col) == c;
            }

            // Type a character with auto-pairing: an opener also inserts its closer (caret stays between);
            // typing a closer that already sits under the caret just steps over it. With a selection it
            // falls back to a plain replace.
            public method typeWithPairs(char c) returns void {
                if (this.hasSelection()) {
                    this.type(c);
                    return;
                }
                if (this.isCloserChar(c) && this.nextCharIs(c)) {
                    this.rawRight();
                    return;
                }
                char closer = this.closerFor(c);
                this.type(c);
                if (closer != cast<char>(0)) {
                    this.buf.insertChar(this.row, this.col, closer);   // after caret, no caret move
                }
            }

            // The matching bracket for a bracket at or just before the caret, or an invalid Match.
            public method matchingBracket() returns Match* {
                Match* m = this.brackets.matchAt(this.row, this.col);
                if (m.valid()) {
                    return m;
                }
                if (this.col > 0) {
                    return this.brackets.matchAt(this.row, this.col - 1);
                }
                return m;
            }

            // --- find / replace (plain text, case-sensitivity via setSearchCase) ---
            public method setSearchCase(boolean caseSensitive) returns void {
                this.search.setCaseSensitive(caseSensitive);
            }
            public method matchCount(String needle) returns int {
                return this.search.count(needle);
            }

            // Move to and select the next/previous occurrence of `needle`. Returns false (leaving the caret
            // put) when there is no match. The match is selected so a following type()/paste() replaces it.
            public method find(String needle) returns boolean {
                Match* m = this.search.findNext(needle, this.row, this.col);
                if (!m.valid()) {
                    return false;
                }
                this.selectMatch(m);
                return true;
            }
            public method findPrevious(String needle) returns boolean {
                Match* m = this.search.findPrev(needle, this.row, this.col);
                if (!m.valid()) {
                    return false;
                }
                this.selectMatch(m);
                return true;
            }
            private method selectMatch(Match* m) returns void {
                this.selRow = m.row;
                this.selCol = m.col;
                this.hasSel = true;
                this.row = m.row;
                this.col = m.col + m.length;
            }

            // Replace every occurrence of `needle` with `replacement`. Returns how many were replaced. One
            // undo step covers the whole sweep. Applied bottom-up so earlier match columns stay valid.
            public method replaceAll(String needle, String replacement) returns int {
                if (needle.length() == 0) {
                    return 0;
                }
                ArrayList<Match>* all = this.search.findAll(needle);
                if (all.size() == 0) {
                    return 0;
                }
                this.saveUndo();
                this.clearSelection();
                for (mutable int i = all.size() - 1; i >= 0; i--) {
                    Match* m = all.get(i);
                    String cur = this.buf.line(m.row);
                    this.buf.setLine(m.row,
                        cur.substring(0, m.col) + replacement + cur.substring(m.col + m.length, cur.length()));
                }
                this.clampCaret();
                return all.size();
            }

            // --- clipboard: copy/cut the selection, paste at the caret (replacing any selection) ---
            public method copy() returns void {
                if (this.hasSelection()) {
                    this.clip.set(this.selectionText());
                }
            }
            public method cut() returns void {
                if (!this.hasSelection()) {
                    return;
                }
                this.clip.set(this.selectionText());
                this.saveUndo();
                this.deleteSelection();
            }
            public method paste() returns void {
                String text = this.clip.get();
                if (text.length() == 0) {
                    return;
                }
                this.saveUndo();
                if (this.hasSelection()) {
                    this.deleteSelection();
                }
                int addedRows = this.buf.insertText(this.row, this.col, text);
                if (addedRows == 0) {
                    this.col = this.col + text.length();
                } else {
                    ArrayList<String> parts = Strings.split(text, "\n");
                    this.row = this.row + addedRows;
                    this.col = parts.get(parts.size() - 1).length();
                }
            }
            public method clipboardText() returns String {
                return this.clip.get();
            }

            // --- line operations (duplicate / delete / move up-down / indent-dedent), on the caret's line ---
            public method duplicateLine() returns void {
                this.saveUndo();
                this.buf.insertLine(this.row + 1, this.buf.line(this.row));
                this.row = this.row + 1;
            }
            public method deleteLine() returns void {
                this.saveUndo();
                this.clearSelection();
                this.buf.removeLine(this.row);
                if (this.row >= this.buf.lineCount()) {
                    this.row = this.buf.lineCount() - 1;
                }
                this.clampCol();
            }
            public method moveLineUp() returns void {
                if (this.row == 0) {
                    return;
                }
                this.saveUndo();
                String cur = this.buf.line(this.row);
                this.buf.setLine(this.row, this.buf.line(this.row - 1));
                this.buf.setLine(this.row - 1, cur);
                this.row = this.row - 1;
            }
            public method moveLineDown() returns void {
                if (this.row >= this.buf.lineCount() - 1) {
                    return;
                }
                this.saveUndo();
                String cur = this.buf.line(this.row);
                this.buf.setLine(this.row, this.buf.line(this.row + 1));
                this.buf.setLine(this.row + 1, cur);
                this.row = this.row + 1;
            }
            public method indent() returns void {
                this.saveUndo();
                this.buf.setLine(this.row, this.indentUnit() + this.buf.line(this.row));
                this.col = this.col + this.tabWidth;
            }
            public method dedent() returns void {
                String cur = this.buf.line(this.row);
                mutable int remove = 0;
                while (remove < this.tabWidth && remove < cur.length() && cur.charAt(remove) == ' ') {
                    remove = remove + 1;
                }
                if (remove == 0) {
                    return;
                }
                this.saveUndo();
                this.buf.setLine(this.row, cur.substring(remove, cur.length()));
                if (this.col >= remove) {
                    this.col = this.col - remove;
                } else {
                    this.col = 0;
                }
            }

            // Block indent/dedent: shift every line the selection touches by four spaces. The caret and the
            // anchor stay on their lines; their columns are clamped afterward.
            private method selMinRow() returns int {
                if (this.selRow < this.row) {
                    return this.selRow;
                }
                return this.row;
            }
            private method selMaxRow() returns int {
                if (this.selRow > this.row) {
                    return this.selRow;
                }
                return this.row;
            }
            public method indentSelection() returns void {
                this.saveUndo();
                int a = this.selMinRow();
                int b = this.selMaxRow();
                for (mutable int r = a; r <= b; r++) {
                    this.buf.setLine(r, this.indentUnit() + this.buf.line(r));
                }
                this.selCol = this.selCol + this.tabWidth;
                this.col = this.col + this.tabWidth;
            }
            public method dedentSelection() returns void {
                this.saveUndo();
                int a = this.selMinRow();
                int b = this.selMaxRow();
                for (mutable int r = a; r <= b; r++) {
                    String s = this.buf.line(r);
                    mutable int rm = 0;
                    while (rm < this.tabWidth && rm < s.length() && s.charAt(rm) == ' ') {
                        rm = rm + 1;
                    }
                    this.buf.setLine(r, s.substring(rm, s.length()));
                }
                this.clampCaret();
                int selLen = this.buf.line(this.selRow).length();
                if (this.selCol > selLen) {
                    this.selCol = selLen;
                }
            }

            // --- word-wise motion & deletion (Ctrl+Arrows, Ctrl+Backspace / Ctrl+Delete) ---
            private method isWordChar(char c) returns boolean {
                return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
                    || (c >= '0' && c <= '9') || c == '_';
            }
            // Column of the next word boundary to the right on the current line: skip a run of separators,
            // then a run of word chars, landing just past the coming word (or at end of line).
            private method wordRightCol() returns int {
                String s = this.buf.line(this.row);
                int len = s.length();
                mutable int c = this.col;
                while (c < len && !this.isWordChar(s.charAt(c))) {
                    c = c + 1;
                }
                while (c < len && this.isWordChar(s.charAt(c))) {
                    c = c + 1;
                }
                return c;
            }
            // Mirror image: skip separators then word chars to the left, landing at the word's start.
            private method wordLeftCol() returns int {
                String s = this.buf.line(this.row);
                mutable int c = this.col;
                while (c > 0 && !this.isWordChar(s.charAt(c - 1))) {
                    c = c - 1;
                }
                while (c > 0 && this.isWordChar(s.charAt(c - 1))) {
                    c = c - 1;
                }
                return c;
            }
            private method rawWordRight() returns void {
                if (this.col >= this.buf.line(this.row).length()) {
                    this.rawRight();
                    return;
                }
                this.col = this.wordRightCol();
            }
            private method rawWordLeft() returns void {
                if (this.col == 0) {
                    this.rawLeft();
                    return;
                }
                this.col = this.wordLeftCol();
            }
            public method moveWordRight() returns void {
                this.clearSelection();
                this.clearExtraCarets();
                this.rawWordRight();
            }
            public method moveWordLeft() returns void {
                this.clearSelection();
                this.clearExtraCarets();
                this.rawWordLeft();
            }
            public method selectWordRight() returns void {
                this.anchorSelection();
                this.rawWordRight();
            }
            public method selectWordLeft()  returns void {
                this.anchorSelection();
                this.rawWordLeft();
            }

            public method deleteWordLeft() returns void {
                if (this.hasSelection()) {
                    this.saveUndo();
                    this.deleteSelection();
                    return;
                }
                if (this.col == 0) {
                    this.backspace();
                    return;
                }
                // at line start: join upward
                int target = this.wordLeftCol();
                this.saveUndo();
                this.buf.deleteRange(this.row, target, this.row, this.col);
                this.col = target;
            }
            public method deleteWordRight() returns void {
                if (this.hasSelection()) {
                    this.saveUndo();
                    this.deleteSelection();
                    return;
                }
                int len = this.buf.line(this.row).length();
                if (this.col >= len) {                             // at line end: pull the next line up
                    if (this.row < this.buf.lineCount() - 1) {
                        this.saveUndo();
                        this.buf.setLine(this.row, this.buf.line(this.row) + this.buf.line(this.row + 1));
                        this.buf.removeLine(this.row + 1);
                    }
                    return;
                }
                int target = this.wordRightCol();
                this.saveUndo();
                this.buf.deleteRange(this.row, this.col, this.row, target);
            }

            // Select the word under (or immediately before) the caret -- double-click semantics. No-op when
            // the caret is not on a word.
            public method selectWordAtCaret() returns void {
                String s = this.buf.line(this.row);
                int len = s.length();
                mutable int start = this.col;
                mutable int end = this.col;
                while (start > 0 && this.isWordChar(s.charAt(start - 1))) {
                    start = start - 1;
                }
                while (end < len && this.isWordChar(s.charAt(end))) {
                    end = end + 1;
                }
                if (start == end) {
                    return;
                }
                this.selRow = this.row;
                this.selCol = start;
                this.hasSel = true;
                this.col = end;
            }

            // --- line-comment toggle (Ctrl+/): comment the caret line, or every line a selection touches.
            // If every non-blank line in range is already commented, uncomment; otherwise comment. Blank
            // lines are left alone. The marker is "// " inserted at each line's first non-blank column.
            private method firstNonBlank(String s) returns int {
                mutable int i = 0;
                while (i < s.length() && (s.charAt(i) == ' ' || s.charAt(i) == '\t')) {
                    i = i + 1;
                }
                return i;
            }
            private method lineIsCommented(String s) returns boolean {
                int at = this.firstNonBlank(s);
                return at + 1 < s.length() && s.charAt(at) == '/' && s.charAt(at + 1) == '/';
            }
            private method commentLine(int row) returns void {
                String s = this.buf.line(row);
                int at = this.firstNonBlank(s);
                this.buf.setLine(row, s.substring(0, at) + "// " + s.substring(at, s.length()));
            }
            private method uncommentLine(int row) returns void {
                String s = this.buf.line(row);
                int at = this.firstNonBlank(s);
                mutable int rm = at + 2;                       // past the "//"
                if (rm < s.length() && s.charAt(rm) == ' ') {
                    rm = rm + 1;
                }
                // and one space
                this.buf.setLine(row, s.substring(0, at) + s.substring(rm, s.length()));
            }
            public method toggleComment() returns void {
                this.saveUndo();
                mutable int a = this.row;
                mutable int b = this.row;
                if (this.hasSelection()) {
                    a = this.selMinRow();
                    b = this.selMaxRow();
                }
                mutable boolean allCommented = true;
                for (mutable int r = a; r <= b; r++) {
                    String s = this.buf.line(r);
                    if (this.firstNonBlank(s) < s.length() && !this.lineIsCommented(s)) {
                        allCommented = false;
                    }
                }
                for (mutable int r = a; r <= b; r++) {
                    String s = this.buf.line(r);
                    if (this.firstNonBlank(s) >= s.length()) {
                        continue;
                    }
                    // skip blank lines
                    if (allCommented) {
                        this.uncommentLine(r);
                    } else {
                        this.commentLine(r);
                    }
                }
            }

            // --- selection ---
            private method anchorSelection() returns void {
                if (!this.hasSel) {
                    this.selRow = this.row;
                    this.selCol = this.col;
                    this.hasSel = true;
                }
            }
            public method clearSelection() returns void {
                this.hasSel = false;
            }
            public method hasSelection() returns boolean {
                return this.hasSel && !(this.selRow == this.row && this.selCol == this.col);
            }
            private method anchorBeforeCaret() returns boolean {
                if (this.selRow < this.row) {
                    return true;
                }
                if (this.selRow > this.row) {
                    return false;
                }
                return this.selCol <= this.col;
            }
            public method selectionText() returns String {
                if (!this.hasSelection()) {
                    return "";
                }
                if (this.anchorBeforeCaret()) {
                    return this.buf.getRange(this.selRow, this.selCol, this.row, this.col);
                }
                return this.buf.getRange(this.row, this.col, this.selRow, this.selCol);
            }
            // Delete the selection and put the caret at its start. Does NOT snapshot undo -- callers wrap it.
            public method deleteSelection() returns void {
                if (!this.hasSelection()) {
                    this.hasSel = false;
                    return;
                }
                if (this.anchorBeforeCaret()) {
                    this.buf.deleteRange(this.selRow, this.selCol, this.row, this.col);
                    this.row = this.selRow;
                    this.col = this.selCol;
                } else {
                    this.buf.deleteRange(this.row, this.col, this.selRow, this.selCol);
                }
                this.hasSel = false;
            }

            public method cursorRow() returns int {
                return this.row;
            }
            public method cursorCol() returns int {
                return this.col;
            }
            public method document() returns TextBuffer* {
                return this.buf;
            }

            // Place the caret at (row, col), clamped into the document, clearing any selection -- a mouse
            // click lands here.
            public method setCaret(int row, int col) returns void {
                this.clearSelection();
                this.clearExtraCarets();
                mutable int rr = row;
                if (rr < 0) {
                    rr = 0;
                }
                if (rr >= this.buf.lineCount()) {
                    rr = this.buf.lineCount() - 1;
                }
                this.row = rr;
                mutable int cc = col;
                if (cc < 0) {
                    cc = 0;
                }
                int len = this.buf.line(this.row).length();
                if (cc > len) {
                    cc = len;
                }
                this.col = cc;
            }

            // Mouse press: place the caret at (row, col) and anchor a (still-empty) selection there, so a drag
            // can extend from this point.
            public method beginSelect(int row, int col) returns void {
                this.setCaret(row, col);
                this.selRow = this.row;
                this.selCol = this.col;
                this.hasSel = true;
            }
            // Double-click: select the whole word at (row, col).
            public method selectWordAt(int row, int col) returns void {
                this.setCaret(row, col);
                String line = this.buf.line(this.row);
                mutable int start = this.col;
                while (start > 0 && Editor.isWordCh(line.charAt(start - 1))) {
                    start = start - 1;
                }
                mutable int end = this.col;
                while (end < line.length() && Editor.isWordCh(line.charAt(end))) {
                    end = end + 1;
                }
                if (end > start) {
                    this.selRow = this.row;
                    this.selCol = start;
                    this.col = end;
                    this.hasSel = true;
                }
            }
            private static method isWordCh(char ch) returns boolean {
                return (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z')
                    || (ch >= '0' && ch <= '9') || ch == '_';
            }
            // Mouse drag: move the caret to (row, col) while keeping the anchor -> grow/shrink the selection.
            public method extendSelectTo(int row, int col) returns void {
                mutable int rr = row;
                if (rr < 0) {
                    rr = 0;
                }
                if (rr >= this.buf.lineCount()) {
                    rr = this.buf.lineCount() - 1;
                }
                this.row = rr;
                mutable int cc = col;
                if (cc < 0) {
                    cc = 0;
                }
                int len = this.buf.line(this.row).length();
                if (cc > len) {
                    cc = len;
                }
                this.col = cc;
                this.hasSel = true;
            }

            // Ordered selection bounds (start <= end), for rendering. Only meaningful when hasSelection().
            public method selStartRow() returns int {
                if (this.anchorBeforeCaret()) {
                    return this.selRow;
                }
                return this.row;
            }
            public method selStartCol() returns int {
                if (this.anchorBeforeCaret()) {
                    return this.selCol;
                }
                return this.col;
            }
            public method selEndRow() returns int {
                if (this.anchorBeforeCaret()) {
                    return this.row;
                }
                return this.selRow;
            }
            public method selEndCol() returns int {
                if (this.anchorBeforeCaret()) {
                    return this.col;
                }
                return this.selCol;
            }

            // Record the current state before a mutating edit; a fresh edit invalidates the redo history.
            // A multi-caret edit takes one snapshot up front and suppresses the per-sub-edit snapshots so the
            // whole thing is a single undo step.
            private method saveUndo() returns void {
                if (this.suppressUndo) {
                    return;
                }
                this.undoStack.add(new Snapshot(this.buf.text(), this.row, this.col) on heap);
                this.redoStack.clear();
            }

            private method restore(Snapshot* s) returns void {
                this.buf.loadText(s.text);
                this.row = s.row;
                this.col = s.col;
            }

            public method undo() returns boolean {
                if (this.undoStack.size() == 0) {
                    return false;
                }
                this.redoStack.add(new Snapshot(this.buf.text(), this.row, this.col) on heap);
                int last = this.undoStack.size() - 1;
                this.restore(this.undoStack.get(last));
                this.undoStack.removeAt(last);
                return true;
            }

            public method redo() returns boolean {
                if (this.redoStack.size() == 0) {
                    return false;
                }
                this.undoStack.add(new Snapshot(this.buf.text(), this.row, this.col) on heap);
                int last = this.redoStack.size() - 1;
                this.restore(this.redoStack.get(last));
                this.redoStack.removeAt(last);
                return true;
            }

            // --- multi-cursor: secondary carets edited together with the primary (row, col) ---
            public method hasMultipleCarets() returns boolean {
                return this.extraRows.size() > 0;
            }
            public method extraCaretCount() returns int {
                return this.extraRows.size();
            }
            public method extraCaretRow(int i) returns int {
                return this.extraRows.get(i);
            }
            public method extraCaretCol(int i) returns int {
                return this.extraCols.get(i);
            }
            public method clearExtraCarets() returns void {
                this.extraRows = new ArrayList<int>() on heap;
                this.extraCols = new ArrayList<int>() on heap;
            }
            // Add a secondary caret at (row, col), clamped into the document; a no-op if it duplicates a caret.
            public method addCaretAt(int row, int col) returns void {
                mutable int rr = row;
                if (rr < 0) {
                    rr = 0;
                }
                if (rr >= this.buf.lineCount()) {
                    rr = this.buf.lineCount() - 1;
                }
                mutable int cc = col;
                if (cc < 0) {
                    cc = 0;
                }
                int len = this.buf.line(rr).length();
                if (cc > len) {
                    cc = len;
                }
                if (rr == this.row && cc == this.col) {
                    return;
                }
                mutable int i = 0;
                while (i < this.extraRows.size()) {
                    if (this.extraRows.get(i) == rr && this.extraCols.get(i) == cc) {
                        return;
                    }
                    i = i + 1;
                }
                this.extraRows.add(rr);
                this.extraCols.add(cc);
            }
            // Add a caret one line below the bottom-most caret (or above the top-most), at the primary column.
            public method addCaretBelow() returns void {
                mutable int maxRow = this.row;
                mutable int i = 0;
                while (i < this.extraRows.size()) {
                    if (this.extraRows.get(i) > maxRow) {
                        maxRow = this.extraRows.get(i);
                    }
                    i = i + 1;
                }
                if (maxRow + 1 < this.buf.lineCount()) {
                    this.addCaretAt(maxRow + 1, this.col);
                }
            }
            public method addCaretAbove() returns void {
                mutable int minRow = this.row;
                mutable int i = 0;
                while (i < this.extraRows.size()) {
                    if (this.extraRows.get(i) < minRow) {
                        minRow = this.extraRows.get(i);
                    }
                    i = i + 1;
                }
                if (minRow - 1 >= 0) {
                    this.addCaretAt(minRow - 1, this.col);
                }
            }

            // Type / backspace / newline that route through every caret when there are secondaries.
            public method typeMulti(char c) returns void {
                if (this.extraRows.size() == 0) {
                    this.typeWithPairs(c);
                    return;
                }
                this.applyMulti(0, c);
            }
            public method backspaceMulti() returns void {
                if (this.extraRows.size() == 0) {
                    this.backspace();
                    return;
                }
                this.applyMulti(1, ' ');
            }
            public method enterMulti() returns void {
                if (this.extraRows.size() == 0) {
                    this.enter();
                    return;
                }
                this.applyMulti(2, ' ');
            }

            // Apply one edit at every caret as a single undo step. op: 0 = type char, 1 = backspace, 2 = enter.
            // Carets run bottom-to-top so an edit never shifts a caret still to be processed.
            private method applyMulti(int op, char ch) returns void {
                this.saveUndo();
                this.suppressUndo = true;
                ArrayList<int>* rows = new ArrayList<int>() on heap;
                ArrayList<int>* cols = new ArrayList<int>() on heap;
                ArrayList<int>* prim = new ArrayList<int>() on heap;
                rows.add(this.row);
                cols.add(this.col);
                prim.add(1);
                mutable int i = 0;
                while (i < this.extraRows.size()) {
                    rows.add(this.extraRows.get(i));
                    cols.add(this.extraCols.get(i));
                    prim.add(0);
                    i = i + 1;
                }
                // selection sort, descending by (row, col)
                mutable int a = 0;
                while (a < rows.size()) {
                    mutable int best = a;
                    mutable int b = a + 1;
                    while (b < rows.size()) {
                        if (Editor.caretAfter(rows.get(b), cols.get(b), rows.get(best), cols.get(best))) {
                            best = b;
                        }
                        b = b + 1;
                    }
                    if (best != a) {
                        Editor.swapInt(rows, a, best);
                        Editor.swapInt(cols, a, best);
                        Editor.swapInt(prim, a, best);
                    }
                    a = a + 1;
                }
                // apply at each caret, recording the new position
                mutable int k = 0;
                while (k < rows.size()) {
                    this.row = rows.get(k);
                    this.col = cols.get(k);
                    this.hasSel = false;
                    if (op == 0) {
                        this.typeWithPairs(ch);
                    } else if (op == 1) {
                        this.backspace();
                    } else {
                        this.enter();
                    }
                    rows.set(k, this.row);
                    cols.set(k, this.col);
                    k = k + 1;
                }
                // scatter back: the tagged entry is the primary, the rest become secondaries
                this.extraRows = new ArrayList<int>() on heap;
                this.extraCols = new ArrayList<int>() on heap;
                mutable int j = 0;
                while (j < rows.size()) {
                    if (prim.get(j) == 1) {
                        this.row = rows.get(j);
                        this.col = cols.get(j);
                    } else {
                        this.extraRows.add(rows.get(j));
                        this.extraCols.add(cols.get(j));
                    }
                    j = j + 1;
                }
                this.suppressUndo = false;
            }
            private static method caretAfter(int r1, int c1, int r2, int c2) returns boolean {
                if (r1 > r2) {
                    return true;
                }
                if (r1 < r2) {
                    return false;
                }
                return c1 > c2;
            }
            private static method swapInt(ArrayList<int>* xs, int i, int j) returns void {
                int t = xs.get(i);
                xs.set(i, xs.get(j));
                xs.set(j, t);
            }

            public method type(char c) returns void {
                this.saveUndo();
                if (this.hasSelection()) {
                    this.deleteSelection();
                }
                this.buf.insertChar(this.row, this.col, c);
                this.col = this.col + 1;
            }

            // Count of leading whitespace on `s`, not looking past column `upTo` (so a caret inside the
            // indentation doesn't over-count).
            private method leadingIndent(String s, int upTo) returns int {
                mutable int i = 0;
                while (i < s.length() && i < upTo && (s.charAt(i) == ' ' || s.charAt(i) == '\t')) {
                    i = i + 1;
                }
                return i;
            }

            // Enter with auto-indent: the new line inherits the current line's leading whitespace, plus one
            // level (four spaces) when the caret follows an opening brace.
            public method enter() returns void {
                this.saveUndo();
                if (this.hasSelection()) {
                    this.deleteSelection();
                }
                String cur = this.buf.line(this.row);
                int ind = this.leadingIndent(cur, this.col);
                boolean opensBlock = this.col > 0 && cur.charAt(this.col - 1) == '{';
                this.buf.splitLine(this.row, this.col);
                this.row = this.row + 1;
                this.col = 0;
                if (ind > 0) {
                    this.buf.insertText(this.row, 0, cur.substring(0, ind));
                    this.col = ind;
                }
                if (opensBlock) {
                    this.buf.insertText(this.row, this.col, this.indentUnit());
                    this.col = this.col + this.tabWidth;
                }
            }

            // Insert `text` (possibly multi-line) verbatim at the caret -- no auto-indent, unlike enter().
            // This is the path for pasting and bulk loading, so pre-formatted code lands exactly as given.
            public method insertText(String text) returns void {
                this.saveUndo();
                if (this.hasSelection()) {
                    this.deleteSelection();
                }
                int added = this.buf.insertText(this.row, this.col, text);
                if (added == 0) {
                    this.col = this.col + text.length();
                } else {
                    ArrayList<String> parts = Strings.split(text, "\n");
                    this.row = this.row + added;
                    this.col = parts.get(parts.size() - 1).length();
                }
            }

            public method backspace() returns void {
                if (this.hasSelection()) {
                    this.saveUndo();
                    this.deleteSelection();
                    return;
                }
                if (this.col == 0 && this.row == 0) {
                    return;
                }
                this.saveUndo();
                boolean joining = this.col == 0;
                int newCol = this.buf.backspace(this.row, this.col);
                if (joining) {
                    this.row = this.row - 1;
                }
                this.col = newCol;
            }

            // Raw caret moves (no selection side effect). The public moveX clear the selection first; the
            // selectX anchor it and extend -- that's Shift+arrow.
            private method rawLeft() returns void {
                if (this.col > 0) {
                    this.col = this.col - 1;
                }
                else if (this.row > 0) {
                    this.row = this.row - 1;
                    this.col = this.buf.line(this.row).length();
                }
            }
            private method rawRight() returns void {
                if (this.col < this.buf.line(this.row).length()) {
                    this.col = this.col + 1;
                }
                else if (this.row < this.buf.lineCount() - 1) {
                    this.row = this.row + 1;
                    this.col = 0;
                }
            }
            private method rawUp() returns void {
                if (this.row > 0) {
                    this.row = this.row - 1;
                    this.clampCol();
                }
            }
            private method rawDown() returns void {
                if (this.row < this.buf.lineCount() - 1) {
                    this.row = this.row + 1;
                    this.clampCol();
                }
            }
            // Smart Home: first press goes to the first non-blank column, a second press to column 0.
            private method rawLineStart() returns void {
                String s = this.buf.line(this.row);
                mutable int firstNonBlank = 0;
                while (firstNonBlank < s.length()
                       && (s.charAt(firstNonBlank) == ' ' || s.charAt(firstNonBlank) == '\t')) {
                    firstNonBlank = firstNonBlank + 1;
                }
                if (this.col == firstNonBlank) {
                    this.col = 0;
                } else {
                    this.col = firstNonBlank;
                }
            }
            private method rawLineEnd() returns void {
                this.col = this.buf.line(this.row).length();
            }
            private method rawDocStart() returns void {
                this.row = 0;
                this.col = 0;
            }
            private method rawDocEnd() returns void {
                this.row = this.buf.lineCount() - 1;
                this.col = this.buf.line(this.row).length();
            }

            public method moveLeft() returns void {
                this.clearSelection();
                this.clearExtraCarets();
                this.rawLeft();
            }
            public method moveRight() returns void {
                this.clearSelection();
                this.clearExtraCarets();
                this.rawRight();
            }
            public method moveUp() returns void {
                this.clearSelection();
                this.clearExtraCarets();
                this.rawUp();
            }
            public method moveDown() returns void {
                this.clearSelection();
                this.clearExtraCarets();
                this.rawDown();
            }
            public method moveLineStart() returns void {
                this.clearSelection();
                this.clearExtraCarets();
                this.rawLineStart();
            }
            public method moveLineEnd() returns void {
                this.clearSelection();
                this.clearExtraCarets();
                this.rawLineEnd();
            }
            public method moveDocStart() returns void {
                this.clearSelection();
                this.clearExtraCarets();
                this.rawDocStart();
            }
            public method moveDocEnd() returns void {
                this.clearSelection();
                this.clearExtraCarets();
                this.rawDocEnd();
            }

            public method selectLeft()  returns void {
                this.anchorSelection();
                this.rawLeft();
            }
            public method selectRight() returns void {
                this.anchorSelection();
                this.rawRight();
            }
            public method selectUp()    returns void {
                this.anchorSelection();
                this.rawUp();
            }
            public method selectDown()  returns void {
                this.anchorSelection();
                this.rawDown();
            }
            public method selectLineStart() returns void {
                this.anchorSelection();
                this.rawLineStart();
            }
            public method selectLineEnd()   returns void {
                this.anchorSelection();
                this.rawLineEnd();
            }
            public method selectDocStart()  returns void {
                this.anchorSelection();
                this.rawDocStart();
            }
            public method selectDocEnd()    returns void {
                this.anchorSelection();
                this.rawDocEnd();
            }
            public method selectAll() returns void {
                this.selRow = 0;
                this.selCol = 0;
                this.hasSel = true;
                this.rawDocEnd();
            }

            // Delete the character to the right of the caret (the Delete key); at a line end, pull the next
            // line up. With a selection, delete that instead.
            public method deleteForward() returns void {
                if (this.hasSelection()) {
                    this.saveUndo();
                    this.deleteSelection();
                    return;
                }
                int len = this.buf.line(this.row).length();
                if (this.col < len) {
                    this.saveUndo();
                    this.buf.deleteRange(this.row, this.col, this.row, this.col + 1);
                } else if (this.row < this.buf.lineCount() - 1) {
                    this.saveUndo();
                    this.buf.setLine(this.row, this.buf.line(this.row) + this.buf.line(this.row + 1));
                    this.buf.removeLine(this.row + 1);
                }
            }

            private method clampCol() returns void {
                int len = this.buf.line(this.row).length();
                if (this.col > len) {
                    this.col = len;
                }
            }

            // Clamp both coordinates back into the buffer after a bulk edit (e.g. replaceAll).
            private method clampCaret() returns void {
                if (this.row >= this.buf.lineCount()) {
                    this.row = this.buf.lineCount() - 1;
                }
                if (this.row < 0) {
                    this.row = 0;
                }
                this.clampCol();
            }
        }
    }
}
