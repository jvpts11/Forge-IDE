import System.Collections.ArrayList;
import System.Text.Strings;
import System.Text.StringBuilder;

program Forge;

public bundle forge {
    public namespace editor {

        // The text of one open document, addressed by (row, col), 0-based. `col` is the number of
        // characters to the left of the caret, so it ranges 0..line.length(). One String per line; an
        // empty document is a single empty line, never zero lines.
        public class TextBuffer {
            private mutable ArrayList<String> lines;

            public constructor TextBuffer() {
                this.lines = new ArrayList<String>() on heap;
                this.lines.add("");
            }

            public method lineCount() returns int { return this.lines.size(); }
            public method line(int row) returns String { return this.lines.get(row); }

            // Whole-line helpers for line operations (duplicate / delete / move / indent).
            public method setLine(int row, String text) returns void { this.lines.set(row, text); }
            public method insertLine(int row, String text) returns void { this.lines.insertAt(row, text); }
            public method removeLine(int row) returns void {
                this.lines.removeAt(row);
                if (this.lines.size() == 0) { this.lines.add(""); }   // never zero lines
            }

            // Replace the whole document with `text`, split on newlines. Empty input is one empty line.
            public method loadText(String text) returns void {
                this.lines = Strings.split(text, "\n");
                if (this.lines.size() == 0) { this.lines.add(""); }
            }

            // Serialize the document back to a single String with '\n' between lines.
            public method text() returns String { return Strings.join(this.lines, "\n"); }

            // Insert character `c` at (row, col): everything from col on shifts right.
            public method insertChar(int row, int col, char c) returns void {
                String cur = this.lines.get(row);
                StringBuilder sb = new StringBuilder() on heap;
                sb.append(cur.substring(0, col));
                sb.appendChar(c);
                sb.append(cur.substring(col, cur.length()));
                this.lines.set(row, sb.toString());
            }

            // Split the line at (row, col) -- the Enter key: the text at and after col becomes a new line.
            public method splitLine(int row, int col) returns void {
                String cur = this.lines.get(row);
                this.lines.set(row, cur.substring(0, col));
                this.lines.insertAt(row + 1, cur.substring(col, cur.length()));
            }

            // The text of the range (r1,c1)..(r2,c2), ordered so (r1,c1) <= (r2,c2). Multi-line ranges keep
            // the '\n' between lines.
            public method getRange(int r1, int c1, int r2, int c2) returns String {
                if (r1 == r2) { return this.lines.get(r1).substring(c1, c2); }
                StringBuilder sb = new StringBuilder() on heap;
                String first = this.lines.get(r1);
                sb.append(first.substring(c1, first.length()));
                sb.appendChar('\n');
                for (mutable int r = r1 + 1; r < r2; r++) {
                    sb.append(this.lines.get(r));
                    sb.appendChar('\n');
                }
                sb.append(this.lines.get(r2).substring(0, c2));
                return sb.toString();
            }

            // Delete the range (r1,c1)..(r2,c2), ordered. The caret belongs at (r1,c1) afterward.
            public method deleteRange(int r1, int c1, int r2, int c2) returns void {
                if (r1 == r2) {
                    String cur = this.lines.get(r1);
                    this.lines.set(r1, cur.substring(0, c1) + cur.substring(c2, cur.length()));
                    return;
                }
                String head = this.lines.get(r1).substring(0, c1);
                String last = this.lines.get(r2);
                String tail = last.substring(c2, last.length());
                this.lines.set(r1, head + tail);
                for (mutable int k = r2; k > r1; k--) { this.lines.removeAt(k); }
            }

            // Insert `text` (possibly multi-line) at (row, col). Returns the row count added (0 for a
            // single-line insert), so the caller can place the caret; its new column is the last inserted
            // segment's length (single-line: col + text.length()).
            public method insertText(int row, int col, String text) returns int {
                ArrayList<String> parts = Strings.split(text, "\n");
                String cur = this.lines.get(row);
                String tail = cur.substring(col, cur.length());
                if (parts.size() == 1) {
                    this.lines.set(row, cur.substring(0, col) + parts.get(0) + tail);
                    return 0;
                }
                this.lines.set(row, cur.substring(0, col) + parts.get(0));
                for (mutable int k = 1; k < parts.size(); k++) {
                    this.lines.insertAt(row + k, parts.get(k));
                }
                int lastRow = row + parts.size() - 1;
                this.lines.set(lastRow, this.lines.get(lastRow) + tail);
                return parts.size() - 1;
            }

            // Backspace at (row, col): within a line (col > 0) delete the char to the left; at a line start
            // (col == 0, row > 0) join this line onto the previous one. Returns the caret's new column.
            public method backspace(int row, int col) returns int {
                if (col > 0) {
                    String cur = this.lines.get(row);
                    StringBuilder sb = new StringBuilder() on heap;
                    sb.append(cur.substring(0, col - 1));
                    sb.append(cur.substring(col, cur.length()));
                    this.lines.set(row, sb.toString());
                    return col - 1;
                }
                if (row > 0) {
                    String prev = this.lines.get(row - 1);
                    int joinCol = prev.length();
                    this.lines.set(row - 1, prev + this.lines.get(row));
                    this.lines.removeAt(row);
                    return joinCol;
                }
                return 0;
            }
        }
    }
}
