import System.IO.File;
import System.IO.Files;
import System.IO.Paths;
import System.OS.Env;
import System.OS.Process;
import System.OS.ProcessResult;
import System.Text.Strings;
import System.Text.StringBuilder;
import System.Collections.ArrayList;

program Forge;

public bundle forge {
    public namespace io {

        // One installed plugin: its directory, what the manifest says, and whether it is enabled.
        public class Plugin {
            public mutable String name;         // directory name; the identity used everywhere
            public mutable String title;        // human name from the manifest (falls back to `name`)
            public mutable String description;
            public mutable String version;
            public mutable String dir;
            public mutable boolean enabled;
            public constructor Plugin(String name, String dir) {
                this.name = name;
                this.dir = dir;
                this.title = name;
                this.description = "";
                this.version = "";
                this.enabled = true;
            }
        }

        // One command a plugin contributes: an id, a title for the palette, and the shell command it
        // runs. Plugins extend Forge by running processes, not by loading code into it.
        public class PluginCommand {
            public mutable String id;
            public mutable String title;
            public mutable String run;
            public constructor PluginCommand(String id, String title, String run) {
                this.id = id;
                this.title = title;
                this.run = run;
            }
        }

        // Installed plugins, under ~/.forge/plugins/<name>/.
        //
        // WHAT A PLUGIN IS (and why): Forge cannot load LDP3 code at runtime, so a plugin is a manifest
        // plus declarative resources and commands that run external processes. That covers the cases
        // that matter -- themes, snippets, and tools driven through Forge's own serve protocol (which is
        // how the MCP server ships as a plugin) -- without pretending to an extension API that does not
        // exist. Anything needing in-process code would need unimport/reimport, a much larger step.
        //
        // Layout:
        //   plugin.txt            manifest: `key = value` (title, version, description)
        //   themes/*.theme        installed alongside the user's own themes
        //   commands.txt          one `id | title | shell command` per line
        //
        // Install is `git clone <url>` into that directory, so any GitHub repository following the
        // layout is installable and `git pull` updates it.
        public class PluginStore {

            public static method pluginsDir() returns String {
                return Env.get("USERPROFILE") + "/.forge/plugins";
            }
            public static method ensurePluginsDir() returns void {
                String d = PluginStore.pluginsDir();
                if (!File.isDir(d)) {
                    File.mkdir(d);
                }
                return;
            }
            // Disabled plugins are listed here, one name per line, so disabling never deletes anything.
            private static method disabledFile() returns String {
                return Env.get("USERPROFILE") + "/.forge/plugins-disabled.txt";
            }

            public static method installed() returns ArrayList<Plugin*>* {
                ArrayList<Plugin*>* out = new ArrayList<Plugin*>() on heap;
                String root = PluginStore.pluginsDir();
                if (!File.isDir(root)) {
                    return out;
                }
                ArrayList<String> disabled = PluginStore.disabledNames();
                // listDir yields bare names, not paths, so every entry is joined to its directory
                // before being tested or stored -- isDir() on a bare name is always false.
                ArrayList<String> entries = Files.listDir(root);
                mutable int i = 0;
                while (i < entries.size()) {
                    String base = Paths.basename(entries.get(i));
                    i = i + 1;
                    String full = root + "/" + base;
                    if (base.startsWith(".") || !File.isDir(full)) {
                        continue;
                    }
                    Plugin* p = new Plugin(base, full) on heap;
                    PluginStore.readManifest(p);
                    mutable int d = 0;
                    while (d < disabled.size()) {
                        if (disabled.get(d).equals(base)) {
                            p.enabled = false;
                        }
                        d = d + 1;
                    }
                    out.add(p);
                }
                return out;
            }

            private static method disabledNames() returns ArrayList<String> {
                String path = PluginStore.disabledFile();
                if (!File.exists(path)) {
                    return new ArrayList<String>();
                }
                return Strings.split(File.readAll(path), "\n");
            }

            // Fill in title/version/description from plugin.txt. A plugin with no manifest still works;
            // it just shows its directory name.
            private static method readManifest(Plugin* p) returns void {
                String path = p.dir + "/plugin.txt";
                if (!File.exists(path)) {
                    return;
                }
                ArrayList<String> lines = Strings.split(File.readAll(path), "\n");
                mutable int i = 0;
                while (i < lines.size()) {
                    String ln = lines.get(i).trim();
                    i = i + 1;
                    if (ln.length() == 0 || ln.charAt(0) == '#') {
                        continue;
                    }
                    int eq = ln.indexOf("=");
                    if (eq < 0) {
                        continue;
                    }
                    String k = ln.substring(0, eq).trim();
                    String v = ln.substring(eq + 1, ln.length()).trim();
                    if (k.equals("title")) {
                        p.title = v;
                    } else if (k.equals("version")) {
                        p.version = v;
                    } else if (k.equals("description")) {
                        p.description = v;
                    }
                }
                return;
            }

            // Every command contributed by an enabled plugin. Ids are prefixed with the plugin name so
            // two plugins cannot collide, and so it is obvious in the palette where a command came from.
            public static method commands() returns ArrayList<PluginCommand*>* {
                ArrayList<PluginCommand*>* out = new ArrayList<PluginCommand*>() on heap;
                ArrayList<Plugin*>* plugins = PluginStore.installed();
                mutable int i = 0;
                while (i < plugins.size()) {
                    Plugin* p = plugins.get(i);
                    i = i + 1;
                    if (!p.enabled) {
                        continue;
                    }
                    String path = p.dir + "/commands.txt";
                    if (!File.exists(path)) {
                        continue;
                    }
                    ArrayList<String> lines = Strings.split(File.readAll(path), "\n");
                    mutable int k = 0;
                    while (k < lines.size()) {
                        String ln = lines.get(k).trim();
                        k = k + 1;
                        if (ln.length() == 0 || ln.charAt(0) == '#') {
                            continue;
                        }
                        ArrayList<String> parts = Strings.split(ln, "|");
                        if (parts.size() < 3) {
                            continue;
                        }
                        out.add(new PluginCommand("plugin." + p.name + "." + parts.get(0).trim(),
                                                  parts.get(1).trim() + "  (" + p.title + ")",
                                                  parts.get(2).trim()) on heap);
                    }
                }
                mutable int f = 0;
                while (f < plugins.size()) {
                    delete plugins.get(f);
                    f = f + 1;
                }
                delete plugins;
                return out;
            }

            // Theme files contributed by enabled plugins, as full paths.
            public static method themeFiles() returns ArrayList<String>* {
                ArrayList<String>* out = new ArrayList<String>() on heap;
                ArrayList<Plugin*>* plugins = PluginStore.installed();
                mutable int i = 0;
                while (i < plugins.size()) {
                    Plugin* p = plugins.get(i);
                    i = i + 1;
                    if (!p.enabled) {
                        continue;
                    }
                    String dir = p.dir + "/themes";
                    if (!File.isDir(dir)) {
                        continue;
                    }
                    ArrayList<String> entries = Files.listDir(dir);
                    mutable int k = 0;
                    while (k < entries.size()) {
                        String e = Paths.basename(entries.get(k));
                        k = k + 1;
                        if (e.endsWith(".theme")) {
                            out.add(dir + "/" + e);      // full path: listDir gives names only
                        }
                    }
                }
                mutable int f = 0;
                while (f < plugins.size()) {
                    delete plugins.get(f);
                    f = f + 1;
                }
                delete plugins;
                return out;
            }

            // Install by cloning. `source` is a GitHub URL, or `owner/repo` as a shorthand. Returns the
            // git output so the caller can show what happened -- a clone can fail for a dozen reasons
            // (no network, bad URL, already installed) and swallowing that is worse than showing it.
            public static method install(String source) returns String {
                PluginStore.ensurePluginsDir();
                mutable String url = source.trim();
                if (url.length() == 0) {
                    return "no repository given";
                }
                if (!url.startsWith("http") && !url.startsWith("git@")) {
                    url = "https://github.com/" + url;          // owner/repo shorthand
                }
                String name = PluginStore.nameFromUrl(url);
                if (name.length() == 0) {
                    return "could not work out a plugin name from: " + url;
                }
                String dest = PluginStore.pluginsDir() + "/" + name;
                if (File.isDir(dest)) {
                    return "already installed: " + name + " (use Plugins: Update)";
                }
                ProcessResult r = Process.run("git clone --depth 1 \"" + url + "\" \"" + dest + "\" 2>&1");
                if (!File.isDir(dest)) {
                    return "install failed: " + r.output.trim();
                }
                return "installed " + name;
            }

            // `git pull` in an installed plugin.
            public static method update(String name) returns String {
                String dir = PluginStore.pluginsDir() + "/" + name;
                if (!File.isDir(dir)) {
                    return "not installed: " + name;
                }
                ProcessResult r = Process.run("git -C \"" + dir + "\" pull --ff-only 2>&1");
                return r.output.trim();
            }

            // Flip a plugin between enabled and disabled. Disabling only records the name, so nothing is
            // lost and re-enabling needs no network.
            public static method setEnabled(String name, boolean enable) returns void {
                ArrayList<String> current = PluginStore.disabledNames();
                StringBuilder sb = new StringBuilder() on heap;
                mutable int i = 0;
                while (i < current.size()) {
                    String n = current.get(i).trim();
                    i = i + 1;
                    if (n.length() == 0 || n.equals(name)) {
                        continue;                      // drop blanks and the one being changed
                    }
                    sb.append(n + "\n");
                }
                if (!enable) {
                    sb.append(name + "\n");
                }
                File.writeAll(PluginStore.disabledFile(), sb.toString());
                delete sb;
                return;
            }

            // The last path segment of a clone URL, minus a trailing ".git".
            public static method nameFromUrl(String url) returns String {
                mutable String u = url.trim();
                while (u.length() > 0 && u.charAt(u.length() - 1) == '/') {
                    u = u.substring(0, u.length() - 1);
                }
                mutable int cut = 0 - 1;
                mutable int i = 0;
                while (i < u.length()) {
                    char c = u.charAt(i);
                    if (c == '/' || c == ':') {
                        cut = i;
                    }
                    i = i + 1;
                }
                mutable String last = u;
                if (cut >= 0) {
                    last = u.substring(cut + 1, u.length());
                }
                if (last.endsWith(".git")) {
                    last = last.substring(0, last.length() - 4);
                }
                return last;
            }
        }
    }
}
