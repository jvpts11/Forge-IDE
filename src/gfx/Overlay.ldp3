import System.Text.StringBuilder;
import System.Collections.ArrayList;

program Forge;

public bundle forge {
    public namespace gfx {

        // A modal input overlay: the command palette, the find bar, or the symbol navigator. While it is open,
        // keystrokes edit its query string instead of the document; Enter runs it, Esc closes it. The app owns
        // one and routes input to it when isOpen(). Kept tiny -- the drawing lives in GpuScreen, the actions in
        // GuiApp. Mode 3 (go-to-symbol) carries a label list and a parallel target-line list.
        public class Overlay {
            public mutable int mode;    // 0 = none, 1 = command palette, 2 = find/replace, 3 = go-to-symbol
            public mutable String query;
            public mutable int sel;     // highlighted result (palette / symbol)
            public mutable ArrayList<String>* items;    // symbol labels (mode 3)
            public mutable ArrayList<int>* targets;     // 1-based target line per item (mode 3)
            public mutable ArrayList<String>* itemFiles;  // per-item file to open first (workspace symbols)
            public mutable String replace;         // replacement text (mode 2)
            public mutable boolean focusReplace;   // in mode 2, whether typing edits the replace field
            public mutable String promptKind;      // mode 7: what Enter does (e.g. "commit")
            public mutable String promptLabel;     // mode 7: the prompt shown before the input
            public mutable boolean matchCase;      // mode 2: case-sensitive find (sticky across opens)
            public mutable boolean wholeWord;      // mode 2: match whole words only
            public mutable boolean useRegex;       // mode 2: treat the query as a regex

            public constructor Overlay() {
                this.mode = 0;
                this.query = "";
                this.sel = 0;
                this.items = new ArrayList<String>() on heap;
                this.targets = new ArrayList<int>() on heap;
                this.itemFiles = new ArrayList<String>() on heap;
                this.replace = "";
                this.focusReplace = false;
                this.promptKind = "";
                this.promptLabel = "";
                this.matchCase = true;
                this.wholeWord = false;
                this.useRegex = false;
            }

            // Find-bar option toggles (mode 2). Sticky, so a chosen mode holds across find sessions.
            public method toggleCase() returns void {
                this.matchCase = !this.matchCase;
            }
            public method toggleWholeWord() returns void {
                this.wholeWord = !this.wholeWord;
            }
            public method toggleRegex() returns void {
                this.useRegex = !this.useRegex;
            }

            // Open a single-line text prompt (mode 7). `kind` names the action Enter triggers; `label` is the
            // hint shown before the input (e.g. "commit message: ").
            public method openPrompt(String kind, String hint) returns void {
                this.mode = 7;
                this.query = "";
                this.sel = 0;
                this.promptKind = kind;
                this.promptLabel = hint;
            }

            // Open the About card (mode 8): a static, centered info panel. It takes no input -- any key or a
            // click dismisses it -- so it just borrows the overlay's modal backdrop and focus capture.
            public method openAbout() returns void {
                this.mode = 8;
                this.query = "";
                this.sel = 0;
            }

            public method isOpen() returns boolean {
                return this.mode != 0;
            }
            public method open(int m) returns void {
                this.mode = m; this.query = ""; this.sel = 0;
                this.replace = ""; this.focusReplace = false;
            }
            public method close() returns void {
                this.mode = 0;
            }
            // Mode 2: Tab moves focus between the find and replace fields.
            public method toggleField() returns void {
                this.focusReplace = !this.focusReplace;
            }

            // Open the symbol navigator over a prepared label/line list (current file; no per-item file).
            public method openSymbols(ArrayList<String>* labels, ArrayList<int>* lines) returns void {
                this.mode = 3;
                this.query = "";
                this.sel = 0;
                this.items = labels;
                this.targets = lines;
                this.itemFiles = new ArrayList<String>() on heap;
            }
            // Open the workspace symbol navigator: each item also carries the file to open before jumping.
            public method openWorkspaceSymbols(ArrayList<String>* labels, ArrayList<int>* lines,
                                               ArrayList<String>* files) returns void {
                this.mode = 3;
                this.query = "";
                this.sel = 0;
                this.items = labels;
                this.targets = lines;
                this.itemFiles = files;
            }
            // Open the quick-file picker over a list of file paths (mode 4). items holds the full paths.
            public method openFiles(ArrayList<String>* paths) returns void {
                this.mode = 4;
                this.query = "";
                this.sel = 0;
                this.items = paths;
            }
            // Open the find-in-files box (mode 6): items carries the project file list to grep on Enter.
            public method openSearch(ArrayList<String>* paths) returns void {
                this.mode = 6;
                this.query = "";
                this.sel = 0;
                this.items = paths;
            }

            // Indices of items whose label contains the query (case-insensitive), in order. When the query is
            // empty, every item matches.
            public method matches() returns ArrayList<int>* {
                ArrayList<int>* out = new ArrayList<int>() on heap;
                String q = Overlay.lower(this.query);
                mutable int i = 0;
                while (i < this.items.size()) {
                    if (q.length() == 0 || Overlay.lower(this.items.get(i)).indexOf(q) >= 0) {
                        out.add(i);
                    }
                    i = i + 1;
                }
                return out;
            }

            private static method lower(String s) returns String {
                StringBuilder sb = new StringBuilder() on heap;
                mutable int i = 0;
                while (i < s.length()) {
                    mutable char c = s.charAt(i);
                    if (c >= 'A' && c <= 'Z') {
                        c = cast<char>(cast<int>(c) + 32);
                    }
                    sb.appendChar(c);
                    i = i + 1;
                }
                return sb.toString();
            }

            public method typeChar(char c) returns void {
                StringBuilder sb = new StringBuilder() on heap;
                if (this.focusReplace) {
                    sb.append(this.replace);
                    sb.appendChar(c);
                    this.replace = sb.toString();
                    return;
                }
                sb.append(this.query);
                sb.appendChar(c);
                this.query = sb.toString();
                this.sel = 0;
            }
            public method backspace() returns void {
                if (this.focusReplace) {
                    if (this.replace.length() > 0) {
                        this.replace = this.replace.substring(0, this.replace.length() - 1);
                    }
                    return;
                }
                if (this.query.length() > 0) {
                    this.query = this.query.substring(0, this.query.length() - 1);
                    this.sel = 0;
                }
            }
            public method moveSel(int delta) returns void {
                mutable int s = this.sel + delta;
                if (s < 0) {
                    s = 0;
                }
                this.sel = s;
            }
        }
    }
}
