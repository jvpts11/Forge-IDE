program Forge;

public bundle forge {
    public namespace gfx {

        // Draws the whole IDE frame on the GPU -- the graphical counterpart of ScreenRenderer. It composes a
        // tab bar, a project tree panel, and the editor pane (gutter + line numbers + token-coloured code +
        // current-line highlight + selection + caret), all from live Workbench + FileTree state through
        // Batch2D quads. It owns no model state; the caller passes the Workbench each frame.
        public class GpuScreen {
            private mutable Font* font;
            private mutable int gutterChars;
            private mutable int topPad;
            private mutable int treeW;
            private mutable boolean caretOn;   // caret visibility for blink (the live loop toggles it)
            private mutable Theme* theme;      // the whole colour palette; swap to re-skin the IDE
            private mutable Highlighter* hl;   // tokenises peek-popup lines (from files that aren't open)

            public constructor GpuScreen(Font* font) {
                this.font = font;
                this.gutterChars = 6;
                this.topPad = 6;
                this.treeW = 230;
                this.caretOn = true;
                this.theme = Theme.makeDark();
                this.hl = new Highlighter() on heap;
            }

            public method colors() returns Theme* {
                return this.theme;
            }
            public method setTheme(Theme* t) returns void {
                this.theme = t;
            }
            // Sync the palette to the workbench's theme preference. Cheap: only rebuilds the Theme when the
            // light/dark choice actually changed, so it is safe to call every frame.
            public method applyThemeFor(Workbench* wb) returns void {
                boolean isLight = !this.theme.dark;
                if (wb.wantsLight() != isLight) {
                    if (wb.wantsLight()) {
                        this.theme = Theme.makeLight();
                    } else {
                        this.theme = Theme.makeDark();
                    }
                }
            }

            // The live loop toggles this to blink the caret; shot/serve leave it on so the caret always shows.
            public method setCaretOn(boolean visible) returns void {
                this.caretOn = visible;
            }

            public method fontTexture() returns int {
                return this.font.texture();
            }
            // Swap the glyph atlas -- used by zoom to change the font size.
            public method setFont(Font* f) returns void {
                this.font = f;
            }
            public method gutterPx() returns int {
                return this.gutterChars * this.font.advance() + 16;
            }
            public method menuH() returns int {
                return this.font.lineHeight() + 8;
            }
            public method tabH() returns int {
                return this.font.lineHeight() + 12;
            }
            public method crumbH() returns int {
                return this.font.lineHeight() + 6;
            }
            public method statusH() returns int {
                return this.font.lineHeight() + 8;
            }
            // Pixel y where the tab bar / tree / breadcrumb bar begin, below the menu bar.
            public method contentTop() returns int {
                return this.menuH() + this.tabH();
            }
            // Pixel y where the editor code begins, below the breadcrumb bar.
            public method editorTop() returns int {
                return this.contentTop() + this.crumbH();
            }
            public method treeWidth() returns int {
                return this.treeW;
            }
            public method charW() returns int {
                return this.font.advance();
            }
            public method lineH() returns int {
                return this.font.lineHeight();
            }
            // Pixel origin of the code text (for mouse hit-testing).
            public method textOx() returns int {
                return this.treeW + this.gutterPx() + 6;
            }
            public method textOy() returns int {
                return this.editorTop() + this.topPad;
            }
            // Which tab index is under pixel x in the tab bar (-1 if none) -- mirrors drawTabBar's layout.
            public method tabAtX(DocumentManager* docs, int mx) returns int {
                int cw = this.font.advance();
                mutable int x = 6;
                mutable int i = 0;
                while (i < docs.count()) {
                    int tw = (docs.title(i).length() + 4) * cw;
                    if (mx >= x && mx < x + tw) {
                        return i;
                    }
                    x = x + tw;
                    i = i + 1;
                }
                return 0 - 1;
            }
            // Which tab's close (x) control is under pixel x (-1 if none) -- mirrors drawTabBar's layout.
            public method tabCloseAtX(DocumentManager* docs, int mx) returns int {
                int cw = this.font.advance();
                mutable int x = 6;
                mutable int i = 0;
                while (i < docs.count()) {
                    int tw = (docs.title(i).length() + 4) * cw;
                    int xx = x + tw - 2 * cw;
                    if (mx >= xx && mx < xx + 2 * cw) {
                        return i;
                    }
                    x = x + tw;
                    i = i + 1;
                }
                return 0 - 1;
            }
            // Which tree row is under pixel y (may be out of range; the caller checks against visible()).
            public method treeRowAtY(int my) returns int {
                return (my - (this.contentTop() + 6)) / this.font.lineHeight();
            }
            // Viewport rows/cols that fit the editor pane of a pixel window (window minus chrome).
            public method paneRowsFor(int screenH) returns int {
                return (screenH - this.editorTop() - this.statusH() - this.topPad) / this.font.lineHeight();
            }
            public method paneColsFor(int screenW) returns int {
                return (screenW - this.treeW - this.gutterPx() - 8) / this.font.advance();
            }

            // Compose the full IDE frame.
            public method drawWorkbench(Batch2D* batch, Workbench* wb, FileTree* tree, Overlay* ov,
                                        int mx, int my, int screenW, int screenH) returns void {
                int mh = this.menuH();
                int tabh = this.tabH();
                int ctop = mh + tabh;
                int etop = ctop + this.crumbH();
                int tw = this.treeW;
                // chrome panel backgrounds
                batch.rect(0, mh, screenW, tabh, this.theme.chrome.r, this.theme.chrome.g, this.theme.chrome.b, this.theme.chrome.a);             // tab bar
                batch.rect(0, ctop, tw, screenH - ctop, this.theme.panel.r, this.theme.panel.g, this.theme.panel.b, this.theme.panel.a);      // tree panel
                batch.rect(tw, ctop, 1, screenH - ctop, this.theme.divider.r, this.theme.divider.g, this.theme.divider.b, this.theme.divider.a);      // tree/editor divider
                int sh = this.statusH();
                boolean termOpen = wb.terminal().isOpen();
                mutable int panelH = 0;
                if (termOpen) {
                    panelH = this.terminalPanelHeight(screenH);
                } else {
                    panelH = this.outputPanelHeight(wb.output(), screenH);
                }
                int ow = this.outlineWidth(wb);
                this.drawTabBar(batch, wb.documents(), mh, tabh, mx, my);
                this.drawTree(batch, tree, ctop, screenH - sh, mx, my);
                this.drawBreadcrumbs(batch, wb, tw, ctop, screenW - tw - ow);
                this.drawEditor(batch, wb, ov, mx, my, tw, etop, screenW - tw - ow,
                                screenH - etop - sh - panelH);
                if (ow > 0) {
                    this.drawOutline(batch, wb, screenW - ow, ctop, ow, screenH - ctop - sh, mx, my);
                }
                if (wb.diffView().isActive()) {
                    this.drawDiff(batch, wb, tw, etop, screenW - tw, screenH - etop - sh);
                }
                if (wb.peekView().isActive()) {
                    this.drawPeek(batch, wb, tw, etop, screenW - tw, screenH - etop - sh - panelH);
                }
                if (termOpen) {
                    this.drawTerminal(batch, wb.terminal(), tw, screenH - sh - panelH, screenW - tw, panelH);
                } else if (panelH > 0) {
                    this.drawOutputPanel(batch, wb.output(), tw, screenH - sh - panelH, screenW - tw, panelH, mx, my);
                }
                if (wb.debugger().isActive()) {
                    this.drawDebugPanel(batch, wb.debugger(), screenW, screenH);
                }
                this.drawStatusBar(batch, wb, screenW, screenH, sh);
            }

            // --- structure panel (Ctrl+F12): the file's declarations, in order, caret-aware ---
            public method outlineWidth(Workbench* wb) returns int {
                if (!wb.outlineOpen()) {
                    return 0;
                }
                return 260;
            }
            public method outlineTop() returns int {
                return this.menuH() + this.tabH() + 6 + this.font.lineHeight();   // below the caption
            }
            // Which outline row is under pixel y (-1 = none). Mirrors drawOutline's layout exactly.
            public method outlineRowAt(int my) returns int {
                int ch = this.font.lineHeight();
                if (my < this.outlineTop()) {
                    return 0 - 1;
                }
                return (my - this.outlineTop()) / ch;
            }
            private method drawOutline(Batch2D* batch, Workbench* wb, int ox, int oy, int w, int h,
                                       int mx, int my) returns void {
                batch.rect(ox, oy, w, h, this.theme.panel.r, this.theme.panel.g, this.theme.panel.b,
                           this.theme.panel.a);
                batch.rect(ox, oy, 1, h, this.theme.divider.r, this.theme.divider.g, this.theme.divider.b,
                           this.theme.divider.a);
                int ch = this.font.lineHeight();
                this.font.drawText(batch, ox + 10, oy + 4, "STRUCTURE", this.theme.textDim.r,
                                   this.theme.textDim.g, this.theme.textDim.b, this.theme.textDim.a);
                ArrayList<Symbol>* syms = wb.outlineSymbols();
                int current = wb.outlineCurrent();
                mutable int i = 0;
                mutable int y = this.outlineTop();
                while (i < syms.size() && y + ch <= oy + h) {
                    String caption = syms.get(i).caption;
                    boolean hover = mx >= ox && mx < ox + w && my >= y && my < y + ch;
                    if (i == current) {
                        batch.rect(ox + 1, y, w - 1, ch, this.theme.selection.r, this.theme.selection.g,
                                   this.theme.selection.b, this.theme.selection.a);
                    } else if (hover) {
                        batch.rect(ox + 1, y, w - 1, ch, this.theme.hover.r, this.theme.hover.g,
                                   this.theme.hover.b, this.theme.hover.a);
                    }
                    // A method sits inside a type, which sits inside a namespace: indent by kind, so the
                    // shape of the file is visible at a glance rather than spelled out.
                    mutable int indent = 0;
                    if (GpuScreen.outlineIsMember(caption)) {
                        indent = 16;
                    }
                    this.font.drawText(batch, ox + 10 + indent, y, caption, this.theme.text.r,
                                       this.theme.text.g, this.theme.text.b, this.theme.text.a);
                    y = y + ch;
                    i = i + 1;
                }
                delete syms;
                return;
            }
            // A member (method/constructor/destructor) as opposed to a container (namespace/class/...).
            private static method outlineIsMember(String caption) returns boolean {
                return caption.startsWith("method") || caption.startsWith("constructor")
                       || caption.startsWith("destructor");
            }

            // Layout of the debug side panel, shared by drawing and click hit-testing.
            public method debugPanelWidth() returns int {
                return 320;
            }
            public method debugPanelX(int screenW) returns int {
                return screenW - this.debugPanelWidth();
            }
            // Screen y of the first call-stack row (below the "DEBUG --" header and the "CALL STACK" label).
            public method debugStackTop() returns int {
                return this.menuH() + this.tabH() + this.crumbH() + 16 + 2 * this.font.lineHeight();
            }
            // The call-stack frame index at a click, or -1 if the click isn't on a frame -- so clicking a
            // frame can jump the editor to its source line.
            public method debugFrameAt(int mx, int my, int screenW, Debugger* dbg) returns int {
                if (!dbg.isActive() || mx < this.debugPanelX(screenW)) {
                    return -1;
                }
                int ch = this.font.lineHeight();
                int top = this.debugStackTop();
                mutable int n = dbg.callStackView().size();
                if (n > 12) {
                    n = 12;
                }
                if (my < top || my >= top + n * ch) {
                    return -1;
                }
                return (my - top) / ch;
            }

            // The debug side panel (shown only during a session): the status, the call stack and the current
            // frame's local variables, updated as the adapter reports stopped/stackTrace/variables.
            private method drawDebugPanel(Batch2D* batch, Debugger* dbg, int screenW, int screenH) returns void {
                int cw = this.font.advance();
                int ch = this.font.lineHeight();
                int pw = this.debugPanelWidth();
                int px = this.debugPanelX(screenW);
                int py = this.menuH() + this.tabH() + this.crumbH();
                int ph = screenH - py - this.statusH();
                batch.rect(px, py, pw, ph, this.theme.panel.r, this.theme.panel.g, this.theme.panel.b, 0.97);
                batch.rect(px, py, 1, ph, this.theme.divider.r, this.theme.divider.g, this.theme.divider.b, this.theme.divider.a);
                mutable int y = py + 8;
                this.font.drawText(batch, px + 10, y, "DEBUG -- " + dbg.statusText(), this.theme.accent.r, this.theme.accent.g, this.theme.accent.b, 1.0);
                y = y + ch + 6;
                this.font.drawText(batch, px + 10, y, "CALL STACK", this.theme.textDim.r, this.theme.textDim.g, this.theme.textDim.b, this.theme.textDim.a);
                y = y + ch + 2;
                ArrayList<DebugFrame*>* stack = dbg.callStackView();
                mutable int i = 0;
                while (i < stack.size() && i < 12) {
                    DebugFrame* fr = stack.get(i);
                    this.font.drawText(batch, px + 16, y, fr.name + " :" + fr.line.toString(), this.theme.text.r, this.theme.text.g, this.theme.text.b, this.theme.text.a);
                    y = y + ch;
                    i = i + 1;
                }
                y = y + 10;
                this.font.drawText(batch, px + 10, y, "VARIABLES", this.theme.textDim.r, this.theme.textDim.g, this.theme.textDim.b, this.theme.textDim.a);
                y = y + ch + 2;
                ArrayList<DebugVar*>* vars = dbg.variablesView();
                mutable int j = 0;
                while (j < vars.size() && y < py + ph - ch) {
                    DebugVar* v = vars.get(j);
                    this.font.drawText(batch, px + 16, y, v.name, this.theme.modified.r, this.theme.modified.g, this.theme.modified.b, this.theme.modified.a);
                    this.font.drawText(batch, px + 16 + (v.name.length() + 1) * cw, y, "= " + v.value, this.theme.text.r, this.theme.text.g, this.theme.text.b, this.theme.text.a);
                    y = y + ch;
                    j = j + 1;
                }
            }

            // The breadcrumb bar above the editor: the caret's scope trail (bundle > namespace > class >
            // method), the last segment brightest -- so you always see where in the structure you are.
            private method drawBreadcrumbs(Batch2D* batch, Workbench* wb, int ox, int oy, int pw) returns void {
                int cw = this.font.advance();
                int ch = this.font.lineHeight();
                int h = this.crumbH();
                batch.rect(ox, oy, pw, h, this.theme.panel.r, this.theme.panel.g, this.theme.panel.b, this.theme.panel.a);
                batch.rect(ox, oy + h - 1, pw, 1, this.theme.divider.r, this.theme.divider.g, this.theme.divider.b, this.theme.divider.a);      // bottom hairline
                int ty = oy + (h - ch) / 2;
                ArrayList<String>* trail = Breadcrumbs.trail(wb.active());
                if (trail.size() == 0) {
                    this.font.drawText(batch, ox + 12, ty, "(top level)", this.theme.textFaint.r, this.theme.textFaint.g, this.theme.textFaint.b, this.theme.textFaint.a);
                    return;
                }
                mutable int x = ox + 12;
                mutable int i = 0;
                while (i < trail.size()) {
                    boolean last = i == trail.size() - 1;
                    String seg = trail.get(i);
                    mutable float r = 0.502;
                    mutable float g = 0.588;
                    mutable float b = 0.584;
                    if (last) {
                        r = 0.804;
                        g = 0.851;
                        b = 0.843;
                    }
                    this.font.drawText(batch, x, ty, seg, r, g, b, 1.0);
                    x = x + (seg.length() + 1) * cw;
                    if (!last) {
                        this.font.drawText(batch, x, ty, ">", this.theme.textFaint.r, this.theme.textFaint.g, this.theme.textFaint.b, this.theme.textFaint.a);
                        x = x + 2 * cw;
                    }
                    i = i + 1;
                }
            }

            // The start screen shown when no project is open: the Forge banner, the New Project / Open Folder /
            // Open Project actions, and the list of recent projects to click. Layout is mirrored by welcomeHit.
            // btnX(k)/btnW give the three action buttons a shared geometry both methods use.
            private method welcomeX0(int screenW) returns int {
                return screenW / 2 - 260;
            }
            private method welcomeBtnW() returns int {
                return 168;
            }
            private method welcomeBtnX(int screenW, int k) returns int {
                return this.welcomeX0(screenW) + k * (this.welcomeBtnW() + 12);
            }
            public method drawWelcome(Batch2D* batch, ArrayList<String>* recent, int mx, int my,
                                      int screenW, int screenH) returns void {
                int cw = this.font.advance();
                int ch = this.font.lineHeight();
                batch.rect(0, 0, screenW, screenH, this.theme.bg.r, this.theme.bg.g, this.theme.bg.b, this.theme.bg.a);
                int x0 = this.welcomeX0(screenW);
                int hover = this.welcomeHit(mx, my, recent.size(), screenW);
                // banner: an amber flame chip + the wordmark
                batch.rect(x0, 84, 16, 16, this.theme.accent.r, this.theme.accent.g, this.theme.accent.b, 1.0);
                this.font.drawText(batch, x0 + 28, 88, "Forge", this.theme.accent.r, this.theme.accent.g, this.theme.accent.b, 1.0);
                this.font.drawText(batch, x0 + 28 + 6 * cw, 88, "the LDP3 IDE", this.theme.textDim.r, this.theme.textDim.g, this.theme.textDim.b, this.theme.textDim.a);
                this.font.drawText(batch, x0 + 28, 88 + ch + 4, "Start a project, or reopen a recent one.",
                                   0.502, 0.588, 0.584, 1.0);
                int btnH = ch + 20;
                int btnW = this.welcomeBtnW();
                int btnY = 160;
                this.welcomeButton(batch, this.welcomeBtnX(screenW, 0), btnY, btnW, btnH, "+ New Project",
                                   hover == 0 - 1);
                this.welcomeButton(batch, this.welcomeBtnX(screenW, 1), btnY, btnW, btnH, "Open Folder...",
                                   hover == 0 - 2);
                this.welcomeButton(batch, this.welcomeBtnX(screenW, 2), btnY, btnW, btnH, "Open Project...",
                                   hover == 0 - 3);
                // recent list
                int hdrY = btnY + btnH + 30;
                this.font.drawText(batch, x0, hdrY, "RECENT PROJECTS", this.theme.textFaint.r, this.theme.textFaint.g, this.theme.textFaint.b, this.theme.textFaint.a);
                int rowH = ch + 10;
                int listTop = hdrY + ch + 10;
                int listW = btnW * 3 + 24;
                mutable int i = 0;
                while (i < recent.size() && i < 12) {
                    int ry = listTop + i * rowH;
                    if (hover == i) {
                        batch.rect(x0 - 4, ry - 3, listW + 8, rowH, this.theme.accent.r, this.theme.accent.g, this.theme.accent.b, 0.14);
                    }
                    String path = recent.get(i);
                    String name = Paths.basename(path);
                    this.font.drawText(batch, x0 + 4, ry, name, this.theme.text.r, this.theme.text.g, this.theme.text.b, this.theme.text.a);
                    this.font.drawText(batch, x0 + 4 + (name.length() + 2) * cw, ry, path,
                                       0.376, 0.478, 0.475, 1.0);
                    i = i + 1;
                }
                if (recent.size() == 0) {
                    this.font.drawText(batch, x0 + 4, listTop, "(none yet -- create or open a project to begin)",
                                       0.376, 0.478, 0.475, 1.0);
                }
            }
            private method welcomeButton(Batch2D* batch, int x, int y, int w, int h, String caption,
                                         boolean hover) returns void {
                mutable float bg = 0.063;
                if (hover) {
                    bg = 0.114;
                }
                batch.rect(x, y, w, h, bg, 0.106, 0.114, 1.0);
                batch.rect(x, y, 3, h, this.theme.accent.r, this.theme.accent.g, this.theme.accent.b, 1.0);
                this.font.drawText(batch, x + 14, y + 10, caption, this.theme.text.r, this.theme.text.g, this.theme.text.b, this.theme.text.a);
            }
            // Which welcome control is under (mx, my): -1 = New Project, -2 = Open Folder, -3 = Open Project,
            // 0..n = a recent index, -10 = nothing.
            public method welcomeHit(int mx, int my, int recentCount, int screenW) returns int {
                int cw = this.font.advance();
                int ch = this.font.lineHeight();
                int x0 = this.welcomeX0(screenW);
                int btnH = ch + 20;
                int btnW = this.welcomeBtnW();
                int btnY = 160;
                if (my >= btnY && my < btnY + btnH) {
                    mutable int k = 0;
                    while (k < 3) {
                        int bx = this.welcomeBtnX(screenW, k);
                        if (mx >= bx && mx < bx + btnW) {
                            return 0 - 1 - k;
                        }
                        k = k + 1;
                    }
                    return 0 - 10;
                }
                int hdrY = btnY + btnH + 30;
                int rowH = ch + 10;
                int listTop = hdrY + ch + 10;
                int listW = btnW * 3 + 24;
                if (mx >= x0 && mx < x0 + listW && my >= listTop) {
                    int idx = (my - listTop) / rowH;
                    if (idx >= 0 && idx < recentCount) {
                        return idx;
                    }
                }
                return 0 - 10;
            }

            // The top menu bar (File / Edit / View / Run / Help). Drawn on top of the frame so the open menu's
            // title can highlight; the dropdown itself is drawn separately by drawMenuDropdown.
            public method drawMenuBar(Batch2D* batch, MenuBar* mb, Workbench* wb, int mx, int my,
                                      int screenW) returns void {
                int cw = this.font.advance();
                int mh = this.menuH();
                batch.rect(0, 0, screenW, mh, this.theme.panel.r, this.theme.panel.g, this.theme.panel.b, this.theme.panel.a);
                batch.rect(0, mh - 1, screenW, 1, this.theme.divider.r, this.theme.divider.g, this.theme.divider.b, this.theme.divider.a);      // bottom hairline
                int ty = (mh - this.font.lineHeight()) / 2;
                mutable int x = 8;
                mutable int i = 0;
                while (i < mb.count()) {
                    String t = mb.title(i);
                    int tw = (t.length() + 2) * cw;
                    boolean isOpen = mb.openIndex == i;
                    mutable float r = 0.706;
                    mutable float g = 0.769;
                    mutable float b = 0.761;
                    if (isOpen) {
                        batch.rect(x, 0, tw, mh, this.theme.panel.r, this.theme.panel.g, this.theme.panel.b, this.theme.panel.a);
                        r = 0.918; g = 0.706; b = 0.392;
                    }
                    this.font.drawText(batch, x + cw, ty, t, r, g, b, 1.0);
                    x = x + tw;
                    i = i + 1;
                }
                // Right side: Build + Run toolbar buttons, and (further left) the project label.
                int rbx = this.runButtonX(screenW);
                int bbx = this.buildButtonX(screenW);
                boolean overBuild = my >= 0 && my < mh && mx >= bbx && mx < bbx + this.toolBtnW();
                boolean overRun = my >= 0 && my < mh && mx >= rbx && mx < rbx + this.toolBtnW();
                mutable float bb = 0.063;
                if (overBuild) {
                    bb = 0.118;
                }
                batch.rect(bbx, 4, this.toolBtnW(), mh - 8, bb, 0.106, 0.114, 1.0);
                this.font.drawText(batch, bbx + cw, ty, "Build", this.theme.text.r, this.theme.text.g, this.theme.text.b, this.theme.text.a);
                mutable float rb = 0.063;
                if (overRun) {
                    rb = 0.118;
                }
                batch.rect(rbx, 4, this.toolBtnW(), mh - 8, rb, 0.106, 0.114, 1.0);
                // a small green play triangle
                int triX = rbx + cw;
                int triY = mh / 2;
                batch.rect(triX, triY - 5, 2, 10, this.theme.added.r, this.theme.added.g, this.theme.added.b, this.theme.added.a);
                batch.rect(triX + 2, triY - 4, 2, 8, this.theme.added.r, this.theme.added.g, this.theme.added.b, this.theme.added.a);
                batch.rect(triX + 4, triY - 3, 2, 6, this.theme.added.r, this.theme.added.g, this.theme.added.b, this.theme.added.a);
                batch.rect(triX + 6, triY - 1, 2, 2, this.theme.added.r, this.theme.added.g, this.theme.added.b, this.theme.added.a);
                this.font.drawText(batch, rbx + cw + 12, ty, "Run", this.theme.added.r, this.theme.added.g, this.theme.added.b, this.theme.added.a);
                String proj = wb.projectLabel();
                if (proj.length() > 0) {
                    int px = bbx - (proj.length() + 3) * cw;
                    this.font.drawText(batch, px, ty, proj, this.theme.textDim.r, this.theme.textDim.g, this.theme.textDim.b, this.theme.textDim.a);
                }
            }
            private method toolBtnW() returns int {
                return 7 * this.font.advance();
            }
            public method runButtonX(int screenW) returns int {
                return screenW - this.toolBtnW() - 10;
            }
            public method buildButtonX(int screenW) returns int {
                return this.runButtonX(screenW) - this.toolBtnW() - 6;
            }
            // Which menu-bar toolbar button is under (mx, my): 1 = Run, 0 = Build, -1 = none.
            public method toolButtonAt(int mx, int my, int screenW) returns int {
                int mh = this.menuH();
                if (my < 0 || my >= mh) {
                    return 0 - 1;
                }
                int rbx = this.runButtonX(screenW);
                if (mx >= rbx && mx < rbx + this.toolBtnW()) {
                    return 1;
                }
                int bbx = this.buildButtonX(screenW);
                if (mx >= bbx && mx < bbx + this.toolBtnW()) {
                    return 0;
                }
                return 0 - 1;
            }

            // The open menu's dropdown, anchored under its title. Does nothing if no menu is open.
            public method drawMenuDropdown(Batch2D* batch, MenuBar* mb, int mx, int my) returns void {
                if (!mb.isOpen()) {
                    return;
                }
                int cw = this.font.advance();
                int ch = this.font.lineHeight();
                int mh = this.menuH();
                Menu* m = mb.openMenu();
                int x = this.menuTitleX(mb, mb.openIndex);
                int dw = this.dropdownWidth(m, cw);
                int rowH = ch + 6;
                mutable int dh = 6;
                mutable int i = 0;
                while (i < m.items.size()) {
                    if (m.items.get(i).isSeparator()) {
                        dh = dh + 7;
                    } else {
                        dh = dh + rowH;
                    }
                    i = i + 1;
                }
                batch.rect(x, mh, dw, dh, this.theme.panel.r, this.theme.panel.g, this.theme.panel.b, this.theme.panel.a);
                batch.rect(x, mh, dw, 2, this.theme.accent.r, this.theme.accent.g, this.theme.accent.b, 1.0);
                mutable int y = mh + 3;
                i = 0;
                while (i < m.items.size()) {
                    MenuItem* it = m.items.get(i);
                    if (it.isSeparator()) {
                        batch.rect(x + 6, y + 3, dw - 12, 1, this.theme.textFaint.r, this.theme.textFaint.g, this.theme.textFaint.b, this.theme.textFaint.a);
                        y = y + 7;
                    } else {
                        boolean hover = mx >= x && mx < x + dw && my >= y - 1 && my < y - 1 + rowH;
                        if (hover) {
                            batch.rect(x + 2, y - 1, dw - 4, rowH, this.theme.accent.r, this.theme.accent.g, this.theme.accent.b, 0.18);
                        }
                        this.font.drawText(batch, x + cw, y + 3, it.caption, this.theme.text.r, this.theme.text.g, this.theme.text.b, this.theme.text.a);
                        y = y + rowH;
                    }
                    i = i + 1;
                }
            }

            // The right-click context menu, drawn at the click point (nudged back on-screen if it would spill
            // past the right/bottom edge). Same visual language as the menu-bar dropdown: panel fill, an amber
            // top rule, hairline separators, and a hover band.
            public method drawContextMenu(Batch2D* batch, ContextMenu* ctx, int mx, int my, int screenW,
                                          int screenH) returns void {
                if (!ctx.isActive()) {
                    return;
                }
                int cw = this.font.advance();
                int ch = this.font.lineHeight();
                int rowH = ch + 6;
                int w = this.contextWidth(ctx, cw);
                int h = this.contextHeight(ctx, rowH);
                int x = this.contextX(ctx, screenW, w);
                int y = this.contextY(ctx, screenH, h);
                batch.rect(x, y, w, h, this.theme.panel.r, this.theme.panel.g, this.theme.panel.b, 1.0);
                batch.rect(x, y, w, 2, this.theme.accent.r, this.theme.accent.g, this.theme.accent.b, 1.0);
                mutable int ry = y + 3;
                mutable int i = 0;
                while (i < ctx.count()) {
                    if (ctx.isSeparator(i)) {
                        batch.rect(x + 6, ry + 3, w - 12, 1, this.theme.textFaint.r, this.theme.textFaint.g,
                                   this.theme.textFaint.b, this.theme.textFaint.a);
                        ry = ry + 7;
                    } else {
                        boolean hover = mx >= x && mx < x + w && my >= ry - 1 && my < ry - 1 + rowH;
                        if (hover) {
                            batch.rect(x + 2, ry - 1, w - 4, rowH, this.theme.accent.r, this.theme.accent.g,
                                       this.theme.accent.b, 0.18);
                        }
                        this.font.drawText(batch, x + cw, ry + 3, ctx.captionAt(i), this.theme.text.r,
                                           this.theme.text.g, this.theme.text.b, this.theme.text.a);
                        ry = ry + rowH;
                    }
                    i = i + 1;
                }
                return;
            }
            // The index of the context-menu item at (mx, my), or -1 (also -1 over a separator or outside).
            public method contextItemAt(ContextMenu* ctx, int mx, int my, int screenW, int screenH) returns int {
                if (!ctx.isActive()) {
                    return 0 - 1;
                }
                int cw = this.font.advance();
                int rowH = this.font.lineHeight() + 6;
                int w = this.contextWidth(ctx, cw);
                int h = this.contextHeight(ctx, rowH);
                int x = this.contextX(ctx, screenW, w);
                int y = this.contextY(ctx, screenH, h);
                if (mx < x || mx >= x + w || my < y || my >= y + h) {
                    return 0 - 1;
                }
                mutable int ry = y + 3;
                mutable int i = 0;
                while (i < ctx.count()) {
                    if (ctx.isSeparator(i)) {
                        if (my >= ry && my < ry + 7) {
                            return 0 - 1;
                        }
                        ry = ry + 7;
                    } else {
                        if (my >= ry - 1 && my < ry - 1 + rowH) {
                            return i;
                        }
                        ry = ry + rowH;
                    }
                    i = i + 1;
                }
                return 0 - 1;
            }
            // Is (mx, my) inside the context popup at all? (A click outside just dismisses it.)
            public method contextHit(ContextMenu* ctx, int mx, int my, int screenW, int screenH) returns boolean {
                if (!ctx.isActive()) {
                    return false;
                }
                int cw = this.font.advance();
                int rowH = this.font.lineHeight() + 6;
                int w = this.contextWidth(ctx, cw);
                int h = this.contextHeight(ctx, rowH);
                int x = this.contextX(ctx, screenW, w);
                int y = this.contextY(ctx, screenH, h);
                return mx >= x && mx < x + w && my >= y && my < y + h;
            }
            private method contextWidth(ContextMenu* ctx, int cw) returns int {
                mutable int maxc = 14;
                mutable int i = 0;
                while (i < ctx.count()) {
                    int len = ctx.captionAt(i).length();
                    if (len > maxc) {
                        maxc = len;
                    }
                    i = i + 1;
                }
                return (maxc + 3) * cw;
            }
            private method contextHeight(ContextMenu* ctx, int rowH) returns int {
                mutable int h = 6;
                mutable int i = 0;
                while (i < ctx.count()) {
                    if (ctx.isSeparator(i)) {
                        h = h + 7;
                    } else {
                        h = h + rowH;
                    }
                    i = i + 1;
                }
                return h;
            }
            private method contextX(ContextMenu* ctx, int screenW, int w) returns int {
                mutable int x = ctx.x;
                if (x + w > screenW) {
                    x = screenW - w;
                }
                if (x < 0) {
                    x = 0;
                }
                return x;
            }
            private method contextY(ContextMenu* ctx, int screenH, int h) returns int {
                mutable int y = ctx.y;
                if (y + h > screenH) {
                    y = screenH - h;
                }
                if (y < 0) {
                    y = 0;
                }
                return y;
            }

            private method dropdownWidth(Menu* m, int cw) returns int {
                mutable int maxc = 12;
                mutable int i = 0;
                while (i < m.items.size()) {
                    int l = m.items.get(i).caption.length();
                    if (l > maxc) {
                        maxc = l;
                    }
                    i = i + 1;
                }
                return (maxc + 4) * cw;
            }

            // x pixel where menu title `idx` begins (mirrors drawMenuBar's layout).
            public method menuTitleX(MenuBar* mb, int idx) returns int {
                int cw = this.font.advance();
                mutable int x = 8;
                mutable int i = 0;
                while (i < idx) {
                    x = x + (mb.title(i).length() + 2) * cw;
                    i = i + 1;
                }
                return x;
            }
            // Which menu title is under pixel x in the bar (-1 if none). Only meaningful when my < menuH().
            public method menuTitleAtX(MenuBar* mb, int mx) returns int {
                int cw = this.font.advance();
                mutable int x = 8;
                mutable int i = 0;
                while (i < mb.count()) {
                    int tw = (mb.title(i).length() + 2) * cw;
                    if (mx >= x && mx < x + tw) {
                        return i;
                    }
                    x = x + tw;
                    i = i + 1;
                }
                return 0 - 1;
            }
            // Which dropdown item is under pixel (mx, my) for the open menu (-1 if none or on a separator).
            public method dropdownItemAt(MenuBar* mb, int mx, int my) returns int {
                if (!mb.isOpen()) {
                    return 0 - 1;
                }
                int cw = this.font.advance();
                int ch = this.font.lineHeight();
                int mh = this.menuH();
                Menu* m = mb.openMenu();
                int x = this.menuTitleX(mb, mb.openIndex);
                int dw = this.dropdownWidth(m, cw);
                if (mx < x || mx >= x + dw || my < mh) {
                    return 0 - 1;
                }
                int rowH = ch + 6;
                mutable int y = mh + 3;
                mutable int i = 0;
                while (i < m.items.size()) {
                    MenuItem* it = m.items.get(i);
                    mutable int h = rowH;
                    if (it.isSeparator()) {
                        h = 7;
                    }
                    if (my >= y && my < y + h) {
                        if (it.isSeparator()) {
                            return 0 - 1;
                        }
                        return i;
                    }
                    y = y + h;
                    i = i + 1;
                }
                return 0 - 1;
            }

            // Height the output panel should occupy: 0 when hidden, otherwise a header plus its content sized
            // to the number of lines (so an empty or short panel is small, not a big blank box), capped at
            // ~40% of the window.
            public method outputPanelHeight(OutputPanel* panel, int screenH) returns int {
                if (!panel.visible) {
                    return 0;
                }
                int ch = this.font.lineHeight();
                int headerH = ch + 8;
                mutable int maxRows = (screenH * 4 / 10) / ch;
                if (maxRows < 3) {
                    maxRows = 3;
                }
                mutable int rows = panel.lineCount();
                if (rows < 1) {
                    rows = 1;
                }
                if (rows > maxRows) {
                    rows = maxRows;
                }
                return headerH + rows * ch + 8;
            }
            // The build/run output panel: a titled band at the bottom of the editor area with a close button,
            // showing the tail of the captured command output.
            private method drawOutputPanel(Batch2D* batch, OutputPanel* panel, int ox, int oy, int pw, int ph,
                                           int mx, int my) returns void {
                int cw = this.font.advance();
                int ch = this.font.lineHeight();
                batch.rect(ox, oy, pw, ph, this.theme.panel.r, this.theme.panel.g, this.theme.panel.b, this.theme.panel.a);
                batch.rect(ox, oy, pw, 1, this.theme.divider.r, this.theme.divider.g, this.theme.divider.b, this.theme.divider.a);
                this.font.drawText(batch, ox + 10, oy + 4, panel.title, this.theme.accent.r, this.theme.accent.g, this.theme.accent.b, 1.0);
                // close button (x) at the top-right of the panel header
                int xbx = ox + pw - 2 * cw;
                boolean overX = mx >= xbx - cw && mx < xbx + cw && my >= oy && my < oy + ch + 8;
                mutable float xr = 0.502;
                if (overX) {
                    xr = 0.902;
                }
                this.font.drawText(batch, xbx, oy + 4, "x", xr, 0.588, 0.584, 1.0);
                int headerH = ch + 8;
                int rows = (ph - headerH) / ch;
                int total = panel.lineCount();
                mutable int start = 0;
                if (total > rows) {
                    start = total - rows;
                }
                mutable int i = start;
                mutable int y = oy + headerH;
                while (i < total) {
                    this.font.drawText(batch, ox + 10, y, panel.line(i), this.theme.text.r, this.theme.text.g, this.theme.text.b, this.theme.text.a);
                    y = y + ch;
                    i = i + 1;
                }
            }
            // True when (mx, my) is on the output panel's close button. `oy` is the panel top.
            public method outputCloseAt(int mx, int my, int ox, int oy, int pw) returns boolean {
                int cw = this.font.advance();
                int ch = this.font.lineHeight();
                int xbx = ox + pw - 2 * cw;
                return mx >= xbx - cw && mx < xbx + cw && my >= oy && my < oy + ch + 8;
            }

            // The integrated terminal panel occupies the bottom ~40% of the window.
            public method terminalPanelHeight(int screenH) returns int {
                return screenH * 4 / 10;
            }
            // Draw the terminal: a header, the tail of the scrollback that fits, the in-progress output tail,
            // and the input line with a prompt + caret.
            private method drawTerminal(Batch2D* batch, Terminal* term, int ox, int oy, int pw, int ph)
                    returns void {
                int cw = this.font.advance();
                int ch = this.font.lineHeight();
                batch.rect(ox, oy, pw, ph, this.theme.panel.r, this.theme.panel.g, this.theme.panel.b, this.theme.panel.a);
                batch.rect(ox, oy, pw, 1, this.theme.divider.r, this.theme.divider.g, this.theme.divider.b, this.theme.divider.a);
                int headerH = ch + 6;
                this.font.drawText(batch, ox + 10, oy + 4, "TERMINAL", this.theme.accent.r, this.theme.accent.g, this.theme.accent.b, this.theme.accent.a);
                // Rows for output: everything below the header, leaving the last row for the input line.
                int bodyTop = oy + headerH;
                int rows = (ph - headerH) / ch;
                if (rows < 2) {
                    return;
                }
                int outRows = rows - 1;
                ArrayList<String>* sb = term.scrollback();
                // Build the visible list = scrollback tail + the partial line, then show its last outRows.
                int total = sb.size() + 1;
                mutable int start = total - outRows;
                if (start < 0) {
                    start = 0;
                }
                mutable int r = 0;
                mutable int idx = start;
                while (idx < total && r < outRows) {
                    mutable String text = "";
                    if (idx < sb.size()) {
                        text = sb.get(idx);
                    } else {
                        text = term.partialLine();
                    }
                    this.font.drawText(batch, ox + 10, bodyTop + r * ch, text, this.theme.text.r, this.theme.text.g, this.theme.text.b, this.theme.text.a);
                    r = r + 1;
                    idx = idx + 1;
                }
                // Input line at the bottom with a prompt and (when focused) a block caret.
                int iy = bodyTop + outRows * ch;
                this.font.drawText(batch, ox + 10, iy, "$ ", this.theme.added.r, this.theme.added.g, this.theme.added.b, this.theme.added.a);
                String inp = term.inputLine();
                this.font.drawText(batch, ox + 10 + 2 * cw, iy, inp, this.theme.text.r, this.theme.text.g, this.theme.text.b, this.theme.text.a);
                if (term.isFocused() && this.caretOn) {
                    int cx = ox + 10 + (2 + inp.length()) * cw;
                    batch.rect(cx, iy, cw, ch, this.theme.accent.r, this.theme.accent.g, this.theme.accent.b, 0.7);
                }
            }

            // Bottom status bar: an amber mode chip, the file, the caret position, and the line count.
            private method drawStatusBar(Batch2D* batch, Workbench* wb, int screenW, int screenH, int sh)
                    returns void {
                int cw = this.font.advance();
                int y0 = screenH - sh;
                int ty = y0 + 4;
                batch.rect(0, y0, screenW, sh, this.theme.chrome.r, this.theme.chrome.g, this.theme.chrome.b, this.theme.chrome.a);
                batch.rect(0, y0, screenW, 1, this.theme.divider.r, this.theme.divider.g, this.theme.divider.b, this.theme.divider.a);   // top hairline
                Controller* c = wb.active();
                // amber mode chip
                int chipW = 6 * cw;
                batch.rect(0, y0, chipW, sh, this.theme.accent.r, this.theme.accent.g, this.theme.accent.b, 1.0);
                this.font.drawText(batch, cw, ty, "LDP3", this.theme.onAccent.r, this.theme.onAccent.g, this.theme.onAccent.b, this.theme.onAccent.a);
                // file name + dirty marker
                mutable String name = c.document().path();
                if (name.length() == 0) {
                    name = "untitled";
                }
                if (c.document().isModified()) {
                    name = name + " *";
                }
                this.font.drawText(batch, chipW + cw, ty, name, this.theme.text.r, this.theme.text.g, this.theme.text.b, this.theme.text.a);
                // diagnostics count (errors red, warnings amber)
                int errs = wb.errorCount();
                int warns = wb.warningCount();
                if (errs > 0 || warns > 0) {
                    int dx = chipW + cw + (name.length() + 3) * cw;
                    String ecnt = "x" + errs.toString();
                    mutable float er = 0.902;
                    if (errs == 0) {
                        er = 0.4;
                    }
                    this.font.drawText(batch, dx, ty, ecnt, er, 0.318, 0.263, 1.0);
                    String wcnt = "!" + warns.toString();
                    this.font.drawText(batch, dx + (ecnt.length() + 1) * cw, ty, wcnt, this.theme.warning.r, this.theme.warning.g, this.theme.warning.b, this.theme.warning.a);
                }
                // the git branch, just left of the caret position (empty when this is not a repository)
                String branch = wb.currentBranch();
                mutable int rightEdge = screenW;
                if (branch.length() > 0) {
                    String chip = "git: " + branch;
                    int bx = screenW - (chip.length() + 2) * cw;
                    this.font.drawText(batch, bx, ty, chip, this.theme.modified.r, this.theme.modified.g,
                                       this.theme.modified.b, this.theme.modified.a);
                    rightEdge = bx - cw;
                }
                // caret position, right side
                String pos = "Ln " + (c.editor().cursorRow() + 1).toString()
                           + ", Col " + (c.editor().cursorCol() + 1).toString()
                           + "    " + c.lineCount().toString() + " lines";
                int px = rightEdge - (pos.length() + 2) * cw;
                this.font.drawText(batch, px, ty, pos, this.theme.textDim.r, this.theme.textDim.g, this.theme.textDim.b, this.theme.textDim.a);
            }

            private method drawTabBar(Batch2D* batch, DocumentManager* docs, int top, int tabh, int mx, int my)
                    returns void {
                int cw = this.font.advance();
                int ty = top + (tabh - this.font.lineHeight()) / 2;
                mutable int x = 6;
                mutable int i = 0;
                while (i < docs.count()) {
                    String title = docs.title(i);
                    int tw = (title.length() + 4) * cw;
                    boolean active = i == docs.activeIndex();
                    boolean hover = my >= top && my < top + tabh && mx >= x && mx < x + tw;
                    mutable float r = 0.502;
                    mutable float g = 0.588;
                    mutable float b = 0.584;
                    if (active) {
                        batch.rect(x, top, tw, tabh, this.theme.bg.r, this.theme.bg.g, this.theme.bg.b, this.theme.bg.a);   // active tab = editor ground
                        batch.rect(x, top, tw, 2, this.theme.accent.r, this.theme.accent.g, this.theme.accent.b, 1.0);      // amber accent
                        r = 0.804; g = 0.851; b = 0.843;
                    } else {
                        if (hover) {
                            batch.rect(x, top, tw, tabh, this.theme.hover.r, this.theme.hover.g, this.theme.hover.b, 0.04);   // hover highlight
                            r = 0.702; g = 0.769; b = 0.761;
                        }
                    }
                    this.font.drawText(batch, x + cw, ty, title, r, g, b, 1.0);
                    // close control (x) at the right of the tab, brighter on the active tab
                    mutable float xr = 0.376;
                    mutable float xg = 0.478;
                    mutable float xb = 0.475;
                    if (active) {
                        xr = 0.702;
                        xg = 0.549;
                        xb = 0.353;
                    }
                    this.font.drawText(batch, x + tw - 2 * cw, ty, "x", xr, xg, xb, 1.0);
                    x = x + tw;
                    i = i + 1;
                }
            }

            private method drawTree(Batch2D* batch, FileTree* tree, int top, int screenH, int mx, int my)
                    returns void {
                int ch = this.font.lineHeight();
                ArrayList<FileNode*>* rows = tree.visible();
                mutable int i = 0;
                while (i < rows.size()) {
                    int y = top + 6 + i * ch;
                    if (y + ch > screenH) {
                        return;
                    }
                    boolean hover = mx >= 0 && mx < this.treeW && my >= y && my < y + ch;
                    if (hover) {
                        batch.rect(0, y, this.treeW, ch, this.theme.hover.r, this.theme.hover.g, this.theme.hover.b, 0.045);
                    }
                    FileNode* node = rows.get(i);
                    mutable float r = 0.576;
                    mutable float g = 0.678;
                    mutable float b = 0.667;
                    if (node.isDir) {
                        r = 0.918;
                        g = 0.706;
                        b = 0.392;
                    }
                    this.font.drawText(batch, 8, y, tree.rowLabel(node), r, g, b, 1.0);
                    i = i + 1;
                }
            }

            // The editor pane at (ox, oy), size (pw, ph).
            private method drawEditor(Batch2D* batch, Workbench* wb, Overlay* ov, int mx, int my, int ox, int oy,
                                      int pw, int ph) returns void {
                Controller* c = wb.active();
                int cw = this.font.advance();
                int ch = this.font.lineHeight();
                int gpx = this.gutterPx();
                int textX = ox + gpx + 6;
                int caretRow = c.caretScreenRow();
                int visible = c.visibleRows();
                int firstLine = c.firstLine();

                batch.rect(ox, oy, gpx, ph, this.theme.gutter.r, this.theme.gutter.g, this.theme.gutter.b, this.theme.gutter.a);   // gutter band

                // find: highlight every occurrence of the query in the visible lines. With the find bar closed,
                // fall back to highlighting the identifier the caret sits on, JetBrains/VS Code-style.
                if (ov.mode == 2 && ov.query.length() > 0) {
                    this.drawFindMatches(batch, c, ov.query, textX, oy, cw, ch, visible, firstLine);
                } else if (!c.editor().hasSelection()) {
                    this.drawOccurrences(batch, c, textX, oy, cw, ch, visible);
                }

                if (c.editor().hasSelection()) {
                    this.drawSelection(batch, c, textX, oy, cw, ch, visible, firstLine);
                }

                GitStatus* git = wb.gitStatus();
                Debugger* dbg = wb.debugger();
                String dbgPath = wb.activePath();
                // bracket-pair colouring: seed the running nesting depth at the first visible document line,
                // then carry it down the visible lines (bridging fold gaps) so each bracket is tinted by depth.
                int firstDoc = c.lineNumberAt(0);
                mutable int bdepth = c.bracketDepthAt(firstDoc);
                mutable int expectDoc = firstDoc;
                mutable int r = 0;
                while (r < visible) {
                    int y = oy + this.topPad + r * ch;
                    int docLine = c.lineNumberAt(r);
                    if (r == caretRow) {
                        batch.rect(ox + gpx, y, pw - gpx, ch, this.theme.caretLine.r, this.theme.caretLine.g, this.theme.caretLine.b, this.theme.caretLine.a);
                    }
                    // stopped line (debugger paused here): a translucent amber band across the whole row
                    if (dbg.isStoppedAt(dbgPath, docLine + 1)) {
                        batch.rect(ox + gpx, y, pw - gpx, ch, this.theme.accent.r, this.theme.accent.g, this.theme.accent.b, 0.16);
                    }
                    // git change bar at the gutter's left edge: green added, blue modified, red deletion tick
                    int gk = git.kindAt(docLine);
                    if (gk == 1) {
                        batch.rect(ox, y, 3, ch, this.theme.added.r, this.theme.added.g, this.theme.added.b, this.theme.added.a);
                    } else if (gk == 2) {
                        batch.rect(ox, y, 3, ch, this.theme.modified.r, this.theme.modified.g, this.theme.modified.b, this.theme.modified.a);
                    } else if (gk == 3) {
                        batch.rect(ox, y + ch - 3, 6, 3, this.theme.removed.r, this.theme.removed.g, this.theme.removed.b, this.theme.removed.a);
                        batch.rect(ox, y + ch - 3, 3, 6, this.theme.removed.r, this.theme.removed.g, this.theme.removed.b, this.theme.removed.a);
                    }
                    // bookmark marker: a small amber square at the gutter's inner edge
                    if (c.hasBookmark(docLine)) {
                        batch.rect(ox + gpx - 5, y + ch / 2 - 3, 5, 6, this.theme.accent.r, this.theme.accent.g, this.theme.accent.b, 1.0);
                    }
                    // breakpoint marker: a red dot at the gutter's left edge (VS Code-style)
                    if (dbg.hasBreakpoint(dbgPath, docLine + 1)) {
                        batch.rect(ox + 4, y + ch / 2 - 4, 8, 8, this.theme.breakpoint.r, this.theme.breakpoint.g, this.theme.breakpoint.b, this.theme.breakpoint.a);
                    }
                    String num = (docLine + 1).toString();
                    int nx = ox + gpx - 8 - num.length() * cw;
                    // the caret's line number is brighter (amber), the rest dim
                    if (r == caretRow) {
                        this.font.drawText(batch, nx, y, num, this.theme.accent.r, this.theme.accent.g, this.theme.accent.b, this.theme.accent.a);
                    } else {
                        this.font.drawText(batch, nx, y, num, this.theme.textFaint.r, this.theme.textFaint.g, this.theme.textFaint.b, this.theme.textFaint.a);
                    }
                    // fold marker in the gutter/text gap for foldable header lines
                    if (c.isFoldable(docLine)) {
                        this.drawFoldMarker(batch, ox + gpx - 3, y + ch / 2, c.isFolded(docLine));
                    }
                    String line = c.renderLine(r);
                    this.drawIndentGuides(batch, c.guideIndent(docLine), textX, y, cw, ch);
                    // carry the bracket depth across any lines a fold skipped since the last drawn line
                    if (docLine > expectDoc) {
                        bdepth = bdepth + c.bracketDeltaBetween(expectDoc, docLine);
                        if (bdepth < 0) {
                            bdepth = 0;
                        }
                    }
                    ArrayList<Span> spans = c.renderSpans(r);
                    mutable int si = 0;
                    while (si < spans.size()) {
                        Span* sp = spans.get(si);
                        if (this.isBracketSpan(line, sp)) {
                            char bc = line.charAt(sp.start);
                            mutable int idx = bdepth;
                            if (bc == ')' || bc == ']' || bc == '}') {
                                bdepth = bdepth - 1;
                                if (bdepth < 0) {
                                    bdepth = 0;
                                }
                                idx = bdepth;
                            } else {
                                bdepth = bdepth + 1;
                            }
                            this.drawBracket(batch, textX, y, cw, line, sp, idx);
                        } else {
                            this.drawSpan(batch, textX, y, cw, line, sp);
                        }
                        si = si + 1;
                    }
                    expectDoc = docLine + 1;
                    // a "..." badge after a collapsed header shows the block is folded
                    if (c.isFolded(docLine)) {
                        int bx2 = textX + (line.length() + 1) * cw;
                        batch.rect(bx2, y + 2, 3 * cw + 4, ch - 4, this.theme.textFaint.r, this.theme.textFaint.g, this.theme.textFaint.b, 0.4);
                        this.font.drawText(batch, bx2 + 2, y, "...", this.theme.textDim.r, this.theme.textDim.g, this.theme.textDim.b, this.theme.textDim.a);
                    }
                    r = r + 1;
                }

                // sticky scroll: pin the enclosing class/method headers that scrolled off above the top line,
                // so you always see what scope the code belongs to. Draws the innermost few over the top rows.
                ArrayList<int>* sticky = Breadcrumbs.stickyLines(c, firstLine);
                mutable int sc = sticky.size();
                if (sc > 3) {
                    sc = 3;
                }
                int startIdx = sticky.size() - sc;
                mutable int s = 0;
                while (s < sc) {
                    int hl = sticky.get(startIdx + s);
                    int sy = oy + this.topPad + s * ch;
                    batch.rect(ox, sy, pw, ch, this.theme.panel.r, this.theme.panel.g, this.theme.panel.b, this.theme.panel.a);
                    String hnum = (hl + 1).toString();
                    this.font.drawText(batch, ox + gpx - 8 - hnum.length() * cw, sy, hnum,
                                       0.376, 0.478, 0.475, 1.0);
                    this.font.drawText(batch, textX, sy, c.editor().document().line(hl),
                                       0.804, 0.851, 0.843, 1.0);
                    s = s + 1;
                }
                if (sc > 0) {
                    batch.rect(ox, oy + this.topPad + sc * ch, pw, 1, this.theme.accent.r, this.theme.accent.g, this.theme.accent.b, 0.35);
                }

                // matching-bracket highlight (both the bracket at the caret and its partner)
                Match* bm = c.editor().matchingBracket();
                if (bm.valid()) {
                    this.drawBracketCell(batch, c.screenRowForDocLine(bm.row), bm.col, textX, oy, cw, ch, visible);
                    int cr = c.editor().cursorRow();
                    int bcol = this.caretBracketCol(c, cr, c.editor().cursorCol());
                    if (bcol >= 0) {
                        this.drawBracketCell(batch, c.screenRowForDocLine(cr), bcol, textX, oy, cw, ch, visible);
                    }
                }

                int ccr = c.caretScreenRow();
                if (ccr >= 0 && ccr < visible && this.caretOn) {
                    int cx = textX + c.caretScreenCol() * cw;
                    batch.rect(cx, oy + this.topPad + ccr * ch, 2, ch, this.theme.accent.r, this.theme.accent.g, this.theme.accent.b, 1.0);
                }
                // secondary carets (multi-cursor), each with its own Ctrl+D selection highlight
                mutable int mc = 0;
                while (mc < c.extraCaretCount()) {
                    int esr = c.extraCaretScreenRow(mc);
                    if (esr >= 0 && esr < visible) {
                        int endCol = c.extraCaretScreenCol(mc);
                        if (c.extraCaretHasSel(mc)) {
                            int startCol = c.extraSelScreenCol(mc);
                            mutable int a = startCol;
                            mutable int b = endCol;
                            if (b < a) {
                                a = endCol;
                                b = startCol;
                            }
                            if (a < 0) {
                                a = 0;
                            }
                            if (b > a) {
                                batch.rect(textX + a * cw, oy + this.topPad + esr * ch, (b - a) * cw, ch,
                                           this.theme.accent.r, this.theme.accent.g, this.theme.accent.b, 0.22);
                            }
                        }
                        if (this.caretOn) {
                            int ex = textX + endCol * cw;
                            batch.rect(ex, oy + this.topPad + esr * ch, 2, ch, this.theme.accent.r, this.theme.accent.g, this.theme.accent.b, 1.0);
                        }
                    }
                    mc = mc + 1;
                }

                // diagnostics (from the last build) for this file: a gutter marker + an underline
                String base = Paths.basename(c.document().path());
                if (base.length() > 0) {
                    ArrayList<Diagnostic>* ds = wb.diagnostics();
                    mutable int di = 0;
                    while (di < ds.size()) {
                        Diagnostic* d = ds.get(di);
                        int sr = c.screenRowForDocLine(d.line - 1);
                        if (d.file.equals(base) && sr >= 0 && sr < visible) {
                            int y = oy + this.topPad + sr * ch;
                            mutable float dr = 0.902;
                            mutable float dg = 0.318;
                            mutable float db = 0.263;
                            if (d.severity != 0) {
                                dg = 0.706;
                                db = 0.318;
                            }
                            batch.rect(ox + 3, y + ch / 2 - 3, 6, 6, dr, dg, db, 1.0);
                            String txt = c.editor().document().line(d.line - 1);
                            mutable int startCol = d.col - 1;
                            if (startCol < 0) {
                                startCol = 0;
                            }
                            mutable int uw = (txt.length() - startCol) * cw;
                            if (uw < cw) {
                                uw = cw;
                            }
                            batch.rect(textX + startCol * cw, y + ch - 2, uw, 2, dr, dg, db, 0.85);
                        }
                        di = di + 1;
                    }
                }

                // the code minimap (right of the text, left of the overview ruler), when enabled
                if (wb.minimapVisible()) {
                    this.drawMinimap(batch, c, ox + pw - this.minimapW() - 14, oy, ph, firstLine, visible);
                }
                // the overview ruler on the right edge: scroll thumb + a tick per diagnostic
                this.drawOverviewRuler(batch, wb, ox + pw, oy, ph);

                // hover tooltip: a diagnostic message when the mouse is over a line the build flagged (that's
                // what you want to read there), otherwise the declaration of the identifier under the mouse.
                if (!ov.isOpen() && mx >= textX && my >= oy + this.topPad && my < oy + ph) {
                    int hsr = (my - (oy + this.topPad)) / ch;
                    if (hsr >= 0 && hsr < visible) {
                        int hdoc = c.lineNumberAt(hsr);
                        int hcol = c.firstColumn() + (mx - textX) / cw;
                        mutable String info = this.diagnosticAt(wb, base, hdoc);
                        if (info.length() == 0) {
                            info = c.hoverInfo(hdoc, hcol);
                        }
                        if (info.length() > 0) {
                            int tw2 = (info.length() + 2) * cw;
                            mutable int tx = mx;
                            if (tx + tw2 > ox + pw) {
                                tx = ox + pw - tw2;
                            }
                            if (tx < ox) {
                                tx = ox;
                            }
                            int tyt = my + ch;
                            batch.rect(tx, tyt, tw2, ch + 8, this.theme.chrome.r, this.theme.chrome.g, this.theme.chrome.b, this.theme.chrome.a);
                            batch.rect(tx, tyt, tw2, 2, this.theme.accent.r, this.theme.accent.g, this.theme.accent.b, 1.0);
                            this.font.drawText(batch, tx + cw, tyt + 4, info, this.theme.text.r, this.theme.text.g, this.theme.text.b, this.theme.text.a);
                        }
                    }
                }
            }

            // A JetBrains/VS Code-style overview ruler down the right edge of the editor: a faint scroll thumb
            // sized to the visible fraction, plus a colored tick per diagnostic at its proportional position,
            // so you see at a glance where the errors are even when they're scrolled off screen.
            // The code minimap: a zoomed-out view of the whole file on the right, each line a faint bar whose
            // width tracks the code length, with a highlighted box over the visible range. Click-scrollable.
            public method minimapW() returns int {
                return 92;
            }
            private method drawMinimap(Batch2D* batch, Controller* c, int mmX, int oy, int ph, int firstLine,
                                       int visible) returns void {
                int mmW = this.minimapW();
                batch.rect(mmX, oy, mmW, ph, this.theme.panel.r, this.theme.panel.g, this.theme.panel.b, this.theme.panel.a);
                batch.rect(mmX, oy, 1, ph, this.theme.divider.r, this.theme.divider.g, this.theme.divider.b, this.theme.divider.a);
                int total = c.editor().document().lineCount();
                if (total <= 0) {
                    return;
                }
                int maxCols = 84;
                mutable int line = 0;
                while (line < total) {
                    int y = oy + (line * ph) / total;
                    String text = c.editor().document().line(line);
                    int lead = this.leadingSpaces(text);
                    int len = text.length() - lead;
                    if (len > 0) {
                        mutable int w = (len * mmW) / maxCols;
                        if (w > mmW) {
                            w = mmW;
                        }
                        mutable int lx = (lead * mmW) / maxCols;
                        if (lx > mmW - 2) {
                            lx = mmW - 2;
                        }
                        batch.rect(mmX + lx, y, w, 1, this.theme.textDim.r, this.theme.textDim.g, this.theme.textDim.b, 0.55);
                    }
                    line = line + 1;
                }
                int vy0 = oy + (firstLine * ph) / total;
                mutable int vyH = (visible * ph) / total;
                if (vyH < 6) {
                    vyH = 6;
                }
                batch.rect(mmX, vy0, mmW, vyH, this.theme.hover.r, this.theme.hover.g, this.theme.hover.b, 0.07);
                batch.rect(mmX, vy0, mmW, 1, this.theme.accent.r, this.theme.accent.g, this.theme.accent.b, 0.5);
                batch.rect(mmX, vy0 + vyH - 1, mmW, 1, this.theme.accent.r, this.theme.accent.g, this.theme.accent.b, 0.5);
            }
            private method leadingSpaces(String s) returns int {
                mutable int i = 0;
                while (i < s.length() && s.charAt(i) == ' ') {
                    i = i + 1;
                }
                return i;
            }

            // The build message on document line `docLine` of the file `base` (0-based), prefixed by severity,
            // or "" if the line is clean. Feeds the hover tooltip.
            private method diagnosticAt(Workbench* wb, String base, int docLine) returns String {
                if (base.length() == 0) {
                    return "";
                }
                ArrayList<Diagnostic>* ds = wb.diagnostics();
                mutable int i = 0;
                while (i < ds.size()) {
                    Diagnostic* d = ds.get(i);
                    if (d.file.equals(base) && d.line - 1 == docLine) {
                        if (d.severity == 0) {
                            return "error: " + d.message;
                        }
                        return "warning: " + d.message;
                    }
                    i = i + 1;
                }
                return "";
            }

            // Read-only git-diff view over the editor (Git > Diff Current File): the raw diff, colour-coded --
            // green added, red removed, amber hunk headers, dim file headers -- with add/remove rows tinted.
            // Scrolls with the arrows/wheel; Esc closes.
            private method drawDiff(Batch2D* batch, Workbench* wb, int ox, int oy, int pw, int ph) returns void {
                DiffView* dv = wb.diffView();
                int cw = this.font.advance();
                int ch = this.font.lineHeight();
                batch.rect(ox, oy, pw, ph, this.theme.bg.r, this.theme.bg.g, this.theme.bg.b, 1.0);
                batch.rect(ox, oy, pw, ch + 8, this.theme.panel.r, this.theme.panel.g, this.theme.panel.b, 1.0);
                batch.rect(ox, oy + ch + 8, pw, 1, this.theme.accent.r, this.theme.accent.g, this.theme.accent.b, 0.5);
                this.font.drawText(batch, ox + 8, oy + 4, dv.title + "   (Esc to close)",
                    this.theme.accent.r, this.theme.accent.g, this.theme.accent.b, 1.0);
                int top = oy + ch + 12;
                int rows = (ph - ch - 12) / ch;
                mutable int r = 0;
                while (r < rows && dv.scroll + r < dv.lines.size()) {
                    int idx = dv.scroll + r;
                    int y = top + r * ch;
                    int kind = dv.kinds.get(idx);
                    String line = dv.lines.get(idx);
                    mutable float cr = this.theme.text.r;
                    mutable float cg = this.theme.text.g;
                    mutable float cb = this.theme.text.b;
                    if (kind == 1) {
                        batch.rect(ox, y, pw, ch, this.theme.added.r, this.theme.added.g, this.theme.added.b, 0.10);
                        cr = this.theme.added.r;
                        cg = this.theme.added.g;
                        cb = this.theme.added.b;
                    } else if (kind == 2) {
                        batch.rect(ox, y, pw, ch, this.theme.removed.r, this.theme.removed.g, this.theme.removed.b, 0.10);
                        cr = this.theme.removed.r;
                        cg = this.theme.removed.g;
                        cb = this.theme.removed.b;
                    } else if (kind == 3) {
                        cr = this.theme.accent.r;
                        cg = this.theme.accent.g;
                        cb = this.theme.accent.b;
                    } else if (kind == 4) {
                        cr = this.theme.textDim.r;
                        cg = this.theme.textDim.g;
                        cb = this.theme.textDim.b;
                    }
                    this.font.drawText(batch, ox + 8, y, line, cr, cg, cb, 1.0);
                    r = r + 1;
                }
                return;
            }

            // Inline peek-definition popup (Alt+F12): a bordered card of the definition's source shown just
            // below the caret (or above it if there is no room), read-only and syntax-highlighted. The
            // declaration line is banded; Enter jumps to it, Esc closes it.
            private method drawPeek(Batch2D* batch, Workbench* wb, int ox, int oy, int pw, int ph) returns void {
                Peek* pk = wb.peekView();
                Controller* c = wb.active();
                int cw = this.font.advance();
                int ch = this.font.lineHeight();
                int caretRow = c.caretScreenRow();
                int rows = pk.lines.size();
                int bodyH = (rows + 1) * ch + 10;
                mutable int py = oy + this.topPad + (caretRow + 1) * ch + 2;
                if (caretRow < 0) {
                    py = oy + this.topPad + 2;
                }
                if (py + bodyH > oy + ph) {
                    mutable int above = oy + this.topPad + caretRow * ch - bodyH - 2;
                    if (above < oy + this.topPad) {
                        above = oy + this.topPad;
                    }
                    py = above;
                }
                batch.rect(ox, py, pw, bodyH, this.theme.panel.r, this.theme.panel.g, this.theme.panel.b, 0.98);
                batch.rect(ox, py, pw, 1, this.theme.accent.r, this.theme.accent.g, this.theme.accent.b, 0.6);
                batch.rect(ox, py + bodyH - 1, pw, 1, this.theme.accent.r, this.theme.accent.g, this.theme.accent.b, 0.6);
                this.font.drawText(batch, ox + 8, py + 4, "> " + pk.file + ":" + (pk.defLine + 1).toString()
                    + "   (Enter to open  Esc to close)",
                    this.theme.accent.r, this.theme.accent.g, this.theme.accent.b, 1.0);
                mutable int i = 0;
                while (i < rows) {
                    int ly = py + ch + 6 + i * ch;
                    int docLine = pk.startLine + i;
                    if (docLine == pk.defLine) {
                        batch.rect(ox, ly, pw, ch, this.theme.accent.r, this.theme.accent.g, this.theme.accent.b, 0.12);
                    }
                    String num = (docLine + 1).toString();
                    this.font.drawText(batch, ox + 8, ly, num,
                        this.theme.textFaint.r, this.theme.textFaint.g, this.theme.textFaint.b, 1.0);
                    String line = pk.lines.get(i);
                    int px = ox + 8 + 6 * cw;
                    ArrayList<Span> spans = this.hl.tokenize(line);
                    mutable int si = 0;
                    while (si < spans.size()) {
                        this.drawSpan(batch, px, ly, cw, line, spans.get(si));
                        si = si + 1;
                    }
                    i = i + 1;
                }
                return;
            }

            private method drawOverviewRuler(Batch2D* batch, Workbench* wb, int rightX, int oy, int ph)
                    returns void {
                int rw = 12;
                int x = rightX - rw;
                batch.rect(x, oy, rw, ph, this.theme.chrome.r, this.theme.chrome.g, this.theme.chrome.b, this.theme.chrome.a);      // track
                Controller* c = wb.active();
                int total = c.lineCount();
                if (total <= 0) {
                    return;
                }
                int first = c.firstLine();
                int vis = c.visibleRows();
                int thumbY = oy + (first * ph) / total;
                mutable int thumbH = (vis * ph) / total;
                if (thumbH < 24) {
                    thumbH = 24;
                }
                batch.rect(x + 2, thumbY, rw - 4, thumbH, this.theme.accent.r, this.theme.accent.g, this.theme.accent.b, 0.28);   // amber thumb
                String base = Paths.basename(c.document().path());
                if (base.length() == 0) {
                    return;
                }
                ArrayList<Diagnostic>* ds = wb.diagnostics();
                mutable int i = 0;
                while (i < ds.size()) {
                    Diagnostic* d = ds.get(i);
                    if (d.file.equals(base)) {
                        int ty = oy + ((d.line - 1) * ph) / total;
                        mutable float r = 0.902;
                        mutable float g = 0.318;
                        mutable float b = 0.263;
                        if (d.severity != 0) {
                            g = 0.706;
                            b = 0.318;
                        }
                        batch.rect(x, ty, rw, 2, r, g, b, 1.0);
                    }
                    i = i + 1;
                }
            }

            private method drawSelection(Batch2D* batch, Controller* c, int textX, int oy, int cw, int ch,
                                         int visible, int firstLine) returns void {
                int sr = c.editor().selStartRow();
                int sc = c.editor().selStartCol();
                int er = c.editor().selEndRow();
                int ec = c.editor().selEndCol();
                mutable int row = sr;
                while (row <= er) {
                    int screenRow = c.screenRowForDocLine(row);
                    if (screenRow >= 0 && screenRow < visible) {
                        mutable int startCol = 0;
                        if (row == sr) {
                            startCol = sc;
                        }
                        mutable int endCol = c.editor().document().line(row).length();
                        if (row == er) {
                            endCol = ec;
                        }
                        mutable int wsel = (endCol - startCol) * cw;
                        if (wsel < cw && row < er) {
                            wsel = cw;
                        }
                        int x = textX + startCol * cw;
                        batch.rect(x, oy + this.topPad + screenRow * ch, wsel, ch, this.theme.accent.r, this.theme.accent.g, this.theme.accent.b, 0.22);
                    }
                    row = row + 1;
                }
            }

            // Highlight every occurrence of `query` (case-insensitive) in the visible lines -- the "find all"
            // feel while the find bar is open.
            private method drawFindMatches(Batch2D* batch, Controller* c, String query, int textX, int oy,
                                           int cw, int ch, int visible, int firstLine) returns void {
                int qlen = query.length();
                int total = c.lineCount();
                mutable int r = 0;
                while (r < visible) {
                    int docRow = c.lineNumberAt(r);
                    if (docRow < total) {
                        String line = c.editor().document().line(docRow);
                        int n = line.length();
                        mutable int i = 0;
                        while (i + qlen <= n) {
                            if (this.matchAt(line, query, i)) {
                                batch.rect(textX + i * cw, oy + this.topPad + r * ch, qlen * cw, ch,
                                           0.918, 0.706, 0.392, 0.26);
                                i = i + qlen;
                            } else {
                                i = i + 1;
                            }
                        }
                    }
                    r = r + 1;
                }
            }
            // Highlight every whole-word occurrence of the identifier under the caret (the caret's own
            // instance excluded), a faint green box, so you see where a name is used at a glance. Only kicks
            // in for identifiers of two or more characters and while nothing is selected.
            private method drawOccurrences(Batch2D* batch, Controller* c, int textX, int oy, int cw, int ch,
                                           int visible) returns void {
                String word = c.wordAtCaret();
                int wlen = word.length();
                if (wlen < 2) {
                    return;
                }
                int total = c.lineCount();
                int caretRow = c.editor().cursorRow();
                int caretCol = c.editor().cursorCol();
                mutable int r = 0;
                while (r < visible) {
                    int docRow = c.lineNumberAt(r);
                    if (docRow < total) {
                        String line = c.editor().document().line(docRow);
                        int n = line.length();
                        mutable int i = 0;
                        while (i + wlen <= n) {
                            if (GpuScreen.wordMatchAt(line, word, i)) {
                                boolean isCaretOne = docRow == caretRow && caretCol >= i && caretCol <= i + wlen;
                                if (!isCaretOne) {
                                    batch.rect(textX + i * cw, oy + this.topPad + r * ch, wlen * cw, ch,
                                               0.549, 0.784, 0.624, 0.13);
                                }
                                i = i + wlen;
                            } else {
                                i = i + 1;
                            }
                        }
                    }
                    r = r + 1;
                }
            }

            // A case-sensitive whole-word match of `word` in `line` at index `i` (identifier boundaries).
            private static method wordMatchAt(String line, String word, int i) returns boolean {
                int wlen = word.length();
                mutable int j = 0;
                while (j < wlen) {
                    if (line.charAt(i + j) != word.charAt(j)) {
                        return false;
                    }
                    j = j + 1;
                }
                if (i > 0 && GpuScreen.isWordCh(line.charAt(i - 1))) {
                    return false;
                }
                if (i + wlen < line.length() && GpuScreen.isWordCh(line.charAt(i + wlen))) {
                    return false;
                }
                return true;
            }
            private static method isWordCh(char ch) returns boolean {
                return (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z')
                    || (ch >= '0' && ch <= '9') || ch == '_';
            }

            // Draw a subtle boxed cell around a matched bracket at screen row `sr`, column `col`.
            private method drawBracketCell(Batch2D* batch, int sr, int col, int textX, int oy, int cw, int ch,
                                           int visible) returns void {
                if (sr < 0 || sr >= visible) {
                    return;
                }
                int x = textX + col * cw;
                int y = oy + this.topPad + sr * ch;
                batch.rect(x, y, cw, ch, this.theme.added.r, this.theme.added.g, this.theme.added.b, 0.16);
                batch.rect(x, y, cw, 1, this.theme.added.r, this.theme.added.g, this.theme.added.b, 0.85);
                batch.rect(x, y + ch - 1, cw, 1, this.theme.added.r, this.theme.added.g, this.theme.added.b, 0.85);
                batch.rect(x, y, 1, ch, this.theme.added.r, this.theme.added.g, this.theme.added.b, 0.85);
                batch.rect(x + cw - 1, y, 1, ch, this.theme.added.r, this.theme.added.g, this.theme.added.b, 0.85);
            }
            // The column of the bracket the caret sits on/after (-1 if none) -- mirrors Editor.matchingBracket.
            private method caretBracketCol(Controller* c, int row, int col) returns int {
                String line = c.editor().document().line(row);
                if (col < line.length() && this.isBracket(line.charAt(col))) {
                    return col;
                }
                if (col > 0 && this.isBracket(line.charAt(col - 1))) {
                    return col - 1;
                }
                return 0 - 1;
            }
            private method isBracket(char ch) returns boolean {
                return ch == '(' || ch == ')' || ch == '[' || ch == ']' || ch == '{' || ch == '}';
            }
            private method matchAt(String line, String q, int pos) returns boolean {
                int m = q.length();
                if (pos + m > line.length()) {
                    return false;
                }
                mutable int j = 0;
                while (j < m) {
                    if (this.lc(line.charAt(pos + j)) != this.lc(q.charAt(j))) {
                        return false;
                    }
                    j = j + 1;
                }
                return true;
            }
            private method lc(char c) returns char {
                if (c >= 'A' && c <= 'Z') {
                    return cast<char>(cast<int>(c) + 32);
                }
                return c;
            }

            // The autocomplete popup, anchored below the caret at the prefix start.
            public method drawCompletion(Batch2D* batch, Completion* comp, Workbench* wb, int screenW,
                                         int screenH) returns void {
                Controller* c = wb.active();
                int cw = this.font.advance();
                int ch = this.font.lineHeight();
                int ox = this.treeW;
                int cx = ox + this.gutterPx() + 6 + c.caretScreenCol() * cw;
                int cy = this.editorTop() + this.topPad + c.caretScreenRow() * ch;
                int px = cx - comp.prefix.length() * cw;
                int py = cy + ch;
                mutable int shown = comp.items.size();
                if (shown > 10) {
                    shown = 10;
                }
                int pw = 280;
                int pph = shown * (ch + 2) + 6;
                batch.rect(px, py, pw, pph, this.theme.panel.r, this.theme.panel.g, this.theme.panel.b, this.theme.panel.a);
                batch.rect(px, py, 2, pph, this.theme.accent.r, this.theme.accent.g, this.theme.accent.b, 1.0);
                mutable int i = 0;
                while (i < shown) {
                    int ry = py + 3 + i * (ch + 2);
                    if (i == comp.sel) {
                        batch.rect(px + 2, ry - 1, pw - 4, ch + 2, this.theme.accent.r, this.theme.accent.g, this.theme.accent.b, 0.18);
                    }
                    this.font.drawText(batch, px + 8, ry, comp.items.get(i), this.theme.text.r, this.theme.text.g, this.theme.text.b, this.theme.text.a);
                    i = i + 1;
                }
            }

            // Signature help: a tooltip above the caret with the declaration of the call it's inside.
            public method drawSignatureHelp(Batch2D* batch, Workbench* wb, int screenW) returns void {
                Controller* c = wb.active();
                String sig = c.signatureAtCaret();
                if (sig.length() == 0) {
                    return;
                }
                int cw = this.font.advance();
                int ch = this.font.lineHeight();
                int ccr = c.caretScreenRow();
                if (ccr < 0) {
                    return;
                }
                int cx = this.treeW + this.gutterPx() + 6 + c.caretScreenCol() * cw;
                int cy = this.editorTop() + this.topPad + ccr * ch;
                int tw = (sig.length() + 2) * cw;
                mutable int tx = cx;
                if (tx + tw > screenW) {
                    tx = screenW - tw - 4;
                }
                if (tx < this.treeW) {
                    tx = this.treeW;
                }
                mutable int ty = cy - ch - 8;
                if (ty < this.editorTop()) {
                    ty = cy + ch;
                }
                batch.rect(tx, ty, tw, ch + 8, this.theme.chrome.r, this.theme.chrome.g, this.theme.chrome.b, this.theme.chrome.a);
                batch.rect(tx, ty, tw, 2, this.theme.accent.r, this.theme.accent.g, this.theme.accent.b, 1.0);
                this.font.drawText(batch, tx + cw, ty + 4, sig, this.theme.text.r, this.theme.text.g, this.theme.text.b, this.theme.text.a);
            }

            // --- modal overlays (drawn on top of the frame) ---
            public method drawOverlay(Batch2D* batch, Overlay* ov, Workbench* wb, int screenW, int screenH)
                    returns void {
                if (ov.mode == 1) {
                    this.drawPalette(batch, ov, wb, screenW, screenH);
                }
                else if (ov.mode == 2) {
                    this.drawFindBar(batch, ov, wb, screenW);
                }
                else if (ov.mode == 3) {
                    this.drawSymbols(batch, ov, screenW, screenH);
                }
                else if (ov.mode == 4) {
                    this.drawQuickOpen(batch, ov, screenW, screenH);
                }
                else if (ov.mode == 5) {
                    this.drawGoToLine(batch, ov, screenW);
                }
                else if (ov.mode == 6) {
                    this.drawFindInFiles(batch, ov, screenW);
                }
                else if (ov.mode == 7) {
                    this.drawPrompt(batch, ov, screenW);
                }
            }

            // A generic single-line text prompt (mode 7): the label, the typed text, a caret. Enter runs the
            // action named by ov.promptKind (e.g. a commit message).
            private method drawPrompt(Batch2D* batch, Overlay* ov, int screenW) returns void {
                int cw = this.font.advance();
                int ch = this.font.lineHeight();
                int bw = 520;
                int bx = (screenW - bw) / 2;
                int by = 70;
                int bh = ch + 14;
                batch.rect(bx, by, bw, bh, this.theme.panel.r, this.theme.panel.g, this.theme.panel.b, this.theme.panel.a);
                batch.rect(bx, by, bw, 2, this.theme.accent.r, this.theme.accent.g, this.theme.accent.b, 1.0);
                this.font.drawText(batch, bx + 12, by + 7, ov.promptLabel, this.theme.textDim.r, this.theme.textDim.g, this.theme.textDim.b, this.theme.textDim.a);
                int lx = bx + 12 + ov.promptLabel.length() * cw;
                this.font.drawText(batch, lx, by + 7, ov.query, this.theme.text.r, this.theme.text.g, this.theme.text.b, this.theme.text.a);
                batch.rect(lx + ov.query.length() * cw, by + 7, 2, ch, this.theme.accent.r, this.theme.accent.g, this.theme.accent.b, 1.0);
            }

            // Find-in-files box (Ctrl+Shift+F): a centered input; Enter greps the project into the output panel.
            private method drawFindInFiles(Batch2D* batch, Overlay* ov, int screenW) returns void {
                int cw = this.font.advance();
                int ch = this.font.lineHeight();
                int bw = 460;
                int bx = (screenW - bw) / 2;
                int by = 70;
                int bh = ch + 14;
                batch.rect(bx, by, bw, bh, this.theme.panel.r, this.theme.panel.g, this.theme.panel.b, this.theme.panel.a);
                batch.rect(bx, by, bw, 2, this.theme.accent.r, this.theme.accent.g, this.theme.accent.b, 1.0);
                this.font.drawText(batch, bx + 12, by + 7, "find in files: ", this.theme.textDim.r, this.theme.textDim.g, this.theme.textDim.b, this.theme.textDim.a);
                int lx = bx + 12 + 15 * cw;
                this.font.drawText(batch, lx, by + 7, ov.query, this.theme.text.r, this.theme.text.g, this.theme.text.b, this.theme.text.a);
                batch.rect(lx + ov.query.length() * cw, by + 7, 2, ch, this.theme.accent.r, this.theme.accent.g, this.theme.accent.b, 1.0);
            }

            // Go-to-line box (Ctrl+G): a small centered input for a line number.
            private method drawGoToLine(Batch2D* batch, Overlay* ov, int screenW) returns void {
                int cw = this.font.advance();
                int ch = this.font.lineHeight();
                int bw = 320;
                int bx = (screenW - bw) / 2;
                int by = 70;
                int bh = ch + 14;
                batch.rect(bx, by, bw, bh, this.theme.panel.r, this.theme.panel.g, this.theme.panel.b, this.theme.panel.a);
                batch.rect(bx, by, bw, 2, this.theme.accent.r, this.theme.accent.g, this.theme.accent.b, 1.0);
                this.font.drawText(batch, bx + 12, by + 7, "line: ", this.theme.textDim.r, this.theme.textDim.g, this.theme.textDim.b, this.theme.textDim.a);
                this.font.drawText(batch, bx + 12 + 6 * cw, by + 7, ov.query, this.theme.text.r, this.theme.text.g, this.theme.text.b, this.theme.text.a);
                int qx = bx + 12 + (6 + ov.query.length()) * cw;
                batch.rect(qx, by + 7, 2, ch, this.theme.accent.r, this.theme.accent.g, this.theme.accent.b, 1.0);
            }

            // The quick-open file picker (Ctrl+P): a centered list of project files filtered by the query,
            // basename bright with the path dim beside it, the selected row highlighted.
            private method drawQuickOpen(Batch2D* batch, Overlay* ov, int screenW, int screenH) returns void {
                int cw = this.font.advance();
                int ch = this.font.lineHeight();
                int bw = 640;
                int bx = (screenW - bw) / 2;
                int by = 70;
                ArrayList<int>* m = ov.matches();
                mutable int shown = m.size();
                if (shown > 14) {
                    shown = 14;
                }
                int bh = ch + 12 + shown * (ch + 4) + 8;
                batch.rect(0, 0, screenW, screenH, 0.0, 0.0, 0.0, 0.35);
                batch.rect(bx, by, bw, bh, this.theme.panel.r, this.theme.panel.g, this.theme.panel.b, this.theme.panel.a);
                batch.rect(bx, by, bw, 2, this.theme.accent.r, this.theme.accent.g, this.theme.accent.b, 1.0);
                this.font.drawText(batch, bx + 12, by + 7, "> ", this.theme.accent.r, this.theme.accent.g, this.theme.accent.b, 1.0);
                this.font.drawText(batch, bx + 12 + 2 * cw, by + 7, ov.query, this.theme.text.r, this.theme.text.g, this.theme.text.b, this.theme.text.a);
                int qx = bx + 12 + (2 + ov.query.length()) * cw;
                batch.rect(qx, by + 7, 2, ch, this.theme.accent.r, this.theme.accent.g, this.theme.accent.b, 1.0);
                mutable int i = 0;
                while (i < shown) {
                    int orig = m.get(i);
                    int ry = by + ch + 12 + i * (ch + 4);
                    if (i == ov.sel) {
                        batch.rect(bx + 4, ry - 2, bw - 8, ch + 4, this.theme.accent.r, this.theme.accent.g, this.theme.accent.b, 0.18);
                    }
                    String path = ov.items.get(orig);
                    String name = Paths.basename(path);
                    this.font.drawText(batch, bx + 16, ry, name, this.theme.text.r, this.theme.text.g, this.theme.text.b, this.theme.text.a);
                    this.font.drawText(batch, bx + 16 + (name.length() + 2) * cw, ry, path,
                                       0.376, 0.478, 0.475, 1.0);
                    i = i + 1;
                }
            }

            // The go-to-symbol navigator (Ctrl+Shift+O): a centered list of the file's declarations filtered by
            // the query, each with its line number, the selected row highlighted.
            private method drawSymbols(Batch2D* batch, Overlay* ov, int screenW, int screenH) returns void {
                int cw = this.font.advance();
                int ch = this.font.lineHeight();
                int bw = 560;
                int bx = (screenW - bw) / 2;
                int by = 70;
                ArrayList<int>* m = ov.matches();
                mutable int shown = m.size();
                if (shown > 14) {
                    shown = 14;
                }
                int bh = ch + 12 + shown * (ch + 4) + 8;
                batch.rect(0, 0, screenW, screenH, 0.0, 0.0, 0.0, 0.35);        // dim backdrop
                batch.rect(bx, by, bw, bh, this.theme.panel.r, this.theme.panel.g, this.theme.panel.b, this.theme.panel.a);
                batch.rect(bx, by, bw, 2, this.theme.accent.r, this.theme.accent.g, this.theme.accent.b, 1.0);
                // query row (a leading '#' hints "symbols")
                this.font.drawText(batch, bx + 12, by + 7, "# ", this.theme.accent.r, this.theme.accent.g, this.theme.accent.b, 1.0);
                this.font.drawText(batch, bx + 12 + 2 * cw, by + 7, ov.query, this.theme.text.r, this.theme.text.g, this.theme.text.b, this.theme.text.a);
                int qx = bx + 12 + (2 + ov.query.length()) * cw;
                batch.rect(qx, by + 7, 2, ch, this.theme.accent.r, this.theme.accent.g, this.theme.accent.b, 1.0);
                mutable int i = 0;
                while (i < shown) {
                    int orig = m.get(i);
                    int ry = by + ch + 12 + i * (ch + 4);
                    if (i == ov.sel) {
                        batch.rect(bx + 4, ry - 2, bw - 8, ch + 4, this.theme.accent.r, this.theme.accent.g, this.theme.accent.b, 0.18);
                    }
                    this.font.drawText(batch, bx + 16, ry, ov.items.get(orig), this.theme.text.r, this.theme.text.g, this.theme.text.b, this.theme.text.a);
                    String ln = ":" + ov.targets.get(orig).toString();
                    this.font.drawText(batch, bx + bw - 16 - ln.length() * cw, ry, ln, this.theme.textFaint.r, this.theme.textFaint.g, this.theme.textFaint.b, this.theme.textFaint.a);
                    i = i + 1;
                }
            }

            private method drawPalette(Batch2D* batch, Overlay* ov, Workbench* wb, int screenW, int screenH)
                    returns void {
                int cw = this.font.advance();
                int ch = this.font.lineHeight();
                int bw = 640;
                int bx = (screenW - bw) / 2;
                int by = 70;
                ArrayList<Command>* results = wb.registry().filter(ov.query);
                mutable int shown = results.size();
                if (shown > 12) {
                    shown = 12;
                }
                int bh = ch + 12 + shown * (ch + 4) + 8;
                batch.rect(0, 0, screenW, screenH, 0.0, 0.0, 0.0, 0.35);        // dim backdrop
                batch.rect(bx, by, bw, bh, this.theme.panel.r, this.theme.panel.g, this.theme.panel.b, this.theme.panel.a);
                batch.rect(bx, by, bw, 2, this.theme.accent.r, this.theme.accent.g, this.theme.accent.b, 1.0);
                // query row
                this.font.drawText(batch, bx + 12, by + 7, "> ", this.theme.accent.r, this.theme.accent.g, this.theme.accent.b, 1.0);
                this.font.drawText(batch, bx + 12 + 2 * cw, by + 7, ov.query, this.theme.text.r, this.theme.text.g, this.theme.text.b, this.theme.text.a);
                int qx = bx + 12 + (2 + ov.query.length()) * cw;
                batch.rect(qx, by + 7, 2, ch, this.theme.accent.r, this.theme.accent.g, this.theme.accent.b, 1.0);
                // results
                mutable int i = 0;
                while (i < shown) {
                    int ry = by + ch + 12 + i * (ch + 4);
                    if (i == ov.sel) {
                        batch.rect(bx + 4, ry - 2, bw - 8, ch + 4, this.theme.accent.r, this.theme.accent.g, this.theme.accent.b, 0.18);
                    }
                    Command* cmd = results.get(i);
                    this.font.drawText(batch, bx + 16, ry, cmd.title, this.theme.text.r, this.theme.text.g, this.theme.text.b, this.theme.text.a);
                    int idx = bx + bw - 16 - cmd.id.length() * cw;
                    this.font.drawText(batch, idx, ry, cmd.id, this.theme.textFaint.r, this.theme.textFaint.g, this.theme.textFaint.b, this.theme.textFaint.a);
                    i = i + 1;
                }
            }

            // Find & replace panel (Ctrl+F): a find row with a live match count and a replace row. Tab moves
            // focus between the two fields (the focused one shows the caret and a brighter label).
            private method drawFindBar(Batch2D* batch, Overlay* ov, Workbench* wb, int screenW) returns void {
                int cw = this.font.advance();
                int ch = this.font.lineHeight();
                int bw = 480;
                int bx = screenW - bw - 24;
                int by = this.contentTop() + 10;
                int rowH = ch + 9;
                int bh = rowH * 2 + 10;
                batch.rect(bx, by, bw, bh, this.theme.panel.r, this.theme.panel.g, this.theme.panel.b, this.theme.panel.a);
                batch.rect(bx, by, 3, bh, this.theme.accent.r, this.theme.accent.g, this.theme.accent.b, 1.0);
                // find row
                int fy = by + 6;
                this.drawField(batch, bx, fy, cw, ch, "find", ov.query, !ov.focusReplace);
                int total = wb.active().matchCount(ov.query);
                mutable String cnt = total.toString() + " found";
                if (ov.query.length() == 0) {
                    cnt = "";
                }
                this.font.drawText(batch, bx + bw - (cnt.length() + 1) * cw, fy, cnt, this.theme.textDim.r, this.theme.textDim.g, this.theme.textDim.b, this.theme.textDim.a);
                // replace row
                int ry = by + 6 + rowH;
                this.drawField(batch, bx, ry, cw, ch, "repl", ov.replace, ov.focusReplace);
                // hint
                String hint = "Enter next  Shift+Enter prev  Tab field  ^A all";
                if (bw - 24 > hint.length() * cw) {
                    this.font.drawText(batch, bx + bw - (hint.length() + 1) * cw, ry, hint, this.theme.textFaint.r, this.theme.textFaint.g, this.theme.textFaint.b, this.theme.textFaint.a);
                }
            }
            // One labelled input row of the find panel; draws the caret when it is the focused field.
            private method drawField(Batch2D* batch, int bx, int y, int cw, int ch, String caption, String text,
                                     boolean focused) returns void {
                mutable float lr = 0.376;
                mutable float lg = 0.478;
                mutable float lb = 0.475;
                if (focused) {
                    lr = 0.918;
                    lg = 0.706;
                    lb = 0.392;
                }
                this.font.drawText(batch, bx + 12, y, caption, lr, lg, lb, 1.0);
                this.font.drawText(batch, bx + 12 + 5 * cw, y, text, this.theme.text.r, this.theme.text.g, this.theme.text.b, this.theme.text.a);
                if (focused) {
                    int qx = bx + 12 + (5 + text.length()) * cw;
                    batch.rect(qx, y, 2, ch, this.theme.accent.r, this.theme.accent.g, this.theme.accent.b, 1.0);
                }
            }

            // A chevron in the gutter for a foldable line: a bright amber right-pointing triangle when the
            // block is collapsed, a clear down-pointing one when it's expanded. Drawn from rects (no glyph in
            // the atlas). The whole gutter is the click target, so this is just the visual affordance.
            private method drawFoldMarker(Batch2D* batch, int cx, int cy, boolean folded) returns void {
                mutable int k = 0;
                if (folded) {
                    // right-pointing filled triangle
                    while (k < 6) {
                        batch.rect(cx + k, cy - (6 - k), 1, (6 - k) * 2, this.theme.accent.r, this.theme.accent.g, this.theme.accent.b, 1.0);
                        k = k + 1;
                    }
                } else {
                    // down-pointing filled triangle
                    while (k < 6) {
                        batch.rect(cx - (6 - k), cy - 3 + k, (6 - k) * 2, 1, this.theme.text.r, this.theme.text.g, this.theme.text.b, 0.95);
                        k = k + 1;
                    }
                }
            }

            // Faint vertical guides at each indent level up to `lead` spaces -- the "where does this block
            // sit" cue. `lead` is the fold/blank-aware effective indent so the guides stay continuous.
            private method drawIndentGuides(Batch2D* batch, int lead, int textX, int y, int cw, int ch)
                    returns void {
                mutable int col = 4;
                while (col < lead) {
                    batch.rect(textX + col * cw, y, 1, ch, this.theme.textFaint.r, this.theme.textFaint.g, this.theme.textFaint.b, 0.5);
                    col = col + 4;
                }
            }

            // Is this span a single bracket character the highlighter classified as punctuation? (Brackets in
            // strings/chars/comments are not PUNCT, so they are never colourised.)
            private method isBracketSpan(String line, Span* sp) returns boolean {
                if (sp.kind != Tok.PUNCT || sp.end != sp.start + 1) {
                    return false;
                }
                char c = line.charAt(sp.start);
                return c == '(' || c == ')' || c == '[' || c == ']' || c == '{' || c == '}';
            }
            // Draw a bracket tinted by its nesting depth (rainbow brackets), cycling three theme colours.
            private method drawBracket(Batch2D* batch, int textX, int y, int cw, String line, Span* sp, int depth)
                    returns void {
                int x = textX + sp.start * cw;
                mutable int idx = depth % 3;
                if (idx < 0) {
                    idx = 0;
                }
                mutable Color* col = this.theme.bracket1;
                if (idx == 1) {
                    col = this.theme.bracket2;
                } else if (idx == 2) {
                    col = this.theme.bracket3;
                }
                this.font.drawSub(batch, x, y, line, sp.start, sp.end, col.r, col.g, col.b, col.a);
            }

            private method drawSpan(Batch2D* batch, int textX, int y, int cw, String line, Span* sp)
                    returns void {
                Tok k = sp.kind;
                int x = textX + sp.start * cw;
                if (k == Tok.WS) {
                    return;
                }
                // A multi-hue scheme in the Forge world: amber for structural declarations (the identity
                // colour), teal for types, magenta for control flow, blue for modifiers, coral for word
                // operators and self-refs, yellow for calls, green for literals/comments.
                if (k == Tok.DECL) {
                    this.font.drawSub(batch, x, y, line, sp.start, sp.end, this.theme.tDecl.r, this.theme.tDecl.g, this.theme.tDecl.b, this.theme.tDecl.a);
                    return;
                }
                if (k == Tok.CONTROL) {
                    this.font.drawSub(batch, x, y, line, sp.start, sp.end, this.theme.tControl.r, this.theme.tControl.g, this.theme.tControl.b, this.theme.tControl.a);
                    return;
                }
                if (k == Tok.MODIFIER) {
                    this.font.drawSub(batch, x, y, line, sp.start, sp.end, this.theme.tModifier.r, this.theme.tModifier.g, this.theme.tModifier.b, this.theme.tModifier.a);
                    return;
                }
                if (k == Tok.TYPE) {
                    this.font.drawSub(batch, x, y, line, sp.start, sp.end, this.theme.tType.r, this.theme.tType.g, this.theme.tType.b, this.theme.tType.a);
                    return;
                }
                if (k == Tok.TYPENAME) {
                    this.font.drawSub(batch, x, y, line, sp.start, sp.end, this.theme.tTypeName.r, this.theme.tTypeName.g, this.theme.tTypeName.b, this.theme.tTypeName.a);
                    return;
                }
                if (k == Tok.OPWORD) {
                    this.font.drawSub(batch, x, y, line, sp.start, sp.end, this.theme.tOpword.r, this.theme.tOpword.g, this.theme.tOpword.b, this.theme.tOpword.a);
                    return;
                }
                if (k == Tok.SELFKW) {
                    this.font.drawSub(batch, x, y, line, sp.start, sp.end, this.theme.tSelf.r, this.theme.tSelf.g, this.theme.tSelf.b, this.theme.tSelf.a);
                    return;
                }
                if (k == Tok.CONSTANT) {
                    this.font.drawSub(batch, x, y, line, sp.start, sp.end, this.theme.tConstant.r, this.theme.tConstant.g, this.theme.tConstant.b, this.theme.tConstant.a);
                    return;
                }
                if (k == Tok.FUNC) {
                    this.font.drawSub(batch, x, y, line, sp.start, sp.end, this.theme.tFunc.r, this.theme.tFunc.g, this.theme.tFunc.b, this.theme.tFunc.a);
                    return;
                }
                if (k == Tok.KEYWORD) {
                    this.font.drawSub(batch, x, y, line, sp.start, sp.end, this.theme.tDecl.r, this.theme.tDecl.g, this.theme.tDecl.b, this.theme.tDecl.a);
                    return;
                }
                if (k == Tok.NUMBER) {
                    this.font.drawSub(batch, x, y, line, sp.start, sp.end, this.theme.tNumber.r, this.theme.tNumber.g, this.theme.tNumber.b, this.theme.tNumber.a);
                    return;
                }
                if (k == Tok.STRING) {
                    this.font.drawSub(batch, x, y, line, sp.start, sp.end, this.theme.tString.r, this.theme.tString.g, this.theme.tString.b, this.theme.tString.a);
                    return;
                }
                if (k == Tok.CHAR) {
                    this.font.drawSub(batch, x, y, line, sp.start, sp.end, this.theme.tString.r, this.theme.tString.g, this.theme.tString.b, this.theme.tString.a);
                    return;
                }
                if (k == Tok.COMMENT) {
                    this.font.drawSub(batch, x, y, line, sp.start, sp.end, this.theme.tComment.r, this.theme.tComment.g, this.theme.tComment.b, this.theme.tComment.a);
                    return;
                }
                if (k == Tok.PUNCT) {
                    this.font.drawSub(batch, x, y, line, sp.start, sp.end, this.theme.tPunct.r, this.theme.tPunct.g, this.theme.tPunct.b, this.theme.tPunct.a);
                    return;
                }
                this.font.drawSub(batch, x, y, line, sp.start, sp.end, this.theme.text.r, this.theme.text.g, this.theme.text.b, this.theme.text.a);
            }
        }
    }
}
