import gfx.Batch2D;
import gfx.Font;
import gfx.Overlay;
import app.Controller;
import app.Workbench;
import app.DocumentManager;
import app.Command;
import app.CommandRegistry;
import app.OutputPanel;
import app.Diagnostic;
import app.Completion;
import app.MenuBar;
import app.Menu;
import app.MenuItem;
import io.FileTree;
import io.FileNode;
import syntax.Tok;
import syntax.Span;
import System.Collections.ArrayList;
import System.IO.Paths;

program Forge;

public bundle forge {
    public namespace gfx {

        // Draws the whole IDE frame on the GPU -- the graphical counterpart of ScreenRenderer. It composes a
        // tab bar, a project tree panel, and the editor pane (gutter + line numbers + token-coloured code +
        // current-line highlight + selection + caret), all from live Workbench + FileTree state through
        // Batch2D quads. It owns no model state; the caller passes the Workbench each frame.
        public class GpuScreen {
            private mutable Font* font;
            private mutable int gutterChars;
            private mutable int topPad;
            private mutable int treeW;

            public constructor GpuScreen(Font* font) {
                this.font = font;
                this.gutterChars = 6;
                this.topPad = 6;
                this.treeW = 230;
            }

            public method fontTexture() returns int { return this.font.texture(); }
            public method gutterPx() returns int { return this.gutterChars * this.font.advance() + 16; }
            public method menuH() returns int { return this.font.lineHeight() + 8; }
            public method tabH() returns int { return this.font.lineHeight() + 12; }
            public method statusH() returns int { return this.font.lineHeight() + 8; }
            // Pixel y where the tab bar / tree / editor begin, below the menu bar.
            public method contentTop() returns int { return this.menuH() + this.tabH(); }
            public method treeWidth() returns int { return this.treeW; }
            public method charW() returns int { return this.font.advance(); }
            public method lineH() returns int { return this.font.lineHeight(); }
            // Pixel origin of the code text (for mouse hit-testing).
            public method textOx() returns int { return this.treeW + this.gutterPx() + 6; }
            public method textOy() returns int { return this.contentTop() + this.topPad; }
            // Which tab index is under pixel x in the tab bar (-1 if none) -- mirrors drawTabBar's layout.
            public method tabAtX(DocumentManager* docs, int mx) returns int {
                int cw = this.font.advance();
                mutable int x = 6;
                mutable int i = 0;
                while (i < docs.count()) {
                    int tw = (docs.title(i).length() + 3) * cw;
                    if (mx >= x && mx < x + tw) { return i; }
                    x = x + tw;
                    i = i + 1;
                }
                return 0 - 1;
            }
            // Which tree row is under pixel y (may be out of range; the caller checks against visible()).
            public method treeRowAtY(int my) returns int {
                return (my - (this.contentTop() + 6)) / this.font.lineHeight();
            }
            // Viewport rows/cols that fit the editor pane of a pixel window (window minus chrome).
            public method paneRowsFor(int screenH) returns int {
                return (screenH - this.contentTop() - this.statusH() - this.topPad) / this.font.lineHeight();
            }
            public method paneColsFor(int screenW) returns int {
                return (screenW - this.treeW - this.gutterPx() - 8) / this.font.advance();
            }

            // Compose the full IDE frame.
            public method drawWorkbench(Batch2D* batch, Workbench* wb, FileTree* tree, int screenW, int screenH)
                    returns void {
                int mh = this.menuH();
                int tabh = this.tabH();
                int ctop = mh + tabh;
                int tw = this.treeW;
                // chrome panel backgrounds
                batch.rect(0, mh, screenW, tabh, 0.027, 0.055, 0.063, 1.0);             // tab bar
                batch.rect(0, ctop, tw, screenH - ctop, 0.035, 0.070, 0.078, 1.0);      // tree panel
                batch.rect(tw, ctop, 1, screenH - ctop, 0.016, 0.035, 0.039, 1.0);      // tree/editor divider
                int sh = this.statusH();
                mutable int panelH = 0;
                if (wb.output().visible) { panelH = 220; }
                this.drawTabBar(batch, wb.documents(), mh, tabh);
                this.drawTree(batch, tree, ctop, screenH - sh);
                this.drawEditor(batch, wb, tw, ctop, screenW - tw, screenH - ctop - sh - panelH);
                if (panelH > 0) {
                    this.drawOutputPanel(batch, wb.output(), tw, screenH - sh - panelH, screenW - tw, panelH);
                }
                this.drawStatusBar(batch, wb, screenW, screenH, sh);
            }

            // The top menu bar (File / Edit / View / Run / Help). Drawn on top of the frame so the open menu's
            // title can highlight; the dropdown itself is drawn separately by drawMenuDropdown.
            public method drawMenuBar(Batch2D* batch, MenuBar* mb, int screenW) returns void {
                int cw = this.font.advance();
                int mh = this.menuH();
                batch.rect(0, 0, screenW, mh, 0.031, 0.063, 0.071, 1.0);
                batch.rect(0, mh - 1, screenW, 1, 0.016, 0.035, 0.039, 1.0);      // bottom hairline
                int ty = (mh - this.font.lineHeight()) / 2;
                mutable int x = 8;
                mutable int i = 0;
                while (i < mb.count()) {
                    String t = mb.title(i);
                    int tw = (t.length() + 2) * cw;
                    boolean isOpen = mb.openIndex == i;
                    mutable float r = 0.706;
                    mutable float g = 0.769;
                    mutable float b = 0.761;
                    if (isOpen) {
                        batch.rect(x, 0, tw, mh, 0.063, 0.106, 0.114, 1.0);
                        r = 0.918; g = 0.706; b = 0.392;
                    }
                    this.font.drawText(batch, x + cw, ty, t, r, g, b, 1.0);
                    x = x + tw;
                    i = i + 1;
                }
            }

            // The open menu's dropdown, anchored under its title. Does nothing if no menu is open.
            public method drawMenuDropdown(Batch2D* batch, MenuBar* mb) returns void {
                if (!mb.isOpen()) { return; }
                int cw = this.font.advance();
                int ch = this.font.lineHeight();
                int mh = this.menuH();
                Menu* m = mb.openMenu();
                int x = this.menuTitleX(mb, mb.openIndex);
                int dw = this.dropdownWidth(m, cw);
                int rowH = ch + 6;
                mutable int dh = 6;
                mutable int i = 0;
                while (i < m.items.size()) {
                    if (m.items.get(i).isSeparator()) { dh = dh + 7; } else { dh = dh + rowH; }
                    i = i + 1;
                }
                batch.rect(x, mh, dw, dh, 0.063, 0.106, 0.114, 1.0);
                batch.rect(x, mh, dw, 2, 0.918, 0.706, 0.392, 1.0);
                mutable int y = mh + 3;
                i = 0;
                while (i < m.items.size()) {
                    MenuItem* it = m.items.get(i);
                    if (it.isSeparator()) {
                        batch.rect(x + 6, y + 3, dw - 12, 1, 0.204, 0.278, 0.290, 1.0);
                        y = y + 7;
                    } else {
                        this.font.drawText(batch, x + cw, y + 3, it.caption, 0.804, 0.851, 0.843, 1.0);
                        y = y + rowH;
                    }
                    i = i + 1;
                }
            }

            private method dropdownWidth(Menu* m, int cw) returns int {
                mutable int maxc = 12;
                mutable int i = 0;
                while (i < m.items.size()) {
                    int l = m.items.get(i).caption.length();
                    if (l > maxc) { maxc = l; }
                    i = i + 1;
                }
                return (maxc + 4) * cw;
            }

            // x pixel where menu title `idx` begins (mirrors drawMenuBar's layout).
            public method menuTitleX(MenuBar* mb, int idx) returns int {
                int cw = this.font.advance();
                mutable int x = 8;
                mutable int i = 0;
                while (i < idx) { x = x + (mb.title(i).length() + 2) * cw; i = i + 1; }
                return x;
            }
            // Which menu title is under pixel x in the bar (-1 if none). Only meaningful when my < menuH().
            public method menuTitleAtX(MenuBar* mb, int mx) returns int {
                int cw = this.font.advance();
                mutable int x = 8;
                mutable int i = 0;
                while (i < mb.count()) {
                    int tw = (mb.title(i).length() + 2) * cw;
                    if (mx >= x && mx < x + tw) { return i; }
                    x = x + tw;
                    i = i + 1;
                }
                return 0 - 1;
            }
            // Which dropdown item is under pixel (mx, my) for the open menu (-1 if none or on a separator).
            public method dropdownItemAt(MenuBar* mb, int mx, int my) returns int {
                if (!mb.isOpen()) { return 0 - 1; }
                int cw = this.font.advance();
                int ch = this.font.lineHeight();
                int mh = this.menuH();
                Menu* m = mb.openMenu();
                int x = this.menuTitleX(mb, mb.openIndex);
                int dw = this.dropdownWidth(m, cw);
                if (mx < x || mx >= x + dw || my < mh) { return 0 - 1; }
                int rowH = ch + 6;
                mutable int y = mh + 3;
                mutable int i = 0;
                while (i < m.items.size()) {
                    MenuItem* it = m.items.get(i);
                    mutable int h = rowH;
                    if (it.isSeparator()) { h = 7; }
                    if (my >= y && my < y + h) {
                        if (it.isSeparator()) { return 0 - 1; }
                        return i;
                    }
                    y = y + h;
                    i = i + 1;
                }
                return 0 - 1;
            }

            // The build/run output panel: a titled band at the bottom of the editor area showing the tail of
            // the captured command output.
            private method drawOutputPanel(Batch2D* batch, OutputPanel* panel, int ox, int oy, int pw, int ph)
                    returns void {
                int ch = this.font.lineHeight();
                batch.rect(ox, oy, pw, ph, 0.043, 0.086, 0.094, 1.0);
                batch.rect(ox, oy, pw, 1, 0.016, 0.035, 0.039, 1.0);
                this.font.drawText(batch, ox + 10, oy + 4, panel.title, 0.918, 0.706, 0.392, 1.0);
                int headerH = ch + 8;
                int rows = (ph - headerH) / ch;
                int total = panel.lineCount();
                mutable int start = 0;
                if (total > rows) { start = total - rows; }
                mutable int i = start;
                mutable int y = oy + headerH;
                while (i < total) {
                    this.font.drawText(batch, ox + 10, y, panel.line(i), 0.784, 0.831, 0.824, 1.0);
                    y = y + ch;
                    i = i + 1;
                }
            }

            // Bottom status bar: an amber mode chip, the file, the caret position, and the line count.
            private method drawStatusBar(Batch2D* batch, Workbench* wb, int screenW, int screenH, int sh)
                    returns void {
                int cw = this.font.advance();
                int y0 = screenH - sh;
                int ty = y0 + 4;
                batch.rect(0, y0, screenW, sh, 0.027, 0.055, 0.063, 1.0);
                batch.rect(0, y0, screenW, 1, 0.016, 0.035, 0.039, 1.0);   // top hairline
                Controller* c = wb.active();
                // amber mode chip
                int chipW = 6 * cw;
                batch.rect(0, y0, chipW, sh, 0.918, 0.706, 0.392, 1.0);
                this.font.drawText(batch, cw, ty, "LDP3", 0.125, 0.086, 0.043, 1.0);
                // file name + dirty marker
                mutable String name = c.document().path();
                if (name.length() == 0) { name = "untitled"; }
                if (c.document().isModified()) { name = name + " *"; }
                this.font.drawText(batch, chipW + cw, ty, name, 0.804, 0.851, 0.843, 1.0);
                // diagnostics count (errors red, warnings amber)
                int errs = wb.errorCount();
                int warns = wb.warningCount();
                if (errs > 0 || warns > 0) {
                    int dx = chipW + cw + (name.length() + 3) * cw;
                    String ecnt = "x" + errs.toString();
                    mutable float er = 0.902;
                    if (errs == 0) { er = 0.4; }
                    this.font.drawText(batch, dx, ty, ecnt, er, 0.318, 0.263, 1.0);
                    String wcnt = "!" + warns.toString();
                    this.font.drawText(batch, dx + (ecnt.length() + 1) * cw, ty, wcnt, 0.902, 0.706, 0.318, 1.0);
                }
                // caret position, right side
                String pos = "Ln " + (c.editor().cursorRow() + 1).toString()
                           + ", Col " + (c.editor().cursorCol() + 1).toString()
                           + "    " + c.lineCount().toString() + " lines";
                int px = screenW - (pos.length() + 2) * cw;
                this.font.drawText(batch, px, ty, pos, 0.502, 0.588, 0.584, 1.0);
            }

            private method drawTabBar(Batch2D* batch, DocumentManager* docs, int top, int tabh) returns void {
                int cw = this.font.advance();
                int ty = top + (tabh - this.font.lineHeight()) / 2;
                mutable int x = 6;
                mutable int i = 0;
                while (i < docs.count()) {
                    String title = docs.title(i);
                    int tw = (title.length() + 3) * cw;
                    boolean active = i == docs.activeIndex();
                    mutable float r = 0.502;
                    mutable float g = 0.588;
                    mutable float b = 0.584;
                    if (active) {
                        batch.rect(x, top, tw, tabh, 0.051, 0.102, 0.114, 1.0);   // active tab = editor ground
                        batch.rect(x, top, tw, 2, 0.918, 0.706, 0.392, 1.0);      // amber accent
                        r = 0.804; g = 0.851; b = 0.843;
                    }
                    this.font.drawText(batch, x + cw, ty, title, r, g, b, 1.0);
                    x = x + tw;
                    i = i + 1;
                }
            }

            private method drawTree(Batch2D* batch, FileTree* tree, int top, int screenH) returns void {
                int ch = this.font.lineHeight();
                ArrayList<FileNode>* rows = tree.visible();
                mutable int i = 0;
                while (i < rows.size()) {
                    int y = top + 6 + i * ch;
                    if (y + ch > screenH) { return; }
                    FileNode* node = rows.get(i);
                    mutable float r = 0.576;
                    mutable float g = 0.678;
                    mutable float b = 0.667;
                    if (node.isDir) { r = 0.918; g = 0.706; b = 0.392; }
                    this.font.drawText(batch, 8, y, tree.rowLabel(node), r, g, b, 1.0);
                    i = i + 1;
                }
            }

            // The editor pane at (ox, oy), size (pw, ph).
            private method drawEditor(Batch2D* batch, Workbench* wb, int ox, int oy, int pw, int ph)
                    returns void {
                Controller* c = wb.active();
                int cw = this.font.advance();
                int ch = this.font.lineHeight();
                int gpx = this.gutterPx();
                int textX = ox + gpx + 6;
                int caretRow = c.caretScreenRow();
                int visible = c.visibleRows();
                int firstLine = c.firstLine();

                batch.rect(ox, oy, gpx, ph, 0.039, 0.078, 0.086, 1.0);   // gutter band

                if (c.editor().hasSelection()) {
                    this.drawSelection(batch, c, textX, oy, cw, ch, visible, firstLine);
                }

                mutable int r = 0;
                while (r < visible) {
                    int y = oy + this.topPad + r * ch;
                    if (r == caretRow) {
                        batch.rect(ox + gpx, y, pw - gpx, ch, 1.0, 1.0, 1.0, 0.035);
                    }
                    String num = (c.lineNumberAt(r) + 1).toString();
                    int nx = ox + gpx - 8 - num.length() * cw;
                    this.font.drawText(batch, nx, y, num, 0.208, 0.329, 0.353, 1.0);
                    String line = c.renderLine(r);
                    ArrayList<Span> spans = c.renderSpans(r);
                    mutable int si = 0;
                    while (si < spans.size()) {
                        this.drawSpan(batch, textX, y, cw, line, spans.get(si));
                        si = si + 1;
                    }
                    r = r + 1;
                }

                int ccr = c.caretScreenRow();
                if (ccr >= 0 && ccr < visible) {
                    int cx = textX + c.caretScreenCol() * cw;
                    batch.rect(cx, oy + this.topPad + ccr * ch, 2, ch, 0.918, 0.706, 0.392, 1.0);
                }

                // diagnostics (from the last build) for this file: a gutter marker + an underline
                String base = Paths.basename(c.document().path());
                if (base.length() > 0) {
                    ArrayList<Diagnostic>* ds = wb.diagnostics();
                    mutable int di = 0;
                    while (di < ds.size()) {
                        Diagnostic* d = ds.get(di);
                        int sr = (d.line - 1) - firstLine;
                        if (d.file.equals(base) && sr >= 0 && sr < visible) {
                            int y = oy + this.topPad + sr * ch;
                            mutable float dr = 0.902;
                            mutable float dg = 0.318;
                            mutable float db = 0.263;
                            if (d.severity != 0) { dg = 0.706; db = 0.318; }
                            batch.rect(ox + 3, y + ch / 2 - 3, 6, 6, dr, dg, db, 1.0);
                            String txt = c.editor().document().line(d.line - 1);
                            mutable int startCol = d.col - 1;
                            if (startCol < 0) { startCol = 0; }
                            mutable int uw = (txt.length() - startCol) * cw;
                            if (uw < cw) { uw = cw; }
                            batch.rect(textX + startCol * cw, y + ch - 2, uw, 2, dr, dg, db, 0.85);
                        }
                        di = di + 1;
                    }
                }
            }

            private method drawSelection(Batch2D* batch, Controller* c, int textX, int oy, int cw, int ch,
                                         int visible, int firstLine) returns void {
                int sr = c.editor().selStartRow();
                int sc = c.editor().selStartCol();
                int er = c.editor().selEndRow();
                int ec = c.editor().selEndCol();
                mutable int row = sr;
                while (row <= er) {
                    int screenRow = row - firstLine;
                    if (screenRow >= 0 && screenRow < visible) {
                        mutable int startCol = 0;
                        if (row == sr) { startCol = sc; }
                        mutable int endCol = c.editor().document().line(row).length();
                        if (row == er) { endCol = ec; }
                        mutable int wsel = (endCol - startCol) * cw;
                        if (wsel < cw && row < er) { wsel = cw; }
                        int x = textX + startCol * cw;
                        batch.rect(x, oy + this.topPad + screenRow * ch, wsel, ch, 0.918, 0.706, 0.392, 0.22);
                    }
                    row = row + 1;
                }
            }

            // The autocomplete popup, anchored below the caret at the prefix start.
            public method drawCompletion(Batch2D* batch, Completion* comp, Workbench* wb, int screenW,
                                         int screenH) returns void {
                Controller* c = wb.active();
                int cw = this.font.advance();
                int ch = this.font.lineHeight();
                int ox = this.treeW;
                int cx = ox + this.gutterPx() + 6 + c.caretScreenCol() * cw;
                int cy = this.contentTop() + this.topPad + c.caretScreenRow() * ch;
                int px = cx - comp.prefix.length() * cw;
                int py = cy + ch;
                mutable int shown = comp.items.size();
                if (shown > 10) { shown = 10; }
                int pw = 280;
                int pph = shown * (ch + 2) + 6;
                batch.rect(px, py, pw, pph, 0.063, 0.106, 0.114, 1.0);
                batch.rect(px, py, 2, pph, 0.918, 0.706, 0.392, 1.0);
                mutable int i = 0;
                while (i < shown) {
                    int ry = py + 3 + i * (ch + 2);
                    if (i == comp.sel) { batch.rect(px + 2, ry - 1, pw - 4, ch + 2, 0.918, 0.706, 0.392, 0.18); }
                    this.font.drawText(batch, px + 8, ry, comp.items.get(i), 0.804, 0.851, 0.843, 1.0);
                    i = i + 1;
                }
            }

            // --- modal overlays (drawn on top of the frame) ---
            public method drawOverlay(Batch2D* batch, Overlay* ov, Workbench* wb, int screenW, int screenH)
                    returns void {
                if (ov.mode == 1) { this.drawPalette(batch, ov, wb, screenW, screenH); }
                else if (ov.mode == 2) { this.drawFindBar(batch, ov, wb, screenW); }
            }

            private method drawPalette(Batch2D* batch, Overlay* ov, Workbench* wb, int screenW, int screenH)
                    returns void {
                int cw = this.font.advance();
                int ch = this.font.lineHeight();
                int bw = 640;
                int bx = (screenW - bw) / 2;
                int by = 70;
                ArrayList<Command>* results = wb.registry().filter(ov.query);
                mutable int shown = results.size();
                if (shown > 12) { shown = 12; }
                int bh = ch + 12 + shown * (ch + 4) + 8;
                batch.rect(0, 0, screenW, screenH, 0.0, 0.0, 0.0, 0.35);        // dim backdrop
                batch.rect(bx, by, bw, bh, 0.055, 0.098, 0.106, 1.0);
                batch.rect(bx, by, bw, 2, 0.918, 0.706, 0.392, 1.0);
                // query row
                this.font.drawText(batch, bx + 12, by + 7, "> ", 0.918, 0.706, 0.392, 1.0);
                this.font.drawText(batch, bx + 12 + 2 * cw, by + 7, ov.query, 0.804, 0.851, 0.843, 1.0);
                int qx = bx + 12 + (2 + ov.query.length()) * cw;
                batch.rect(qx, by + 7, 2, ch, 0.918, 0.706, 0.392, 1.0);
                // results
                mutable int i = 0;
                while (i < shown) {
                    int ry = by + ch + 12 + i * (ch + 4);
                    if (i == ov.sel) { batch.rect(bx + 4, ry - 2, bw - 8, ch + 4, 0.918, 0.706, 0.392, 0.18); }
                    Command* cmd = results.get(i);
                    this.font.drawText(batch, bx + 16, ry, cmd.title, 0.804, 0.851, 0.843, 1.0);
                    int idx = bx + bw - 16 - cmd.id.length() * cw;
                    this.font.drawText(batch, idx, ry, cmd.id, 0.376, 0.478, 0.475, 1.0);
                    i = i + 1;
                }
            }

            private method drawFindBar(Batch2D* batch, Overlay* ov, Workbench* wb, int screenW) returns void {
                int cw = this.font.advance();
                int ch = this.font.lineHeight();
                int bw = 420;
                int bx = screenW - bw - 24;
                int by = this.contentTop() + 10;
                int bh = ch + 12;
                batch.rect(bx, by, bw, bh, 0.055, 0.098, 0.106, 1.0);
                batch.rect(bx, by, 3, bh, 0.918, 0.706, 0.392, 1.0);
                this.font.drawText(batch, bx + 12, by + 6, "find ", 0.502, 0.588, 0.584, 1.0);
                this.font.drawText(batch, bx + 12 + 5 * cw, by + 6, ov.query, 0.804, 0.851, 0.843, 1.0);
                int qx = bx + 12 + (5 + ov.query.length()) * cw;
                batch.rect(qx, by + 6, 2, ch, 0.918, 0.706, 0.392, 1.0);
                String cnt = wb.active().matchCount(ov.query).toString() + " matches";
                this.font.drawText(batch, bx + bw - (cnt.length() + 1) * cw, by + 6, cnt, 0.502, 0.588, 0.584, 1.0);
            }

            private method drawSpan(Batch2D* batch, int textX, int y, int cw, String line, Span* sp)
                    returns void {
                Tok k = sp.kind;
                int x = textX + sp.start * cw;
                if (k == Tok.WS) { return; }
                if (k == Tok.KEYWORD) { this.font.drawSub(batch, x, y, line, sp.start, sp.end, 0.918, 0.706, 0.392, 1.0); return; }
                if (k == Tok.NUMBER)  { this.font.drawSub(batch, x, y, line, sp.start, sp.end, 0.902, 0.647, 0.400, 1.0); return; }
                if (k == Tok.STRING)  { this.font.drawSub(batch, x, y, line, sp.start, sp.end, 0.561, 0.780, 0.624, 1.0); return; }
                if (k == Tok.CHAR)    { this.font.drawSub(batch, x, y, line, sp.start, sp.end, 0.561, 0.780, 0.624, 1.0); return; }
                if (k == Tok.COMMENT) { this.font.drawSub(batch, x, y, line, sp.start, sp.end, 0.302, 0.416, 0.427, 1.0); return; }
                if (k == Tok.PUNCT)   { this.font.drawSub(batch, x, y, line, sp.start, sp.end, 0.565, 0.635, 0.631, 1.0); return; }
                this.font.drawSub(batch, x, y, line, sp.start, sp.end, 0.804, 0.851, 0.843, 1.0);
            }
        }
    }
}
