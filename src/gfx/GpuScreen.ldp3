import gfx.Batch2D;
import gfx.Font;
import app.Controller;
import syntax.Tok;
import syntax.Span;
import System.Collections.ArrayList;

program Forge;

public bundle forge {
    public namespace gfx {

        // Draws an editor Controller's visible state on the GPU -- the graphical counterpart of the text
        // ScreenRenderer. It reads the same render queries (visibleRows/lineNumberAt/renderLine, and later
        // the spans, caret and selection) and paints them as Batch2D quads. This slice draws the gutter,
        // right-aligned line numbers, and the code text of every visible line, monospace-aligned. It owns no
        // model state; the caller passes the active Controller each frame.
        public class GpuScreen {
            private mutable Font* font;
            private mutable int gutterChars;
            private mutable int topPad;

            public constructor GpuScreen(Font* font) {
                this.font = font;
                this.gutterChars = 6;
                this.topPad = 8;
            }

            // The gutter width, and the viewport size (rows/cols) that fit the code area of a pixel window,
            // so the caller can size the Controller's viewport to match what is drawn.
            public method fontTexture() returns int { return this.font.texture(); }
            public method gutterPx() returns int { return this.gutterChars * this.font.advance() + 16; }
            public method rowsFor(int screenH) returns int {
                return (screenH - this.topPad) / this.font.lineHeight();
            }
            public method colsFor(int screenW) returns int {
                return (screenW - this.gutterPx() - 8) / this.font.advance();
            }

            public method draw(Batch2D* batch, Controller* c, int screenW, int screenH) returns void {
                int cw = this.font.advance();
                int ch = this.font.lineHeight();
                int gpx = this.gutterPx();
                int textX = gpx + 6;
                int caretRow = c.caretScreenRow();

                int visible = c.visibleRows();
                int firstLine = c.firstLine();

                // gutter background band
                batch.rect(0, 0, gpx, screenH, 0.039, 0.078, 0.086, 1.0);

                // selection highlight (under the text), one band per line the selection touches
                if (c.editor().hasSelection()) {
                    this.drawSelection(batch, c, textX, cw, ch, visible, firstLine, screenW - textX);
                }

                mutable int r = 0;
                while (r < visible) {
                    int y = this.topPad + r * ch;
                    if (r == caretRow) {
                        batch.rect(gpx, y, screenW - gpx, ch, 1.0, 1.0, 1.0, 0.035);
                    }
                    String num = (c.lineNumberAt(r) + 1).toString();
                    int nx = gpx - 8 - num.length() * cw;
                    this.font.drawText(batch, nx, y, num, 0.208, 0.329, 0.353, 1.0);
                    String line = c.renderLine(r);
                    ArrayList<Span> spans = c.renderSpans(r);
                    mutable int si = 0;
                    while (si < spans.size()) {
                        this.drawSpan(batch, textX, y, cw, line, spans.get(si));
                        si = si + 1;
                    }
                    r = r + 1;
                }

                // caret (on top), a thin amber bar
                int ccr = c.caretScreenRow();
                if (ccr >= 0 && ccr < visible) {
                    int cx = textX + c.caretScreenCol() * cw;
                    batch.rect(cx, this.topPad + ccr * ch, 2, ch, 0.918, 0.706, 0.392, 1.0);
                }
            }

            // Draw the translucent selection band(s), clipped to the visible rows.
            private method drawSelection(Batch2D* batch, Controller* c, int textX, int cw, int ch,
                                         int visible, int firstLine, int maxW) returns void {
                int sr = c.editor().selStartRow();
                int sc = c.editor().selStartCol();
                int er = c.editor().selEndRow();
                int ec = c.editor().selEndCol();
                mutable int row = sr;
                while (row <= er) {
                    int screenRow = row - firstLine;
                    if (screenRow >= 0 && screenRow < visible) {
                        mutable int startCol = 0;
                        if (row == sr) { startCol = sc; }
                        mutable int endCol = c.editor().document().line(row).length();
                        if (row == er) { endCol = ec; }
                        mutable int wsel = (endCol - startCol) * cw;
                        if (wsel < cw && row < er) { wsel = cw; }   // show a sliver for a selected newline
                        int x = textX + startCol * cw;
                        batch.rect(x, this.topPad + screenRow * ch, wsel, ch, 0.918, 0.706, 0.392, 0.22);
                    }
                    row = row + 1;
                }
            }

            // Draw one token span at its column, coloured by its kind (whitespace draws nothing).
            private method drawSpan(Batch2D* batch, int textX, int y, int cw, String line, Span* sp)
                    returns void {
                Tok k = sp.kind;
                int x = textX + sp.start * cw;
                if (k == Tok.WS) { return; }
                if (k == Tok.KEYWORD) { this.font.drawSub(batch, x, y, line, sp.start, sp.end, 0.918, 0.706, 0.392, 1.0); return; }
                if (k == Tok.NUMBER)  { this.font.drawSub(batch, x, y, line, sp.start, sp.end, 0.902, 0.647, 0.400, 1.0); return; }
                if (k == Tok.STRING)  { this.font.drawSub(batch, x, y, line, sp.start, sp.end, 0.561, 0.780, 0.624, 1.0); return; }
                if (k == Tok.CHAR)    { this.font.drawSub(batch, x, y, line, sp.start, sp.end, 0.561, 0.780, 0.624, 1.0); return; }
                if (k == Tok.COMMENT) { this.font.drawSub(batch, x, y, line, sp.start, sp.end, 0.302, 0.416, 0.427, 1.0); return; }
                if (k == Tok.PUNCT)   { this.font.drawSub(batch, x, y, line, sp.start, sp.end, 0.565, 0.635, 0.631, 1.0); return; }
                this.font.drawSub(batch, x, y, line, sp.start, sp.end, 0.804, 0.851, 0.843, 1.0);   // IDENT
            }
        }
    }
}
