import gl.Gl;
import gl.Wgl;
import glfw.GlWindow;
import gltext.GdiFont;
import gltext.FontAtlas;
import System.IO.Console;
import System.IO.File;
import System.Text.StringBuilder;

program Forge;

public bundle forge {
    public namespace gfx {

        // The graphics front-end: opens a real OpenGL window, loads the Consolas glyph atlas onto the GPU,
        // and runs the frame loop that draws the editor. run() is the live interactive window; shot()
        // renders one frame to a PPM for offscreen verification. This slice draws sample text.
        public class GuiApp {
            public static method run() returns void {
                GlWindow* win = new GlWindow() on heap;
                if (win.open("Forge", 1100, 720, 4, 6) == 0) {
                    System.IO.Console.printf("Forge: could not open a GL 4.6 window\n");
                    return;
                }
                win.setVSync(1);
                Font* font = GuiApp.loadFont(win, 20);
                Batch2D* batch = new Batch2D(win.gl) on heap;
                while (win.isOpen()) {
                    win.pump();
                    GuiApp.drawFrame(win, batch, font);
                    win.swap();
                    win.sleep(8);
                }
                return;
            }

            public static method shot(String path) returns void {
                GlWindow* win = new GlWindow() on heap;
                if (win.open("Forge", 1100, 720, 4, 6) == 0) {
                    System.IO.Console.printf("Forge: could not open a GL 4.6 window\n");
                    return;
                }
                Font* font = GuiApp.loadFont(win, 20);
                Batch2D* batch = new Batch2D(win.gl) on heap;
                win.pump();
                GuiApp.drawFrame(win, batch, font);
                Wgl.glFinish();
                int w = win.width();
                int h = win.height();
                byte[] px = win.gl.readPixelsRgb(0, 0, w, h);
                GuiApp.writePpm(path, px, w, h);
                win.swap();
                System.IO.Console.printf("Forge: wrote %s (%dx%d)\n", path, w, h);
                return;
            }

            // Rasterize the Consolas atlas and upload it as a GL texture, wrapped in a Font.
            private static method loadFont(GlWindow* win, int px) returns Font* {
                FontAtlas atlas = GdiFont.rasterizeAscii("Consolas", px);
                int tex = win.gl.uploadRGBA(atlas.pixels, atlas.atlasW, atlas.atlasH);
                return new Font(atlas, tex) on heap;
            }

            // One frame: clear to the Forge ground, then draw sample text (G2).
            private static method drawFrame(GlWindow* win, Batch2D* batch, Font* font) returns void {
                int w = win.width();
                int h = win.height();
                Wgl.glViewport(0, 0, w, h);
                Wgl.glClearColor(0.051, 0.102, 0.114, 1.0);   // #0d1a1d
                Wgl.glClear(16384);   // GL_COLOR_BUFFER_BIT

                batch.begin(w, h, font.texture());
                int lh = font.lineHeight();
                font.drawText(batch, 24, 24, "Forge -- the LDP3 IDE", 0.918, 0.706, 0.392, 1.0);
                font.drawText(batch, 24, 24 + lh, "rendered on the GPU via ldp3-opengl", 0.804, 0.851, 0.843, 1.0);
                font.drawText(batch, 24, 24 + lh * 3, "ABCDEFGHIJKLMNOPQRSTUVWXYZ", 0.475, 0.698, 0.729, 1.0);
                font.drawText(batch, 24, 24 + lh * 4, "abcdefghijklmnopqrstuvwxyz 0123456789", 0.475, 0.698, 0.729, 1.0);
                font.drawText(batch, 24, 24 + lh * 5, "{ } ( ) [ ] < > + - * / = ! & | ^ ~ ;", 0.561, 0.780, 0.624, 1.0);
                batch.flush();
                return;
            }

            // Write an RGB byte buffer as an ASCII P3 PPM, flipped in Y (GL's origin is bottom-left).
            private static method writePpm(String path, byte[] px, int w, int h) returns void {
                StringBuilder sb = new StringBuilder() on heap;
                sb.append("P3\n");
                sb.appendInt(w);
                sb.append(" ");
                sb.appendInt(h);
                sb.append("\n255\n");
                mutable int y = h - 1;
                while (y >= 0) {
                    mutable int x = 0;
                    while (x < w) {
                        int i = (y * w + x) * 3;
                        sb.appendInt(cast<int>(px[i]) & 255);
                        sb.append(" ");
                        sb.appendInt(cast<int>(px[i + 1]) & 255);
                        sb.append(" ");
                        sb.appendInt(cast<int>(px[i + 2]) & 255);
                        sb.append(" ");
                        x = x + 1;
                    }
                    sb.append("\n");
                    y = y - 1;
                }
                File.writeAll(path, sb.toString());
                return;
            }
        }
    }
}
