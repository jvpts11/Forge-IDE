import gl.Gl;
import gl.Wgl;
import glfw.GlWindow;
import glfw.InputEvent;
import gltext.GdiFont;
import gltext.FontAtlas;
import app.Workbench;
import app.Command;
import io.FileTree;
import io.FileNode;
import input.Key;
import input.KeyCode;
import System.Collections.ArrayList;
import System.IO.Console;
import System.IO.File;
import System.Text.StringBuilder;

program Forge;

public bundle forge {
    public namespace gfx {

        // Post synthetic input to a window, so the real WM_CHAR/WM_KEYDOWN decode path can be exercised
        // offscreen (the uitest mode) rather than only the scripted handleKey proxy.
        // Win32/CRT entry points used by the automation modes. fflush(NULL) flushes stdout after every
        // serve reply -- when stdout is a pipe (the MCP transport) the CRT fully buffers it, so without
        // this the client blocks waiting for an ack stuck in the buffer.
        public class Win32 {
            public extern stdcall static method PostMessageA(long hwnd, int msg, long wp, long lp) returns int;
            public extern stdcall static method fflush(long stream) returns int;
        }

        // The graphics front-end: opens a real OpenGL window, loads the Consolas glyph atlas onto the GPU,
        // builds the editor Workbench sized to the window, and runs the frame loop that draws the document
        // through GpuScreen. run() is the live interactive window; shot() renders one frame to a PPM for
        // offscreen verification.
        public class GuiApp {
            public static method run() returns void {
                GlWindow* win = new GlWindow() on heap;
                if (win.open("Forge", 1100, 720, 4, 6) == 0) {
                    System.IO.Console.printf("Forge: could not open a GL 4.6 window\n");
                    return;
                }
                win.setVSync(1);
                Font* font = GuiApp.loadFont(win, 18);
                Batch2D* batch = new Batch2D(win.gl) on heap;
                GpuScreen* screen = new GpuScreen(font) on heap;
                Workbench* wb = GuiApp.buildWorkbench(screen, win.width(), win.height());
                FileTree* tree = new FileTree("src") on heap;
                Overlay* ov = new Overlay() on heap;
                Completion* comp = new Completion() on heap;
                MenuBar* menu = new MenuBar() on heap;
                mutable boolean prevDown = false;
                mutable int lastW = win.width();
                mutable int lastH = win.height();
                while (win.isOpen()) {
                    win.pump();
                    GuiApp.processInput(win, wb, ov, comp, menu);
                    // left click -> menu bar / tab / tree / caret (edge-triggered); ignored while an overlay
                    // is open, but menu clicks still work because the menu isn't a modal overlay
                    boolean down = win.keyDown(1);   // VK_LBUTTON
                    if (down && !prevDown && !ov.isOpen()) { GuiApp.handleClick(win, screen, wb, tree, ov, menu); }
                    prevDown = down;
                    // mouse wheel -> scroll the view (3 lines per notch)
                    int scroll = win.takeScroll();
                    if (scroll != 0) { wb.active().scrollLines(0 - (scroll / 120) * 3); }
                    // window resize -> re-fit the viewport
                    int w2 = win.width();
                    int h2 = win.height();
                    if (w2 != lastW || h2 != lastH) {
                        wb.active().resizeViewport(screen.paneRowsFor(h2), screen.paneColsFor(w2));
                        lastW = w2;
                        lastH = h2;
                    }
                    GuiApp.drawFrame(win, batch, screen, wb, tree, ov, comp, menu);
                    win.swap();
                    win.sleep(8);
                }
                return;
            }

            private static method handleClick(GlWindow* win, GpuScreen* screen, Workbench* wb, FileTree* tree,
                                              Overlay* ov, MenuBar* menu) returns void {
                GuiApp.clickAt(win, screen, wb, tree, ov, menu, win.cursorX(), win.cursorY());
                return;
            }

            // Route a click at pixel (mx, my): the menu bar opens/switches a menu or runs a dropdown item; a
            // tab activates it; a tree directory expands/collapses; a tree file opens in a tab; and the editor
            // pane places the caret. Split out from cursor reading so it can be verified with synthetic
            // coordinates. Menu handling has top priority so its dropdown overlays the rest.
            private static method clickAt(GlWindow* win, GpuScreen* screen, Workbench* wb, FileTree* tree,
                                          Overlay* ov, MenuBar* menu, int mx, int my) returns void {
                if (menu.isOpen()) {
                    int item = screen.dropdownItemAt(menu, mx, my);
                    if (item >= 0) {
                        String id = menu.openMenu().items.get(item).commandId;
                        menu.close();
                        GuiApp.runMenuCommand(win, wb, ov, id);
                        return;
                    }
                    if (my < screen.menuH()) {
                        int ti = screen.menuTitleAtX(menu, mx);
                        if (ti >= 0) { menu.toggle(ti); return; }
                    }
                    menu.close();
                    return;
                }
                if (my < screen.menuH()) {
                    int ti = screen.menuTitleAtX(menu, mx);
                    if (ti >= 0) { menu.openAt(ti); }
                    return;
                }
                if (my < screen.contentTop()) {
                    int ti = screen.tabAtX(wb.documents(), mx);
                    if (ti >= 0) { wb.documents().setActive(ti); }
                    return;
                }
                if (mx < screen.treeWidth()) {
                    int ri = screen.treeRowAtY(my);
                    ArrayList<FileNode>* rows = tree.visible();
                    if (ri >= 0 && ri < rows.size()) {
                        FileNode* node = rows.get(ri);
                        if (node.isDir) { tree.toggle(node); } else { wb.openFile(node.path); }
                    }
                    return;
                }
                int screenRow = (my - screen.textOy()) / screen.lineH();
                if (screenRow < 0) { return; }
                mutable int col = (mx - screen.textOx()) / screen.charW();
                if (col < 0) { col = 0; }
                Controller* c = wb.active();
                c.placeCaret(c.firstLine() + screenRow, c.firstColumn() + col);
                return;
            }

            // Execute a menu item's command id. Most map straight to Workbench.runCommand; a few are shell-level
            // actions the GUI owns: opening the find/palette overlays, closing the active tab, quitting the
            // window (WM_CLOSE), and the About banner.
            private static method runMenuCommand(GlWindow* win, Workbench* wb, Overlay* ov, String id)
                    returns void {
                if (id.equals("edit.find")) { ov.open(2); return; }
                if (id.equals("view.palette")) { ov.open(1); return; }
                if (id.equals("file.close")) {
                    if (wb.documents().count() > 1) { wb.documents().close(wb.documents().activeIndex()); }
                    return;
                }
                if (id.equals("app.quit")) { Win32.PostMessageA(win.hwnd, 16, 0, 0); return; }   // WM_CLOSE
                if (id.equals("help.about")) {
                    wb.output().banner("About Forge", "Forge -- the LDP3 IDE, written in LDP3.");
                    return;
                }
                wb.runCommand(id);
                return;
            }

            // Scriptable automation server: open the window once, then read one command per line from stdin
            // and drive the IDE. This is the transport the Forge MCP server speaks -- a remote control for
            // testing, scripting, and (eventually) AI integration. Commands: type <text>, key <name>,
            // click <x> <y>, cmd <id>, open <path>, save, palette <query>, find <query>, esc, shot <path>,
            // state, quit. Each command prints a one-line acknowledgement.
            public static method serve() returns void {
                GlWindow* win = new GlWindow() on heap;
                if (win.open("Forge", 1100, 720, 4, 6) == 0) {
                    System.IO.Console.println("err: no GL window");
                    return;
                }
                Font* font = GuiApp.loadFont(win, 18);
                Batch2D* batch = new Batch2D(win.gl) on heap;
                GpuScreen* screen = new GpuScreen(font) on heap;
                Workbench* wb = GuiApp.buildWorkbench(screen, win.width(), win.height());
                FileTree* tree = new FileTree("src") on heap;
                Overlay* ov = new Overlay() on heap;
                Completion* comp = new Completion() on heap;
                MenuBar* menu = new MenuBar() on heap;
                System.IO.Console.println("forge-serve ready");
                Win32.fflush(0);
                mutable boolean running = true;
                while (running) {
                    win.pump();
                    String line = System.IO.Console.read();
                    if (line.length() == 0) { running = false; }
                    else if (GuiApp.firstWord(line).equals("quit")) { running = false; }
                    else {
                        GuiApp.serveCommand(line, win, batch, screen, wb, tree, ov, comp, menu);
                        Win32.fflush(0);
                    }
                }
                return;
            }

            private static method serveCommand(String line, GlWindow* win, Batch2D* batch, GpuScreen* screen,
                                               Workbench* wb, FileTree* tree, Overlay* ov, Completion* comp,
                                               MenuBar* menu) returns void {
                String cmd = GuiApp.firstWord(line);
                String arg = GuiApp.rest(line);
                if (cmd.equals("type")) {
                    mutable int i = 0;
                    while (i < arg.length()) {
                        char c = arg.charAt(i);
                        if (ov.isOpen()) { ov.typeChar(c); } else { wb.handleKey(Key.ch(c)); }
                        i = i + 1;
                    }
                    if (!ov.isOpen()) { comp.update(wb.active()); }
                    System.IO.Console.println("ok");
                } else if (cmd.equals("key")) {
                    GuiApp.serveKey(wb, ov, comp, arg);
                    System.IO.Console.println("ok");
                } else if (cmd.equals("click")) {
                    String rx = GuiApp.firstWord(arg);
                    String ry = GuiApp.rest(arg);
                    GuiApp.clickAt(win, screen, wb, tree, ov, menu, rx.toInt(), ry.toInt());
                    System.IO.Console.println("ok");
                } else if (cmd.equals("menu")) {
                    // menu <i> opens/toggles menu i; menu -1 closes any open menu
                    int mi = arg.toInt();
                    if (mi < 0) { menu.close(); } else { menu.toggle(mi); }
                    System.IO.Console.println("ok");
                } else if (cmd.equals("menuitem")) {
                    // menuitem <i> runs item i of the currently open menu (scripted equivalent of a click)
                    if (menu.isOpen()) {
                        int mi = arg.toInt();
                        if (mi >= 0 && mi < menu.openMenu().items.size()) {
                            String id = menu.openMenu().items.get(mi).commandId;
                            menu.close();
                            GuiApp.runMenuCommand(win, wb, ov, id);
                        }
                    }
                    System.IO.Console.println("ok");
                } else if (cmd.equals("cmd")) {
                    wb.runCommand(arg);
                    System.IO.Console.println("ok");
                } else if (cmd.equals("open")) {
                    wb.openFile(arg);
                    System.IO.Console.println("ok");
                } else if (cmd.equals("save")) {
                    wb.active().save();
                    System.IO.Console.println("ok");
                } else if (cmd.equals("palette")) {
                    ov.open(1);
                    mutable int i = 0;
                    while (i < arg.length()) { ov.typeChar(arg.charAt(i)); i = i + 1; }
                    System.IO.Console.println("ok");
                } else if (cmd.equals("find")) {
                    ov.open(2);
                    mutable int i = 0;
                    while (i < arg.length()) { ov.typeChar(arg.charAt(i)); i = i + 1; }
                    wb.active().find(arg);
                    System.IO.Console.println("ok");
                } else if (cmd.equals("esc")) {
                    ov.close();
                    System.IO.Console.println("ok");
                } else if (cmd.equals("shot")) {
                    GuiApp.drawFrame(win, batch, screen, wb, tree, ov, comp, menu);
                    Wgl.glFinish();
                    int w = win.width();
                    int h = win.height();
                    byte[] px = win.gl.readPixelsRgb(0, 0, w, h);
                    GuiApp.writePpm(arg, px, w, h);
                    win.swap();
                    System.IO.Console.println("shot " + arg);
                } else if (cmd.equals("run")) {
                    wb.runShell("Run", arg);
                    System.IO.Console.println("ok " + wb.output().lineCount().toString() + " lines");
                } else if (cmd.equals("build")) {
                    wb.diagnose();
                    System.IO.Console.println("ok " + wb.errorCount().toString() + " errors "
                        + wb.warningCount().toString() + " warnings");
                } else if (cmd.equals("state")) {
                    GuiApp.serveState(wb);
                } else {
                    System.IO.Console.println("err: unknown " + cmd);
                }
                return;
            }

            private static method serveKey(Workbench* wb, Overlay* ov, Completion* comp, String name) returns void {
                int vk = GuiApp.vkForName(name);
                if (ov.isOpen()) {
                    if (vk == 27) { ov.close(); }
                    else if (vk == 8) { ov.backspace(); }
                    else if (vk == 40) { ov.moveSel(1); }
                    else if (vk == 38) { ov.moveSel(0 - 1); }
                    else if (vk == 13) {
                        if (ov.mode == 1) { GuiApp.runPaletteSelection(ov, wb); }
                        else { wb.active().find(ov.query); }
                        ov.close();
                    }
                } else if (comp.active && GuiApp.completionKey(comp, wb, vk)) {
                    return;
                } else {
                    GuiApp.dispatchKey(wb, vk, false, false, false);
                    if (vk == 8) { comp.update(wb.active()); } else { comp.dismiss(); }
                }
                return;
            }

            private static method serveState(Workbench* wb) returns void {
                Controller* c = wb.active();
                mutable String path = c.document().path();
                if (path.length() == 0) { path = "untitled"; }
                mutable int dirty = 0;
                if (c.document().isModified()) { dirty = 1; }
                System.IO.Console.println("state file=" + path
                    + " ln=" + (c.editor().cursorRow() + 1).toString()
                    + " col=" + (c.editor().cursorCol() + 1).toString()
                    + " lines=" + c.lineCount().toString()
                    + " tabs=" + wb.documents().count().toString()
                    + " dirty=" + dirty.toString());
                return;
            }

            private static method firstWord(String s) returns String {
                int sp = s.indexOf(" ");
                if (sp < 0) { return s; }
                return s.substring(0, sp);
            }
            private static method rest(String s) returns String {
                int sp = s.indexOf(" ");
                if (sp < 0) { return ""; }
                return s.substring(sp + 1, s.length());
            }
            private static method vkForName(String name) returns int {
                if (name.equals("enter")) { return 13; }
                if (name.equals("backspace")) { return 8; }
                if (name.equals("tab")) { return 9; }
                if (name.equals("esc")) { return 27; }
                if (name.equals("delete")) { return 46; }
                if (name.equals("left")) { return 37; }
                if (name.equals("up")) { return 38; }
                if (name.equals("right")) { return 39; }
                if (name.equals("down")) { return 40; }
                if (name.equals("home")) { return 36; }
                if (name.equals("end")) { return 35; }
                if (name.equals("pageup")) { return 33; }
                if (name.equals("pagedown")) { return 34; }
                return 0;
            }

            // Offscreen verification of the REAL input path: post WM_CHAR/WM_KEYDOWN to the window, let
            // pump() decode them into the event queue, drain them through processInput (the same code the
            // live loop runs), then render one frame to a PPM.
            public static method uitest(String path) returns void {
                GlWindow* win = new GlWindow() on heap;
                if (win.open("Forge", 1100, 720, 4, 6) == 0) {
                    System.IO.Console.printf("Forge: could not open a GL 4.6 window\n");
                    return;
                }
                Font* font = GuiApp.loadFont(win, 18);
                Batch2D* batch = new Batch2D(win.gl) on heap;
                GpuScreen* screen = new GpuScreen(font) on heap;
                Workbench* wb = GuiApp.buildWorkbench(screen, win.width(), win.height());
                FileTree* tree = new FileTree("src") on heap;
                Overlay* ov = new Overlay() on heap;
                Completion* comp = new Completion() on heap;
                MenuBar* menu = new MenuBar() on heap;

                // open the command palette and type a query via real WM_CHAR messages, routed through the
                // overlay path (processInput -> overlayEvent -> typeChar).
                ov.open(1);
                String typed = "save";
                mutable int i = 0;
                while (i < typed.length()) {
                    GuiApp.post(win, 258, cast<int>(typed.charAt(i)));   // WM_CHAR
                    i = i + 1;
                }
                win.pump();
                GuiApp.processInput(win, wb, ov, comp, menu);

                GuiApp.drawFrame(win, batch, screen, wb, tree, ov, comp, menu);
                Wgl.glFinish();
                int w = win.width();
                int h = win.height();
                byte[] px = win.gl.readPixelsRgb(0, 0, w, h);
                GuiApp.writePpm(path, px, w, h);
                win.swap();
                System.IO.Console.printf("Forge: uitest wrote %s\n", path);
                return;
            }
            private static method post(GlWindow* win, int msg, int wp) returns void {
                Win32.PostMessageA(win.hwnd, msg, cast<long>(wp), 0);
                return;
            }

            // Drain the window's keyboard events and drive the Workbench: printable characters type, special
            // keys navigate/edit, Ctrl+letter runs a shortcut -- exactly the CHAR-vs-special split the KeyMap
            // expects. Typed text comes via WM_CHAR; Ctrl combos and named keys via WM_KEYDOWN.
            private static method processInput(GlWindow* win, Workbench* wb, Overlay* ov, Completion* comp,
                                               MenuBar* menu) returns void {
                while (win.hasEvent()) {
                    InputEvent* e = win.nextEvent();
                    boolean ctrl = win.modCtrl();
                    boolean shift = win.modShift();
                    boolean alt = win.modAlt();
                    if (ov.isOpen()) {
                        GuiApp.overlayEvent(ov, wb, e, ctrl);
                    } else if (menu.isOpen() && e.isKey() && e.vk == 27) {   // Esc closes an open menu
                        menu.close();
                    } else if (comp.active && e.isKey() && GuiApp.completionKey(comp, wb, e.vk)) {
                        // consumed by the completion popup (Tab/Enter/Esc/Up/Down)
                    } else if (e.isKey() && ctrl && shift && e.vk == 80) {   // Ctrl+Shift+P -> palette
                        ov.open(1);
                    } else if (e.isKey() && ctrl && e.vk == 70) {            // Ctrl+F -> find
                        ov.open(2);
                    } else if (e.isChar()) {
                        int cp = e.code;
                        if (cp >= 32 && cp != 127 && !ctrl) {
                            wb.handleKey(Key.ch(cast<char>(cp)));
                            comp.update(wb.active());
                        }
                    } else if (e.isKey()) {
                        GuiApp.dispatchKey(wb, e.vk, ctrl, shift, alt);
                        if (e.vk == 8) { comp.update(wb.active()); } else { comp.dismiss(); }
                    }
                }
                return;
            }

            // Handle a key while the completion popup is open. Returns true if it consumed the key.
            private static method completionKey(Completion* comp, Workbench* wb, int vk) returns boolean {
                if (vk == 9 || vk == 13) { comp.accept(wb.active()); return true; }   // Tab / Enter
                if (vk == 27) { comp.dismiss(); return true; }                        // Esc
                if (vk == 40) { comp.moveSel(1); return true; }                       // Down
                if (vk == 38) { comp.moveSel(0 - 1); return true; }                   // Up
                return false;
            }

            // Route an event to the open overlay: type into its query, Esc closes, Enter runs it, arrows
            // move the palette selection.
            private static method overlayEvent(Overlay* ov, Workbench* wb, InputEvent* e, boolean ctrl)
                    returns void {
                if (e.isKey()) {
                    int vk = e.vk;
                    if (vk == 27) { ov.close(); return; }               // Esc
                    if (vk == 8) { ov.backspace(); return; }            // Backspace
                    if (vk == 40) { ov.moveSel(1); return; }            // Down
                    if (vk == 38) { ov.moveSel(0 - 1); return; }        // Up
                    if (vk == 13) {                                     // Enter
                        if (ov.mode == 1) { GuiApp.runPaletteSelection(ov, wb); }
                        else { wb.active().find(ov.query); }
                        ov.close();
                    }
                    return;
                }
                if (e.isChar()) {
                    int cp = e.code;
                    if (cp >= 32 && cp != 127 && !ctrl) { ov.typeChar(cast<char>(cp)); }
                }
                return;
            }

            private static method runPaletteSelection(Overlay* ov, Workbench* wb) returns void {
                ArrayList<Command>* results = wb.registry().filter(ov.query);
                if (ov.sel >= 0 && ov.sel < results.size()) {
                    wb.runCommand(results.get(ov.sel).id);
                }
                return;
            }

            // Map a Win32 virtual-key to a Key and dispatch it, carrying the modifier state.
            private static method dispatchKey(Workbench* wb, int vk, boolean ctrl, boolean shift, boolean alt)
                    returns void {
                if (ctrl && vk >= 65 && vk <= 90) { wb.handleKey(Key.ctrlCh(cast<char>(vk + 32))); return; }
                if (vk == 0x25) { wb.handleKey(new Key(KeyCode.LEFT, ' ', ctrl, shift, alt) on heap); return; }
                if (vk == 0x27) { wb.handleKey(new Key(KeyCode.RIGHT, ' ', ctrl, shift, alt) on heap); return; }
                if (vk == 0x26) { wb.handleKey(new Key(KeyCode.UP, ' ', ctrl, shift, alt) on heap); return; }
                if (vk == 0x28) { wb.handleKey(new Key(KeyCode.DOWN, ' ', ctrl, shift, alt) on heap); return; }
                if (vk == 0x08) { wb.handleKey(new Key(KeyCode.BACKSPACE, ' ', ctrl, shift, alt) on heap); return; }
                if (vk == 0x0D) { wb.handleKey(new Key(KeyCode.ENTER, ' ', ctrl, shift, alt) on heap); return; }
                if (vk == 0x2E) { wb.handleKey(new Key(KeyCode.DELETE, ' ', ctrl, shift, alt) on heap); return; }
                if (vk == 0x09) { wb.handleKey(new Key(KeyCode.TAB, ' ', ctrl, shift, alt) on heap); return; }
                if (vk == 0x24) { wb.handleKey(new Key(KeyCode.HOME, ' ', ctrl, shift, alt) on heap); return; }
                if (vk == 0x23) { wb.handleKey(new Key(KeyCode.END, ' ', ctrl, shift, alt) on heap); return; }
                if (vk == 0x21) { wb.handleKey(new Key(KeyCode.PAGE_UP, ' ', ctrl, shift, alt) on heap); return; }
                if (vk == 0x22) { wb.handleKey(new Key(KeyCode.PAGE_DOWN, ' ', ctrl, shift, alt) on heap); return; }
                return;
            }

            public static method shot(String path) returns void {
                GlWindow* win = new GlWindow() on heap;
                if (win.open("Forge", 1100, 720, 4, 6) == 0) {
                    System.IO.Console.printf("Forge: could not open a GL 4.6 window\n");
                    return;
                }
                Font* font = GuiApp.loadFont(win, 18);
                Batch2D* batch = new Batch2D(win.gl) on heap;
                GpuScreen* screen = new GpuScreen(font) on heap;
                Workbench* wb = GuiApp.buildWorkbench(screen, win.width(), win.height());
                FileTree* tree = new FileTree("src") on heap;
                Overlay* ov = new Overlay() on heap;
                Completion* comp = new Completion() on heap;
                MenuBar* menu = new MenuBar() on heap;
                win.pump();
                GuiApp.drawFrame(win, batch, screen, wb, tree, ov, comp, menu);
                Wgl.glFinish();
                int w = win.width();
                int h = win.height();
                byte[] px = win.gl.readPixelsRgb(0, 0, w, h);
                GuiApp.writePpm(path, px, w, h);
                win.swap();
                System.IO.Console.printf("Forge: wrote %s (%dx%d)\n", path, w, h);
                return;
            }

            private static method loadFont(GlWindow* win, int px) returns Font* {
                FontAtlas atlas = GdiFont.rasterizeAscii("Consolas", px);
                int tex = win.gl.uploadRGBA(atlas.pixels, atlas.atlasW, atlas.atlasH);
                return new Font(atlas, tex) on heap;
            }

            // Build the editor with a viewport sized to the window's code area, and open a document. Opens
            // one of Forge's own source files (real, long, colourful LDP3), falling back to a small embedded
            // sample if it isn't on disk, then places the caret and a selection to demonstrate scrolling.
            private static method buildWorkbench(GpuScreen* screen, int w, int h) returns Workbench* {
                int rows = screen.paneRowsFor(h);
                int cols = screen.paneColsFor(w);
                Workbench* wb = new Workbench(rows, cols) on heap;
                wb.openFile("src/gfx/GpuScreen.ldp3");
                Controller* c = wb.active();
                if (c.editor().document().lineCount() < 3) { c.insertText(GuiApp.sample()); }
                c.moveDocStart(false);
                return wb;
            }

            // Drive a few edits through handleKey -- the same path the live loop uses -- so the offscreen
            // shot demonstrates that typed input reaches the model and re-renders.
            private static method scriptDemo(Workbench* wb) returns void {
                String s = "// typed live in Forge, then run() takes the keyboard.";
                mutable int i = 0;
                while (i < s.length()) { wb.handleKey(Key.ch(s.charAt(i))); i = i + 1; }
                wb.handleKey(new Key(KeyCode.ENTER, ' ', false, false, false) on heap);
                return;
            }

            // One frame: clear to the Forge ground, draw the full IDE (tabs + tree + editor), then any
            // open modal overlay on top.
            private static method drawFrame(GlWindow* win, Batch2D* batch, GpuScreen* screen, Workbench* wb,
                                            FileTree* tree, Overlay* ov, Completion* comp, MenuBar* menu)
                    returns void {
                int w = win.width();
                int h = win.height();
                Wgl.glViewport(0, 0, w, h);
                Wgl.glClearColor(0.051, 0.102, 0.114, 1.0);   // #0d1a1d
                Wgl.glClear(16384);   // GL_COLOR_BUFFER_BIT

                batch.begin(w, h, screen.fontTexture());
                screen.drawWorkbench(batch, wb, tree, w, h);
                if (comp.active) { screen.drawCompletion(batch, comp, wb, w, h); }
                screen.drawMenuBar(batch, menu, w);
                screen.drawMenuDropdown(batch, menu);
                if (ov.isOpen()) { screen.drawOverlay(batch, ov, wb, w, h); }
                batch.flush();
                return;
            }

            private static method sample() returns String {
                return "program Demo;\n\npublic bundle app {\n    public namespace demo {\n        // A tiny sample rendered by Forge itself.\n        public class Counter {\n            private mutable int value;\n\n            public constructor Counter(int start) {\n                this.value = start;\n            }\n\n            public method increment() returns void {\n                this.value = this.value + 1;\n            }\n\n            public method get() returns int {\n                return this.value;\n            }\n        }\n    }\n}";
            }

            // Write an RGB byte buffer as an ASCII P3 PPM, flipped in Y (GL's origin is bottom-left).
            private static method writePpm(String path, byte[] px, int w, int h) returns void {
                StringBuilder sb = new StringBuilder() on heap;
                sb.append("P3\n");
                sb.appendInt(w);
                sb.append(" ");
                sb.appendInt(h);
                sb.append("\n255\n");
                mutable int y = h - 1;
                while (y >= 0) {
                    mutable int x = 0;
                    while (x < w) {
                        int i = (y * w + x) * 3;
                        sb.appendInt(cast<int>(px[i]) & 255);
                        sb.append(" ");
                        sb.appendInt(cast<int>(px[i + 1]) & 255);
                        sb.append(" ");
                        sb.appendInt(cast<int>(px[i + 2]) & 255);
                        sb.append(" ");
                        x = x + 1;
                    }
                    sb.append("\n");
                    y = y - 1;
                }
                File.writeAll(path, sb.toString());
                return;
            }
        }
    }
}
