import gl.Gl;
import gl.Wgl;
import glfw.GlWindow;
import glfw.InputEvent;
import gltext.GdiFont;
import gltext.FontAtlas;
import app.Workbench;
import app.Debugger;
import app.Terminal;
import app.ContextMenu;
import app.Command;
import io.FileTree;
import io.FileNode;
import io.WorkspaceStore;
import input.Key;
import input.KeyCode;
import System.Collections.ArrayList;
import System.IO.Console;
import System.IO.File;
import System.IO.Paths;
import System.Text.StringBuilder;
import System.Memory;

program Forge;

public bundle forge {
    public namespace gfx {

        // Post synthetic input to a window, so the real WM_CHAR/WM_KEYDOWN decode path can be exercised
        // offscreen (the uitest mode) rather than only the scripted handleKey proxy.
        // Win32/CRT entry points used by the automation modes. fflush(NULL) flushes stdout after every
        // serve reply -- when stdout is a pipe (the MCP transport) the CRT fully buffers it, so without
        // this the client blocks waiting for an ack stuck in the buffer.
        public class Win32 {
            public extern stdcall static method PostMessageA(long hwnd, int msg, long wp, long lp) returns int;
            public extern stdcall static method fflush(long stream) returns int;
            public extern stdcall static method GetModuleFileNameA(long hModule, long buf, int size) returns int;
        }

        // A one-shot request from a menu command back to the run loop to open a project folder. The loop owns
        // the file tree, so a "File > Open Folder" click stashes the chosen path here and the loop swaps the
        // tree on the next iteration.
        public class OpenRequest {
            public mutable String path;
            public constructor OpenRequest() {
                this.path = "";
            }
        }

        // The graphics front-end: opens a real OpenGL window, loads the Consolas glyph atlas onto the GPU,
        // builds the editor Workbench sized to the window, and runs the frame loop that draws the document
        // through GpuScreen. run() is the live interactive window; shot() renders one frame to a PPM for
        // offscreen verification.
        public class GuiApp {
            public static method run(String openPath) returns void {
                GlWindow* win = new GlWindow() on heap;
                if (win.open("Forge", 1100, 720, 4, 6) == 0) {
                    System.IO.Console.printf("Forge: could not open a GL 4.6 window\n");
                    return;
                }
                win.setVSync(1);
                Font* font = GuiApp.loadFont(win, 18);
                Batch2D* batch = new Batch2D(win.gl) on heap;
                GpuScreen* screen = new GpuScreen(font) on heap;
                // With no path argument, reopen the last project the user had open.
                mutable String ws = openPath;
                if (ws.length() == 0) {
                    ws = WorkspaceStore.lastProject();
                }
                String treeRoot = GuiApp.treeRootFor(ws);
                Workbench* wb = GuiApp.buildWorkbench(screen, win.width(), win.height(),
                                                      GuiApp.fileToOpenFor(ws));
                wb.setProjectDir(treeRoot);
                GuiApp.restoreSession(wb, treeRoot);
                mutable FileTree* tree = new FileTree(treeRoot) on heap;
                // No project yet? Show the welcome screen instead of an editor over the launch directory.
                mutable boolean workspaceOpen = ws.length() > 0;
                if (ws.length() > 0) {
                    WorkspaceStore.addRecent(treeRoot);
                }
                mutable ArrayList<String>* recent = WorkspaceStore.loadRecent();
                Overlay* ov = new Overlay() on heap;
                Completion* comp = new Completion() on heap;
                comp.loadImports(GuiApp.referencePath("imports.txt"));
                GuiApp.refreshProjectSymbols(comp, tree);
                MenuBar* menu = new MenuBar() on heap;
                ContextMenu* ctx = new ContextMenu() on heap;
                OpenRequest* req = new OpenRequest() on heap;
                mutable boolean prevDown = false;
                mutable boolean prevRight = false;
                mutable boolean prevMiddle = false;
                mutable boolean dragging = false;
                mutable int lastW = win.width();
                mutable int lastH = win.height();
                mutable int blink = 0;
                mutable int frames = 0;
                mutable int lastClickFrame = 0 - 100;
                mutable int lastClickX = 0;
                mutable int lastClickY = 0;
                mutable int fontPx = 18;
                mutable boolean prevZoom = false;
                while (win.isOpen()) {
                    frames = frames + 1;
                    win.pump();
                    if (!workspaceOpen) {
                        boolean wdown = win.keyDown(1);
                        if (wdown && !prevDown) {
                            int hit = screen.welcomeHit(win.cursorX(), win.cursorY(), recent.size(), win.width());
                            if (hit == 0 - 1) {
                                // New Project: scaffold ldp3.toml + src/main.ldp3 in a chosen folder, then open it.
                                String picked = NativeDialog.pickFolder(win.hwnd, "Create the project in this folder");
                                if (picked.length() > 0) {
                                    GuiApp.scaffoldProject(picked);
                                    wb.setProjectDir(picked);
                                    wb.openFile(Paths.join(picked, "src/main.ldp3"));
                                    tree = new FileTree(picked) on heap;
                                    WorkspaceStore.addRecent(picked);
                                    workspaceOpen = true;
                                }
                            } else if (hit == 0 - 2) {
                                String picked = NativeDialog.pickFolder(win.hwnd, "Open a folder");
                                if (picked.length() > 0) {
                                    wb.setProjectDir(picked);
                                    GuiApp.restoreSession(wb, picked);
                                    tree = new FileTree(picked) on heap;
                                    WorkspaceStore.addRecent(picked);
                                    workspaceOpen = true;
                                }
                            } else if (hit == 0 - 3) {
                                // Open Project: a folder that is an LDP3 project (has ldp3.toml).
                                String picked = NativeDialog.pickFolder(win.hwnd, "Open an LDP3 project folder");
                                if (picked.length() > 0) {
                                    wb.setProjectDir(picked);
                                    GuiApp.restoreSession(wb, picked);
                                    tree = new FileTree(picked) on heap;
                                    WorkspaceStore.addRecent(picked);
                                    workspaceOpen = true;
                                    if (!File.exists(Paths.join(picked, "ldp3.toml"))) {
                                        wb.output().banner("Not an LDP3 project",
                                            "No ldp3.toml in " + picked + " -- opened as a plain folder.");
                                    }
                                }
                            } else if (hit >= 0) {
                                String p = recent.get(hit);
                                wb.setProjectDir(p);
                                GuiApp.restoreSession(wb, p);
                                tree = new FileTree(p) on heap;
                                WorkspaceStore.addRecent(p);
                                workspaceOpen = true;
                            }
                        }
                        prevDown = wdown;
                        win.setIBeam(false);
                        GuiApp.drawWelcomeFrame(win, batch, screen, recent);
                        win.swap();
                        win.sleep(8);
                        continue;
                    }
                    GuiApp.processInput(win, wb, ov, comp, menu, tree);
                    // right click -> the context menu for whatever is under the cursor (editor / tree / tab)
                    boolean rdown = win.keyDown(2);   // VK_RBUTTON
                    if (rdown && !prevRight && !ov.isOpen()) {
                        menu.close();
                        GuiApp.rightClickAt(win, screen, wb, tree, ctx, win.cursorX(), win.cursorY());
                    }
                    prevRight = rdown;
                    // left click -> context-menu item (when open), else menu bar / tab / tree / caret
                    boolean down = win.keyDown(1);   // VK_LBUTTON
                    if (down && !prevDown && ctx.isActive()) {
                        int cxi = win.cursorX();
                        int cyi = win.cursorY();
                        int item = screen.contextItemAt(ctx, cxi, cyi, win.width(), win.height());
                        if (item >= 0) {
                            GuiApp.runContextCommand(win, screen, wb, tree, ov, req, ctx, ctx.idAt(item));
                        } else if (!screen.contextHit(ctx, cxi, cyi, win.width(), win.height())) {
                            ctx.close();       // a click outside dismisses it
                        }
                        prevDown = down;
                        dragging = false;
                        GuiApp.drawFrame(win, batch, screen, wb, tree, ov, comp, menu, ctx);
                        win.swap();
                        win.sleep(8);
                        continue;
                    }
                    if (down && !prevDown && !ov.isOpen()) {
                        int cxNow = win.cursorX();
                        int cyNow = win.cursorY();
                        boolean dbl = frames - lastClickFrame < 22
                            && GuiApp.absDiff(cxNow, lastClickX) < 5 && GuiApp.absDiff(cyNow, lastClickY) < 5;
                        if (dbl && cxNow >= screen.textOx() && GuiApp.overEditor(screen, win, ov, win.height())) {
                            GuiApp.selectWordAtMouse(screen, wb, win);       // double-click selects the word
                            dragging = false;
                        } else {
                            GuiApp.handleClick(win, screen, wb, tree, ov, menu, req, win.modAlt());
                            // start a drag-select only over the text (not the gutter, where a click folds)
                            dragging = GuiApp.overEditor(screen, win, ov, win.height()) && !win.modAlt()
                                && cxNow >= screen.textOx();
                        }
                        lastClickFrame = frames;
                        lastClickX = cxNow;
                        lastClickY = cyNow;
                    } else if (down && prevDown && dragging && !ov.isOpen()) {
                        GuiApp.dragExtend(screen, wb, win);                   // extend the selection
                    }
                    if (!down) {
                        dragging = false;
                    }
                    prevDown = down;
                    // a "File > Open Folder" click asked to switch projects: swap the tree live
                    if (req.path.length() > 0) {
                        WorkspaceStore.saveSession(wb.projectRoot(), wb.documents().openPaths());
                        wb.setProjectDir(req.path);
                        GuiApp.restoreSession(wb, req.path);
                        tree = new FileTree(req.path) on heap;
                        WorkspaceStore.addRecent(req.path);
                        req.path = "";
                    }
                    // a file operation (new/rename) asked to rebuild the tree at the current root
                    if (wb.treeNeedsRefresh()) {
                        tree = new FileTree(tree.root().path) on heap;
                    }
                    // periodically persist the open tabs so the session survives a crash / next launch
                    if (frames % 300 == 0) {
                        WorkspaceStore.saveSession(wb.projectRoot(), wb.documents().openPaths());
                    }
                    // middle click on a tab closes it (the browser gesture every editor copies)
                    boolean mdown = win.keyDown(4);   // VK_MBUTTON
                    if (mdown && !prevMiddle && !ov.isOpen()) {
                        int my2 = win.cursorY();
                        if (my2 >= screen.menuH() && my2 < screen.contentTop()) {
                            int ti = screen.tabAtX(wb.documents(), win.cursorX());
                            if (ti >= 0) {
                                wb.closeTab(ti);
                            }
                        }
                    }
                    prevMiddle = mdown;
                    // mouse wheel -> scroll the view (3 lines per notch); with Ctrl held it zooms the font
                    int scroll = win.takeScroll();
                    if (scroll != 0) {
                        if (win.modCtrl()) {
                            mutable int delta = 1;
                            if (scroll < 0) {
                                delta = 0 - 1;
                            }
                            int want = fontPx + delta;
                            if (want >= 10 && want <= 32) {
                                fontPx = want;
                                screen.setFont(GuiApp.loadFont(win, fontPx));
                                wb.active().resizeViewport(screen.paneRowsFor(win.height()),
                                                           screen.paneColsFor(win.width()));
                            }
                        } else {
                            wb.active().scrollLines(0 - (scroll / 120) * 3);
                        }
                    }
                    // Ctrl+= / Ctrl+- zoom the editor font in and out (reloads the glyph atlas at the new
                    // size, then re-fits the viewport to the new metrics). Edge-triggered so one press = one step.
                    boolean zplus = win.modCtrl() && win.keyDown(187);   // VK_OEM_PLUS (the '=' key)
                    boolean zminus = win.modCtrl() && win.keyDown(189);  // VK_OEM_MINUS (the '-' key)
                    if ((zplus || zminus) && !prevZoom) {
                        if (zplus && fontPx < 32) {
                            fontPx = fontPx + 2;
                        }
                        if (zminus && fontPx > 10) {
                            fontPx = fontPx - 2;
                        }
                        screen.setFont(GuiApp.loadFont(win, fontPx));
                        wb.active().resizeViewport(screen.paneRowsFor(win.height()),
                                                   screen.paneColsFor(win.width()));
                    }
                    prevZoom = zplus || zminus;
                    // window resize -> re-fit the viewport
                    int w2 = win.width();
                    int h2 = win.height();
                    if (w2 != lastW || h2 != lastH) {
                        wb.active().resizeViewport(screen.paneRowsFor(h2), screen.paneColsFor(w2));
                        lastW = w2;
                        lastH = h2;
                    }
                    // the editing feel: an I-beam over the text region (arrow over the chrome) and a caret that
                    // blinks about twice a second.
                    win.setIBeam(GuiApp.overEditor(screen, win, ov, h2));
                    blink = blink + 1;
                    if (blink >= 60) {
                        blink = 0;
                    }
                    screen.setCaretOn(blink < 30);
                    GuiApp.drawFrame(win, batch, screen, wb, tree, ov, comp, menu, ctx);
                    win.swap();
                    win.sleep(8);
                }
                return;
            }

            // True when the mouse is over the editable text region (right of the tree, below the breadcrumb
            // bar, above the status bar) and no modal overlay covers it -- the region that gets the I-beam.
            private static method overEditor(GpuScreen* screen, GlWindow* win, Overlay* ov, int screenH)
                    returns boolean {
                if (ov.isOpen()) {
                    return false;
                }
                int mx = win.cursorX();
                int my = win.cursorY();
                return mx >= screen.treeWidth() && my >= screen.editorTop() && my < screenH - screen.statusH();
            }

            private static method handleClick(GlWindow* win, GpuScreen* screen, Workbench* wb, FileTree* tree,
                                              Overlay* ov, MenuBar* menu, OpenRequest* req, boolean alt)
                    returns void {
                GuiApp.clickAt(win, screen, wb, tree, ov, menu, req, win.cursorX(), win.cursorY(), alt);
                return;
            }

            // Route a click at pixel (mx, my): the menu bar opens/switches a menu or runs a dropdown item; a
            // tab activates it; a tree directory expands/collapses; a tree file opens in a tab; and the editor
            // pane places the caret. Split out from cursor reading so it can be verified with synthetic
            // coordinates. Menu handling has top priority so its dropdown overlays the rest.
            private static method clickAt(GlWindow* win, GpuScreen* screen, Workbench* wb, FileTree* tree,
                                          Overlay* ov, MenuBar* menu, OpenRequest* req, int mx, int my,
                                          boolean alt) returns void {
                if (menu.isOpen()) {
                    int item = screen.dropdownItemAt(menu, mx, my);
                    if (item >= 0) {
                        String id = menu.openMenu().items.get(item).commandId;
                        menu.close();
                        GuiApp.runMenuCommand(win, wb, ov, req, id);
                        return;
                    }
                    if (my < screen.menuH()) {
                        int ti = screen.menuTitleAtX(menu, mx);
                        if (ti >= 0) {
                            menu.toggle(ti);
                            return;
                        }
                    }
                    menu.close();
                    return;
                }
                int dbgFrame = screen.debugFrameAt(mx, my, win.width(), wb.debugger());
                if (dbgFrame >= 0) {
                    wb.jumpToStackFrame(dbgFrame);   // click a call-stack frame -> open its source line
                    return;
                }
                if (my < screen.menuH()) {
                    int tb = screen.toolButtonAt(mx, my, win.width());
                    if (tb == 1) {
                        menu.close();
                        wb.runCommand("run.program");
                        return;
                    }
                    if (tb == 0) {
                        menu.close();
                        wb.runCommand("run.build");
                        return;
                    }
                    int ti = screen.menuTitleAtX(menu, mx);
                    if (ti >= 0) {
                        menu.openAt(ti);
                    }
                    return;
                }
                if (my < screen.contentTop()) {
                    int ci = screen.tabCloseAtX(wb.documents(), mx);
                    if (ci >= 0) {
                        wb.closeTab(ci);
                        return;
                    }
                    int ti = screen.tabAtX(wb.documents(), mx);
                    if (ti >= 0) {
                        wb.documents().setActive(ti);
                        wb.refreshGit();
                    }
                    return;
                }
                if (mx < screen.treeWidth()) {
                    int ri = screen.treeRowAtY(my);
                    ArrayList<FileNode*>* rows = tree.visible();
                    if (ri >= 0 && ri < rows.size()) {
                        FileNode* node = rows.get(ri);
                        if (node.isDir) {
                            tree.toggle(node);
                        } else {
                            wb.openFile(node.path);
                        }
                    }
                    return;
                }
                // clicks in the output panel are consumed there: the close button hides it, and a navigable
                // result row (search / references) jumps to its file and line.
                int panelH = screen.outputPanelHeight(wb.output(), win.height());
                if (panelH > 0) {
                    int panelTop = win.height() - screen.statusH() - panelH;
                    if (my >= panelTop) {
                        if (screen.outputCloseAt(mx, my, screen.treeWidth(), panelTop,
                                                 win.width() - screen.treeWidth())) {
                            wb.output().hide();
                            return;
                        }
                        int ch = screen.lineH();
                        int headerH = ch + 8;
                        int bodyTop = panelTop + headerH;
                        if (my >= bodyTop) {
                            int visRows = (panelH - headerH) / ch;
                            int total = wb.output().lineCount();
                            mutable int startRow = 0;
                            if (total > visRows) {
                                startRow = total - visRows;
                            }
                            int idx = startRow + (my - bodyTop) / ch;
                            String nf = wb.output().navFileAt(idx);
                            int nl = wb.output().navLineAt(idx);
                            if (nf.length() > 0 && nl >= 0) {
                                wb.openFile(nf);
                                wb.active().placeCaret(nl, 0);
                            }
                        }
                        return;
                    }
                }
                // a click in the structure panel jumps to that declaration
                int outW = screen.outlineWidth(wb);
                if (outW > 0 && mx >= win.width() - outW && my >= screen.editorTop()) {
                    int idx = screen.outlineRowAt(my);
                    ArrayList<Symbol>* syms = wb.outlineSymbols();
                    if (idx >= 0 && idx < syms.size()) {
                        wb.active().placeCaret(syms.get(idx).line - 1, 0);   // Symbol.line is 1-based
                    }
                    delete syms;
                    return;
                }
                // a click on the minimap scrolls the editor to the corresponding line
                if (wb.minimapVisible()) {
                    int mmW = screen.minimapW();
                    int mmX = win.width() - mmW - 14;
                    if (mx >= mmX && mx < mmX + mmW && my >= screen.editorTop()) {
                        int total = wb.active().lineCount();
                        int span = win.height() - screen.editorTop() - screen.statusH();
                        if (span > 0 && total > 0) {
                            wb.active().placeCaret((my - screen.editorTop()) * total / span, 0);
                        }
                        return;
                    }
                }
                int screenRow = (my - screen.textOy()) / screen.lineH();
                if (screenRow < 0) {
                    return;
                }
                Controller* c = wb.active();
                // a click in the gutter (left of the code): the leftmost strip toggles a breakpoint (VS
                // Code-style), the inner part toggles the fold on a foldable line.
                if (mx < screen.textOx()) {
                    int docLine = c.lineNumberAt(screenRow);
                    if (mx < screen.treeWidth() + 18) {
                        wb.debugger().toggleBreakpoint(wb.activePath(), docLine + 1);
                    } else if (c.isFoldable(docLine)) {
                        c.toggleFold(docLine);
                    }
                    return;
                }
                mutable int col = (mx - screen.textOx()) / screen.charW();
                if (col < 0) {
                    col = 0;
                }
                if (alt) {
                    c.addCaretAt(c.lineNumberAt(screenRow), c.firstColumn() + col);   // Alt+click adds a caret
                } else {
                    c.beginSelect(c.lineNumberAt(screenRow), c.firstColumn() + col);  // anchor a drag selection
                }
                return;
            }

            // Right-click at pixel (mx, my): open the context menu appropriate to what's under the cursor -- the
            // editor (code navigation / refactor / clipboard, with the caret moved to the click first, so the
            // actions apply to what you clicked), the file tree (file operations on that entry), or the tab bar
            // (tab operations). Anywhere else just closes any open popup.
            private static method rightClickAt(GlWindow* win, GpuScreen* screen, Workbench* wb, FileTree* tree,
                                               ContextMenu* ctx, int mx, int my) returns void {
                ctx.close();
                if (my < screen.menuH()) {
                    return;
                }
                if (my < screen.contentTop()) {
                    int ti = screen.tabAtX(wb.documents(), mx);
                    if (ti >= 0) {
                        wb.documents().setActive(ti);
                        ctx.openForTab(mx, my, wb.documents().at(ti).document().path());
                    }
                    return;
                }
                if (mx < screen.treeWidth()) {
                    int ri = screen.treeRowAtY(my);
                    ArrayList<FileNode*>* rows = tree.visible();
                    if (ri >= 0 && ri < rows.size()) {
                        FileNode* node = rows.get(ri);
                        ctx.openForTree(mx, my, node.path, node.isDir);
                    }
                    return;
                }
                int panelH = screen.outputPanelHeight(wb.output(), win.height());
                if (panelH > 0 && my >= win.height() - screen.statusH() - panelH) {
                    return;
                }
                int screenRow = (my - screen.textOy()) / screen.lineH();
                if (screenRow < 0 || mx < screen.textOx()) {
                    return;
                }
                Controller* c = wb.active();
                mutable int col = (mx - screen.textOx()) / screen.charW();
                if (col < 0) {
                    col = 0;
                }
                int docRow = c.lineNumberAt(screenRow);
                int docCol = c.firstColumn() + col;
                // Keep an existing selection if the click landed inside it (so Cut/Copy act on it); otherwise
                // move the caret to the click, the way every editor does.
                boolean inSel = c.editor().hasSelection() && GuiApp.insideSelection(c, docRow, docCol);
                if (!inSel) {
                    c.placeCaret(docRow, docCol);
                }
                boolean hasWord = c.wordAtCaret().length() > 0;
                ctx.openForEditor(mx, my, hasWord, c.editor().hasSelection());
                return;
            }
            // Is (row, col) inside the active selection? (document order, half-open at the end)
            private static method insideSelection(Controller* c, int row, int col) returns boolean {
                int sr = c.editor().selStartRow();
                int sc = c.editor().selStartCol();
                int er = c.editor().selEndRow();
                int ec = c.editor().selEndCol();
                if (row < sr || row > er) {
                    return false;
                }
                if (row == sr && col < sc) {
                    return false;
                }
                if (row == er && col > ec) {
                    return false;
                }
                return true;
            }

            // Run a context-menu item. Context-only ids (ctx.*) are handled here -- they need the file tree, the
            // window, or the menu's target path; everything else is a normal command id the workbench knows.
            private static method runContextCommand(GlWindow* win, GpuScreen* screen, Workbench* wb,
                                                    FileTree* tree, Overlay* ov, OpenRequest* req,
                                                    ContextMenu* ctx, String id) returns void {
                String target = ctx.targetPath;
                ctx.close();
                if (id.equals("ctx.gotoDef")) {
                    GuiApp.gotoDef(wb, tree);
                    return;
                }
                if (id.equals("ctx.peekDef")) {
                    wb.peekDefinition(tree.allFiles());
                    return;
                }
                if (id.equals("ctx.findRefs")) {
                    wb.findReferencesAcross(tree.allFiles());
                    return;
                }
                if (id.equals("ctx.cut")) {
                    wb.active().cut();
                    return;
                }
                if (id.equals("ctx.copy")) {
                    wb.active().copy();
                    return;
                }
                if (id.equals("ctx.paste")) {
                    wb.active().paste();
                    return;
                }
                if (id.equals("ctx.comment")) {
                    wb.active().toggleComment();
                    return;
                }
                if (id.equals("ctx.treeOpen")) {
                    if (target.length() > 0) {
                        wb.openFile(target);
                    }
                    return;
                }
                if (id.equals("ctx.treeNewFile")) {
                    ov.openPrompt("newfile", "new file (path): ");
                    return;
                }
                if (id.equals("ctx.treeRename")) {
                    if (target.length() > 0) {
                        wb.openFile(target);
                        ov.openPrompt("rename", "rename to: ");
                    }
                    return;
                }
                if (id.equals("ctx.treeDelete")) {
                    if (target.length() > 0) {
                        wb.openFile(target);
                        ov.openPrompt("delete", "delete '" + Paths.basename(target) + "'? type y to confirm: ");
                    }
                    return;
                }
                if (id.equals("ctx.treeCopyPath")) {
                    wb.output().banner("Path", target);
                    return;
                }
                if (id.equals("ctx.treeReveal")) {
                    if (target.length() > 0) {
                        wb.runShell("Explorer", "explorer /select,\"" + target + "\"");
                    }
                    return;
                }
                if (id.equals("ctx.tabClose")) {
                    wb.closeActiveTab();
                    return;
                }
                if (id.equals("ctx.tabCloseOthers")) {
                    wb.closeOtherTabs();
                    return;
                }
                if (id.equals("ctx.tabSave")) {
                    wb.active().save();
                    wb.refreshGit();
                    return;
                }
                GuiApp.runMenuCommand(win, wb, ov, req, id);   // a plain command id (rename, format, nav, ...)
                return;
            }

            // Mouse drag inside the editor: extend the selection to the live cursor.
            private static method dragExtend(GpuScreen* screen, Workbench* wb, GlWindow* win) returns void {
                GuiApp.dragExtendAt(screen, wb, win.cursorX(), win.cursorY());
                return;
            }
            private static method absDiff(int a, int b) returns int {
                if (a > b) {
                    return a - b;
                }
                return b - a;
            }
            // Double-click in the text: select the word under the mouse.
            private static method selectWordAtMouse(GpuScreen* screen, Workbench* wb, GlWindow* win) returns void {
                GuiApp.selectWordAtCoords(screen, wb, win.cursorX(), win.cursorY());
                return;
            }
            private static method selectWordAtCoords(GpuScreen* screen, Workbench* wb, int mx, int my)
                    returns void {
                mutable int sr = (my - screen.textOy()) / screen.lineH();
                if (sr < 0) {
                    sr = 0;
                }
                mutable int col = (mx - screen.textOx()) / screen.charW();
                if (col < 0) {
                    col = 0;
                }
                Controller* c = wb.active();
                c.selectWordAt(c.lineNumberAt(sr), c.firstColumn() + col);
                return;
            }
            // Extend the selection to a pixel (mx, my) -- shared by the live drag and the serve `dragto` command.
            private static method dragExtendAt(GpuScreen* screen, Workbench* wb, int mx, int my) returns void {
                mutable int sr = (my - screen.textOy()) / screen.lineH();
                if (sr < 0) {
                    sr = 0;
                }
                mutable int col = (mx - screen.textOx()) / screen.charW();
                if (col < 0) {
                    col = 0;
                }
                Controller* c = wb.active();
                c.extendSelectTo(c.lineNumberAt(sr), c.firstColumn() + col);
                return;
            }

            // Execute a menu item's command id. Most map straight to Workbench.runCommand; a few are shell-level
            // actions the GUI owns: opening the find/palette overlays, closing the active tab, quitting the
            // window (WM_CLOSE), and the About banner.
            private static method runMenuCommand(GlWindow* win, Workbench* wb, Overlay* ov, OpenRequest* req,
                                                 String id) returns void {
                if (id.equals("file.openFolder")) {
                    String picked = NativeDialog.pickFolder(win.hwnd, "Open a project folder");
                    if (picked.length() > 0) {
                        req.path = picked;
                    }
                    return;
                }
                if (id.equals("file.save")) {
                    wb.active().save();
                    return;
                }
                if (id.equals("file.saveAs")) {
                    GuiApp.runSaveAs(win, wb);
                    return;
                }
                if (id.equals("edit.find")) {
                    ov.open(2);
                    return;
                }
                if (id.equals("edit.rename")) {
                    GuiApp.beginRenameSymbol(wb, ov);
                    return;
                }
                if (id.equals("refactor.extractVariable")) {
                    if (wb.active().editor().hasSelection()) {
                        ov.openPrompt("extractVar", "extract to variable named: ");
                    }
                    return;
                }
                if (id.equals("git.commit")) {
                    ov.openPrompt("commit", "commit message: ");
                    return;
                }
                if (id.equals("file.newDisk")) {
                    ov.openPrompt("newfile", "new file (path): ");
                    return;
                }
                if (id.equals("file.rename")) {
                    ov.openPrompt("rename", "rename to: ");
                    return;
                }
                if (id.equals("file.delete")) {
                    String base = Paths.basename(wb.activePath());
                    if (base.length() > 0) {
                        ov.openPrompt("delete", "delete '" + base + "'? type y to confirm: ");
                    }
                    return;
                }
                if (id.equals("git.status")) {
                    wb.gitStatusView();
                    return;
                }
                if (id.equals("git.push")) {
                    wb.gitPush();
                    return;
                }
                if (id.equals("git.diff")) {
                    wb.gitDiff();
                    return;
                }
                if (id.equals("view.palette")) {
                    ov.open(1);
                    return;
                }
                if (id.equals("view.fold")) {
                    wb.active().toggleFoldAtCaret();
                    return;
                }
                if (id.equals("view.unfoldAll")) {
                    wb.active().unfoldAll();
                    return;
                }
                if (id.equals("file.close")) {
                    wb.closeActiveTab();
                    return;
                }
                if (id.equals("app.quit")) {
                    Win32.PostMessageA(win.hwnd, 16, 0, 0);
                    return;
                }
                // WM_CLOSE
                if (id.equals("help.stdlib")) {
                    GuiApp.openReference(wb, "stdlib.ldp3");
                    return;
                }
                if (id.equals("help.langref")) {
                    GuiApp.openReference(wb, "language-reference.md");
                    return;
                }
                if (id.equals("help.keywords")) {
                    GuiApp.openReference(wb, "keywords.md");
                    return;
                }
                if (id.equals("help.about")) {
                    wb.output().banner("About Forge", "Forge -- the LDP3 IDE, written in LDP3.");
                    return;
                }
                wb.runCommand(id);
                return;
            }

            // Save the active document under a new path chosen from the native "Save As" dialog. Pre-fills the
            // current file name (or "untitled.ldp3" for a fresh buffer); the tab title follows the new path.
            private static method runSaveAs(GlWindow* win, Workbench* wb) returns void {
                Controller* c = wb.active();
                mutable String suggested = Paths.basename(c.document().path());
                if (suggested.length() == 0) {
                    suggested = "untitled.ldp3";
                }
                String path = NativeDialog.saveFile(win.hwnd, suggested);
                if (path.length() > 0) {
                    c.saveAs(path);
                }
                return;
            }

            // Scaffold a minimal LDP3 project in `dir`: an ldp3.toml and a src/main.ldp3 hello-world, so
            // "New Project" produces something that builds and runs immediately. Never overwrites main.ldp3.
            private static method scaffoldProject(String dir) returns void {
                String prog = GuiApp.toIdent(Paths.basename(dir));
                String toml = "[program]\nname = \"" + prog + "\"\nversion = \"0.1.0\"\n"
                    + "entry = \"src/main.ldp3\"\n\n[build]\noutput = \"build-output/\"\n";
                File.writeAll(Paths.join(dir, "ldp3.toml"), toml);
                File.mkdir(Paths.join(dir, "src"));
                String main = Paths.join(dir, "src/main.ldp3");
                if (!File.exists(main)) {
                    StringBuilder sb = new StringBuilder() on heap;
                    sb.append("import System.IO.Console;\n\n");
                    sb.append("program " + prog + ";\n\n");
                    sb.append("public bundle main {\n");
                    sb.append("    public namespace app {\n");
                    sb.append("        public class Main {\n");
                    sb.append("            public static method main(string[] args) returns void {\n");
                    sb.append("                System.IO.Console.println(\"Hello from " + prog + "!\");\n");
                    sb.append("            }\n");
                    sb.append("        }\n");
                    sb.append("    }\n");
                    sb.append("}\n");
                    File.writeAll(main, sb.toString());
                }
                return;
            }
            // A valid LDP3 identifier from a folder name (drop non-alphanumerics; fall back to "App").
            private static method toIdent(String s) returns String {
                StringBuilder sb = new StringBuilder() on heap;
                mutable int i = 0;
                while (i < s.length()) {
                    char c = s.charAt(i);
                    if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9')) {
                        sb.appendChar(c);
                    }
                    i = i + 1;
                }
                String r = sb.toString();
                if (r.length() == 0) {
                    return "App";
                }
                if (r.charAt(0) >= '0' && r.charAt(0) <= '9') {
                    return "App" + r;
                }
                return r;
            }

            // The directory Forge.exe lives in (via GetModuleFileNameA), so bundled resources resolve
            // relative to the install location rather than the current working directory.
            private static method exeDir() returns String {
                address buf = Memory.alloc(520);
                int n = Win32.GetModuleFileNameA(0, cast<long>(buf), 520);
                mutable String full = "";
                if (n > 0) {
                    full = Memory.readString(buf, n);
                }
                Memory.free(buf);
                return Paths.dirname(full);
            }
            // Full path to a bundled reference file (reference/<name> next to the exe).
            private static method referencePath(String name) returns String {
                return GuiApp.exeDir() + "/reference/" + name;
            }
            // Open a bundled reference document (the real stdlib, the spec) in a browsable tab. Reuses the
            // full editor -- syntax highlighting, folding, Ctrl+Shift+O symbol navigation -- so the standard
            // library is browsed "down to the class" with the same tools as any source file.
            private static method openReference(Workbench* wb, String name) returns void {
                String p = GuiApp.referencePath(name);
                if (File.exists(p)) {
                    wb.openFile(p);
                } else {
                    wb.output().banner("Reference not found",
                        "Could not find " + name + " next to Forge (looked in " + GuiApp.exeDir() + "/reference).");
                }
                return;
            }

            // Reopen the files that were open last time this project was closed, so Forge picks up where the
            // user left off. Called on opening/switching a project.
            private static method restoreSession(Workbench* wb, String dir) returns void {
                ArrayList<String>* sess = WorkspaceStore.loadSession(dir);
                mutable int i = 0;
                while (i < sess.size()) {
                    wb.openFile(sess.get(i));
                    i = i + 1;
                }
                return;
            }

            // Scriptable automation server: open the window once, then read one command per line from stdin
            // and drive the IDE. This is the transport the Forge MCP server speaks -- a remote control for
            // testing, scripting, and (eventually) AI integration. Commands: type <text>, key <name>,
            // click <x> <y>, cmd <id>, open <path>, save, palette <query>, find <query>, esc, shot <path>,
            // state, quit. Each command prints a one-line acknowledgement.
            public static method serve() returns void {
                GlWindow* win = new GlWindow() on heap;
                if (win.open("Forge", 1100, 720, 4, 6) == 0) {
                    System.IO.Console.println("err: no GL window");
                    return;
                }
                Font* font = GuiApp.loadFont(win, 18);
                Batch2D* batch = new Batch2D(win.gl) on heap;
                GpuScreen* screen = new GpuScreen(font) on heap;
                Workbench* wb = GuiApp.buildWorkbench(screen, win.width(), win.height(),
                                                      "src/gfx/GpuScreen.ldp3");
                FileTree* tree = new FileTree("src") on heap;
                Overlay* ov = new Overlay() on heap;
                Completion* comp = new Completion() on heap;
                comp.loadImports(GuiApp.referencePath("imports.txt"));
                GuiApp.refreshProjectSymbols(comp, tree);
                MenuBar* menu = new MenuBar() on heap;
                ContextMenu* ctx = new ContextMenu() on heap;
                OpenRequest* req = new OpenRequest() on heap;
                System.IO.Console.println("forge-serve ready");
                Win32.fflush(0);
                mutable boolean running = true;
                while (running) {
                    win.pump();
                    String line = System.IO.Console.read();
                    if (line.length() == 0) {
                        running = false;
                    }
                    else if (GuiApp.firstWord(line).equals("quit")) {
                        running = false;
                    }
                    else {
                        GuiApp.serveCommand(line, win, batch, screen, wb, tree, ov, comp, menu, ctx, req);
                        Win32.fflush(0);
                    }
                }
                return;
            }

            private static method serveCommand(String line, GlWindow* win, Batch2D* batch, GpuScreen* screen,
                                               Workbench* wb, FileTree* tree, Overlay* ov, Completion* comp,
                                               MenuBar* menu, ContextMenu* ctx, OpenRequest* req) returns void {
                String cmd = GuiApp.firstWord(line);
                String arg = GuiApp.rest(line);
                if (cmd.equals("type")) {
                    mutable int i = 0;
                    while (i < arg.length()) {
                        char c = arg.charAt(i);
                        if (ov.isOpen()) {
                            ov.typeChar(c);
                        } else {
                            wb.handleKey(Key.ch(c));
                        }
                        i = i + 1;
                    }
                    if (!ov.isOpen()) {
                        comp.update(wb.active());
                    }
                    System.IO.Console.println("ok");
                } else if (cmd.equals("key")) {
                    GuiApp.serveKey(wb, ov, comp, arg);
                    System.IO.Console.println("ok");
                } else if (cmd.equals("click")) {
                    String rx = GuiApp.firstWord(arg);
                    String ry = GuiApp.rest(arg);
                    GuiApp.clickAt(win, screen, wb, tree, ov, menu, req, rx.toInt(), ry.toInt(), false);
                    System.IO.Console.println("ok");
                } else if (cmd.equals("altclick")) {
                    String rx = GuiApp.firstWord(arg);
                    String ry = GuiApp.rest(arg);
                    GuiApp.clickAt(win, screen, wb, tree, ov, menu, req, rx.toInt(), ry.toInt(), true);
                    System.IO.Console.println("ok carets=" + (wb.active().extraCaretCount() + 1).toString());
                } else if (cmd.equals("rclick")) {
                    String rx = GuiApp.firstWord(arg);              // rclick <x> <y>: open the context menu there
                    String ry = GuiApp.rest(arg);
                    GuiApp.rightClickAt(win, screen, wb, tree, ctx, rx.toInt(), ry.toInt());
                    System.IO.Console.println("ok ctx items=" + ctx.count().toString());
                } else if (cmd.equals("ctxdump")) {
                    mutable int ci = 0;
                    while (ci < ctx.count()) {
                        System.IO.Console.println("C" + ci.toString() + "| " + ctx.captionAt(ci)
                            + "  [" + ctx.idAt(ci) + "]");
                        ci = ci + 1;
                    }
                    System.IO.Console.println("ok");
                } else if (cmd.equals("ctxrun")) {
                    int ci = arg.toInt();                            // ctxrun <i>: activate context item i
                    if (ci >= 0 && ci < ctx.count()) {
                        GuiApp.runContextCommand(win, screen, wb, tree, ov, req, ctx, ctx.idAt(ci));
                    }
                    System.IO.Console.println("ok");
                } else if (cmd.equals("dragto")) {
                    String rx = GuiApp.firstWord(arg);
                    String ry = GuiApp.rest(arg);
                    GuiApp.dragExtendAt(screen, wb, rx.toInt(), ry.toInt());
                    System.IO.Console.println("ok");
                } else if (cmd.equals("bp")) {
                    // bp <line>: toggle a breakpoint on the active file at a 1-based line (debug-UI check).
                    boolean added = wb.debugger().toggleBreakpoint(wb.activePath(), arg.toInt());
                    if (added) {
                        System.IO.Console.println("ok bp on");
                    } else {
                        System.IO.Console.println("ok bp off");
                    }
                } else if (cmd.equals("theme")) {
                    wb.toggleTheme();                               // flip light/dark (applied next drawFrame)
                    screen.applyThemeFor(wb);
                    System.IO.Console.println("ok light=" + GuiApp.boolStr(wb.wantsLight()));
                } else if (cmd.equals("term")) {
                    // term [cmd]: open the terminal; with an argument, type it and press Enter.
                    if (!wb.terminal().isOpen()) {
                        wb.toggleTerminal();
                    }
                    if (arg.length() > 0) {
                        mutable int ti = 0;
                        while (ti < arg.length()) {
                            wb.terminal().typeChar(arg.charAt(ti));
                            ti = ti + 1;
                        }
                        wb.terminal().enter();
                    }
                    System.IO.Console.println("ok term open=" + GuiApp.boolStr(wb.terminal().isOpen()));
                } else if (cmd.equals("termdump")) {
                    ArrayList<String>* tl = wb.terminal().scrollback();
                    mutable int td = 0;
                    if (tl.size() > 30) {
                        td = tl.size() - 30;
                    }
                    while (td < tl.size()) {
                        System.IO.Console.println("T| " + tl.get(td));
                        td = td + 1;
                    }
                    System.IO.Console.println("ok");
                } else if (cmd.equals("cmd")) {
                    boolean ran = wb.runCommand(arg);               // run any registered command by id
                    if (ran) {
                        System.IO.Console.println("ok");
                    } else {
                        System.IO.Console.println("unknown command");
                    }
                } else if (cmd.equals("extractvar")) {
                    boolean ok = wb.active().extractVariable(arg);   // extractvar <name>: on the current selection
                    System.IO.Console.println("ok extract " + GuiApp.boolStr(ok));
                } else if (cmd.equals("renamesym")) {
                    String oldName = GuiApp.firstWord(arg);         // renamesym <old> <new>: workspace rename
                    String newName = GuiApp.rest(arg);
                    int n = wb.renameSymbolAcross(oldName, newName);
                    System.IO.Console.println("ok renamed " + n.toString());
                } else if (cmd.equals("problem")) {
                    wb.nextProblem(!arg.equals("back"));            // problem [back]: jump to next/prev problem
                    System.IO.Console.println("ok line=" + (wb.active().editor().cursorRow() + 1).toString()
                        + " problems=" + wb.diagnostics().size().toString());
                } else if (cmd.equals("project")) {
                    wb.setProjectDir(arg);                           // point build/debug at a project root
                    System.IO.Console.println("ok " + wb.projectLabel());
                } else if (cmd.equals("debug")) {
                    wb.startDebugging();                            // build --debug + launch the adapter
                    System.IO.Console.println("ok debug active=" + GuiApp.boolStr(wb.debugger().isActive()));
                } else if (cmd.equals("dbgstep")) {
                    wb.debugger().stepOver();
                    System.IO.Console.println("ok");
                } else if (cmd.equals("dbgstop")) {
                    wb.debugger().stop();
                    System.IO.Console.println("ok");
                } else if (cmd.equals("outdump")) {
                    ArrayList<String>* ls = wb.output().lines;    // dump the output/console panel lines
                    mutable int oi = 0;
                    while (oi < ls.size()) {
                        System.IO.Console.println("OUT| " + ls.get(oi));
                        oi = oi + 1;
                    }
                    System.IO.Console.println("ok");
                } else if (cmd.equals("dbgstate")) {
                    Debugger* dbg = wb.debugger();
                    System.IO.Console.println("dbg active=" + GuiApp.boolStr(dbg.isActive())
                        + " stopped=" + GuiApp.boolStr(dbg.isStopped())
                        + " line=" + dbg.stoppedAtLine().toString()
                        + " frames=" + dbg.callStackView().size().toString()
                        + " vars=" + dbg.variablesView().size().toString()
                        + " status=" + dbg.statusText());
                } else if (cmd.equals("selword")) {
                    String rx = GuiApp.firstWord(arg);
                    String ry = GuiApp.rest(arg);
                    GuiApp.selectWordAtCoords(screen, wb, rx.toInt(), ry.toInt());
                    System.IO.Console.println("ok sel='" + wb.active().editor().selectionText() + "'");
                } else if (cmd.equals("menu")) {
                    // menu <i> opens/toggles menu i; menu -1 closes any open menu
                    int mi = arg.toInt();
                    if (mi < 0) {
                        menu.close();
                    } else {
                        menu.toggle(mi);
                    }
                    System.IO.Console.println("ok");
                } else if (cmd.equals("menuitem")) {
                    // menuitem <i> runs item i of the currently open menu (scripted equivalent of a click)
                    if (menu.isOpen()) {
                        int mi = arg.toInt();
                        if (mi >= 0 && mi < menu.openMenu().items.size()) {
                            String id = menu.openMenu().items.get(mi).commandId;
                            menu.close();
                            GuiApp.runMenuCommand(win, wb, ov, req, id);
                        }
                    }
                    System.IO.Console.println("ok");
                } else if (cmd.equals("cmd")) {
                    wb.runCommand(arg);
                    System.IO.Console.println("ok");
                } else if (cmd.equals("open")) {
                    wb.openFile(arg);
                    System.IO.Console.println("ok");
                } else if (cmd.equals("save")) {
                    wb.active().save();
                    System.IO.Console.println("ok");
                } else if (cmd.equals("saveas")) {
                    wb.active().saveAs(arg);
                    System.IO.Console.println("ok " + Paths.basename(wb.active().document().path()));
                } else if (cmd.equals("palette")) {
                    ov.open(1);
                    mutable int i = 0;
                    while (i < arg.length()) {
                        ov.typeChar(arg.charAt(i));
                        i = i + 1;
                    }
                    System.IO.Console.println("ok");
                } else if (cmd.equals("find")) {
                    ov.open(2);
                    mutable int i = 0;
                    while (i < arg.length()) {
                        ov.typeChar(arg.charAt(i));
                        i = i + 1;
                    }
                    wb.active().find(arg);
                    System.IO.Console.println("ok " + wb.active().matchCount(arg).toString() + " matches");
                } else if (cmd.equals("findinfiles")) {
                    ov.openSearch(tree.allFiles());
                    mutable int i = 0;
                    while (i < arg.length()) {
                        ov.typeChar(arg.charAt(i));
                        i = i + 1;
                    }
                    GuiApp.runGlobalSearch(ov, wb);
                    ov.close();
                    System.IO.Console.println("ok " + wb.output().lineCount().toString() + " result lines");
                } else if (cmd.equals("replaceall")) {
                    // replaceall <query>::<replacement>
                    int sep = arg.indexOf("::");
                    if (sep >= 0) {
                        String q = arg.substring(0, sep);
                        String rp = arg.substring(sep + 2, arg.length());
                        int n = wb.active().replaceAll(q, rp);
                        System.IO.Console.println("ok " + n.toString() + " replaced");
                    } else {
                        System.IO.Console.println("err: use replaceall <query>::<replacement>");
                    }
                } else if (cmd.equals("symbols")) {
                    GuiApp.openSymbols(ov, wb);
                    mutable int i = 0;
                    while (i < arg.length()) {
                        ov.typeChar(arg.charAt(i));
                        i = i + 1;
                    }
                    System.IO.Console.println("ok " + ov.matches().size().toString() + " symbols");
                } else if (cmd.equals("wsymbols")) {
                    GuiApp.openWorkspaceSymbols(ov, wb, tree);
                    mutable int i = 0;
                    while (i < arg.length()) {
                        ov.typeChar(arg.charAt(i));
                        i = i + 1;
                    }
                    System.IO.Console.println("ok " + ov.matches().size().toString() + " of "
                        + ov.items.size().toString() + " workspace symbols");
                } else if (cmd.equals("quickopen")) {
                    ov.openFiles(tree.allFiles());
                    mutable int i = 0;
                    while (i < arg.length()) {
                        ov.typeChar(arg.charAt(i));
                        i = i + 1;
                    }
                    System.IO.Console.println("ok " + ov.matches().size().toString() + " files");
                } else if (cmd.equals("gotoline")) {
                    ov.open(5);
                    mutable int i = 0;
                    while (i < arg.length()) {
                        ov.typeChar(arg.charAt(i));
                        i = i + 1;
                    }
                    GuiApp.runGoToLine(ov, wb);
                    ov.close();
                    System.IO.Console.println("ok ln=" + (wb.active().editor().cursorRow() + 1).toString());
                } else if (cmd.equals("welcomeshot")) {
                    GuiApp.drawWelcomeFrame(win, batch, screen, WorkspaceStore.loadRecent());
                    Wgl.glFinish();
                    int w = win.width();
                    int h = win.height();
                    byte[] px = win.gl.readPixelsRgb(0, 0, w, h);
                    GuiApp.writePpm(arg, px, w, h);
                    win.swap();
                    System.IO.Console.println("welcomeshot " + arg);
                } else if (cmd.equals("recent")) {
                    ArrayList<String>* r = WorkspaceStore.loadRecent();
                    mutable String s = "";
                    mutable int i = 0;
                    while (i < r.size()) {
                        s = s + r.get(i) + " | ";
                        i = i + 1;
                    }
                    System.IO.Console.println("recent " + r.size().toString() + ": " + s);
                } else if (cmd.equals("addrecent")) {
                    WorkspaceStore.addRecent(arg);
                    System.IO.Console.println("ok last=" + WorkspaceStore.lastProject());
                } else if (cmd.equals("hoverat")) {
                    Controller* hc = wb.active();
                    String info = hc.hoverInfo(hc.editor().cursorRow(), hc.editor().cursorCol());
                    System.IO.Console.println("hover: " + info);
                } else if (cmd.equals("refs")) {
                    int n = wb.findReferencesAcross(tree.allFiles());
                    System.IO.Console.println("ok " + n.toString() + " references");
                } else if (cmd.equals("sigat")) {
                    System.IO.Console.println("sig: " + wb.active().signatureAtCaret());
                } else if (cmd.equals("gotodef")) {
                    boolean found = GuiApp.gotoDef(wb, tree);
                    mutable String r = "not-found";
                    if (found) {
                        r = Paths.basename(wb.activePath()) + ":" + (wb.active().editor().cursorRow() + 1).toString();
                    }
                    System.IO.Console.println("ok " + r);
                } else if (cmd.equals("peek")) {
                    boolean found = wb.peekDefinition(tree.allFiles());
                    mutable String r = "not-found";
                    if (found) {
                        r = wb.peekView().file + ":" + (wb.peekView().defLine + 1).toString()
                            + " lines=" + wb.peekView().lines.size().toString();
                    }
                    System.IO.Console.println("ok peek " + r);
                } else if (cmd.equals("fold")) {
                    // fold <line> toggles the fold whose header is that 1-based line
                    int docLine = arg.toInt() - 1;
                    if (wb.active().isFoldable(docLine)) {
                        wb.active().toggleFold(docLine);
                        mutable String st = "expanded";
                        if (wb.active().isFolded(docLine)) {
                            st = "folded";
                        }
                        System.IO.Console.println("ok " + st);
                    } else {
                        System.IO.Console.println("ok not-foldable");
                    }
                } else if (cmd.equals("unfoldall")) {
                    wb.active().unfoldAll();
                    System.IO.Console.println("ok");
                } else if (cmd.equals("esc")) {
                    ov.close();
                    System.IO.Console.println("ok");
                } else if (cmd.equals("shot")) {
                    GuiApp.drawFrame(win, batch, screen, wb, tree, ov, comp, menu, ctx);
                    Wgl.glFinish();
                    int w = win.width();
                    int h = win.height();
                    byte[] px = win.gl.readPixelsRgb(0, 0, w, h);
                    GuiApp.writePpm(arg, px, w, h);
                    win.swap();
                    System.IO.Console.println("shot " + arg);
                } else if (cmd.equals("run")) {
                    wb.runShell("Run", arg);
                    System.IO.Console.println("ok " + wb.output().lineCount().toString() + " lines");
                } else if (cmd.equals("build")) {
                    wb.diagnose();
                    System.IO.Console.println("ok " + wb.errorCount().toString() + " errors "
                        + wb.warningCount().toString() + " warnings");
                } else if (cmd.equals("gitstatus")) {
                    wb.gitStatusView();
                    System.IO.Console.println("ok " + wb.output().lineCount().toString() + " changed");
                } else if (cmd.equals("diff")) {
                    wb.openDiff();
                    System.IO.Console.println("ok diff " + wb.diffView().lines.size().toString() + " lines");
                } else if (cmd.equals("diffdump")) {
                    ArrayList<String>* dl = wb.diffView().lines;
                    mutable int di = 0;
                    while (di < dl.size() && di < 40) {
                        System.IO.Console.println("D" + wb.diffView().kinds.get(di).toString() + "| " + dl.get(di));
                        di = di + 1;
                    }
                    System.IO.Console.println("ok");
                } else if (cmd.equals("newfile")) {
                    wb.newFileOnDisk(arg);
                    System.IO.Console.println("ok " + wb.documents().active().document().path());
                } else if (cmd.equals("bookmark")) {
                    wb.active().toggleBookmark();
                    System.IO.Console.println("ok");
                } else if (cmd.equals("nextbm")) {
                    wb.active().nextBookmark(true);
                    System.IO.Console.println("ok ln=" + (wb.active().editor().cursorRow() + 1).toString());
                } else if (cmd.equals("state")) {
                    GuiApp.serveState(wb);
                } else if (cmd.equals("metrics")) {
                    mutable String m = "metrics treeW=" + screen.treeWidth().toString();
                    m = m + " textOx=" + screen.textOx().toString();
                    m = m + " textOy=" + screen.textOy().toString();
                    m = m + " lineH=" + screen.lineH().toString();
                    m = m + " visibleRows=" + wb.active().visibleRows().toString();
                    m = m + " paneRows=" + screen.paneRowsFor(win.height()).toString();
                    System.IO.Console.println(m);
                } else {
                    System.IO.Console.println("err: unknown " + cmd);
                }
                return;
            }

            private static method serveKey(Workbench* wb, Overlay* ov, Completion* comp, String name) returns void {
                // parse optional modifier prefixes: e.g. "ctrl+slash", "shift+enter", "ctrl+shift+p"
                mutable boolean ctrl = false;
                mutable boolean shift = false;
                mutable boolean alt = false;
                mutable String n = name;
                mutable boolean more = true;
                while (more) {
                    if (n.startsWith("ctrl+")) {
                        ctrl = true;
                        n = n.substring(5, n.length());
                    }
                    else if (n.startsWith("shift+")) {
                        shift = true;
                        n = n.substring(6, n.length());
                    }
                    else if (n.startsWith("alt+")) {
                        alt = true;
                        n = n.substring(4, n.length());
                    }
                    else {
                        more = false;
                    }
                }
                int vk = GuiApp.vkForName(n);
                if (ov.isOpen()) {
                    if (vk == 27) {
                        ov.close();
                    }
                    else if (ov.mode == 2) {
                        GuiApp.findKey(ov, wb, vk, ctrl, shift);
                    }
                    else if (vk == 8) {
                        ov.backspace();
                    }
                    else if (vk == 40) {
                        ov.moveSel(1);
                    }
                    else if (vk == 38) {
                        ov.moveSel(0 - 1);
                    }
                    else if (vk == 13) {
                        if (ov.mode == 1) {
                            GuiApp.runPaletteSelection(ov, wb);
                        }
                        else if (ov.mode == 3) {
                            GuiApp.runSymbolSelection(ov, wb);
                        }
                        else if (ov.mode == 4) {
                            GuiApp.runQuickOpen(ov, wb);
                        }
                        else if (ov.mode == 5) {
                            GuiApp.runGoToLine(ov, wb);
                        }
                        else if (ov.mode == 6) {
                            GuiApp.runGlobalSearch(ov, wb);
                        }
                        else if (ov.mode == 7) {
                            GuiApp.runPrompt(ov, wb);
                        }
                        else {
                            wb.active().find(ov.query);
                        }
                        ov.close();
                    }
                } else if (comp.active && GuiApp.completionKey(comp, wb, vk)) {
                    return;
                } else if (GuiApp.caretHotkey(wb, vk, ctrl, shift, alt)) {
                    return;
                } else if (ctrl && vk == 87) {
                    wb.closeActiveTab();
                    return;
                } else {
                    GuiApp.dispatchKey(wb, vk, ctrl, shift, alt);
                    if (vk == 8) {
                        comp.update(wb.active());
                    } else {
                        comp.dismiss();
                    }
                }
                return;
            }

            private static method serveState(Workbench* wb) returns void {
                wb.trackNav();   // in serve mode there is no per-frame loop; sample the nav tracker here
                Controller* c = wb.active();
                mutable String path = c.document().path();
                if (path.length() == 0) {
                    path = "untitled";
                }
                mutable int dirty = 0;
                if (c.document().isModified()) {
                    dirty = 1;
                }
                System.IO.Console.println("state file=" + path
                    + " ln=" + (c.editor().cursorRow() + 1).toString()
                    + " col=" + (c.editor().cursorCol() + 1).toString()
                    + " lines=" + c.lineCount().toString()
                    + " tabs=" + wb.documents().count().toString()
                    + " dirty=" + dirty.toString());
                return;
            }

            private static method firstWord(String s) returns String {
                int sp = s.indexOf(" ");
                if (sp < 0) {
                    return s;
                }
                return s.substring(0, sp);
            }
            private static method boolStr(boolean b) returns String {
                if (b) {
                    return "1";
                }
                return "0";
            }
            // Start a symbol rename: stash the identifier under the caret and open a prompt pre-filled with it.
            private static method beginRenameSymbol(Workbench* wb, Overlay* ov) returns void {
                String w = wb.active().wordAtCaret();
                if (w.length() == 0) {
                    return;
                }
                wb.setRenameTarget(w);
                ov.openPrompt("renameSymbol", "rename '" + w + "' to: ");
                mutable int i = 0;
                while (i < w.length()) {
                    ov.typeChar(w.charAt(i));
                    i = i + 1;
                }
            }
            private static method rest(String s) returns String {
                int sp = s.indexOf(" ");
                if (sp < 0) {
                    return "";
                }
                return s.substring(sp + 1, s.length());
            }
            private static method vkForName(String name) returns int {
                if (name.equals("enter")) {
                    return 13;
                }
                if (name.equals("backspace")) {
                    return 8;
                }
                if (name.equals("tab")) {
                    return 9;
                }
                if (name.equals("esc")) {
                    return 27;
                }
                if (name.equals("delete")) {
                    return 46;
                }
                if (name.equals("left")) {
                    return 37;
                }
                if (name.equals("up")) {
                    return 38;
                }
                if (name.equals("right")) {
                    return 39;
                }
                if (name.equals("down")) {
                    return 40;
                }
                if (name.equals("home")) {
                    return 36;
                }
                if (name.equals("end")) {
                    return 35;
                }
                if (name.equals("pageup")) {
                    return 33;
                }
                if (name.equals("pagedown")) {
                    return 34;
                }
                if (name.equals("slash")) {
                    return 191;
                }
                if (name.length() == 1) {
                    char c = name.charAt(0);
                    if (c >= 'a' && c <= 'z') {
                        return cast<int>(c) - 32;
                    }
                    // 'a' -> VK 65
                    if (c >= 'A' && c <= 'Z') {
                        return cast<int>(c);
                    }
                    if (c >= '0' && c <= '9') {
                        return cast<int>(c);
                    }
                }
                return 0;
            }

            // Offscreen verification of the REAL input path: post WM_CHAR/WM_KEYDOWN to the window, let
            // pump() decode them into the event queue, drain them through processInput (the same code the
            // live loop runs), then render one frame to a PPM.
            public static method uitest(String path) returns void {
                GlWindow* win = new GlWindow() on heap;
                if (win.open("Forge", 1100, 720, 4, 6) == 0) {
                    System.IO.Console.printf("Forge: could not open a GL 4.6 window\n");
                    return;
                }
                Font* font = GuiApp.loadFont(win, 18);
                Batch2D* batch = new Batch2D(win.gl) on heap;
                GpuScreen* screen = new GpuScreen(font) on heap;
                Workbench* wb = GuiApp.buildWorkbench(screen, win.width(), win.height(),
                                                      "src/gfx/GpuScreen.ldp3");
                FileTree* tree = new FileTree("src") on heap;
                Overlay* ov = new Overlay() on heap;
                Completion* comp = new Completion() on heap;
                comp.loadImports(GuiApp.referencePath("imports.txt"));
                GuiApp.refreshProjectSymbols(comp, tree);
                MenuBar* menu = new MenuBar() on heap;

                // open the command palette and type a query via real WM_CHAR messages, routed through the
                // overlay path (processInput -> overlayEvent -> typeChar).
                ov.open(1);
                String typed = "save";
                mutable int i = 0;
                while (i < typed.length()) {
                    GuiApp.post(win, 258, cast<int>(typed.charAt(i)));   // WM_CHAR
                    i = i + 1;
                }
                win.pump();
                GuiApp.processInput(win, wb, ov, comp, menu, tree);

                GuiApp.drawFrame(win, batch, screen, wb, tree, ov, comp, menu, new ContextMenu() on heap);
                Wgl.glFinish();
                int w = win.width();
                int h = win.height();
                byte[] px = win.gl.readPixelsRgb(0, 0, w, h);
                GuiApp.writePpm(path, px, w, h);
                win.swap();
                System.IO.Console.printf("Forge: uitest wrote %s\n", path);
                return;
            }
            private static method post(GlWindow* win, int msg, int wp) returns void {
                Win32.PostMessageA(win.hwnd, msg, cast<long>(wp), 0);
                return;
            }

            // Drain the window's keyboard events and drive the Workbench: printable characters type, special
            // keys navigate/edit, Ctrl+letter runs a shortcut -- exactly the CHAR-vs-special split the KeyMap
            // expects. Typed text comes via WM_CHAR; Ctrl combos and named keys via WM_KEYDOWN.
            private static method processInput(GlWindow* win, Workbench* wb, Overlay* ov, Completion* comp,
                                               MenuBar* menu, FileTree* tree) returns void {
                while (win.hasEvent()) {
                    InputEvent* e = win.nextEvent();
                    boolean ctrl = win.modCtrl();
                    boolean shift = win.modShift();
                    boolean alt = win.modAlt();
                    if (e.isKey() && ctrl && e.vk == 192) {                  // Ctrl+` -> toggle terminal
                        wb.toggleTerminal();
                    } else if (wb.terminal().isFocused()) {
                        GuiApp.terminalKey(wb.terminal(), e, ctrl);
                    } else if (ov.isOpen()) {
                        GuiApp.overlayEvent(ov, wb, e, ctrl, shift, alt);
                    } else if (menu.isOpen() && e.isKey() && e.vk == 27) {   // Esc closes an open menu
                        menu.close();
                    } else if (comp.active && e.isKey() && GuiApp.completionKey(comp, wb, e.vk)) {
                        // consumed by the completion popup (Tab/Enter/Esc/Up/Down)
                    } else if (wb.diffView().isActive() && e.isKey() && e.vk == 27) {   // Esc closes the diff
                        wb.diffView().clear();
                    } else if (wb.diffView().isActive() && e.isKey() && e.vk == 40) {   // Down scrolls the diff
                        wb.diffView().scrollBy(1);
                    } else if (wb.diffView().isActive() && e.isKey() && e.vk == 38) {   // Up scrolls the diff
                        wb.diffView().scrollBy(0 - 1);
                    } else if (wb.diffView().isActive() && e.isKey() && e.vk == 34) {   // PageDown
                        wb.diffView().scrollBy(20);
                    } else if (wb.diffView().isActive() && e.isKey() && e.vk == 33) {   // PageUp
                        wb.diffView().scrollBy(0 - 20);
                    } else if (wb.peekView().isActive() && e.isKey() && e.vk == 27) {   // Esc closes the peek
                        wb.peekView().clear();
                    } else if (wb.peekView().isActive() && e.isKey() && e.vk == 13) {   // Enter opens the peek
                        wb.peekJump();
                    } else if (e.isKey() && ctrl && shift && e.vk == 83) {   // Ctrl+Shift+S -> save as
                        GuiApp.runSaveAs(win, wb);
                    } else if (e.isKey() && ctrl && shift && e.vk == 80) {   // Ctrl+Shift+P -> palette
                        ov.open(1);
                    } else if (e.isKey() && ctrl && !shift && e.vk == 80) {  // Ctrl+P -> quick open file
                        ov.openFiles(tree.allFiles());
                    } else if (e.isKey() && ctrl && !shift && e.vk == 71) {  // Ctrl+G -> go to line
                        ov.open(5);
                    } else if (e.isKey() && ctrl && shift && e.vk == 79) {   // Ctrl+Shift+O -> go-to-symbol
                        GuiApp.openSymbols(ov, wb);
                    } else if (e.isKey() && ctrl && !shift && e.vk == 84) {  // Ctrl+T -> workspace symbols
                        GuiApp.openWorkspaceSymbols(ov, wb, tree);
                    } else if (e.isKey() && ctrl && shift && e.vk == 220) {  // Ctrl+Shift+\ -> matching bracket
                        wb.active().goToMatchingBracket();
                    } else if (e.isKey() && ctrl && shift && e.vk == 219) {  // Ctrl+Shift+[ -> fold at caret
                        wb.active().toggleFoldAtCaret();
                    } else if (e.isKey() && ctrl && shift && e.vk == 70) {   // Ctrl+Shift+F -> find in files
                        ov.openSearch(tree.allFiles());
                    } else if (e.isKey() && ctrl && !shift && e.vk == 70) {  // Ctrl+F -> find
                        ov.open(2);
                    } else if (e.isKey() && ctrl && shift && e.vk == 71) {   // Ctrl+Shift+G -> source control
                        wb.gitStatusView();
                    } else if (e.isKey() && ctrl && e.vk == 9) {             // Ctrl+Tab -> last-used tab
                        wb.documents().switchToPrevious();
                    } else if (e.isKey() && ctrl && !shift && e.vk == 74) {  // Ctrl+J -> join lines
                        wb.active().joinLines();
                    } else if (e.isKey() && ctrl && e.vk == 87) {            // Ctrl+W -> close tab
                        wb.closeActiveTab();
                    } else if (e.isKey() && e.vk == 112) {                   // F1 -> standard library reference
                        GuiApp.openReference(wb, "stdlib.ldp3");
                    } else if (e.isKey() && e.vk == 113) {                   // F2 bookmarks
                        if (ctrl) {
                            wb.active().toggleBookmark();
                        } else if (shift) {
                            wb.active().nextBookmark(false);
                        } else {
                            wb.active().nextBookmark(true);
                        }
                    } else if (e.isKey() && ctrl && shift && e.vk == 66) {   // Ctrl+Shift+B -> branches
                        // The list goes to the output panel and the prompt takes the name: you can SEE the
                        // branches while you type the one you want, with no new picker to learn.
                        wb.runCommand("git.branch");
                        ov.openPrompt("checkout", "checkout branch: ");
                    } else if (e.isKey() && ctrl && e.vk == 123) {           // Ctrl+F12 -> structure panel
                        wb.toggleOutline();
                    } else if (e.isKey() && ctrl && shift && e.vk == 77) {   // Ctrl+Shift+M -> problems panel
                        wb.showProblems();
                    } else if (e.isKey() && ctrl && shift && e.vk == 72) {   // Ctrl+Shift+H -> replace in files
                        ov.openPrompt("replaceAll", "replace in files (find|replace): ");
                    } else if (e.isKey() && alt && shift && e.vk == 70) {    // Shift+Alt+F -> format document
                        wb.formatDocument();
                    } else if (e.isKey() && shift && e.vk == 117) {          // Shift+F6 -> rename symbol
                        GuiApp.beginRenameSymbol(wb, ov);
                    } else if (e.isKey() && e.vk == 119) {                   // F8 next problem, Shift+F8 previous
                        wb.nextProblem(!shift);
                    } else if (e.isKey() && alt && !ctrl && !shift && e.vk == 38) {  // Alt+Up -> move line up
                        wb.active().moveLineUp();
                    } else if (e.isKey() && alt && !ctrl && !shift && e.vk == 40) {  // Alt+Down -> move line down
                        wb.active().moveLineDown();
                    } else if (e.isKey() && alt && shift && !ctrl && e.vk == 40) {   // Alt+Shift+Down -> duplicate line
                        wb.active().duplicateLine();
                    } else if (e.isKey() && e.vk == 116) {                   // F5 start/continue, Shift+F5 stop
                        if (shift) {
                            wb.debugger().stop();
                        } else if (wb.debugger().isActive()) {
                            wb.debugger().continueRun();
                        } else {
                            wb.startDebugging();
                        }
                    } else if (e.isKey() && e.vk == 121) {                   // F10 -> step over
                        wb.debugger().stepOver();
                    } else if (e.isKey() && e.vk == 122) {                   // F11 step in, Shift+F11 step out
                        if (shift) {
                            wb.debugger().stepOut();
                        } else {
                            wb.debugger().stepInto();
                        }
                    } else if (e.isKey() && e.vk == 123) {                   // F12 def, Shift+F12 refs, Alt+F12 peek
                        if (shift) {
                            wb.findReferencesAcross(tree.allFiles());
                        } else if (alt) {
                            wb.peekDefinition(tree.allFiles());
                        } else {
                            GuiApp.gotoDef(wb, tree);
                        }
                    } else if (e.isKey() && e.vk == 27 && wb.output().visible
                               && !wb.active().hasMultipleCarets()) {       // Esc closes the output panel
                        wb.output().hide();
                    } else if (e.isKey() && GuiApp.caretHotkey(wb, e.vk, ctrl, shift, alt)) {
                        // consumed by a multi-cursor hotkey (Ctrl+Alt+Up/Down add a caret; Esc collapses)
                    } else if (e.isChar()) {
                        // Accept a printable character. Reject it only for a real Ctrl shortcut (Ctrl without
                        // Alt); AltGr, which Windows reports as Ctrl+Alt, produces printable chars like { } [ ]
                        // on ABNT2/international layouts and must pass through.
                        int cp = e.code;
                        if (cp >= 32 && cp != 127 && (!ctrl || alt)) {
                            wb.handleKey(Key.ch(cast<char>(cp)));
                            comp.update(wb.active());
                        }
                    } else if (e.isKey()) {
                        GuiApp.dispatchKey(wb, e.vk, ctrl, shift, alt);
                        if (e.vk == 8) {
                            comp.update(wb.active());
                        } else {
                            comp.dismiss();
                        }
                        // after a save (Ctrl+S), the git change bars reflect the new on-disk state and the
                        // project symbol index picks up any renamed/added declarations
                        if (ctrl && !alt && e.vk == 83) {
                            wb.refreshGit();
                            GuiApp.refreshProjectSymbols(comp, tree);
                        }
                    }
                }
                return;
            }

            // Route a key to the integrated terminal while it is focused.
            private static method terminalKey(Terminal* t, InputEvent* e, boolean ctrl) returns void {
                if (e.isKey() && e.vk == 27) {           // Esc -> back to the editor (panel stays open)
                    t.blur();
                } else if (e.isKey() && e.vk == 13) {    // Enter -> run the line
                    t.enter();
                } else if (e.isKey() && e.vk == 8) {     // Backspace
                    t.backspace();
                } else if (ctrl && e.isKey() && e.vk == 67) {   // Ctrl+C -> interrupt
                    t.interrupt();
                } else if (e.isChar()) {
                    int cp = e.code;
                    if (cp >= 32 && cp != 127) {
                        t.typeChar(cast<char>(cp));
                    }
                }
            }

            // Handle a key while the completion popup is open. Returns true if it consumed the key.
            private static method completionKey(Completion* comp, Workbench* wb, int vk) returns boolean {
                if (vk == 9 || vk == 13) {
                    comp.accept(wb.active());
                    return true;
                }
                // Tab / Enter
                if (vk == 27) {
                    comp.dismiss();
                    return true;
                }
                // Esc
                if (vk == 40) {
                    comp.moveSel(1);
                    return true;
                }
                // Down
                if (vk == 38) {
                    comp.moveSel(0 - 1);
                    return true;
                }
                // Up
                return false;
            }

            // Multi-cursor hotkeys: Ctrl+Alt+Down/Up add a secondary caret below/above; Ctrl+D adds the next
            // occurrence of the selection (or selects the word first); Ctrl+Shift+L selects every occurrence;
            // Esc collapses back to one when there are extras. Returns true if it consumed the key.
            private static method caretHotkey(Workbench* wb, int vk, boolean ctrl, boolean shift, boolean alt)
                    returns boolean {
                if (ctrl && alt && vk == 40) {
                    wb.active().addCaretBelow();
                    return true;
                }
                if (ctrl && alt && vk == 38) {
                    wb.active().addCaretAbove();
                    return true;
                }
                if (ctrl && !alt && !shift && vk == 68) {
                    wb.active().selectNextOccurrence();
                    return true;
                }
                if (ctrl && !alt && shift && vk == 76) {
                    wb.active().selectAllOccurrences();
                    return true;
                }
                if (!ctrl && shift && alt && vk == 39) {
                    wb.active().expandSelection();
                    return true;
                }
                if (!ctrl && shift && alt && vk == 37) {
                    wb.active().shrinkSelection();
                    return true;
                }
                if (!ctrl && !shift && alt && vk == 37) {
                    wb.navGoBack();
                    return true;
                }
                if (!ctrl && !shift && alt && vk == 39) {
                    wb.navGoForward();
                    return true;
                }
                if (vk == 27 && wb.active().hasMultipleCarets()) {
                    wb.active().clearExtraCarets();
                    return true;
                }
                return false;
            }

            // Route an event to the open overlay: type into its query, Esc closes, Enter runs it, arrows
            // move the palette selection.
            private static method overlayEvent(Overlay* ov, Workbench* wb, InputEvent* e, boolean ctrl,
                                               boolean shift, boolean alt) returns void {
                if (e.isKey()) {
                    int vk = e.vk;
                    if (vk == 27) {
                        ov.close();
                        return;
                    }
                    // Esc
                    if (ov.mode == 2) {
                        GuiApp.findKey(ov, wb, vk, ctrl, shift);
                        return;
                    }
                    if (vk == 8) {
                        ov.backspace();
                        return;
                    }
                    // Backspace
                    if (vk == 40) {
                        ov.moveSel(1);
                        return;
                    }
                    // Down
                    if (vk == 38) {
                        ov.moveSel(0 - 1);
                        return;
                    }
                    // Up
                    if (vk == 13) {                                     // Enter
                        if (ov.mode == 1) {
                            GuiApp.runPaletteSelection(ov, wb);
                        }
                        else if (ov.mode == 3) {
                            GuiApp.runSymbolSelection(ov, wb);
                        }
                        else if (ov.mode == 4) {
                            GuiApp.runQuickOpen(ov, wb);
                        }
                        else if (ov.mode == 5) {
                            GuiApp.runGoToLine(ov, wb);
                        }
                        else if (ov.mode == 6) {
                            GuiApp.runGlobalSearch(ov, wb);
                        }
                        else if (ov.mode == 7) {
                            GuiApp.runPrompt(ov, wb);
                        }
                        else {
                            wb.active().find(ov.query);
                        }
                        ov.close();
                    }
                    return;
                }
                if (e.isChar()) {
                    int cp = e.code;
                    if (cp >= 32 && cp != 127 && (!ctrl || alt)) {
                        ov.typeChar(cast<char>(cp));
                    }
                }
                return;
            }

            private static method runPaletteSelection(Overlay* ov, Workbench* wb) returns void {
                ArrayList<Command>* results = wb.registry().filter(ov.query);
                if (ov.sel >= 0 && ov.sel < results.size()) {
                    wb.runCommand(results.get(ov.sel).id);
                }
                return;
            }

            // Keys while the find/replace bar is open: Tab switches field, Backspace edits it, Enter finds the
            // next match (Shift+Enter the previous), Ctrl+Enter replaces every match with the replace text.
            private static method findKey(Overlay* ov, Workbench* wb, int vk, boolean ctrl, boolean shift)
                    returns void {
                if (vk == 8) {
                    ov.backspace();
                    return;
                }
                // Backspace
                if (vk == 9) {
                    ov.toggleField();
                    return;
                }
                // Tab
                if (vk == 13) {                                  // Enter
                    if (ctrl) {
                        wb.active().replaceAll(ov.query, ov.replace);
                        return;
                    }
                    if (shift) {
                        wb.active().findPrevious(ov.query);
                    } else {
                        wb.active().find(ov.query);
                    }
                }
                return;
            }

            // Populate the symbol navigator from the active document's declarations and open it.
            private static method openSymbols(Overlay* ov, Workbench* wb) returns void {
                ArrayList<Symbol>* syms = Symbols.list(wb.active());
                ArrayList<String>* labels = new ArrayList<String>() on heap;
                ArrayList<int>* lines = new ArrayList<int>() on heap;
                mutable int i = 0;
                while (i < syms.size()) {
                    labels.add(syms.get(i).caption);
                    lines.add(syms.get(i).line);
                    i = i + 1;
                }
                ov.openSymbols(labels, lines);
                return;
            }

            // Jump the caret to the selected symbol's line (the viewport follows).
            private static method runSymbolSelection(Overlay* ov, Workbench* wb) returns void {
                ArrayList<int>* m = ov.matches();
                if (ov.sel >= 0 && ov.sel < m.size()) {
                    int orig = m.get(ov.sel);
                    // workspace symbols carry a file to open first; file-local symbols don't
                    if (orig < ov.itemFiles.size()) {
                        wb.openFile(ov.itemFiles.get(orig));
                    }
                    int line = ov.targets.get(orig);
                    wb.active().placeCaret(line - 1, 0);
                }
                return;
            }
            // Go-to-definition (F12): jump to where the identifier under the caret is declared. Tries the
            // current file first (fast, and prefers a local declaration), then scans every project .ldp3 file so
            // the definition can live in another file. Records nothing here -- the per-frame nav tracker captures
            // the jump for Alt+Left. Returns true if it jumped.
            private static method gotoDef(Workbench* wb, FileTree* tree) returns boolean {
                if (wb.active().goToDefinition()) {
                    return true;
                }
                String w = wb.active().wordAtCaret();
                if (w.length() == 0) {
                    return false;
                }
                String activePath = wb.activePath();
                ArrayList<String>* files = tree.allFiles();
                mutable int fi = 0;
                while (fi < files.size()) {
                    String path = files.get(fi);
                    fi = fi + 1;
                    if (path.endsWith(".ldp3") && !path.equals(activePath)) {
                        int line = Symbols.definitionLineIn(Files.readLines(path), w);
                        if (line >= 0) {
                            wb.openFile(path);
                            wb.active().placeCaret(line, 0);
                            return true;
                        }
                    }
                }
                return false;
            }

            // Rebuild the project-wide symbol index feeding autocomplete: every class/method/enum name across
            // the project, deduped. Called on project open and after each save (not per keystroke), so typing
            // offers cross-file names without re-scanning the workspace on every character.
            private static method refreshProjectSymbols(Completion* comp, FileTree* tree) returns void {
                ArrayList<String>* files = tree.allFiles();
                ArrayList<String>* names = new ArrayList<String>() on heap;
                mutable int fi = 0;
                while (fi < files.size() && names.size() < 4000) {
                    String path = files.get(fi);
                    fi = fi + 1;
                    if (path.endsWith(".ldp3")) {
                        ArrayList<Symbol>* syms = new ArrayList<Symbol>() on heap;
                        Symbols.scan(Files.readLines(path), syms);
                        mutable int si = 0;
                        while (si < syms.size()) {
                            String nm = GuiApp.symbolName(syms.get(si).caption);
                            if (nm.length() > 1 && !GuiApp.listHas(names, nm)) {
                                names.add(nm);
                            }
                            si = si + 1;
                        }
                    }
                }
                comp.setProjectSymbols(names);
                return;
            }
            private static method symbolName(String caption) returns String {
                mutable int sp = 0 - 1;
                mutable int i = 0;
                while (i < caption.length()) {
                    if (caption.charAt(i) == ' ') {
                        sp = i;
                    }
                    i = i + 1;
                }
                if (sp < 0) {
                    return caption;
                }
                return caption.substring(sp + 1, caption.length());
            }
            private static method listHas(ArrayList<String>* xs, String w) returns boolean {
                mutable int i = 0;
                while (i < xs.size()) {
                    if (xs.get(i).equals(w)) {
                        return true;
                    }
                    i = i + 1;
                }
                return false;
            }

            // Gather every declaration in every project .ldp3 file into the symbol navigator (Ctrl+T), each
            // labelled with its file, so you can jump to any class/method in the workspace.
            private static method openWorkspaceSymbols(Overlay* ov, Workbench* wb, FileTree* tree) returns void {
                ArrayList<String>* files = tree.allFiles();
                ArrayList<String>* labels = new ArrayList<String>() on heap;
                ArrayList<int>* lines = new ArrayList<int>() on heap;
                ArrayList<String>* symFiles = new ArrayList<String>() on heap;
                mutable int fi = 0;
                while (fi < files.size() && labels.size() < 3000) {
                    String path = files.get(fi);
                    if (path.endsWith(".ldp3")) {
                        ArrayList<Symbol>* syms = new ArrayList<Symbol>() on heap;
                        Symbols.scan(Files.readLines(path), syms);
                        String base = Paths.basename(path);
                        mutable int si = 0;
                        while (si < syms.size()) {
                            labels.add(syms.get(si).caption + "  (" + base + ")");
                            lines.add(syms.get(si).line);
                            symFiles.add(path);
                            si = si + 1;
                        }
                    }
                    fi = fi + 1;
                }
                ov.openWorkspaceSymbols(labels, lines, symFiles);
                return;
            }
            // Open the selected file from the quick-open picker.
            private static method runQuickOpen(Overlay* ov, Workbench* wb) returns void {
                ArrayList<int>* m = ov.matches();
                if (ov.sel >= 0 && ov.sel < m.size()) {
                    wb.openFile(ov.items.get(m.get(ov.sel)));
                }
                return;
            }
            // Jump to the 1-based line number typed into the go-to-line box.
            private static method runGoToLine(Overlay* ov, Workbench* wb) returns void {
                int ln = ov.query.toInt();
                if (ln > 0) {
                    wb.active().placeCaret(ln - 1, 0);
                }
                return;
            }

            // Grep every project text file (captured in ov.items) for ov.query and list the matches, as
            // `file:line: text`, in the output panel. Bounded so a huge project can't stall the search.
            // Run the action a text prompt (mode 7) was opened for, with the typed text.
            private static method runPrompt(Overlay* ov, Workbench* wb) returns void {
                if (ov.promptKind.equals("commit")) {
                    if (ov.query.length() > 0) {
                        wb.gitCommit(ov.query);
                    }
                } else if (ov.promptKind.equals("newfile")) {
                    wb.newFileOnDisk(ov.query);
                } else if (ov.promptKind.equals("rename")) {
                    wb.renameActiveFile(ov.query);
                } else if (ov.promptKind.equals("delete")) {
                    if (ov.query.equals("y") || ov.query.equals("yes")) {
                        wb.deleteActiveFile();
                    }
                } else if (ov.promptKind.equals("extractVar")) {
                    wb.active().extractVariable(ov.query);
                } else if (ov.promptKind.equals("checkout")) {
                    wb.gitCheckout(ov.query);
                } else if (ov.promptKind.equals("replaceAll")) {
                    // One prompt, two answers: "find|replace". A single step keeps the flow honest --
                    // the prompt caption says exactly what the separator is.
                    int bar = ov.query.indexOf("|");
                    if (bar > 0) {
                        String needle = ov.query.substring(0, bar);
                        String repl = ov.query.substring(bar + 1, ov.query.length());
                        ArrayList<String>* files = wb.projectFiles();
                        wb.replaceInFiles(files, needle, repl);
                    }
                } else if (ov.promptKind.equals("renameSymbol")) {
                    int n = wb.renameSymbolAcross(wb.renameTargetName(), ov.query);
                    wb.output().banner("Rename", "Renamed " + n.toString() + " occurrence(s) of '"
                        + wb.renameTargetName() + "' across the workspace.");
                }
                return;
            }

            private static method runGlobalSearch(Overlay* ov, Workbench* wb) returns void {
                String q = ov.query;
                if (q.length() == 0) {
                    return;
                }
                ArrayList<String>* results = new ArrayList<String>() on heap;
                ArrayList<String>* navFiles = new ArrayList<String>() on heap;
                ArrayList<int>* navLines = new ArrayList<int>() on heap;
                mutable int fi = 0;
                mutable int hits = 0;
                while (fi < ov.items.size() && results.size() < 800) {
                    String path = ov.items.get(fi);
                    if (GuiApp.isSearchable(path)) {
                        ArrayList<String> lines = Files.readLines(path);
                        String base = Paths.basename(path);
                        mutable int li = 0;
                        while (li < lines.size()) {
                            if (lines.get(li).indexOf(q) >= 0) {
                                hits = hits + 1;
                                results.add(base + ":" + (li + 1).toString() + ":  " + lines.get(li).trim());
                                navFiles.add(path);
                                navLines.add(li);
                            }
                            li = li + 1;
                        }
                    }
                    fi = fi + 1;
                }
                wb.output().showNavigable(hits.toString() + " matches for '" + q + "'", results,
                                          navFiles, navLines);
                return;
            }
            // Only grep text-ish files (skip binaries/images the tree may include).
            private static method isSearchable(String path) returns boolean {
                return path.endsWith(".ldp3") || path.endsWith(".toml") || path.endsWith(".md")
                    || path.endsWith(".txt") || path.endsWith(".json") || path.endsWith(".ps1")
                    || path.endsWith(".cpp") || path.endsWith(".h");
            }

            // Map a Win32 virtual-key to a Key and dispatch it, carrying the modifier state.
            private static method dispatchKey(Workbench* wb, int vk, boolean ctrl, boolean shift, boolean alt)
                    returns void {
                // A real Ctrl shortcut never has Alt held; Ctrl+Alt is AltGr (a character), so exclude it.
                if (ctrl && !alt && vk >= 65 && vk <= 90) {
                    wb.handleKey(Key.ctrlCh(cast<char>(vk + 32)));
                    return;
                }
                if (ctrl && !alt && vk == 191) {
                    wb.handleKey(Key.ctrlCh('/'));
                    return;
                }
                // Ctrl+/ toggle comment
                if (vk == 0x25) {
                    wb.handleKey(new Key(KeyCode.LEFT, ' ', ctrl, shift, alt) on heap);
                    return;
                }
                if (vk == 0x27) {
                    wb.handleKey(new Key(KeyCode.RIGHT, ' ', ctrl, shift, alt) on heap);
                    return;
                }
                if (vk == 0x26) {
                    wb.handleKey(new Key(KeyCode.UP, ' ', ctrl, shift, alt) on heap);
                    return;
                }
                if (vk == 0x28) {
                    wb.handleKey(new Key(KeyCode.DOWN, ' ', ctrl, shift, alt) on heap);
                    return;
                }
                if (vk == 0x08) {
                    wb.handleKey(new Key(KeyCode.BACKSPACE, ' ', ctrl, shift, alt) on heap);
                    return;
                }
                if (vk == 0x0D) {
                    wb.handleKey(new Key(KeyCode.ENTER, ' ', ctrl, shift, alt) on heap);
                    return;
                }
                if (vk == 0x2E) {
                    wb.handleKey(new Key(KeyCode.DELETE, ' ', ctrl, shift, alt) on heap);
                    return;
                }
                if (vk == 0x09) {
                    wb.handleKey(new Key(KeyCode.TAB, ' ', ctrl, shift, alt) on heap);
                    return;
                }
                if (vk == 0x24) {
                    wb.handleKey(new Key(KeyCode.HOME, ' ', ctrl, shift, alt) on heap);
                    return;
                }
                if (vk == 0x23) {
                    wb.handleKey(new Key(KeyCode.END, ' ', ctrl, shift, alt) on heap);
                    return;
                }
                if (vk == 0x21) {
                    wb.handleKey(new Key(KeyCode.PAGE_UP, ' ', ctrl, shift, alt) on heap);
                    return;
                }
                if (vk == 0x22) {
                    wb.handleKey(new Key(KeyCode.PAGE_DOWN, ' ', ctrl, shift, alt) on heap);
                    return;
                }
                return;
            }

            public static method shot(String path) returns void {
                GlWindow* win = new GlWindow() on heap;
                if (win.open("Forge", 1100, 720, 4, 6) == 0) {
                    System.IO.Console.printf("Forge: could not open a GL 4.6 window\n");
                    return;
                }
                Font* font = GuiApp.loadFont(win, 18);
                Batch2D* batch = new Batch2D(win.gl) on heap;
                GpuScreen* screen = new GpuScreen(font) on heap;
                Workbench* wb = GuiApp.buildWorkbench(screen, win.width(), win.height(),
                                                      "src/gfx/GpuScreen.ldp3");
                FileTree* tree = new FileTree("src") on heap;
                Overlay* ov = new Overlay() on heap;
                Completion* comp = new Completion() on heap;
                comp.loadImports(GuiApp.referencePath("imports.txt"));
                GuiApp.refreshProjectSymbols(comp, tree);
                MenuBar* menu = new MenuBar() on heap;
                win.pump();
                GuiApp.drawFrame(win, batch, screen, wb, tree, ov, comp, menu, new ContextMenu() on heap);
                Wgl.glFinish();
                int w = win.width();
                int h = win.height();
                byte[] px = win.gl.readPixelsRgb(0, 0, w, h);
                GuiApp.writePpm(path, px, w, h);
                win.swap();
                System.IO.Console.printf("Forge: wrote %s (%dx%d)\n", path, w, h);
                return;
            }

            private static method loadFont(GlWindow* win, int px) returns Font* {
                FontAtlas atlas = GdiFont.rasterizeAscii("Consolas", px);
                int tex = win.gl.uploadRGBA(atlas.pixels, atlas.atlasW, atlas.atlasH);
                return new Font(atlas, tex) on heap;
            }

            // Build the editor with a viewport sized to the window's code area, and open a document. Opens
            // one of Forge's own source files (real, long, colourful LDP3), falling back to a small embedded
            // sample if it isn't on disk, then places the caret and a selection to demonstrate scrolling.
            // Build the workbench, opening `fileToOpen` when it names an existing file, otherwise leaving the
            // single untitled document the Workbench starts with. Opening a path that doesn't exist would show
            // a phantom tab, so it's skipped -- Forge runs cleanly from any directory.
            private static method buildWorkbench(GpuScreen* screen, int w, int h, String fileToOpen)
                    returns Workbench* {
                int rows = screen.paneRowsFor(h);
                int cols = screen.paneColsFor(w);
                Workbench* wb = new Workbench(rows, cols) on heap;
                if (fileToOpen.length() > 0 && File.exists(fileToOpen)) {
                    wb.openFile(fileToOpen);
                    wb.active().moveDocStart(false);
                }
                return wb;
            }
            // From a path argument, decide which directory the tree shows and which file (if any) to open:
            // a directory becomes the tree root; a file opens with its parent directory as the root; empty or
            // missing falls back to the current directory with an untitled document.
            private static method treeRootFor(String openPath) returns String {
                if (openPath.length() == 0) {
                    return ".";
                }
                if (File.isDir(openPath)) {
                    return openPath;
                }
                if (File.exists(openPath)) {
                    String d = Paths.dirname(openPath);
                    if (d.length() > 0) {
                        return d;
                    }
                }
                return ".";
            }
            private static method fileToOpenFor(String openPath) returns String {
                if (openPath.length() > 0 && File.exists(openPath) && !File.isDir(openPath)) {
                    return openPath;
                }
                return "";
            }

            // Drive a few edits through handleKey -- the same path the live loop uses -- so the offscreen
            // shot demonstrates that typed input reaches the model and re-renders.
            private static method scriptDemo(Workbench* wb) returns void {
                String s = "// typed live in Forge, then run() takes the keyboard.";
                mutable int i = 0;
                while (i < s.length()) {
                    wb.handleKey(Key.ch(s.charAt(i)));
                    i = i + 1;
                }
                wb.handleKey(new Key(KeyCode.ENTER, ' ', false, false, false) on heap);
                return;
            }

            // One frame: clear to the Forge ground, draw the full IDE (tabs + tree + editor), then any
            // open modal overlay on top.
            private static method drawFrame(GlWindow* win, Batch2D* batch, GpuScreen* screen, Workbench* wb,
                                            FileTree* tree, Overlay* ov, Completion* comp, MenuBar* menu,
                                            ContextMenu* ctx)
                    returns void {
                // Drain any debug-adapter messages that arrived since the last frame (non-blocking): the
                // stopped line, call stack, variables and program output update in step with the UI.
                wb.debugger().pump();
                wb.drainDebugOutput();
                wb.terminal().pump();       // stream the integrated terminal's output
                wb.trackNav();              // record far caret jumps for Alt+Left / Alt+Right
                screen.applyThemeFor(wb);   // re-skin if the theme preference changed
                int w = win.width();
                int h = win.height();
                // Fit the active document's viewport to the window so it fills the whole editor pane. A
                // freshly opened tab starts at the default row count; without this it would render only those
                // rows and leave the bottom of the pane blank. Only re-fit on a real change, so it never
                // fights manual scrolling.
                int fitRows = screen.paneRowsFor(h);
                if (fitRows > 0 && wb.active().visibleRows() != fitRows) {
                    wb.active().resizeViewport(fitRows, screen.paneColsFor(w));
                }
                Wgl.glViewport(0, 0, w, h);
                Wgl.glClearColor(screen.colors().bg.r, screen.colors().bg.g, screen.colors().bg.b, 1.0);
                Wgl.glClear(16384);   // GL_COLOR_BUFFER_BIT

                int mx = win.cursorX();
                int my = win.cursorY();
                batch.begin(w, h, screen.fontTexture());
                screen.drawWorkbench(batch, wb, tree, ov, mx, my, w, h);
                if (comp.active) {
                    screen.drawCompletion(batch, comp, wb, w, h);
                } else if (!ov.isOpen()) {
                    screen.drawSignatureHelp(batch, wb, w);
                }
                screen.drawMenuBar(batch, menu, wb, mx, my, w);
                screen.drawMenuDropdown(batch, menu, mx, my);
                screen.drawContextMenu(batch, ctx, mx, my, w, h);
                if (ov.isOpen()) {
                    screen.drawOverlay(batch, ov, wb, w, h);
                }
                batch.flush();
                return;
            }

            // One frame of the welcome / start screen (shown until a project is opened).
            private static method drawWelcomeFrame(GlWindow* win, Batch2D* batch, GpuScreen* screen,
                                                   ArrayList<String>* recent) returns void {
                int w = win.width();
                int h = win.height();
                Wgl.glViewport(0, 0, w, h);
                Wgl.glClearColor(screen.colors().bg.r, screen.colors().bg.g, screen.colors().bg.b, 1.0);
                Wgl.glClear(16384);
                batch.begin(w, h, screen.fontTexture());
                screen.drawWelcome(batch, recent, win.cursorX(), win.cursorY(), w, h);
                batch.flush();
                return;
            }

            private static method sample() returns String {
                return "program Demo;\n\npublic bundle app {\n    public namespace demo {\n        // A tiny sample rendered by Forge itself.\n        public class Counter {\n            private mutable int value;\n\n            public constructor Counter(int start) {\n                this.value = start;\n            }\n\n            public method increment() returns void {\n                this.value = this.value + 1;\n            }\n\n            public method get() returns int {\n                return this.value;\n            }\n        }\n    }\n}";
            }

            // Write an RGB byte buffer as an ASCII P3 PPM, flipped in Y (GL's origin is bottom-left).
            private static method writePpm(String path, byte[] px, int w, int h) returns void {
                StringBuilder sb = new StringBuilder() on heap;
                sb.append("P3\n");
                sb.appendInt(w);
                sb.append(" ");
                sb.appendInt(h);
                sb.append("\n255\n");
                mutable int y = h - 1;
                while (y >= 0) {
                    mutable int x = 0;
                    while (x < w) {
                        int i = (y * w + x) * 3;
                        sb.appendInt(cast<int>(px[i]) & 255);
                        sb.append(" ");
                        sb.appendInt(cast<int>(px[i + 1]) & 255);
                        sb.append(" ");
                        sb.appendInt(cast<int>(px[i + 2]) & 255);
                        sb.append(" ");
                        x = x + 1;
                    }
                    sb.append("\n");
                    y = y - 1;
                }
                File.writeAll(path, sb.toString());
                return;
            }
        }
    }
}
