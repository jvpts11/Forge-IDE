import System.Memory.Allocator;
import System.Memory.Raw;

import forge.ffi.Shell;
import forge.ffi.Ole;
import forge.ffi.Comdlg;

program Forge;

public bundle forge {
    public namespace gfx {

        // The FFI shims Shell (shell32), Ole (ole32) and Comdlg (comdlg32) live in their own files in
        // this namespace -- Shell.pol, Ole.pol, Comdlg.pol.

        // A native "choose a folder" dialog, so the user opens a project with the OS picker they know. Returns
        // the chosen directory, or "" if cancelled. Marshals a BROWSEINFOA (64 bytes on x64) by hand.
        public class NativeDialog {
            public static method pickFolder(long hwnd, String title) returns String {
                Ole.CoInitialize(0);
                address bi = Allocator.alloc(64);
                mutable int k = 0;
                while (k < 64) {
                    Raw.write<byte>(bi + cast<address>(k), cast<byte>(0));
                    k = k + 1;
                }
                address nameBuf = Allocator.alloc(260);
                address titleBuf = Allocator.alloc(cast<long>(title.length() + 1));
                Raw.writeString(titleBuf, title);
                Raw.write<long>(bi + cast<address>(0), hwnd);                    // hwndOwner
                Raw.write<long>(bi + cast<address>(16), cast<long>(nameBuf));    // pszDisplayName
                Raw.write<long>(bi + cast<address>(24), cast<long>(titleBuf));   // lpszTitle
                // BIF_RETURNONLYFSDIRS | BIF_EDITBOX | BIF_NEWDIALOGSTYLE
                Raw.write<int>(bi + cast<address>(32), 0x51);
                long pidl = Shell.SHBrowseForFolderA(cast<long>(bi));
                mutable String result = "";
                if (pidl != 0) {
                    address pathBuf = Allocator.alloc(260);
                    int ok = Shell.SHGetPathFromIDListA(pidl, pathBuf);
                    if (ok != 0) {
                        mutable int slen = 0;
                        while (slen < 260 && Raw.read<byte>(pathBuf + cast<address>(slen)) != cast<byte>(0)) {
                            slen = slen + 1;
                        }
                        result = Raw.readString(pathBuf, slen);
                    }
                    Allocator.free(pathBuf);
                    Ole.CoTaskMemFree(pidl);
                }
                Allocator.free(bi);
                Allocator.free(nameBuf);
                Allocator.free(titleBuf);
                return result;
            }

            // A native "Save As" dialog (comdlg32 GetSaveFileNameA). `suggested` pre-fills the file name box.
            // Returns the chosen full path, or "" if the user cancelled. Marshals an OPENFILENAMEA (152 bytes
            // on x64) and a double-null-terminated filter list by hand.
            public static method saveFile(long hwnd, String suggested) returns String {
                int ofnSize = 152;
                address ofn = Allocator.alloc(cast<long>(ofnSize));
                mutable int k = 0;
                while (k < ofnSize) {
                    Raw.write<byte>(ofn + cast<address>(k), cast<byte>(0));
                    k = k + 1;
                }
                // lpstrFile is both input (the suggested name) and output (the chosen path).
                address fileBuf = Allocator.alloc(520);
                mutable int f = 0;
                while (f < 520) {
                    Raw.write<byte>(fileBuf + cast<address>(f), cast<byte>(0));
                    f = f + 1;
                }
                if (suggested.length() > 0) {
                    Raw.writeString(fileBuf, suggested);
                }
                // filter pairs "label\0pattern\0...\0\0"
                address filter = Allocator.alloc(64);
                mutable int fp = 0;
                fp = NativeDialog.putz(filter, fp, "Polaron (*.pol)");
                fp = NativeDialog.putz(filter, fp, "*.pol");
                fp = NativeDialog.putz(filter, fp, "All Files (*.*)");
                fp = NativeDialog.putz(filter, fp, "*.*");
                Raw.write<byte>(filter + cast<address>(fp), cast<byte>(0));   // extra terminating null
                address defext = Allocator.alloc(8);
                Raw.writeString(defext, "pol");

                Raw.write<int>(ofn + cast<address>(0), ofnSize);              // lStructSize
                Raw.write<long>(ofn + cast<address>(8), hwnd);               // hwndOwner
                Raw.write<long>(ofn + cast<address>(24), cast<long>(filter)); // lpstrFilter
                Raw.write<int>(ofn + cast<address>(44), 1);                  // nFilterIndex
                Raw.write<long>(ofn + cast<address>(48), cast<long>(fileBuf)); // lpstrFile
                Raw.write<int>(ofn + cast<address>(56), 520);               // nMaxFile
                // OFN_OVERWRITEPROMPT | OFN_HIDEREADONLY | OFN_NOCHANGEDIR
                Raw.write<int>(ofn + cast<address>(96), 0x0E);              // Flags
                Raw.write<long>(ofn + cast<address>(104), cast<long>(defext)); // lpstrDefExt

                int ok = Comdlg.GetSaveFileNameA(cast<long>(ofn));
                mutable String result = "";
                if (ok != 0) {
                    mutable int slen = 0;
                    while (slen < 520 && Raw.read<byte>(fileBuf + cast<address>(slen)) != cast<byte>(0)) {
                        slen = slen + 1;
                    }
                    result = Raw.readString(fileBuf, slen);
                }
                Allocator.free(ofn);
                Allocator.free(fileBuf);
                Allocator.free(filter);
                Allocator.free(defext);
                return result;
            }

            // Write `s` then a trailing null byte into `buf` at offset `off`; return the offset past the null.
            private static method putz(address buf, int off, String s) returns int {
                mutable int i = 0;
                while (i < s.length()) {
                    Raw.write<byte>(buf + cast<address>(off + i), cast<byte>(cast<int>(s.charAt(i))));
                    i = i + 1;
                }
                Raw.write<byte>(buf + cast<address>(off + s.length()), cast<byte>(0));
                return off + s.length() + 1;
            }
        }
    }
}
