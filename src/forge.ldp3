import System.IO.Console;
import System.Collections.ArrayList;
import System.Collections.HashSet;
import System.Text.Strings;
import System.Text.StringBuilder;
import editor.TextBuffer;
import editor.Editor;
import syntax.Tok;
import syntax.Span;
import syntax.Highlighter;
import harness.Asserts;

program Forge;

// Forge -- the LDP3 IDE. Editor core (headless, pure LDP3): a line-based text model plus a cursor-driven
// Editor over it. The graphics/UI layer wires onto this later (docs/DESIGN.md). Runs a self-check suite.
public bundle forge {
    public namespace editor {

        // The text of one open document, addressed by (row, col), 0-based; col is the number of characters
        // to the left of the caret, 0..line.length().
        public class TextBuffer {
            private mutable ArrayList<String> lines;

            public constructor TextBuffer() {
                this.lines = new ArrayList<String>() on heap;
                this.lines.add("");                      // an empty document is one empty line, never zero
            }

            public method lineCount() returns int { return this.lines.size(); }
            public method line(int row) returns String { return this.lines.get(row); }

            public method loadText(String text) returns void {
                this.lines = Strings.split(text, "\n");
                if (this.lines.size() == 0) { this.lines.add(""); }
            }

            public method text() returns String { return Strings.join(this.lines, "\n"); }

            public method insertChar(int row, int col, char c) returns void {
                String cur = this.lines.get(row);
                StringBuilder sb = new StringBuilder() on heap;
                sb.append(cur.substring(0, col));
                sb.appendChar(c);
                sb.append(cur.substring(col, cur.length()));
                this.lines.set(row, sb.toString());
            }

            public method splitLine(int row, int col) returns void {
                String cur = this.lines.get(row);
                this.lines.set(row, cur.substring(0, col));
                this.lines.insertAt(row + 1, cur.substring(col, cur.length()));
            }

            // Backspace at (row, col): within a line it deletes the char to the left; at a line start it
            // joins this line onto the previous one. Returns the caret's new column.
            public method backspace(int row, int col) returns int {
                if (col > 0) {
                    String cur = this.lines.get(row);
                    StringBuilder sb = new StringBuilder() on heap;
                    sb.append(cur.substring(0, col - 1));
                    sb.append(cur.substring(col, cur.length()));
                    this.lines.set(row, sb.toString());
                    return col - 1;
                }
                if (row > 0) {
                    String prev = this.lines.get(row - 1);
                    int joinCol = prev.length();
                    this.lines.set(row - 1, prev + this.lines.get(row));
                    this.lines.removeAt(row);
                    return joinCol;
                }
                return 0;                                // top-left backspace is a no-op
            }
        }

        // A caret over a TextBuffer: turns key events (type/enter/backspace) and arrow moves into buffer
        // edits, keeping (row, col) valid. This is the model an input layer will drive.
        public class Editor {
            private mutable TextBuffer* buf;
            private mutable int row;
            private mutable int col;

            public constructor Editor(TextBuffer* doc) {
                this.buf = doc;
                this.row = 0;
                this.col = 0;
            }

            public method cursorRow() returns int { return this.row; }
            public method cursorCol() returns int { return this.col; }
            public method document() returns TextBuffer* { return this.buf; }

            public method type(char c) returns void {
                this.buf.insertChar(this.row, this.col, c);
                this.col = this.col + 1;
            }

            public method enter() returns void {
                this.buf.splitLine(this.row, this.col);
                this.row = this.row + 1;
                this.col = 0;
            }

            public method backspace() returns void {
                if (this.col == 0 && this.row == 0) { return; }
                boolean joining = this.col == 0;
                int newCol = this.buf.backspace(this.row, this.col);
                if (joining) { this.row = this.row - 1; }
                this.col = newCol;
            }

            public method moveLeft() returns void {
                if (this.col > 0) { this.col = this.col - 1; }
                else if (this.row > 0) {
                    this.row = this.row - 1;
                    this.col = this.buf.line(this.row).length();
                }
            }

            public method moveRight() returns void {
                if (this.col < this.buf.line(this.row).length()) { this.col = this.col + 1; }
                else if (this.row < this.buf.lineCount() - 1) {
                    this.row = this.row + 1;
                    this.col = 0;
                }
            }

            public method moveUp() returns void {
                if (this.row > 0) {
                    this.row = this.row - 1;
                    this.clampCol();
                }
            }

            public method moveDown() returns void {
                if (this.row < this.buf.lineCount() - 1) {
                    this.row = this.row + 1;
                    this.clampCol();
                }
            }

            private method clampCol() returns void {
                int len = this.buf.line(this.row).length();
                if (this.col > len) { this.col = len; }
            }
        }
    }

    public namespace harness {
        // A tiny assert harness: counts pass/fail, prints each failure, and a one-line summary that reads
        // "<suite>: OK" only when everything passed -- so a build can gate on that string.
        public class Asserts {
            private mutable int passed;
            private mutable int failed;
            public constructor Asserts() { this.passed = 0; this.failed = 0; }

            public method eqStr(String actual, String expected, String name) returns void {
                if (actual.equals(expected)) { this.passed = this.passed + 1; }
                else {
                    this.failed = this.failed + 1;
                    System.IO.Console.printf("FAIL %s: [%s] != [%s]\n", name, actual, expected);
                }
            }
            public method eqInt(int actual, int expected, String name) returns void {
                if (actual == expected) { this.passed = this.passed + 1; }
                else {
                    this.failed = this.failed + 1;
                    System.IO.Console.printf("FAIL %s: %d != %d\n", name, actual, expected);
                }
            }
            public method summary(String suite) returns void {
                if (this.failed == 0) {
                    System.IO.Console.printf("%s: OK (%d checks)\n", suite, this.passed);
                } else {
                    System.IO.Console.printf("%s: %d FAILED of %d\n", suite, this.failed,
                                             this.passed + this.failed);
                }
            }
        }
    }

    public namespace syntax {
        // Token classes a line is broken into for colouring.
        public enum Tok { WS, IDENT, KEYWORD, NUMBER, STRING, CHAR, COMMENT, PUNCT }

        // A coloured run over [start, end) of a line.
        public class Span {
            public mutable int start;
            public mutable int end;
            public mutable Tok kind;
            public constructor Span(int start, int end, Tok kind) {
                this.start = start;
                this.end = end;
                this.kind = kind;
            }
        }

        // A tiny LDP3 tokenizer for syntax highlighting: it tiles a line into Spans (whitespace, comments,
        // string/char literals, numbers, keywords vs identifiers, punctuation). Line-local -- no multi-line
        // (block comment / string) state yet; that comes with the incremental highlighter.
        public class Highlighter {
            private mutable HashSet<String> keywords;

            public constructor Highlighter() {
                this.keywords = new HashSet<String>() on heap;
                String[] kw = new String[74]();
                kw[0]="program"; kw[1]="bundle"; kw[2]="namespace"; kw[3]="class"; kw[4]="interface";
                kw[5]="enum"; kw[6]="struct"; kw[7]="record"; kw[8]="union"; kw[9]="catalog";
                kw[10]="method"; kw[11]="constructor"; kw[12]="destructor"; kw[13]="public"; kw[14]="private";
                kw[15]="protected"; kw[16]="internal"; kw[17]="static"; kw[18]="abstract"; kw[19]="final";
                kw[20]="override"; kw[21]="sealed"; kw[22]="permits"; kw[23]="mutable"; kw[24]="var";
                kw[25]="return"; kw[26]="returns"; kw[27]="if"; kw[28]="else"; kw[29]="while";
                kw[30]="do"; kw[31]="for"; kw[32]="foreach"; kw[33]="switch"; kw[34]="case";
                kw[35]="default"; kw[36]="break"; kw[37]="continue"; kw[38]="match"; kw[39]="try";
                kw[40]="catch"; kw[41]="finally"; kw[42]="throw"; kw[43]="throws"; kw[44]="new";
                kw[45]="delete"; kw[46]="on"; kw[47]="stack"; kw[48]="heap"; kw[49]="in";
                kw[50]="region"; kw[51]="unique"; kw[52]="movable"; kw[53]="move"; kw[54]="cascade";
                kw[55]="defer"; kw[56]="using"; kw[57]="import"; kw[58]="extends"; kw[59]="implements";
                kw[60]="this"; kw[61]="super"; kw[62]="true"; kw[63]="false"; kw[64]="null";
                kw[65]="boolean"; kw[66]="char"; kw[67]="int"; kw[68]="long"; kw[69]="void";
                kw[70]="async"; kw[71]="await"; kw[72]="lambda"; kw[73]="step";
                for (mutable int i = 0; i < 74; i++) { this.keywords.add(kw[i]); }
                delete kw;
            }

            public method isKeyword(String word) returns boolean { return this.keywords.contains(word); }

            private method isDigit(char c) returns boolean { return c >= '0' && c <= '9'; }
            private method isAlpha(char c) returns boolean {
                return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_';
            }
            private method isAlnum(char c) returns boolean { return this.isAlpha(c) || this.isDigit(c); }

            // Break `line` into a complete, gap-free sequence of Spans.
            public method tokenize(String line) returns ArrayList<Span> {
                ArrayList<Span> spans = new ArrayList<Span>() on heap;
                int n = line.length();
                mutable int i = 0;
                while (i < n) {
                    char c = line.charAt(i);
                    int start = i;
                    if (c == ' ' || c == '\t') {
                        while (i < n && (line.charAt(i) == ' ' || line.charAt(i) == '\t')) { i = i + 1; }
                        spans.add(new Span(start, i, Tok.WS) on heap);
                    } else if (c == '/' && i + 1 < n && line.charAt(i + 1) == '/') {
                        spans.add(new Span(start, n, Tok.COMMENT) on heap);
                        i = n;                                   // line comment runs to the end
                    } else if (c == '"') {
                        i = i + 1;
                        while (i < n && line.charAt(i) != '"') {
                            if (line.charAt(i) == '\\' && i + 1 < n) { i = i + 1; }
                            i = i + 1;
                        }
                        if (i < n) { i = i + 1; }                // closing quote
                        spans.add(new Span(start, i, Tok.STRING) on heap);
                    } else if (c == '\'') {
                        i = i + 1;
                        while (i < n && line.charAt(i) != '\'') {
                            if (line.charAt(i) == '\\' && i + 1 < n) { i = i + 1; }
                            i = i + 1;
                        }
                        if (i < n) { i = i + 1; }
                        spans.add(new Span(start, i, Tok.CHAR) on heap);
                    } else if (this.isDigit(c)) {
                        while (i < n && (this.isAlnum(line.charAt(i)) || line.charAt(i) == '.')) {
                            i = i + 1;                           // digits + '.' + a literal suffix
                        }
                        spans.add(new Span(start, i, Tok.NUMBER) on heap);
                    } else if (this.isAlpha(c)) {
                        while (i < n && this.isAlnum(line.charAt(i))) { i = i + 1; }
                        String word = line.substring(start, i);
                        if (this.keywords.contains(word)) { spans.add(new Span(start, i, Tok.KEYWORD) on heap); }
                        else { spans.add(new Span(start, i, Tok.IDENT) on heap); }
                    } else {
                        i = i + 1;
                        spans.add(new Span(start, i, Tok.PUNCT) on heap);
                    }
                }
                return spans;
            }
        }
    }

    public namespace app {
        public class Main {
            public static method main(string[] args) returns void {
                Asserts a = new Asserts() on heap;

                // --- TextBuffer edits ---
                TextBuffer buf = new TextBuffer() on heap;
                buf.loadText("ab\ncd");
                buf.insertChar(0, 1, 'X');               // "aXb"
                buf.splitLine(0, 2);                       // "aX" / "b"
                buf.backspace(2, 0);                       // join "cd" onto "b" -> "bcd"
                a.eqInt(buf.lineCount(), 2, "buf.lineCount");
                a.eqStr(buf.line(0), "aX", "buf.line0");
                a.eqStr(buf.line(1), "bcd", "buf.line1");

                // --- Editor: type, Enter, backspace within a line, backspace-join ---
                Editor ed = new Editor(new TextBuffer() on heap) on heap;
                ed.type('h'); ed.type('i'); ed.enter(); ed.type('y'); ed.type('o');   // "hi" / "yo"
                a.eqInt(ed.document().lineCount(), 2, "ed.lineCount");
                a.eqStr(ed.document().line(0), "hi", "ed.line0");
                a.eqStr(ed.document().line(1), "yo", "ed.line1");
                a.eqInt(ed.cursorRow(), 1, "ed.row");
                a.eqInt(ed.cursorCol(), 2, "ed.col");

                ed.backspace(); ed.backspace();           // remove "yo" -> "hi" / ""
                a.eqStr(ed.document().line(1), "", "ed.after-bs-line1");
                a.eqInt(ed.cursorCol(), 0, "ed.col-after-bs");

                ed.backspace();                            // line-start backspace joins -> "hi"
                a.eqInt(ed.document().lineCount(), 1, "ed.after-join-count");
                a.eqStr(ed.document().line(0), "hi", "ed.after-join");
                a.eqInt(ed.cursorRow(), 0, "ed.row-after-join");
                a.eqInt(ed.cursorCol(), 2, "ed.col-after-join");

                // --- cursor movement with clamping / line wrap ---
                ed.moveLeft();  a.eqInt(ed.cursorCol(), 1, "moveLeft");
                ed.moveRight(); ed.moveRight();  a.eqInt(ed.cursorCol(), 2, "moveRight-clamp");

                // --- syntax highlighting ---
                Highlighter hl = new Highlighter() on heap;
                ArrayList<Span> sp = hl.tokenize("public int x = 42; // hi");
                a.eqInt(sp.size(), 12, "hl.spanCount");
                a.eqInt(cast<int>(sp.get(0).kind), cast<int>(Tok.KEYWORD), "hl.public-kw");
                a.eqInt(cast<int>(sp.get(2).kind), cast<int>(Tok.KEYWORD), "hl.int-kw");
                a.eqInt(cast<int>(sp.get(4).kind), cast<int>(Tok.IDENT), "hl.x-ident");
                a.eqInt(cast<int>(sp.get(8).kind), cast<int>(Tok.NUMBER), "hl.42-number");
                a.eqInt(cast<int>(sp.get(11).kind), cast<int>(Tok.COMMENT), "hl.comment");
                ArrayList<Span> sp2 = hl.tokenize("s = \"hi\";");
                a.eqInt(cast<int>(sp2.get(4).kind), cast<int>(Tok.STRING), "hl.string");

                a.summary("editor tests");
                return;
            }
        }
    }
}
