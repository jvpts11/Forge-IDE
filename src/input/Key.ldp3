program Forge;

public bundle forge {
    public namespace input {

        // The kind of a key press. CHAR means a printable character (in Key.ch); the rest are the editing
        // and navigation keys an IDE cares about. The physical terminal/GUI layer decodes escape sequences
        // or OS events into these; the KeyMap turns them into Controller commands.
        public enum KeyCode {
            CHAR, ENTER, BACKSPACE, DELETE, TAB,
            LEFT, RIGHT, UP, DOWN,
            HOME, END, PAGE_UP, PAGE_DOWN
        }

        // One decoded key event: a code, the character (valid when code == CHAR), and the modifier state.
        // Static factories cover the common shapes so call sites read cleanly.
        public class Key {
            public mutable KeyCode code;
            public mutable char ch;
            public mutable boolean ctrl;
            public mutable boolean shift;
            public mutable boolean alt;

            public constructor Key(KeyCode code, char ch, boolean ctrl, boolean shift, boolean alt) {
                this.code = code;
                this.ch = ch;
                this.ctrl = ctrl;
                this.shift = shift;
                this.alt = alt;
            }

            // A plain printable character.
            public static method ch(char c) returns Key* {
                return new Key(KeyCode.CHAR, c, false, false, false) on heap;
            }
            // Ctrl + a letter (a shortcut like Ctrl+C).
            public static method ctrlCh(char c) returns Key* {
                return new Key(KeyCode.CHAR, c, true, false, false) on heap;
            }
            // Alt + a letter.
            public static method altCh(char c) returns Key* {
                return new Key(KeyCode.CHAR, c, false, false, true) on heap;
            }
            // A named key with no modifiers.
            public static method key(KeyCode code) returns Key* {
                return new Key(code, ' ', false, false, false) on heap;
            }
            // A named key with Shift held (extends the selection).
            public static method shiftKey(KeyCode code) returns Key* {
                return new Key(code, ' ', false, true, false) on heap;
            }
            // A named key with Ctrl held (word/document-scoped motion).
            public static method ctrlKey(KeyCode code) returns Key* {
                return new Key(code, ' ', true, false, false) on heap;
            }
            // A named key with Ctrl+Shift (scoped motion that also extends the selection).
            public static method ctrlShiftKey(KeyCode code) returns Key* {
                return new Key(code, ' ', true, true, false) on heap;
            }
            // A named key with Alt held (line moves).
            public static method altKey(KeyCode code) returns Key* {
                return new Key(code, ' ', false, false, true) on heap;
            }
        }
    }
}
