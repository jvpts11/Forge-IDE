import System.Collections.ArrayList;
import System.Json.Json;
import System.OS.Env;
import System.IO.File;
import System.IO.Paths;

program Forge;

public bundle forge {
    public namespace app {

        // Breakpoints for one source file: its path and the 1-based lines. (A plain class rather than a
        // HashMap<String, ArrayList<int>*> entry -- a pointer to a generic instantiation as a map value type
        // currently mis-monomorphizes; see LDP3 task #184.)
        public class BreakpointFile {
            public mutable String path;
            public mutable ArrayList<int>* lines;
            public mutable ArrayList<String>* conditions;   // parallel to lines; "" = unconditional
            public constructor BreakpointFile(String path) {
                this.path = path;
                this.lines = new ArrayList<int>() on heap;
                this.conditions = new ArrayList<String>() on heap;
            }
        }

        // A single debug frame's display info, as parsed from a DAP stackTrace response.
        public class DebugFrame {
            public mutable int id;
            public mutable String name;
            public mutable String path;
            public mutable int line;
            public constructor DebugFrame(int id, String name, String path, int line) {
                this.id = id;
                this.name = name;
                this.path = path;
                this.line = line;
            }
        }

        // A local variable's display info (name, value, type), as parsed from a DAP variables response.
        public class DebugVar {
            public mutable String name;
            public mutable String value;
            public mutable String kind;
            public constructor DebugVar(String name, String value, String kind) {
                this.name = name;
                this.value = value;
                this.kind = kind;
            }
        }

        // Drives a debug session: owns the DapClient, runs the DAP handshake as a small state machine, and
        // turns incoming events/responses into the state the UI renders (stopped line, call stack, variables,
        // program output). The UI calls pump() every frame; the model never blocks. Line numbers are 1-based
        // (DAP + DWARF convention); the editor converts to its own 0-based rows when highlighting.
        public class Debugger {
            private mutable DapClient client;
            private mutable ArrayList<BreakpointFile*>* breakpoints;
            private mutable String programPath;

            private mutable boolean active;      // a session is running
            private mutable boolean stopped;     // currently paused at a location
            private mutable int currentThread;
            private mutable String stoppedFile;
            private mutable int stoppedLine;
            private mutable ArrayList<DebugFrame*>* callStack;
            private mutable ArrayList<DebugVar*>* variables;
            private mutable ArrayList<String>* output;
            private mutable String status;
            private mutable ArrayList<String>* watches;       // watch expressions
            private mutable ArrayList<String>* watchValues;   // their last-evaluated values (parallel)
            private mutable ArrayList<int>* pendingEval;      // FIFO of eval targets: a watch index, or -1 (console)
            private mutable int currentFrameId;               // top frame, the context for evaluate
            private mutable String lastEval;                  // the debug console's last result

            public constructor Debugger() {
                this.client = new DapClient() on heap;
                this.breakpoints = new ArrayList<BreakpointFile*>() on heap;
                this.programPath = "";
                this.active = false;
                this.stopped = false;
                this.currentThread = 1;
                this.stoppedFile = "";
                this.stoppedLine = 0;
                this.callStack = new ArrayList<DebugFrame*>() on heap;
                this.variables = new ArrayList<DebugVar*>() on heap;
                this.output = new ArrayList<String>() on heap;
                this.status = "idle";
                this.watches = new ArrayList<String>() on heap;
                this.watchValues = new ArrayList<String>() on heap;
                this.pendingEval = new ArrayList<int>() on heap;
                this.currentFrameId = 0;
                this.lastEval = "";
            }

            // ---- Breakpoints (persist across sessions; re-sent on the next launch) ----

            // The breakpoint entry for `file`, or null if none exists yet.
            private method entryFor(String file) returns nullable BreakpointFile {
                for (mutable int i = 0; i < this.breakpoints.size(); i++) {
                    BreakpointFile* bf = this.breakpoints.get(i);
                    if (bf.path.equals(file)) {
                        return bf;
                    }
                }
                return null;
            }

            public method toggleBreakpoint(String file, int line) returns boolean {
                mutable nullable BreakpointFile entry = this.entryFor(file);
                if (entry == null) {
                    BreakpointFile fresh = new BreakpointFile(file) on heap;
                    this.breakpoints.add(fresh);
                    entry = fresh;
                }
                ArrayList<int>* lines = entry.lines;
                mutable int found = -1;
                for (mutable int i = 0; i < lines.size(); i++) {
                    if (lines.get(i) == line) {
                        found = i;
                    }
                }
                mutable boolean nowSet = false;
                if (found >= 0) {
                    lines.removeAt(found);
                    entry.conditions.removeAt(found);
                } else {
                    lines.add(line);
                    entry.conditions.add("");
                    nowSet = true;
                }
                if (this.active) {
                    this.client.setBreakpoints(file, lines, entry.conditions);
                }
                return nowSet;
            }

            // Set (or clear, with "") the condition on the breakpoint at (file, line). Returns false if there
            // is no breakpoint there yet. Re-sends the file's breakpoints so a live session picks it up.
            public method setBreakpointCondition(String file, int line, String cond) returns boolean {
                nullable BreakpointFile entry = this.entryFor(file);
                if (entry == null) {
                    return false;
                }
                ArrayList<int>* lines = entry.lines;
                for (mutable int i = 0; i < lines.size(); i++) {
                    if (lines.get(i) == line) {
                        entry.conditions.set(i, cond);
                        if (this.active) {
                            this.client.setBreakpoints(file, lines, entry.conditions);
                        }
                        return true;
                    }
                }
                return false;
            }

            public method breakpointsFor(String file) returns ArrayList<int>* {
                nullable BreakpointFile entry = this.entryFor(file);
                if (entry != null) {
                    return entry.lines;
                }
                return new ArrayList<int>() on heap;
            }

            public method hasBreakpoint(String file, int line) returns boolean {
                nullable BreakpointFile entry = this.entryFor(file);
                if (entry == null) {
                    return false;
                }
                ArrayList<int>* lines = entry.lines;
                for (mutable int i = 0; i < lines.size(); i++) {
                    if (lines.get(i) == line) {
                        return true;
                    }
                }
                return false;
            }

            // ---- Session lifecycle ----

            // Locate the lldb-dap adapter: bundled beside the running IDE (the .msi ships it), else a system
            // LLVM install, else hope it is on PATH.
            public static method findLldbDap() returns String {
                String selfDir = Paths.dirname(Env.executablePath());
                String bundled = Paths.join(selfDir, "lldb-dap.exe");
                if (File.exists(bundled)) {
                    return bundled;
                }
                String sys = "C:\\Program Files\\LLVM\\bin\\lldb-dap.exe";
                if (File.exists(sys)) {
                    return sys;
                }
                return "lldb-dap";
            }

            // Start debugging a native .exe (built with -g) via the given lldb-dap command.
            public method start(String dapCommand, String exePath) returns boolean {
                if (!this.client.start(dapCommand)) {
                    this.status = "failed to start adapter";
                    return false;
                }
                this.programPath = exePath;
                this.active = true;
                this.stopped = false;
                this.status = "launching";
                this.client.initialize();
                return true;
            }

            public method isActive() returns boolean {
                return this.active;
            }
            public method isStopped() returns boolean {
                return this.stopped;
            }
            public method stoppedFilePath() returns String {
                return this.stoppedFile;
            }
            public method stoppedAtLine() returns int {
                return this.stoppedLine;
            }
            // True if execution is paused on (file, line). Tolerant of relative-vs-absolute paths by also
            // matching on basename, since the adapter reports the DWARF path which may differ from the
            // editor's stored path.
            public method isStoppedAt(String file, int line) returns boolean {
                if (!this.stopped || this.stoppedLine != line) {
                    return false;
                }
                if (this.stoppedFile.equals(file)) {
                    return true;
                }
                return Debugger.baseName(this.stoppedFile).equals(Debugger.baseName(file));
            }
            private static method baseName(String p) returns String {
                mutable int cut = -1;
                for (mutable int i = 0; i < p.length(); i++) {
                    char ch = p.charAt(i);
                    if (ch == '/' || ch == '\\') {
                        cut = i;
                    }
                }
                if (cut < 0) {
                    return p;
                }
                return p.substring(cut + 1, p.length());
            }
            public method currentThreadId() returns int {
                return this.currentThread;
            }
            public method statusText() returns String {
                return this.status;
            }
            public method callStackView() returns ArrayList<DebugFrame*>* {
                return this.callStack;
            }
            public method variablesView() returns ArrayList<DebugVar*>* {
                return this.variables;
            }
            public method outputView() returns ArrayList<String>* {
                return this.output;
            }

            // Execution controls (no-ops unless stopped, to keep the UI honest).
            public method continueRun() returns void {
                if (this.active) {
                    this.stopped = false;
                    this.status = "running";
                    this.client.resume(this.currentThread);
                }
            }
            public method stepOver() returns void {
                if (this.active) {
                    this.client.stepOver(this.currentThread);
                }
            }
            public method stepInto() returns void {
                if (this.active) {
                    this.client.stepIn(this.currentThread);
                }
            }
            public method stepOut() returns void {
                if (this.active) {
                    this.client.stepOut(this.currentThread);
                }
            }
            public method stop() returns void {
                if (this.active) {
                    this.client.disconnect();
                }
                this.active = false;
                this.stopped = false;
                this.status = "stopped";
                this.callStack = new ArrayList<DebugFrame*>() on heap;
                this.variables = new ArrayList<DebugVar*>() on heap;
            }

            // ---- Message pump ----

            // Drain and dispatch every DAP message ready this frame. Call once per render tick.
            public method pump() returns void {
                if (!this.active) {
                    return;
                }
                ArrayList<Json*>* msgs = this.client.poll();
                for (mutable int i = 0; i < msgs.size(); i++) {
                    this.dispatch(msgs.get(i));
                }
            }

            private method dispatch(Json* msg) returns void {
                String type = msg.field("type").asStr();
                if (type.equals("event")) {
                    this.onEvent(msg);
                } else {
                    if (type.equals("response")) {
                        this.onResponse(msg);
                    }
                }
            }

            private method onEvent(Json* msg) returns void {
                String event = msg.field("event").asStr();
                if (event.equals("initialized")) {
                    // The adapter is ready for configuration (DAP: this event follows the launch request):
                    // send all breakpoints, then signal configuration is done.
                    this.sendAllBreakpoints();
                    this.client.configurationDone();
                } else {
                    if (event.equals("stopped")) {
                        this.stopped = true;
                        this.status = "paused";
                        nullable Json body = msg.field("body");
                        this.currentThread = cast<int>(body.field("threadId").asNum());
                        this.client.stackTrace(this.currentThread);
                    } else {
                        if (event.equals("output")) {
                            nullable Json body = msg.field("body");
                            this.output.add(body.field("output").asStr());
                        } else {
                            if (event.equals("terminated") || event.equals("exited")) {
                                this.active = false;
                                this.stopped = false;
                                this.status = "program exited";
                            }
                        }
                    }
                }
            }

            private method onResponse(Json* msg) returns void {
                String command = msg.field("command").asStr();
                nullable Json body = msg.field("body");
                if (command.equals("initialize")) {
                    // The adapter accepted our capabilities: now request the launch. The adapter replies with
                    // an `initialized` event, at which point we send breakpoints + configurationDone. Run to
                    // the first breakpoint (stopOnEntry=false) rather than halting in the loader at entry.
                    this.client.launch(this.programPath, false);
                } else if (command.equals("stackTrace")) {
                    this.parseStackTrace(body);
                } else {
                    if (command.equals("scopes")) {
                        this.parseScopes(body);
                    } else {
                        if (command.equals("variables")) {
                            this.parseVariables(body);
                        } else {
                            if (command.equals("evaluate")) {
                                this.parseEvaluate(body);
                            }
                        }
                    }
                }
            }

            private method sendAllBreakpoints() returns void {
                for (mutable int i = 0; i < this.breakpoints.size(); i++) {
                    BreakpointFile* bf = this.breakpoints.get(i);
                    this.client.setBreakpoints(bf.path, bf.lines, bf.conditions);
                }
            }

            // ---- Watch expressions + the debug console (DAP evaluate) ----

            // Add a watch expression; evaluate it now if we are paused so its value shows immediately.
            public method addWatch(String expr) returns void {
                if (expr.length() == 0) {
                    return;
                }
                this.watches.add(expr);
                this.watchValues.add("...");
                if (this.stopped) {
                    this.pendingEval.add(this.watches.size() - 1);
                    this.client.evaluate(expr, this.currentFrameId, "watch");
                }
                return;
            }
            public method clearWatches() returns void {
                this.watches = new ArrayList<String>() on heap;
                this.watchValues = new ArrayList<String>() on heap;
                return;
            }
            public method watchesView() returns ArrayList<String>* {
                return this.watches;
            }
            public method watchValuesView() returns ArrayList<String>* {
                return this.watchValues;
            }
            public method lastEvalResult() returns String {
                return this.lastEval;
            }
            // Evaluate `expr` in the debug console (repl context); the result lands in lastEvalResult().
            public method evalConsole(String expr) returns void {
                if (expr.length() == 0 || !this.stopped) {
                    return;
                }
                this.pendingEval.add(0 - 1);
                this.client.evaluate(expr, this.currentFrameId, "repl");
                return;
            }
            // Re-evaluate every watch (called when execution stops at a new location).
            private method refreshWatches() returns void {
                for (mutable int i = 0; i < this.watches.size(); i++) {
                    this.pendingEval.add(i);
                    this.client.evaluate(this.watches.get(i), this.currentFrameId, "watch");
                }
                return;
            }

            private method parseStackTrace(nullable Json body) returns void {
                this.callStack = new ArrayList<DebugFrame*>() on heap;
                nullable Json frames = body.field("stackFrames");
                for (mutable int i = 0; i < frames.size(); i++) {
                    nullable Json fr = frames.at(i);
                    int id = cast<int>(fr.field("id").asNum());
                    String name = fr.field("name").asStr();
                    int line = cast<int>(fr.field("line").asNum());
                    mutable String path = "";
                    nullable Json src = fr.field("source");
                    if (src.kindOf() == 5) {
                        path = src.field("path").asStr();
                    }
                    this.callStack.add(new DebugFrame(id, name, path, line) on heap);
                }
                if (this.callStack.size() > 0) {
                    DebugFrame* top = this.callStack.get(0);
                    this.stoppedFile = top.path;
                    this.stoppedLine = top.line;
                    this.currentFrameId = top.id;
                    this.pendingEval = new ArrayList<int>() on heap;  // drop stale eval correlations
                    this.client.scopes(top.id);   // fetch locals for the top frame
                    this.refreshWatches();
                }
            }
            private method parseEvaluate(nullable Json body) returns void {
                String result = body.field("result").asStr();
                if (this.pendingEval.size() == 0) {
                    this.lastEval = result;
                    return;
                }
                int idx = this.pendingEval.get(0);
                this.pendingEval.removeAt(0);
                if (idx >= 0 && idx < this.watchValues.size()) {
                    this.watchValues.set(idx, result);
                } else {
                    this.lastEval = result;
                }
                return;
            }

            private method parseScopes(nullable Json body) returns void {
                nullable Json scopes = body.field("scopes");
                mutable int ref = -1;
                for (mutable int i = 0; i < scopes.size(); i++) {
                    nullable Json sc = scopes.at(i);
                    String nm = sc.field("name").asStr();
                    int r = cast<int>(sc.field("variablesReference").asNum());
                    if (nm.equals("Locals") && ref < 0) {
                        ref = r;
                    }
                    if (ref < 0 && r > 0) {
                        ref = r;   // fall back to the first non-empty scope
                    }
                }
                if (ref > 0) {
                    this.client.variables(ref);
                }
            }

            private method parseVariables(nullable Json body) returns void {
                this.variables = new ArrayList<DebugVar*>() on heap;
                nullable Json vars = body.field("variables");
                for (mutable int i = 0; i < vars.size(); i++) {
                    nullable Json v = vars.at(i);
                    String name = v.field("name").asStr();
                    String value = v.field("value").asStr();
                    String kind = v.field("type").asStr();
                    this.variables.add(new DebugVar(name, value, kind) on heap);
                }
            }
        }
    }
}
