import System.Collections.ArrayList;
import System.IO.Paths;
import forge.app.Controller;
import forge.io.Document;

program Forge;

public bundle forge {
    public namespace app {

        // The open documents, one active. Each open document is a full Controller (its own buffer, caret,
        // undo history, and viewport), so switching tabs is just changing the active index -- the per-tab
        // state is preserved. The UI's tab bar reads count()/title()/activeIndex(); the editor area drives
        // active(). openFile de-duplicates: a path already open is re-activated rather than opened twice.
        public class DocumentManager {
            private mutable ArrayList<Controller*>* tabs;
            private mutable int active;
            private mutable int prevActive;   // most-recently-used previous tab, for Ctrl+Tab
            private mutable int rows;
            private mutable int cols;
            // The paths of tabs the user closed, newest last -- so Ctrl+Shift+T reopens the last one, then
            // the one before it, the way every editor does. Untitled buffers (no path) are not remembered.
            private mutable ArrayList<String>* closed;

            public constructor DocumentManager(int rows, int cols) {
                this.tabs = new ArrayList<Controller*>() on heap;
                this.active = 0 - 1;
                this.prevActive = 0 - 1;
                this.rows = rows;
                this.cols = cols;
                this.closed = new ArrayList<String>() on heap;
            }

            // The panes are this manager's: it makes them and it frees them. Held by POINTER, because
            // a Controller owns an editor, folds and a viewport and frees them in its destructor -- a
            // list of them by value would hand a copy the same things to free.
            public destructor ~DocumentManager() returns void {
                for (var t in this.tabs.toArray()) {
                    delete t;
                }
                delete this.tabs;
                delete this.closed;
                return;
            }

            public method count() returns int {
                return this.tabs.size();
            }
            public method activeIndex() returns int {
                return this.active;
            }
            public method hasActive() returns boolean {
                return this.active >= 0;
            }
            public method active() returns Controller* {
                return this.tabs.get(this.active);
            }
            public method at(int i) returns Controller* {
                return this.tabs.get(i);
            }
            public method setActive(int i) returns void {
                if (i >= 0 && i < this.tabs.size()) {
                    if (i != this.active) {
                        this.prevActive = this.active;
                    }
                    this.active = i;
                }
            }
            // Ctrl+Tab: jump back to the most-recently-used other tab (and remember the current as the next
            // "previous", so a second Ctrl+Tab returns) -- Alt+Tab-style toggling between two tabs.
            public method switchToPrevious() returns void {
                if (this.prevActive >= 0 && this.prevActive < this.tabs.size()
                    && this.prevActive != this.active) {
                    int t = this.active;
                    this.active = this.prevActive;
                    this.prevActive = t;
                }
            }

            // Open a fresh empty document and make it active.
            public method openNew() returns Controller* {
                this.prevActive = this.active;
                this.tabs.add(new Controller(this.rows, this.cols) on heap);
                this.active = this.tabs.size() - 1;
                return this.tabs.get(this.active);
            }

            // Open `path`: if it is already open, re-activate that tab; otherwise load it into a new tab.
            public method openFile(String path) returns Controller* {
                for (mutable int i = 0; i < this.tabs.size(); i++) {
                    if (this.tabs.get(i).document().path().equals(path)) {
                        if (i != this.active) {
                            this.prevActive = this.active;
                        }
                        this.active = i;
                        return this.tabs.get(i);
                    }
                }
                this.prevActive = this.active;
                this.tabs.add(new Controller(this.rows, this.cols) on heap);
                this.active = this.tabs.size() - 1;
                Controller* c = this.tabs.get(this.active);
                c.openFile(path);
                return c;
            }
            // Open a VIEW of a document another pane already has open: same buffer, same undo history, its
            // own caret and scroll. Focuses the existing tab if this pane already shows that document.
            public method openView(Document* shared) returns Controller* {
                for (mutable int i = 0; i < this.tabs.size(); i++) {
                    if (this.tabs.get(i).document() == shared) {
                        this.prevActive = this.active;
                        this.active = i;
                        return this.tabs.get(i);
                    }
                }
                this.prevActive = this.active;
                this.tabs.add(new Controller(this.rows, this.cols) on heap);
                this.active = this.tabs.size() - 1;
                Controller* c = this.tabs.get(this.active);
                c.attachDocument(shared);
                return c;
            }
            // The document this pane shows in tab `i` (null-safe: an empty pane has none).
            public method documentAt(int i) returns Document* {
                return this.tabs.get(i).document();
            }

            // Close tab `i`, keeping the active index pointing at a sensible neighbour.
            public method close(int i) returns void {
                if (i < 0 || i >= this.tabs.size()) {
                    return;
                }
                Controller* going = this.tabs.get(i);
                String path = going.document().path();
                if (path.length() > 0) {
                    this.closed.add(path);   // remember it so Ctrl+Shift+T can bring it back
                }
                this.tabs.removeAt(i);
                delete going;   // the pane is this list's, and closing it is where it goes
                if (this.tabs.size() == 0) {
                    this.active = 0 - 1;
                    return;
                }
                if (this.active >= this.tabs.size()) {
                    this.active = this.tabs.size() - 1;
                }
                else if (this.active > i) {
                    this.active = this.active - 1;
                }
            }

            // The path of the most-recently-closed tab, removed from the history, or "" when there is none.
            // openFile de-duplicates, so reopening a file that is somehow already open just focuses it.
            public method popClosed() returns String {
                mutable int n = this.closed.size();
                // Skip any path that is already open again (closed, then reopened another way).
                while (n > 0) {
                    n = n - 1;
                    String path = this.closed.get(n);
                    this.closed.removeAt(n);
                    if (!this.hasOpen(path)) {
                        return path;
                    }
                }
                return "";
            }
            public method hasClosed() returns boolean {
                return this.closed.size() > 0;
            }
            private method hasOpen(String path) returns boolean {
                mutable int i = 0;
                while (i < this.tabs.size()) {
                    if (this.tabs.get(i).document().path().equals(path)) {
                        return true;
                    }
                    i = i + 1;
                }
                return false;
            }

            // Tab label: the file's basename (or "untitled"), with " *" when it has unsaved edits.
            public method title(int i) returns String {
                String p = this.tabs.get(i).document().path();
                mutable String name = "untitled";
                if (p.length() > 0) {
                    name = Paths.basename(p);
                }
                if (this.tabs.get(i).document().isModified()) {
                    return name + " *";
                }
                return name;
            }
            public method titles() returns ArrayList<String> {
                ArrayList<String> out = new ArrayList<String>() on heap;
                for (mutable int i = 0; i < this.tabs.size(); i++) {
                    out.add(this.title(i));
                }
                return out;
            }
            // The file paths of the open tabs (skipping untitled buffers) -- used to save/restore the session.
            public method openPaths() returns ArrayList<String>* {
                ArrayList<String>* out = new ArrayList<String>() on heap;
                mutable int i = 0;
                while (i < this.tabs.size()) {
                    String p = this.tabs.get(i).document().path();
                    if (p.length() > 0) {
                        out.add(p);
                    }
                    i = i + 1;
                }
                return out;
            }
        }
    }
}
