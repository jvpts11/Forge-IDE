import System.Collections.ArrayList;
import System.Text.StringBuilder;

program Forge;

public bundle forge {
    public namespace app {

        // One row of the terminal screen: a character per column plus a parallel attribute per column.
        // The attribute packs the SGR state the character was written with:
        //   bits 0-7   foreground colour index (0-15 ANSI, 16-255 xterm cube)
        //   bits 8-15  background colour index
        //   bit  16    bold/bright
        //   bit  17    inverse (swap fg/bg at draw time)
        // Storing colour per cell (rather than per line) is what lets `git status` or a compiler's
        // diagnostics keep their colours mid-line.
        public class TermLine {
            private mutable char[] chars;
            private mutable int[] attrs;
            private mutable int cols;
            private mutable ArrayList<String>* runText;   // same-attribute spans, rebuilt on demand
            private mutable ArrayList<int>* runAttr;
            private mutable boolean runsStale;            // set by every write; cleared by buildRuns

            public constructor TermLine(int width) {
                this.cols = width;
                this.chars = new char[width]();
                this.attrs = new int[width]();
                this.runText = new ArrayList<String>() on heap;
                this.runAttr = new ArrayList<int>() on heap;
                this.runsStale = true;
                this.clearWith(TermLine.defaultAttr());
            }
            public destructor ~TermLine() returns void {
                delete this.chars;
                delete this.attrs;
                delete this.runText;
                delete this.runAttr;
            }

            // fg=7 (light grey) on bg=0 (default background), no flags.
            public static method defaultAttr() returns int {
                return 7;
            }
            public static method attrFg(int a) returns int {
                return a & 255;
            }
            public static method attrBg(int a) returns int {
                return (a >> 8) & 255;
            }
            public static method attrBold(int a) returns boolean {
                return (a & 65536) != 0;
            }
            public static method attrInverse(int a) returns boolean {
                return (a & 131072) != 0;
            }

            public method width() returns int {
                return this.cols;
            }
            public method charAtCol(int c) returns char {
                if (c < 0 || c >= this.cols) {
                    return ' ';
                }
                return this.chars[c];
            }
            public method attrAtCol(int c) returns int {
                if (c < 0 || c >= this.cols) {
                    return TermLine.defaultAttr();
                }
                return this.attrs[c];
            }
            public method setCell(int c, char ch, int a) returns void {
                if (c < 0 || c >= this.cols) {
                    return;
                }
                this.chars[c] = ch;
                this.attrs[c] = a;
                this.runsStale = true;
            }
            public method clearWith(int a) returns void {
                mutable int i = 0;
                while (i < this.cols) {
                    this.chars[i] = ' ';
                    this.attrs[i] = a;
                    i = i + 1;
                }
                this.runsStale = true;
            }
            // Erase from `from` to the end of the row (CSI K with no parameter).
            public method clearFrom(int from, int a) returns void {
                mutable int i = from;
                if (i < 0) {
                    i = 0;
                }
                while (i < this.cols) {
                    this.chars[i] = ' ';
                    this.attrs[i] = a;
                    i = i + 1;
                }
                this.runsStale = true;
            }
            // Erase from the start of the row through `through` (CSI 1K).
            public method clearTo(int through, int a) returns void {
                mutable int i = 0;
                while (i <= through && i < this.cols) {
                    this.chars[i] = ' ';
                    this.attrs[i] = a;
                    i = i + 1;
                }
                this.runsStale = true;
            }

            // The last column holding a non-blank, so the renderer can skip trailing padding.
            public method lastUsedCol() returns int {
                mutable int last = -1;
                mutable int i = 0;
                while (i < this.cols) {
                    if (this.chars[i] != ' ' || this.attrs[i] != TermLine.defaultAttr()) {
                        last = i;
                    }
                    i = i + 1;
                }
                return last;
            }

            // Collapse the row into spans that share one attribute, so a frame draws a handful of
            // coloured runs per line instead of one quad per character.
            // Rebuilds only when the row actually changed since the last call. Scrollback rows never
            // change again, so a terminal sitting idle re-allocates nothing per frame -- which matters
            // because an IDE holds this open for hours.
            public method buildRuns() returns void {
                if (!this.runsStale) {
                    return;
                }
                this.runsStale = false;
                this.runText.clear();
                this.runAttr.clear();
                int last = this.lastUsedCol();
                if (last < 0) {
                    return;
                }
                mutable StringBuilder sb = new StringBuilder() on heap;
                mutable int cur = this.attrs[0];
                mutable int i = 0;
                while (i <= last) {
                    if (this.attrs[i] != cur) {
                        this.runText.add(sb.toString());
                        this.runAttr.add(cur);
                        delete sb;
                        sb = new StringBuilder() on heap;
                        cur = this.attrs[i];
                    }
                    sb.appendChar(this.chars[i]);
                    i = i + 1;
                }
                this.runText.add(sb.toString());
                this.runAttr.add(cur);
                delete sb;
            }
            public method runCount() returns int {
                return this.runText.size();
            }
            public method runTextAt(int i) returns String {
                return this.runText.get(i);
            }
            public method runAttrAt(int i) returns int {
                return this.runAttr.get(i);
            }
            // The whole row as plain text (used by the self-tests and by plain-text copy).
            public method plainText() returns String {
                int last = this.lastUsedCol();
                if (last < 0) {
                    return "";
                }
                StringBuilder sb = new StringBuilder() on heap;
                mutable int i = 0;
                while (i <= last) {
                    sb.appendChar(this.chars[i]);
                    i = i + 1;
                }
                String out = sb.toString();
                delete sb;
                return out;
            }
        }
    }
}
