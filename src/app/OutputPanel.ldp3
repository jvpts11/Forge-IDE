import System.Collections.ArrayList;
import System.Text.Strings;
import System.OS.Process;
import System.OS.ProcessResult;

program Forge;

public bundle forge {
    public namespace app {

        // The build/run output panel: runs a shell command (e.g. `ldp3 build`, `ldp3 run`) on the project,
        // captures its stdout, and holds the lines for the UI to draw in a bottom panel. This is the IDE's
        // build-and-run integration -- one of the things that makes Forge an IDE rather than an editor.
        public class OutputPanel {
            public mutable ArrayList<String>* lines;
            public mutable boolean visible;
            public mutable String title;
            // Optional jump targets parallel to `lines`: for a navigable result list (search / references),
            // clicking row i opens navFile[i] at navLine[i]. Empty strings mean "not navigable".
            public mutable ArrayList<String>* navFile;
            public mutable ArrayList<int>* navLine;

            public constructor OutputPanel() {
                this.lines = new ArrayList<String>() on heap;
                this.visible = false;
                this.title = "Output";
                this.navFile = new ArrayList<String>() on heap;
                this.navLine = new ArrayList<int>() on heap;
            }

            public method toggle() returns void {
                this.visible = !this.visible;
            }
            public method hide() returns void {
                this.visible = false;
            }
            // Show a static one-line message in the panel (no process run) -- used by menu items like About.
            public method banner(String caption, String text) returns void {
                this.title = caption;
                ArrayList<String>* out = new ArrayList<String>() on heap;
                out.add(text);
                this.lines = out;
                this.navFile = new ArrayList<String>() on heap;
                this.navLine = new ArrayList<int>() on heap;
                this.visible = true;
            }
            // Append one line to the panel (keeping it visible), e.g. streaming a debugged program's output.
            public method appendLine(String line) returns void {
                this.lines.add(line);
                this.navFile.add("");
                this.navLine.add(0);
                this.visible = true;
            }
            // Show a prepared list of lines (e.g. find-references results). Not navigable.
            public method showLines(String caption, ArrayList<String>* body) returns void {
                this.title = caption;
                this.lines = body;
                this.navFile = new ArrayList<String>() on heap;
                this.navLine = new ArrayList<int>() on heap;
                this.visible = true;
            }
            // Show a navigable result list: line i, when clicked, opens files.get(i) at lineNums.get(i).
            public method showNavigable(String caption, ArrayList<String>* body, ArrayList<String>* files,
                                        ArrayList<int>* lineNums) returns void {
                this.title = caption;
                this.lines = body;
                this.navFile = files;
                this.navLine = lineNums;
                this.visible = true;
            }
            // The jump target for row i, or "" / -1 when that row isn't navigable.
            public method navFileAt(int i) returns String {
                if (i >= 0 && i < this.navFile.size()) {
                    return this.navFile.get(i);
                }
                return "";
            }
            public method navLineAt(int i) returns int {
                if (i >= 0 && i < this.navLine.size()) {
                    return this.navLine.get(i);
                }
                return 0 - 1;
            }
            public method lineCount() returns int {
                return this.lines.size();
            }
            public method line(int i) returns String {
                return this.lines.get(i);
            }

            // Run `cmd` through the shell, capture its output, and show the panel titled `label`.
            public method run(String caption, String cmd) returns void {
                this.title = caption;
                ArrayList<String>* out = new ArrayList<String>() on heap;
                out.add("$ " + cmd);
                ProcessResult r = Process.run(cmd);
                ArrayList<String> body = Strings.split(r.output, "\n");
                mutable int i = 0;
                while (i < body.size()) {
                    String ln = body.get(i);
                    if (ln.length() > 0 || i < body.size() - 1) {
                        out.add(ln);
                    }
                    i = i + 1;
                }
                out.add("[exit " + r.exitCode.toString() + "]");
                this.lines = out;
                this.navFile = new ArrayList<String>() on heap;
                this.navLine = new ArrayList<int>() on heap;
                this.visible = true;
            }
        }
    }
}
