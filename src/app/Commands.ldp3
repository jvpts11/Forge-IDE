import System.Collections.ArrayList;

program Forge;

public bundle forge {
    public namespace app {

        // One command the palette can run: a stable id (the app dispatches on it) and a human title.
        public class Command {
            public mutable String id;
            public mutable String title;
            public constructor Command(String id, String title) {
                this.id = id;
                this.title = title;
            }
        }

        // The command registry and fuzzy command palette. Commands are registered once (the constructor
        // seeds the standard editor set); filter(query) returns the commands whose title fuzzy-matches the
        // query -- each query character must appear in order -- ranked best first. Selecting a result yields
        // its id, which the app maps to a Controller action, so the palette stays decoupled from behaviour.
        public class CommandRegistry {
            private mutable ArrayList<Command>* commands;

            public constructor CommandRegistry() {
                this.commands = new ArrayList<Command>() on heap;
                this.register("file.new", "New File");
                this.register("file.open", "Open File");
                this.register("file.save", "Save File");
                this.register("file.saveAs", "Save File As");
                this.register("edit.undo", "Undo");
                this.register("edit.redo", "Redo");
                this.register("edit.find", "Find");
                this.register("edit.replace", "Replace");
                this.register("edit.replaceInFiles", "Replace in Files");
                this.register("view.problems", "Problems");
                this.register("view.outline", "Toggle Structure Panel");
                this.register("git.branch", "Git: Branches");
                this.register("view.todos", "Tasks (TODO / FIXME)");
                this.register("edit.selectAll", "Select All");
                this.register("edit.duplicateLine", "Duplicate Line");
                this.register("edit.joinLines", "Join Lines");
                this.register("edit.sortLines", "Sort Lines Ascending");
                this.register("refactor.extractVariable", "Refactor: Extract Variable");
                this.register("edit.upperCase", "Transform to Uppercase");
                this.register("edit.lowerCase", "Transform to Lowercase");
                this.register("edit.matchBracket", "Go to Matching Bracket");
                this.register("edit.addNextOccurrence", "Add Next Occurrence to Selection");
                this.register("edit.selectAllOccurrences", "Select All Occurrences");
                this.register("edit.expandSelection", "Expand Selection");
                this.register("edit.shrinkSelection", "Shrink Selection");
                this.register("nav.back", "Go Back");
                this.register("nav.forward", "Go Forward");
                this.register("snippet.class", "Snippet: Class");
                this.register("snippet.method", "Snippet: Method");
                this.register("snippet.forLoop", "Snippet: For Loop");
                this.register("snippet.main", "Snippet: Main Method");
                this.register("run.build", "Build Project");
                this.register("run.program", "Run Project");
                this.register("run.test", "Run Tests");
                this.register("git.status", "Git: Source Control");
                this.register("git.commit", "Git: Commit All");
                this.register("git.push", "Git: Push");
                this.register("git.diff", "Git: Diff (current)");
                this.register("view.output", "Toggle Output Panel");
                this.register("view.minimap", "Toggle Minimap");
                this.register("view.split", "Split Editor");
                this.register("view.theme", "Toggle Light/Dark Theme");
                this.register("view.terminal", "Toggle Terminal");
                this.register("edit.format", "Format Document");
                this.register("debug.start", "Debug: Start / Continue");
                this.register("debug.stepOver", "Debug: Step Over");
                this.register("debug.stepInto", "Debug: Step Into");
                this.register("debug.stepOut", "Debug: Step Out");
                this.register("debug.stop", "Debug: Stop");
            }

            public method register(String id, String title) returns void {
                this.commands.add(new Command(id, title) on heap);
            }
            public method all() returns ArrayList<Command>* {
                return this.commands;
            }

            // Subsequence fuzzy score: every query char must appear in `title` in order (case-insensitive).
            // Consecutive matches and matches at word starts score higher. -1 means no match.
            public method fuzzyScore(String query, String title) returns int {
                String q = query.toLower();
                String t = title.toLower();
                if (q.length() == 0) {
                    return 0;
                }
                mutable int ti = 0;
                mutable int qi = 0;
                mutable int score = 0;
                mutable int streak = 0;
                while (ti < t.length() && qi < q.length()) {
                    if (t.charAt(ti) == q.charAt(qi)) {
                        streak = streak + 1;
                        score = score + streak;
                        if (ti == 0 || t.charAt(ti - 1) == ' ') {
                            score = score + 3;
                        }
                        qi = qi + 1;
                    } else {
                        streak = 0;
                    }
                    ti = ti + 1;
                }
                if (qi < q.length()) {
                    return 0 - 1;
                }
                return score;
            }

            // Commands whose title matches `query`, best score first (insertion sort -- the list is small).
            public method filter(String query) returns ArrayList<Command>* {
                ArrayList<Command>* out = new ArrayList<Command>() on heap;
                for (mutable int i = 0; i < this.commands.size(); i++) {
                    Command* cmd = this.commands.get(i);
                    if (this.fuzzyScore(query, cmd.title) >= 0) {
                        out.add(cmd);
                    }
                }
                for (mutable int i = 1; i < out.size(); i++) {
                    Command* key = out.get(i);
                    int keyScore = this.fuzzyScore(query, key.title);
                    mutable int j = i - 1;
                    while (j >= 0 && this.fuzzyScore(query, out.get(j).title) < keyScore) {
                        out.set(j + 1, out.get(j));
                        j = j - 1;
                    }
                    out.set(j + 1, key);
                }
                return out;
            }
        }
    }
}
