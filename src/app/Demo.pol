import System.Collections.ArrayList;
import System.IO.Console;
import forge.app.Workbench;
import forge.io.FileTree;
import forge.view.ScreenRenderer;

program Forge;

public bundle forge {
    public namespace app {

        // A headless demo of the whole application: build a Workbench, type a sample program into its
        // document, load Forge's own src/ as the project tree, and print one fully-composed IDE frame (tab
        // bar + file tree + editor with gutter + status bar). This is exactly the screen the GUI shell will
        // draw; running Forge.exe shows the entire engine -- documents, editor, viewport, highlighter, tree,
        // renderer -- composing end to end.
        public class Demo {
            public static method run() returns void {
                Workbench wb = new Workbench(12, 46) on heap;
                wb.active().insertText("program Hello;\n\npublic bundle main {\n    public class Main {\n        public static method main(string[] args) returns void {\n            mutable int x = 42;\n            x = x + 1;\n        }\n    }\n}");
                wb.active().moveDocStart(false);

                FileTree* tree = new FileTree("src") on heap;
                ScreenRenderer sr = new ScreenRenderer() on heap;
                ArrayList<String> screen = sr.render(wb, tree);
                for (mutable int i = 0; i < screen.size(); i++) {
                    System.IO.Console.println(screen.get(i));
                }
                System.IO.Console.println("");
            }
        }
    }
}
