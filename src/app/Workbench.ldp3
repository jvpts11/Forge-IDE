import editor.Editor;
import app.Controller;
import app.DocumentManager;
import app.CommandRegistry;
import app.OutputPanel;
import app.Diagnostic;
import app.GitStatus;
import input.Key;
import input.KeyMap;
import System.Collections.ArrayList;
import System.Text.Strings;
import System.Text.StringBuilder;
import System.IO.Paths;
import System.IO.File;
import System.IO.Files;
import System.OS.Process;
import System.OS.ProcessResult;

program Forge;

public bundle forge {
    public namespace app {

        // The application root: the open documents, the command registry, and the key map, tied together.
        // The GUI (or terminal) shell instantiates one Workbench, feeds it key events (handleKey) and
        // palette selections (runCommand), and renders the active document's Controller. Nothing here is
        // graphical, so the whole application logic is unit-testable. The project file tree is a separate
        // panel the shell owns; it is not part of the core Workbench state.
        public class Workbench {
            private mutable DocumentManager* docs;
            private mutable CommandRegistry* commands;
            private mutable KeyMap* keymap;
            private mutable OutputPanel* out;
            private mutable ArrayList<Diagnostic>* diags;
            private mutable String projectDir;      // where build/run commands execute (the project root)
            private mutable String projectName;     // from ldp3.toml, shown in the status bar
            private mutable GitStatus* git;         // change marks for the active file's gutter
            private mutable Debugger* dbg;          // debug session (breakpoints, stopped line, stack, vars)
            private mutable String renameOldName;   // the identifier a pending rename prompt is renaming
            private mutable int dbgOutConsumed;      // how many debug-output lines are already in the panel
            private mutable boolean lightTheme;      // UI theme preference (true = light); the shell applies it
            private mutable Terminal* term;          // integrated terminal (a cmd.exe behind a Subprocess)
            private mutable boolean treeDirty;      // set by file ops; the shell rebuilds the file tree
            private mutable boolean showMinimap;    // view preference: the code minimap on the right

            public constructor Workbench(int rows, int cols) {
                this.docs = new DocumentManager(rows, cols) on heap;
                this.commands = new CommandRegistry() on heap;
                this.keymap = new KeyMap() on heap;
                this.out = new OutputPanel() on heap;
                this.diags = new ArrayList<Diagnostic>() on heap;
                this.projectDir = ".";
                this.projectName = "";
                this.git = new GitStatus() on heap;
                this.dbg = new Debugger() on heap;
                this.renameOldName = "";
                this.dbgOutConsumed = 0;
                this.lightTheme = WorkspaceStore.loadTheme();
                this.term = new Terminal() on heap;
                this.treeDirty = false;
                this.showMinimap = false;
                this.docs.openNew();               // start on one empty document
            }

            // The debug session. The gutter shows its breakpoints and stopped line; the shell pumps it each
            // frame so incoming adapter events update the UI without blocking.
            public method debugger() returns Debugger* {
                return this.dbg;
            }
            // UI theme preference. The shell reads wantsLight() each frame and re-skins GpuScreen on a change.
            public method wantsLight() returns boolean {
                return this.lightTheme;
            }
            public method toggleTheme() returns void {
                this.lightTheme = !this.lightTheme;
                WorkspaceStore.saveTheme(this.lightTheme);
            }

            // The integrated terminal. The shell toggles/focuses it, pumps its output each frame, and routes
            // keystrokes to it while it is focused.
            public method terminal() returns Terminal* {
                return this.term;
            }
            public method toggleTerminal() returns void {
                this.term.setCwd(this.projectDir);
                this.term.toggle();
            }
            // Move any new output the debugged program produced into the Debug Console panel. Called each
            // frame right after pump(), so the program's stdout streams in live.
            public method drainDebugOutput() returns void {
                ArrayList<String>* out = this.dbg.outputView();
                while (this.dbgOutConsumed < out.size()) {
                    this.out.appendLine(out.get(this.dbgOutConsumed));
                    this.dbgOutConsumed = this.dbgOutConsumed + 1;
                }
            }
            // The active document's on-disk path (matched against breakpoints and the debugger's stopped file).
            public method activePath() returns String {
                return this.docs.active().document().path();
            }

            // Recompute the active file's git change marks (called on open, save and tab switch).
            public method refreshGit() returns void {
                this.git.refresh(this.projectDir, this.docs.active().document().path());
            }
            public method gitStatus() returns GitStatus* {
                return this.git;
            }

            // Point build/run and the project label at a workspace directory. Reads its ldp3.toml (if any)
            // for the program name, so the shell knows which project it's driving.
            public method setProjectDir(String dir) returns void {
                this.projectDir = dir;
                this.projectName = Workbench.readProjectName(dir);
            }
            public method projectRoot() returns String {
                return this.projectDir;
            }
            public method projectLabel() returns String {
                return this.projectName;
            }
            public method hasProject() returns boolean {
                return File.exists(Paths.join(this.projectDir, "ldp3.toml"));
            }
            // Pull `name = "..."` out of the [program]/[library] section of an ldp3.toml, or "" if absent.
            private static method readProjectName(String dir) returns String {
                String toml = Paths.join(dir, "ldp3.toml");
                if (!File.exists(toml)) {
                    return "";
                }
                ArrayList<String> ls = Files.readLines(toml);
                mutable int i = 0;
                while (i < ls.size()) {
                    String t = ls.get(i).trim();
                    if (t.startsWith("name") && t.indexOf("=") >= 0) {
                        String v = t.substring(t.indexOf("=") + 1, t.length()).trim();
                        return Workbench.unquote(v);
                    }
                    i = i + 1;
                }
                return "";
            }
            private static method unquote(String s) returns String {
                mutable String v = s;
                if (v.length() >= 2 && v.charAt(0) == '"' && v.charAt(v.length() - 1) == '"') {
                    v = v.substring(1, v.length() - 1);
                }
                return v;
            }

            // --- diagnostics: run the LDP3 compiler and surface its errors/warnings inline ---
            public method diagnostics() returns ArrayList<Diagnostic>* {
                return this.diags;
            }
            public method errorCount() returns int {
                return this.countBySeverity(0);
            }
            public method warningCount() returns int {
                return this.countBySeverity(1);
            }
            private method countBySeverity(int sev) returns int {
                mutable int c = 0;
                mutable int i = 0;
                while (i < this.diags.size()) {
                    if (this.diags.get(i).severity == sev) {
                        c = c + 1;
                    }
                    i = i + 1;
                }
                return c;
            }
            // Build the project and parse the compiler output into inline diagnostics. Merge stderr into
            // stdout (2>&1) because the compiler writes its errors to stderr, which Process.run drops.
            public method diagnose() returns void {
                this.runShell("Build", "ldp3 build 2>&1");
                ArrayList<Diagnostic>* ds = new ArrayList<Diagnostic>() on heap;
                ArrayList<String>* body = new ArrayList<String>() on heap;
                ArrayList<String>* navFiles = new ArrayList<String>() on heap;
                ArrayList<int>* navLines = new ArrayList<int>() on heap;
                mutable int i = 0;
                while (i < this.out.lineCount()) {
                    String raw = this.out.line(i);
                    Diagnostic* d = Workbench.parseLine(raw);
                    if (d.line > 0) {
                        ds.add(d);
                        int m = raw.indexOf(".ldp3:");
                        String rel = raw.substring(0, m + 5);
                        mutable String sev = "error";
                        if (d.severity == 1) {
                            sev = "warning";
                        }
                        body.add(d.file + ":" + d.line.toString() + ":" + d.col.toString() + "  "
                                 + sev + ": " + d.message);
                        navFiles.add(Paths.join(this.projectDir, rel));
                        navLines.add(d.line - 1);
                    }
                    i = i + 1;
                }
                this.diags = ds;
                // When the build reported problems, replace the raw log with a clickable Problems list;
                // clicking a row jumps to that file and line. A clean build keeps the raw success output.
                if (ds.size() > 0) {
                    this.out.showNavigable(ds.size().toString() + " problems", body, navFiles, navLines);
                }
            }
            // Parse `path.ldp3:LINE:COL: severity: message`; returns a sentinel (line < 0) if it doesn't match.
            private static method parseLine(String s) returns Diagnostic* {
                int m = s.indexOf(".ldp3:");
                if (m < 0) {
                    return new Diagnostic("", 0 - 1, 0, 0, "") on heap;
                }
                String path = s.substring(0, m + 5);
                String rest = s.substring(m + 6, s.length());
                int c1 = rest.indexOf(":");
                if (c1 < 0) {
                    return new Diagnostic("", 0 - 1, 0, 0, "") on heap;
                }
                String rest2 = rest.substring(c1 + 1, rest.length());
                int c2 = rest2.indexOf(":");
                if (c2 < 0) {
                    return new Diagnostic("", 0 - 1, 0, 0, "") on heap;
                }
                String rest3 = rest2.substring(c2 + 1, rest2.length()).trim();
                int c3 = rest3.indexOf(":");
                if (c3 < 0) {
                    return new Diagnostic("", 0 - 1, 0, 0, "") on heap;
                }
                mutable int sev = 0;
                if (rest3.substring(0, c3).trim().equals("warning")) {
                    sev = 1;
                }
                return new Diagnostic(Paths.basename(path), rest.substring(0, c1).toInt(),
                                      rest2.substring(0, c2).toInt(), sev,
                                      rest3.substring(c3 + 1, rest3.length()).trim()) on heap;
            }

            public method documents() returns DocumentManager* {
                return this.docs;
            }
            public method registry() returns CommandRegistry* {
                return this.commands;
            }
            public method active() returns Controller* {
                return this.docs.active();
            }
            public method openFile(String path) returns Controller* {
                Controller* c = this.docs.openFile(path);
                this.refreshGit();
                return c;
            }
            // Close tab `i`; never leave the window with no document -- open a fresh one if that was the last.
            public method closeTab(int i) returns void {
                this.docs.close(i);
                if (this.docs.count() == 0) {
                    this.docs.openNew();
                }
            }
            public method closeActiveTab() returns void {
                this.closeTab(this.docs.activeIndex());
            }

            // Find all references to the identifier under the caret in the active file and list them in the
            // output panel (whole-word matches). Returns the number found.
            public method findReferences() returns int {
                Controller* c = this.docs.active();
                String w = c.wordAtCaret();
                if (w.length() == 0) {
                    return 0;
                }
                ArrayList<String>* body = new ArrayList<String>() on heap;
                ArrayList<String>* navFiles = new ArrayList<String>() on heap;
                ArrayList<int>* navLines = new ArrayList<int>() on heap;
                String path = c.document().path();
                mutable int count = 0;
                int total = c.editor().document().lineCount();
                mutable int row = 0;
                while (row < total) {
                    String line = c.editor().document().line(row);
                    int here = Workbench.countWholeWord(line, w);
                    if (here > 0) {
                        body.add("  L" + (row + 1).toString() + ":  " + line.trim());
                        navFiles.add(path);
                        navLines.add(row);
                        count = count + here;
                    }
                    row = row + 1;
                }
                this.out.showNavigable(count.toString() + " references to '" + w + "'", body,
                                       navFiles, navLines);
                return count;
            }
            private static method countWholeWord(String line, String w) returns int {
                int m = w.length();
                int n = line.length();
                mutable int count = 0;
                mutable int i = 0;
                while (i + m <= n) {
                    if (line.substring(i, i + m).equals(w)) {
                        boolean leftOk = i == 0 || !Workbench.isIdentChar(line.charAt(i - 1));
                        boolean rightOk = i + m == n || !Workbench.isIdentChar(line.charAt(i + m));
                        if (leftOk && rightOk) {
                            count = count + 1;
                            i = i + m;
                        } else {
                            i = i + 1;
                        }
                    } else {
                        i = i + 1;
                    }
                }
                return count;
            }
            private static method isIdentChar(char ch) returns boolean {
                return (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z')
                    || (ch >= '0' && ch <= '9') || ch == '_';
            }
            public method output() returns OutputPanel* {
                return this.out;
            }
            // Run a shell command on the project and show its output in the bottom panel.
            // Run a shell command in the project directory (so `ldp3 build`/`ldp3 run` drive the open project,
            // not whatever directory Forge was launched from).
            public method runShell(String caption, String cmd) returns void {
                this.out.run(caption, "cd /d \"" + this.projectDir + "\" && " + cmd);
            }

            // Open the source of call-stack frame `idx` (from the debug panel) and put the caret on its line.
            public method jumpToStackFrame(int idx) returns void {
                ArrayList<DebugFrame*>* stack = this.dbg.callStackView();
                if (idx < 0 || idx >= stack.size()) {
                    return;
                }
                DebugFrame* fr = stack.get(idx);
                if (fr.path.length() > 0 && File.exists(fr.path)) {
                    Controller* c = this.openFile(fr.path);
                    if (fr.line > 0) {
                        c.placeCaret(fr.line - 1, 0);
                    }
                }
            }

            // Jump to the next (forward) or previous problem in the active file from the last build, wrapping
            // around, and show its message. F8 / Shift+F8.
            public method nextProblem(boolean forward) returns void {
                if (this.diags.size() == 0) {
                    this.out.banner("Problems", "No problems -- build the project (Run > Build) to check.");
                    return;
                }
                String base = Paths.basename(this.docs.active().document().path());
                ArrayList<int>* lines = new ArrayList<int>() on heap;
                ArrayList<String>* msgs = new ArrayList<String>() on heap;
                for (mutable int i = 0; i < this.diags.size(); i++) {
                    Diagnostic d = this.diags.get(i);
                    if (Paths.basename(d.file).equals(base)) {
                        lines.add(d.line);
                        msgs.add(d.message);
                    }
                }
                if (lines.size() == 0) {
                    this.out.banner("Problems", "No problems in this file.");
                    return;
                }
                int cur = this.docs.active().editor().cursorRow() + 1;   // 1-based
                mutable int target = -1;
                mutable int bestLine = 0;
                for (mutable int i = 0; i < lines.size(); i++) {
                    int l = lines.get(i);
                    mutable boolean cand = false;
                    if (forward) {
                        cand = l > cur && (target < 0 || l < bestLine);
                    } else {
                        cand = l < cur && (target < 0 || l > bestLine);
                    }
                    if (cand) {
                        target = i;
                        bestLine = l;
                    }
                }
                if (target < 0) {
                    // wrap: the first problem going forward, or the last going backward
                    for (mutable int i = 0; i < lines.size(); i++) {
                        int l = lines.get(i);
                        if (target < 0 || (forward && l < bestLine) || (!forward && l > bestLine)) {
                            target = i;
                            bestLine = l;
                        }
                    }
                }
                int ln = lines.get(target);
                this.docs.active().placeCaret(ln - 1, 0);
                this.out.banner("Problem", "Line " + ln.toString() + ": " + msgs.get(target));
            }

            // Symbol rename (Shift+F6): the shell stashes the identifier under the caret here, then applies the
            // new name to every whole-word occurrence when the prompt is confirmed.
            public method setRenameTarget(String w) returns void {
                this.renameOldName = w;
            }
            public method renameTargetName() returns String {
                return this.renameOldName;
            }
            public method renameSymbol(String oldName, String newName) returns int {
                if (newName.length() == 0 || oldName.equals(newName)) {
                    return 0;
                }
                return this.docs.active().renameSymbol(oldName, newName);
            }

            // Format the active file in place with `ldp3 fmt`, then reload it (Shift+Alt+F). The caret line is
            // kept; formatting never changes meaning, so undo of the whole reformat is one step.
            public method formatDocument() returns void {
                Controller* c = this.docs.active();
                String path = c.document().path();
                if (path.length() == 0) {
                    this.out.banner("Format", "Save the file to disk first, then format it.");
                    return;
                }
                c.save();
                int row = c.editor().cursorRow();
                Process.run("ldp3 fmt \"" + path + "\"");
                c.openFile(path);
                if (row < c.lineCount()) {
                    c.placeCaret(row, 0);
                }
                this.refreshGit();
            }

            // Build the current project with debug info (ldp3 build --debug) and start a debug session on the
            // resulting exe. Breakpoints already set in the gutter are sent on launch. F5 when idle.
            public method startDebugging() returns void {
                if (this.dbg.isActive()) {
                    return;
                }
                if (!this.hasProject()) {
                    this.out.banner("Debug", "Open an ldp3.toml project first -- there is nothing to debug.");
                    return;
                }
                ProcessResult br = Process.run("cd /d \"" + this.projectDir + "\" && ldp3 build --debug 2>&1");
                if (!br.success()) {
                    this.out.banner("Debug build failed", br.output);
                    return;
                }
                String exe = Paths.join(this.projectDir, Paths.join("build-output", this.projectName + ".exe"));
                if (!File.exists(exe)) {
                    this.out.banner("Debug", "Built executable not found: " + exe);
                    return;
                }
                String dap = Debugger.findLldbDap();
                if (this.dbg.start(dap, exe)) {
                    this.dbgOutConsumed = 0;
                    this.out.showLines("Debug Console", new ArrayList<String>() on heap);
                } else {
                    this.out.banner("Debug", "Could not start the debug adapter (" + dap + "). Is lldb-dap installed?");
                }
            }

            // --- source control: drive git on the project directory, straight from the IDE ---
            // Show the working-tree status as a navigable list (click a row to open that file).
            public method gitStatusView() returns void {
                ProcessResult r = Process.run("git -C \"" + this.projectDir + "\" status --porcelain");
                ArrayList<String> raw = Strings.split(r.output, "\n");
                ArrayList<String>* body = new ArrayList<String>() on heap;
                ArrayList<String>* navFiles = new ArrayList<String>() on heap;
                ArrayList<int>* navLines = new ArrayList<int>() on heap;
                mutable int i = 0;
                while (i < raw.size()) {
                    String line = raw.get(i);
                    if (line.length() > 3) {
                        String rel = line.substring(3, line.length());
                        body.add(line);
                        navFiles.add(Paths.join(this.projectDir, rel));
                        navLines.add(0);
                    }
                    i = i + 1;
                }
                if (body.size() == 0) {
                    body.add("(clean -- no changes)");
                }
                this.out.showNavigable("Source Control", body, navFiles, navLines);
            }
            // Stage everything and commit with `msg` (the common "commit all" flow), then refresh the gutter.
            public method gitCommit(String msg) returns void {
                String safe = Workbench.shellEscape(msg);
                this.runShell("Commit", "git add -A && git commit -m \"" + safe + "\"");
                this.refreshGit();
            }
            public method gitPush() returns void {
                this.runShell("Push", "git push");
            }
            // Show the diff of the active file (or the whole tree if it has no path).
            public method gitDiff() returns void {
                String path = this.docs.active().document().path();
                if (path.length() == 0) {
                    this.runShell("Diff", "git --no-pager diff");
                } else {
                    this.runShell("Diff", "git --no-pager diff -- \"" + path + "\"");
                }
            }
            // --- file operations (the shell rebuilds the tree when treeDirty is set) ---
            // Create an empty file at `rel` (relative to the project) and open it.
            public method newFileOnDisk(String rel) returns void {
                if (rel.length() == 0) {
                    return;
                }
                String full = Paths.join(this.projectDir, rel);
                if (!File.exists(full)) {
                    File.writeAll(full, "");
                }
                this.openFile(full);
                this.treeDirty = true;
            }
            // Rename the active file to `newName` in its own directory, and reopen it under the new name.
            public method renameActiveFile(String newName) returns void {
                if (newName.length() == 0) {
                    return;
                }
                String old = this.docs.active().document().path();
                if (old.length() == 0) {
                    return;
                }
                String dir = Paths.dirname(old);
                String dest = Paths.join(dir, newName);
                File.rename(old, dest);
                this.openFile(dest);
                this.treeDirty = true;
            }
            public method treeNeedsRefresh() returns boolean {
                if (this.treeDirty) {
                    this.treeDirty = false;
                    return true;
                }
                return false;
            }
            public method toggleMinimap() returns void {
                this.showMinimap = !this.showMinimap;
            }
            public method minimapVisible() returns boolean {
                return this.showMinimap;
            }

            // Escape a commit message for a double-quoted shell argument (drop the quotes that would end it).
            private static method shellEscape(String s) returns String {
                StringBuilder sb = new StringBuilder() on heap;
                mutable int i = 0;
                while (i < s.length()) {
                    char c = s.charAt(i);
                    if (c != '"') {
                        sb.appendChar(c);
                    }
                    i = i + 1;
                }
                return sb.toString();
            }

            // Feed a decoded key to the active document's editor. Returns whether it was handled.
            public method handleKey(Key* k) returns boolean {
                if (!this.docs.hasActive()) {
                    return false;
                }
                return this.keymap.dispatch(this.docs.active(), k);
            }

            // Run a palette command by id. Handles the argument-free commands; commands that need input
            // (open/save-as a path, find/replace a term) are dispatched by the shell with their arguments,
            // so this returns false for them. Returns whether the id was handled here.
            public method runCommand(String id) returns boolean {
                if (id.equals("file.new")) {
                    this.docs.openNew();
                    return true;
                }
                if (!this.docs.hasActive()) {
                    return false;
                }
                Controller* c = this.docs.active();
                if (id.equals("file.save")) {
                    c.save();
                    return true;
                }
                if (id.equals("edit.undo")) {
                    c.undo();
                    return true;
                }
                if (id.equals("edit.redo")) {
                    c.redo();
                    return true;
                }
                if (id.equals("edit.selectAll")) {
                    c.selectAll();
                    return true;
                }
                if (id.equals("edit.duplicateLine")) {
                    c.duplicateLine();
                    return true;
                }
                if (id.equals("edit.addNextOccurrence")) {
                    c.selectNextOccurrence();
                    return true;
                }
                if (id.equals("edit.selectAllOccurrences")) {
                    c.selectAllOccurrences();
                    return true;
                }
                if (id.equals("run.build")) {
                    this.diagnose();
                    return true;
                }
                if (id.equals("run.program")) {
                    this.runShell("Run", "ldp3 run");
                    return true;
                }
                if (id.equals("run.test")) {
                    this.runShell("Tests", "ldp3 test");
                    return true;
                }
                if (id.equals("view.output")) {
                    this.out.toggle();
                    return true;
                }
                if (id.equals("view.minimap")) {
                    this.toggleMinimap();
                    return true;
                }
                if (id.equals("view.theme")) {
                    this.toggleTheme();
                    return true;
                }
                if (id.equals("view.terminal")) {
                    this.toggleTerminal();
                    return true;
                }
                if (id.equals("git.status")) {
                    this.gitStatusView();
                    return true;
                }
                if (id.equals("git.push")) {
                    this.gitPush();
                    return true;
                }
                if (id.equals("git.diff")) {
                    this.gitDiff();
                    return true;
                }
                if (id.equals("edit.format")) {
                    this.formatDocument();
                    return true;
                }
                if (id.equals("debug.start")) {
                    if (this.dbg.isActive()) {
                        this.dbg.continueRun();
                    } else {
                        this.startDebugging();
                    }
                    return true;
                }
                if (id.equals("debug.stepOver")) {
                    this.dbg.stepOver();
                    return true;
                }
                if (id.equals("debug.stepInto")) {
                    this.dbg.stepInto();
                    return true;
                }
                if (id.equals("debug.stepOut")) {
                    this.dbg.stepOut();
                    return true;
                }
                if (id.equals("debug.stop")) {
                    this.dbg.stop();
                    return true;
                }
                return false;
            }
        }
    }
}
