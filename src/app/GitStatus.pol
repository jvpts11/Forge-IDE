import System.Collections.ArrayList;
import System.Text.Strings;
import System.OS.Subprocess;

program Forge;

public bundle forge {
    public namespace app {

        // Per-file git change status for the editor gutter: a list of (line, kind) marks — 1 = added,
        // 2 = modified, 3 = a deletion marker — parsed from `git diff` hunk headers, drawn as coloured bars
        // JetBrains/VS Code-style. The diff runs as a BACKGROUND subprocess (startRefresh spawns it, poll()
        // drains it a frame at a time) so opening a file never blocks the UI on a git process — the earlier
        // synchronous refresh froze a whole frame (tens to hundreds of ms) on every file open. Silent (no
        // marks) outside a git repo.
        public class GitStatus {
            private mutable ArrayList<int>* lines;    // 0-based line numbers with a change mark
            private mutable ArrayList<int>* kinds;    // parallel: 1 added, 2 modified, 3 deletion marker
            // The running `git diff`. ABSENT rather than empty between refreshes: there is no such thing
            // as a subprocess that is not running, so the slot says so instead of holding an object
            // pretending to be one.
            private mutable nullable Subprocess proc;
            private mutable boolean pending;          // a diff subprocess is in flight
            private mutable String outbuf;            // its stdout accumulated across frames

            public constructor GitStatus() {
                this.lines = new ArrayList<int>() on heap;
                this.kinds = new ArrayList<int>() on heap;
                this.proc = null;
                this.pending = false;
                this.outbuf = "";
            }

            public method clear() returns void {
                this.lines = new ArrayList<int>() on heap;
                this.kinds = new ArrayList<int>() on heap;
            }

            // Kick off a diff for `filePath` in the background; the gutter clears at once and the new marks
            // land a frame or two later via poll(). A diff already in flight is abandoned (file changed).
            public method startRefresh(String projectDir, String filePath) returns void {
                if (this.pending) {
                    this.proc.close();
                    this.pending = false;
                }
                this.clear();
                if (filePath.length() == 0) {
                    return;
                }
                String cmd = "git -C \"" + projectDir + "\" --no-pager diff --unified=0 -- \"" + filePath + "\"";
                this.proc = Subprocess.start(cmd);
                if (!this.proc.isValid()) {
                    return;
                }
                this.outbuf = "";
                this.pending = true;
            }

            // Drain the in-flight diff without blocking; when the process has finished and its output is fully
            // read, parse the hunk headers into marks. Call once per frame.
            public method poll() returns void {
                if (!this.pending) {
                    return;
                }
                while (this.proc.canRead()) {
                    String chunk = this.proc.read();
                    if (chunk.length() == 0) {
                        break;   // EOF
                    }
                    this.outbuf = this.outbuf + chunk;
                }
                if (!this.proc.isAlive() && !this.proc.canRead()) {
                    this.parseOutput(this.outbuf);
                    this.proc.close();
                    this.pending = false;
                }
            }

            private method parseOutput(String out) returns void {
                ArrayList<String> lns = Strings.split(out, "\n");
                mutable int i = 0;
                while (i < lns.size()) {
                    String ln = lns.get(i);
                    if (ln.startsWith("@@")) {
                        this.parseHunk(ln);
                    }
                    i = i + 1;
                }
            }

            // Parse a hunk header `@@ -oldStart,oldCount +newStart,newCount @@` and record its marks. A count
            // defaults to 1 when omitted (git's convention). Avoids two-argument indexOf by slicing.
            private method parseHunk(String header) returns void {
                int plus = header.indexOf("+");
                if (plus < 0) {
                    return;
                }
                String newPart = GitStatus.firstField(header.substring(plus + 1, header.length()));
                int minus = header.indexOf("-");
                mutable int oldCount = 1;
                if (minus >= 0 && minus < plus) {
                    oldCount = GitStatus.countField(GitStatus.firstField(
                        header.substring(minus + 1, header.length())));
                }
                int comma = newPart.indexOf(",");
                mutable int newStart = 0;
                mutable int newCount = 1;
                if (comma < 0) {
                    newStart = newPart.toInt();
                } else {
                    newStart = newPart.substring(0, comma).toInt();
                    newCount = newPart.substring(comma + 1, newPart.length()).toInt();
                }
                if (newCount == 0) {
                    // pure deletion: mark the line the removed text sat above
                    mutable int at = newStart;
                    if (at < 1) {
                        at = 1;
                    }
                    this.add(at - 1, 3);
                    return;
                }
                mutable int kind = 1;                 // added
                if (oldCount > 0) {
                    kind = 2;                         // lines existed before -> modified
                }
                mutable int k = 0;
                while (k < newCount) {
                    this.add(newStart - 1 + k, kind);
                    k = k + 1;
                }
            }

            // The text up to the first space (the "12,3" range field of a hunk side).
            private static method firstField(String s) returns String {
                int sp = s.indexOf(" ");
                if (sp < 0) {
                    return s;
                }
                return s.substring(0, sp);
            }

            // The count from a "start,count" field, or 1 when the count is omitted.
            private static method countField(String field) returns int {
                int comma = field.indexOf(",");
                if (comma < 0) {
                    return 1;
                }
                return field.substring(comma + 1, field.length()).toInt();
            }

            private method add(int line, int kind) returns void {
                this.lines.add(line);
                this.kinds.add(kind);
            }

            // The change kind for a 0-based document line (0 = none), scanned linearly over the (small) mark set.
            public method kindAt(int line) returns int {
                mutable int i = 0;
                while (i < this.lines.size()) {
                    if (this.lines.get(i) == line) {
                        return this.kinds.get(i);
                    }
                    i = i + 1;
                }
                return 0;
            }

            public method markCount() returns int {
                return this.lines.size();
            }
        }
    }
}
