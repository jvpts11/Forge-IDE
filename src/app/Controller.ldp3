import System.Collections.ArrayList;
import editor.Editor;
import editor.TextBuffer;
import editor.Match;
import editor.FoldState;
import view.Viewport;
import syntax.Highlighter;
import syntax.Span;
import io.Document;

program Forge;

public bundle forge {
    public namespace app {

        // The editor "brain": owns the Document, the caret/editing model (Editor), the scrolling window
        // (Viewport), and the syntax Highlighter, and keeps them consistent. A UI layer -- terminal or GUI
        // -- translates key/mouse events into these commands and reads back the render state (visible lines,
        // spans, caret, selection). Nothing here touches pixels or the terminal, so it is unit-testable.
        public class Controller {
            private mutable Document* doc;
            private mutable Editor* ed;
            private mutable Viewport* view;
            private mutable Highlighter* hl;
            private mutable FoldState* folds;
            private mutable int scrollMargin;

            public constructor Controller(int rows, int cols) {
                this.doc = new Document(new TextBuffer() on heap) on heap;
                this.ed = new Editor(this.doc.buffer()) on heap;
                this.view = new Viewport(rows, cols) on heap;
                this.hl = new Highlighter() on heap;
                this.folds = new FoldState() on heap;
                this.scrollMargin = 2;
                this.folds.recompute(this.ed.document());
                this.moved();
            }

            // Refresh the viewport's line count and follow the caret. Called after every command.
            private method moved() returns void {
                this.view.setTotalLines(this.ed.document().lineCount());
                this.view.scrollToCaret(this.ed.cursorRow(), this.ed.cursorCol(), this.scrollMargin);
            }
            // Same, plus flag the document dirty -- used by the commands that change text.
            private method edited() returns void {
                this.doc.markModified();
                this.folds.recompute(this.ed.document());
                this.moved();
            }

            public method editor() returns Editor* { return this.ed; }
            public method viewport() returns Viewport* { return this.view; }
            public method document() returns Document* { return this.doc; }
            public method lineCount() returns int { return this.ed.document().lineCount(); }
            public method setScrollMargin(int m) returns void { this.scrollMargin = m; }
            public method setTabWidth(int n) returns void { this.ed.setTabWidth(n); }

            // --- text-changing commands ---
            public method insertChar(char c) returns void { this.ed.typeWithPairs(c); this.edited(); }
            public method insertText(String s) returns void { this.ed.insertText(s); this.edited(); }
            public method newline() returns void { this.ed.enter(); this.edited(); }
            public method backspace() returns void { this.ed.backspace(); this.edited(); }
            public method deleteForward() returns void { this.ed.deleteForward(); this.edited(); }
            public method deleteWordLeft() returns void { this.ed.deleteWordLeft(); this.edited(); }
            public method deleteWordRight() returns void { this.ed.deleteWordRight(); this.edited(); }
            public method indent() returns void {
                if (this.ed.hasSelection()) { this.ed.indentSelection(); } else { this.ed.indent(); }
                this.edited();
            }
            public method dedent() returns void {
                if (this.ed.hasSelection()) { this.ed.dedentSelection(); } else { this.ed.dedent(); }
                this.edited();
            }
            public method toggleComment() returns void { this.ed.toggleComment(); this.edited(); }
            public method duplicateLine() returns void { this.ed.duplicateLine(); this.edited(); }
            public method deleteLine() returns void { this.ed.deleteLine(); this.edited(); }
            public method moveLineUp() returns void { this.ed.moveLineUp(); this.edited(); }
            public method moveLineDown() returns void { this.ed.moveLineDown(); this.edited(); }
            public method cut() returns void { this.ed.cut(); this.edited(); }
            public method paste() returns void { this.ed.paste(); this.edited(); }
            public method copy() returns void { this.ed.copy(); }

            public method undo() returns boolean { boolean r = this.ed.undo(); this.edited(); return r; }
            public method redo() returns boolean { boolean r = this.ed.redo(); this.edited(); return r; }

            // --- caret motion (extend == Shift held: extend the selection instead of clearing it) ---
            public method moveLeft(boolean extend) returns void {
                if (extend) { this.ed.selectLeft(); } else { this.ed.moveLeft(); }
                this.moved();
            }
            public method moveRight(boolean extend) returns void {
                if (extend) { this.ed.selectRight(); } else { this.ed.moveRight(); }
                this.moved();
            }
            public method moveUp(boolean extend) returns void {
                if (extend) { this.ed.selectUp(); } else { this.ed.moveUp(); }
                this.moved();
            }
            public method moveDown(boolean extend) returns void {
                if (extend) { this.ed.selectDown(); } else { this.ed.moveDown(); }
                this.moved();
            }
            public method moveWordLeft(boolean extend) returns void {
                if (extend) { this.ed.selectWordLeft(); } else { this.ed.moveWordLeft(); }
                this.moved();
            }
            public method moveWordRight(boolean extend) returns void {
                if (extend) { this.ed.selectWordRight(); } else { this.ed.moveWordRight(); }
                this.moved();
            }
            public method moveLineStart(boolean extend) returns void {
                if (extend) { this.ed.selectLineStart(); } else { this.ed.moveLineStart(); }
                this.moved();
            }
            public method moveLineEnd(boolean extend) returns void {
                if (extend) { this.ed.selectLineEnd(); } else { this.ed.moveLineEnd(); }
                this.moved();
            }
            public method moveDocStart(boolean extend) returns void {
                if (extend) { this.ed.selectDocStart(); } else { this.ed.moveDocStart(); }
                this.moved();
            }
            public method moveDocEnd(boolean extend) returns void {
                if (extend) { this.ed.selectDocEnd(); } else { this.ed.moveDocEnd(); }
                this.moved();
            }
            public method selectAll() returns void { this.ed.selectAll(); this.moved(); }
            // The bracket that pairs with the one at/near the caret (invalid Match if none) -- for highlighting.
            public method matchingBracket() returns Match* { return this.ed.matchingBracket(); }

            // Mouse: place the caret at a document position (a hit-test result).
            public method placeCaret(int row, int col) returns void { this.ed.setCaret(row, col); this.moved(); }
            // Mouse press then drag: anchor a selection, then extend it to the dragged position.
            public method beginSelect(int row, int col) returns void { this.ed.beginSelect(row, col); this.moved(); }
            public method extendSelectTo(int row, int col) returns void { this.ed.extendSelectTo(row, col); this.moved(); }
            // Mouse wheel: scroll the viewport by `delta` lines without moving the caret.
            public method scrollLines(int delta) returns void {
                if (delta < 0) { this.view.scrollUp(0 - delta); } else { this.view.scrollDown(delta); }
            }
            // Window resize: re-fit the viewport to the new pane size.
            public method resizeViewport(int rows, int cols) returns void {
                this.view.resize(rows, cols);
                this.moved();
            }

            // Paging moves the caret by (height - 1) lines; following the caret does the scroll.
            public method pageDown(boolean extend) returns void {
                int amount = this.view.height() - 1;
                for (mutable int i = 0; i < amount; i++) {
                    if (extend) { this.ed.selectDown(); } else { this.ed.moveDown(); }
                }
                this.moved();
            }
            public method pageUp(boolean extend) returns void {
                int amount = this.view.height() - 1;
                for (mutable int i = 0; i < amount; i++) {
                    if (extend) { this.ed.selectUp(); } else { this.ed.moveUp(); }
                }
                this.moved();
            }

            // --- search / file ---
            public method matchCount(String needle) returns int { return this.ed.matchCount(needle); }
            public method find(String needle) returns boolean {
                boolean r = this.ed.find(needle); this.moved(); return r;
            }
            public method findPrevious(String needle) returns boolean {
                boolean r = this.ed.findPrevious(needle); this.moved(); return r;
            }
            public method replaceAll(String needle, String replacement) returns int {
                int n = this.ed.replaceAll(needle, replacement); this.edited(); return n;
            }
            public method openFile(String path) returns void {
                this.doc.openFile(path);
                this.ed.moveDocStart();
                this.folds.recompute(this.ed.document());
                this.moved();
            }
            // Save to disk (a no-op for an untitled buffer -- a Save As prompt is the shell's job).
            public method save() returns void {
                if (this.doc.path().length() > 0) { this.doc.save(); }
            }
            public method saveAs(String path) returns void { this.doc.saveAs(path); }

            // --- render queries (the UI reads these to paint one frame) ---
            public method visibleRows() returns int { return this.view.lastLine() - this.view.firstLine(); }
            public method firstLine() returns int { return this.view.firstLine(); }
            public method firstColumn() returns int { return this.view.firstColumn(); }
            // The document row drawn at screen row `screenRow`, walking from the viewport top and skipping any
            // lines hidden by a collapsed fold. This is the single fold-aware mapping the UI reads through.
            public method lineNumberAt(int screenRow) returns int {
                int total = this.ed.document().lineCount();
                mutable int line = this.folds.firstVisibleFrom(this.view.firstLine(), total);
                mutable int steps = screenRow;
                while (steps > 0 && line < total - 1) {
                    line = line + 1;
                    while (line < total && this.folds.isHidden(line)) { line = line + 1; }
                    steps = steps - 1;
                }
                if (line >= total) { line = total - 1; }
                return line;
            }
            public method renderLine(int screenRow) returns String {
                return this.ed.document().line(this.lineNumberAt(screenRow));
            }
            public method renderSpans(int screenRow) returns ArrayList<Span> {
                return this.hl.tokenize(this.ed.document().line(this.lineNumberAt(screenRow)));
            }
            // The screen row a document line is drawn at, counting only visible lines from the viewport top.
            // Negative if the line is above the viewport; -1 if the line is hidden by a fold.
            public method screenRowForDocLine(int docLine) returns int {
                int top = this.folds.firstVisibleFrom(this.view.firstLine(), this.ed.document().lineCount());
                if (docLine < top) { return docLine - top; }
                if (this.folds.isHidden(docLine)) { return 0 - 1; }
                mutable int count = 0;
                mutable int line = top;
                while (line < docLine) {
                    line = line + 1;
                    if (!this.folds.isHidden(line)) { count = count + 1; }
                }
                return count;
            }
            // Caret position relative to the viewport's top-left (fold-aware for the row).
            public method caretScreenRow() returns int { return this.screenRowForDocLine(this.ed.cursorRow()); }
            public method caretScreenCol() returns int { return this.ed.cursorCol() - this.view.firstColumn(); }

            // Effective indentation (in leading spaces) for the indent guides at a line. A blank line carries
            // the guides of its surrounding block -- the deeper of the nearest non-blank line above and below
            // -- so the vertical guides stay continuous through empty lines instead of breaking.
            public method guideIndent(int docLine) returns int {
                String line = this.ed.document().line(docLine);
                if (!Controller.isBlankLine(line)) {
                    return Controller.leadingSpaces(line);
                }
                int total = this.ed.document().lineCount();
                mutable int up = docLine - 1;
                while (up >= 0 && Controller.isBlankLine(this.ed.document().line(up))) {
                    up = up - 1;
                }
                mutable int down = docLine + 1;
                while (down < total && Controller.isBlankLine(this.ed.document().line(down))) {
                    down = down + 1;
                }
                mutable int pv = 0;
                if (up >= 0) {
                    pv = Controller.leadingSpaces(this.ed.document().line(up));
                }
                mutable int nx = 0;
                if (down < total) {
                    nx = Controller.leadingSpaces(this.ed.document().line(down));
                }
                if (pv > nx) {
                    return pv;
                }
                return nx;
            }
            private static method isBlankLine(String s) returns boolean {
                mutable int i = 0;
                while (i < s.length()) {
                    char ch = s.charAt(i);
                    if (ch != ' ' && ch != '\t') {
                        return false;
                    }
                    i = i + 1;
                }
                return true;
            }
            private static method leadingSpaces(String s) returns int {
                mutable int i = 0;
                while (i < s.length() && s.charAt(i) == ' ') {
                    i = i + 1;
                }
                return i;
            }

            // --- folding ---
            public method isFoldable(int docLine) returns boolean { return this.folds.isFoldable(docLine); }
            public method isFolded(int docLine) returns boolean { return this.folds.isFolded(docLine); }
            public method foldEnd(int docLine) returns int { return this.folds.endOf(docLine); }
            public method anyFolded() returns boolean { return this.folds.anyFolded(); }
            // Toggle the fold whose header is `docLine`. If the caret ends up hidden, move it to the header.
            public method toggleFold(int docLine) returns void {
                this.folds.toggle(docLine);
                int caret = this.ed.cursorRow();
                if (this.folds.isHidden(caret)) {
                    int h = this.folds.headerHiding(caret);
                    if (h >= 0) { this.ed.setCaret(h, 0); }
                }
                this.moved();
            }
            // Toggle the fold at the caret: the caret's own line if foldable, else the innermost block that
            // encloses the caret.
            public method toggleFoldAtCaret() returns void {
                int caret = this.ed.cursorRow();
                if (this.folds.isFoldable(caret)) { this.toggleFold(caret); return; }
                int h = this.folds.enclosing(caret);
                if (h >= 0) { this.toggleFold(h); }
            }
            public method unfoldAll() returns void { this.folds.unfoldAll(); this.moved(); }
        }
    }
}
